    "mapscreen_psds_tip_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie PSDS unter Einstellungen → Standort für eine deutlich schnellere Ortung (auf GrapheneOS läuft es über deren Proxy)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable PSDS in Settings → Location for a much faster fix (on GrapheneOS it routes through their proxy)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa PSDS en Ajustes → Ubicación para una fijación mucho más rápida (en GrapheneOS pasa por su proxy)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez PSDS dans Paramètres → Localization pour un positionnement bien plus rapide (sur GrapheneOS, il passe par leur proxy)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעל PSDS בהגדרות ← מיקום לקליטה מהירה בהרבה (ב-GrapheneOS זה עובר דרך הפרוקסי שלהם)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsold be a PSDS-t a Beállítások → Helyadatok menüben a sokkal gyorsabb bemérésért (GrapheneOS-en a saját proxyjukon keresztül megy)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva PSDS in Impostazioni → Posizione per un blocco molto più rapido (su GrapheneOS passa attraverso il loro proxy)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 → 位置情報 で PSDS を有効にすると、測位がはるかに速くなります（GrapheneOS では専用プロキシを経由します）。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel PSDS in bij Instellingen → Locatie voor een veel snellere fix (op GrapheneOS loopt het via hun proxy)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz PSDS w Ustawienia → Lokalizacja, aby uzyskać znacznie szybsze ustalenie pozycji (w GrapheneOS przechodzi przez ich serwer proxy)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o PSDS em Configurações → Localização para uma fixação muito mais rápida (no GrapheneOS passa pelo proxy deles)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o PSDS em Definições → Localização para uma fixação muito mais rápida (no GrapheneOS passa pelo proxy deles)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activează PSDS în Setări → Locație pentru o localizare mult mai rapidă (pe GrapheneOS, traseul se face prin proxy-ul lor)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите PSDS в «Настройки → Местоположение» для гораздо более быстрого определения (в GrapheneOS запрос идёт через их прокси)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera PSDS i Inställningar → Plats för en mycket snabbare positionering (på GrapheneOS går det via deras proxy)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть PSDS у Налаштування → Місцезнаходження для значно швидшого визначення (у GrapheneOS воно йде через їхній проксі)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设置 → 位置信息中启用 PSDS 可大幅加快定位（GrapheneOS 上会经由其代理）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定 → 位置」啟用 PSDS 可大幅加快定位（在 GrapheneOS 上會透過其代理伺服器連線）。"
          }
        }
      }
    },
