    "transit_board_has_no_time_for_this_stop" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The board has no departure time for this stop, so Vela asked for now plus %1$@ min instead."
          }
        }
      }
    },
    "transit_board_time_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسرد لوحة التوقف دائمًا رحلات المغادرة التالية. تطبيق إعادة طرح المجلس وأي بحث رحلة مفتوحة؛ السطر أعلاه يعطي وقت هذا السؤال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Haltestellentafel listet stets die nächsten Abfahrten auf. Bewerben Sie sich erneut beim Vorstand und bei der Suche nach offenen Reisen. Die obige Zeile gibt den Zeitpunkt dieser Anfrage an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A stop board always lists the next departures. Apply re-asks the board and any open trip search; the line above gives the time of that ask."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A stop board always lists the next departures. Apply re-asks the board and any open trip search; the line above gives the time of that ask."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tablero de parada siempre indica las próximas salidas. Aplicar vuelve a preguntar a la junta y cualquier búsqueda de viaje abierta; la línea de arriba indica la hora de esa solicitud."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peatustahvlil on alati järgmised väljumised. Rakenda uuesti küsib pardal ja avatud reisi otsing; ülaltoodud rida annab selle küsimise aja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tableau d'arrêt liste toujours les prochains départs. Appliquer redemande le tableau et toute recherche de trajet ouverte ; la ligne au-dessus donne l'heure de cette demande."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לוח עצור תמיד מפרט את היציאות הבאות. החל מבקשת מחדש את הלוח וכל חיפוש טיול פתוח; השורה למעלה נותנת את זמן השאלון."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A stoptábla mindig felsorolja a következő indulásokat. Apply újra felkéri a fórumot, és minden nyitott utazás keresést; a fenti sor az adott kérdezés idejét adja meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tabellone delle fermate elenca sempre le prossime partenze. Applica richiede nuovamente la scheda e qualsiasi ricerca di viaggio aperta; la riga sopra indica l'ora della richiesta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停留所ボードには常に次の出発便が表示されます。申請は理事会とオープンな旅行検索を再質問します。上の行はその問い合わせの時間を示しています。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op een stopbord staan altijd de volgende vertrekken vermeld. Solliciteer opnieuw vraagt ​​het bestuur en eventuele openstaande reizen zoeken; de regel erboven geeft het tijdstip van die vraag weer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tablica przystankowa zawsze wyświetla listę kolejnych odjazdów. Zastosuj ponownie zwraca się do zarządu i wszelkich otwartych poszukiwań podróży; powyższa linia podaje czas tego zapytania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um quadro de parada sempre lista as próximas partidas. Aplicar novas perguntas ao conselho e qualquer pesquisa de viagem aberta; a linha acima fornece o horário dessa pergunta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um quadro de parada sempre lista as próximas partidas. Aplicar novas perguntas ao conselho e qualquer pesquisa de viagem aberta; a linha acima fornece o horário dessa pergunta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un panou de oprire afișează întotdeauna următoarele plecări. Aplicați întreabă din nou panoul și orice căutare de călătorie deschisă; rândul de mai sus indică timpul acelei întrebări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На табло остановок всегда указаны следующие отправления. Применить повторно запрашивает доску и любой открытый поиск поездки; строка выше показывает время этого запроса."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na postajališčih so vedno navedeni naslednji odhodi. Uporabi ponovno vpraša tablo in vsako odprto iskanje potovanja; zgornja vrstica prikazuje čas tega vprašanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En stopptavla listar alltid nästa avgångar. Ansök omfrågar styrelsen och alla öppna resesökningar; raden ovan anger tiden för den frågan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir durak panosu her zaman bir sonraki kalkışları listeler. Uygula, yönetim kuruluna ve herhangi bir açık gezi aramasına yeniden sorar; Yukarıdaki satır bu sormanın zamanını verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На табло зупинки завжди вказані наступні відправлення. Apply повторно запитує дошку та будь-який відкритий пошук поїздки; рядок вище вказує час цього запиту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "车站牌总是列出下一个出发的班次。申请重新询问董事会和任何开放的行程搜索；上面的行给出了该询问的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車站牌總是列出下一個出發的班次。申請重新詢問董事會和任何開放的行程搜尋；上面的行給出了該詢問的時間。"
          }
        }
      }
    },
