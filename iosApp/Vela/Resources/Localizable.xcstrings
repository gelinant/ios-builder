    "transit_vela_replans_from_the_chosen_departure" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم إعادة تخطيط Vela بدءًا من وقت المغادرة المختار. يحتفظ خط سير الرحلة الحالي بأوقاته الخاصة حتى يتم اختيار خيار جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela plant ab der gewählten Abfahrtszeit um. Die aktuelle Reiseroute behält ihre eigenen Zeiten bei, bis eine neue Option ausgewählt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela replans from the chosen departure time. The current itinerary keeps its own times until a new option is picked."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela replans from the chosen departure time. The current itinerary keeps its own times until a new option is picked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela vuelve a planificar a partir de la hora de salida elegida. El itinerario actual mantiene sus propios horarios hasta que se elija una nueva opción."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela plaanib ümber valitud väljumisajast. Praegune marsruut säilitab oma ajad kuni uue valiku valimiseni."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela replanifie à partir de l'heure de départ choisie. L'itinéraire actuel conserve ses propres horaires jusqu'à ce qu'une nouvelle option soit choisie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela מתכננת מחדש משעת היציאה שנבחרה. המסלול הנוכחי שומר על הזמנים שלו עד לבחירת אפשרות חדשה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vela a választott indulási időponttól újratervez. Az aktuális útvonal megtartja a saját időpontját, amíg új opciót nem választanak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela riprogramma dall'orario di partenza scelto. L'itinerario attuale mantiene i propri tempi finché non viene scelta una nuova opzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela は、選択した出発時刻から再計画します。現在の旅程は、新しいオプションが選択されるまで独自の時間を維持します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela plant opnieuw vanaf de gekozen vertrektijd. Het huidige reisschema behoudt zijn eigen tijden totdat er een nieuwe optie wordt gekozen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela zmienia plany od wybranego czasu odjazdu. Bieżący plan podróży zachowuje swoje własne czasy do czasu wybrania nowej opcji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela replaneja a partir do horário de partida escolhido. O itinerário atual mantém seus próprios horários até que uma nova opção seja escolhida."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela replaneja a partir do horário de partida escolhido. O itinerário atual mantém seus próprios horários até que uma nova opção seja escolhida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela replanifică de la ora de plecare aleasă. Itinerarul actual își păstrează propriile timpi până când este selectată o nouă opțiune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela меняет планы с выбранного времени вылета. Текущий маршрут сохраняет свое время до тех пор, пока не будет выбран новый вариант."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela načrtuje od izbranega časa odhoda. Trenutni načrt poti ohranja svoje čase, dokler ne izberete nove možnosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela planerar om från den valda avgångstiden. Den aktuella resplanen behåller sina egna tider tills ett nytt alternativ väljs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela seçilen kalkış saatinden itibaren yeniden planlama yapar. Mevcut seyahat planı, yeni bir seçenek seçilene kadar kendi zamanlarını korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela переплановує з обраного часу відправлення. Поточний маршрут зберігає власний час, доки не буде вибрано новий варіант."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 从所选出发时间重新计划。当前行程将保留自己的时间，直到选择新选项为止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 從所選發時間重新規劃。目前行程將保留自己的時間，直到選擇新選項為止。"
          }
        }
      }
    },
