    "settings_diag_redact_trips_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet Suchanfragen, Ziele, Links und Ortsnamen im Diagnose-Export aus und rundet seine Koordinaten auf etwa 10 km. Zeiten, Zählungen und Fehler bleiben. Geteilte Fahrten starten mit dem größten Kürzungsabstand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hides searches, destinations, links and place names from the diagnostics export and rounds its coordinates to about 10 km. Timing, counts and errors stay. Shared trips start on the largest trim distance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta búsquedas, destinos, enlaces y nombres de lugares en la exportación de diagnóstico y redondea sus coordenadas a unos 10 km. Los tiempos, recuentos y errores se mantienen. Los trayectos compartidos empiezan con la distancia de recorte más grande."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque les recherches, destinations, liens et noms de lieux dans l'export des diagnostics et arrondit ses coordonnées à environ 10 km. Les durées, les décomptes et les erreurs restent. Les trajets partagés démarrent avec la plus grande distance de rognage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסתיר חיפושים, יעדים, קישורים ושמות מקומות מייצוא האבחון ומעגל את הקואורדינטות לכ-10 ק\"מ. תזמונים, ספירות ושגיאות נשארים. נסיעות משותפות מתחילות במרחק הגזימה הגדול ביותר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elrejti a kereséseket, célpontokat, linkeket és helyneveket a diagnosztikai exportból, a koordinátákat pedig kb. 10 km-re kerekíti. Az időzítések, számlálók és hibák megmaradnak. A megosztott utak a legnagyobb levágási távolsággal indulnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde ricerche, destinazioni, link e nomi dei luoghi dall'esportazione della diagnostica e arrotonda le coordinate a circa 10 km. Tempi, conteggi ed errori restano. I viaggi condivisi partono dalla distanza di taglio più ampia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "診断データのエクスポートから検索語句、目的地、リンク、場所の名前を伏せ、座標を約 10 km 単位に丸めます。タイミング、件数、エラーは残ります。共有する移動記録は、最大のトリミング距離から始まります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbergt zoekopdrachten, bestemmingen, links en plaatsnamen in de diagnostiekexport en rondt de coördinaten af op ongeveer 10 km. Tijden, aantallen en fouten blijven staan. Gedeelde ritten beginnen op de grootste inkortafstand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukrywa wyszukiwania, cele, linki i nazwy miejsc w eksporcie diagnostyki i zaokrągla jego współrzędne do około 10 km. Czasy, liczniki i błędy zostają. Udostępniane podróże zaczynają od największej odległości przycięcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta pesquisas, destinos, links e nomes de locais na exportação de diagnóstico e arredonda as coordenadas para cerca de 10 km. Os tempos, as contagens e os erros permanecem. As viagens compartilhadas começam na maior distância de corte."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta pesquisas, destinos, ligações e nomes de locais na exportação de diagnóstico e arredonda as coordenadas a cerca de 10 km. Os tempos, as contagens e os erros mantêm-se. As viagens partilhadas começam na maior distância a cortar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascunde căutările, destinațiile, linkurile și denumirile locurilor din exportul de date de diagnosticare și rotunjește coordonatele la aproximativ 10 km. Datele privind durata, numărul de evenimente și erorile rămân. Călătoriile partajate încep de la cea mai mare distanță de traseu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убирает запросы, пункты назначения, ссылки и названия мест из экспорта диагностики и округляет его координаты примерно до 10 км. Тайминги, счётчики и ошибки остаются. Для поездок, которыми вы делитесь, сначала выбран наибольший радиус обрезки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Döljer sökningar, mål, länkar och platsnamn i diagnostikexporten och avrundar dess koordinater till ungefär 10 km. Tider, antal och fel behålls. Delade resor börjar på det största beskärningsavståndet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прибирає пошуки, пункти призначення, посилання й назви місць з експорту діагностики та округлює його координати приблизно до 10 км. Час, лічильники й помилки залишаються. Для поїздок, якими ви ділитеся, спершу вибрано найбільшу відстань обрізання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从诊断导出中隐去搜索、目的地、链接和地点名称，并将坐标取整到约 10 公里。时间、计数和错误会保留。分享的行程默认使用最大的裁剪距离。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從診斷匯出中隱藏搜尋、目的地、連結和地點名稱，並將座標取整到約 10 公里。時間、次數和錯誤會保留。分享行程時預設使用最大的修剪距離。"
          }
        }
      }
    },
