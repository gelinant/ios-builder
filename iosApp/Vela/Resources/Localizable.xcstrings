    "settings_poi_icon_size_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klein passt zu niedrig auflösenden Bildschirmen wie Head-Units im Auto, auf denen die Standardsymbole überdimensioniert wirken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small suits low-resolution screens like car head units, where the default icons render oversized."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tamaño pequeño va bien en pantallas de baja resolución, como las de los equipos de coche, donde los iconos predeterminados se ven enormes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petite convient aux écrans basse résolution comme les autoradios, où les icônes par défaut paraissent surdimensionnées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קטן מתאים למסכים ברזולוציה נמוכה כמו מסכי רכב, שבהם האייקונים הרגילים נראים גדולים מדי."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kicsi jól illik alacsony felbontású kijelzőkhöz, mint pl. autós fejegységek, ahol az alapértelmezett ikonok túl nagynak tűnnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piccola è adatta agli schermi a bassa risoluzione come quelli delle autoradio, dove le icone predefinite risultano enormi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車載機のような低解像度の画面では標準のアイコンが大きすぎるため、「小」が適しています。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klein past bij schermen met een lage resolutie, zoals autoschermen, waar de standaardpictogrammen te groot worden weergegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Małe pasują do ekranów o niskiej rozdzielczości, takich jak radia samochodowe, gdzie domyślne ikony są za duże."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pequeno serve para telas de baixa resolução, como as de rádios de carro, onde os ícones padrão ficam grandes demais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pequeno serve para ecrãs de baixa resolução, como os dos rádios de automóvel, onde os ícones predefinidos ficam demasiado grandes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mic se potrivește ecranelor cu rezoluție mică, cum ar fi unitățile principale ale mașinilor, unde pictogramele implicite sunt afișate supradimensionate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маленький подходит экранам с низким разрешением, например автомобильным, где обычные значки выглядят слишком крупными."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Majhne ikone so primerne za zaslone z nižjo ločljivostjo, na primer avtomobilske enote."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liten passar lågupplösta skärmar som bilstereor, där standardikonerna blir för stora."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Малий підходить для екранів із низькою роздільною здатністю, як-от автомобільні магнітоли, де типові значки виглядають завеликими."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "车机等低分辨率屏幕适合用“小”，默认图标在这类屏幕上会显得过大。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「小」適合車機這類低解析度螢幕，預設圖示在上面會顯得過大。"
          }
        }
      }
    },
