    "settings_voice_remove_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist Ihre einzige Vela-Stimme. Gesprochene Ansagen greifen dann auf eine System-Text-zu-Sprache-Engine zurück (oder bleiben stumm, falls keine installiert ist), bis Sie eine andere herunterladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is your only Vela Voice. Spoken directions fall back to a system text-to-speech engine (or go silent if none is installed) until you download another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es tu única voz de Vela. Las indicaciones habladas recurrirán a un motor de texto a voz del sistema (o quedarán en silencio si no hay ninguno instalado) hasta que descargues otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est votre seule voix Vela. Les instructions vocales utiliseront un moteur de synthèse vocale du système (ou resteront silencieuses si aucun n'est installé) jusqu'à ce que vous en téléchargiez une autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה הקול היחיד שלך מ-Vela. ההוראות המדוברות יעברו למנוע טקסט-לדיבור של המערכת (או ישתקו אם אף אחד לא מותקן) עד שתוריד אחר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az egyetlen Vela hangod. A hangos útvonalvezetés egy rendszer szövegfelolvasóra vált vissza (vagy elnémul, ha nincs telepítve egy sem), amíg le nem töltesz egy másikat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa è la tua unica voce Vela. Le indicazioni vocali ripiegheranno su un motore di sintesi vocale di sistema (o resteranno mute se non ne è installato nessuno) finché non ne scarichi un'altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは唯一の Vela 音声です。別の音声をダウンロードするまで、音声案内はシステムのテキスト読み上げエンジンを使用します（未インストールの場合は無音になります）。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is uw enige Vela-stem. Gesproken instructies vallen terug op een systeem-tekst-naar-spraak-engine (of vallen stil als er geen is geïnstalleerd) totdat u een andere downloadt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To Twój jedyny głos Vela. Wskazówki głosowe przełączą się na systemowy silnik syntezy mowy (albo zamilkną, jeśli żaden nie jest zainstalowany), dopóki nie pobierzesz kolejnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta é a sua única voz Vela. As instruções faladas passam a usar um mecanismo de texto para voz do sistema (ou ficam em silêncio se nenhum estiver instalado) até você baixar outra."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta é a sua única voz Vela. As indicações faladas passam a usar um motor de texto para voz do sistema (ou ficam silenciosas se nenhum estiver instalado) até transferir outra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceasta este singura ta versiune Vela Voice. Instrucțiunile vocale vor fi redate prin intermediul unui motor de sintetizare vocală al sistemului (sau nu se va auzi nimic dacă nu este instalat niciunul) până când vei descărca o altă versiune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это ваш единственный голос Vela. Голосовые подсказки перейдут на системный движок синтеза речи (или замолчат, если ни один не установлен), пока вы не загрузите другой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta är din enda Vela-röst. Talade vägbeskrivningar faller tillbaka på en system-text-till-tal-motor (eller blir tysta om ingen är installerad) tills du hämtar en annan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це єдиний ваш голос Vela. Голосові вказівки перейдуть на системний рушій синтезу мовлення (або замовкнуть, якщо жодного не встановлено), доки ви не завантажите інший."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是您唯一的 Vela 语音。移除后，语音播报将回退到系统文字转语音引擎（若未安装任何引擎则保持静音），直到您下载新的语音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是你唯一的 Vela 語音。移除後，語音指引會改用系統的文字轉語音引擎（如果一個都沒安裝則會靜音），直到你下載其他語音為止。"
          }
        }
      }
    },
    "settings_voice_remove_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ entfernen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove %1$@?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
