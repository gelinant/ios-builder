        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運転中は地図を平面のまま北を上に表示します。ナビ中にコンパスをタップすると切り替わります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kaart blijft plat met het noorden boven terwijl je rijdt. Tik tijdens de rit op het kompas om te wisselen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas jazdy mapa pozostaje płaska, z północą u góry. Dotknij kompasu w trakcie jazdy, aby przełączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mapa fica plano e com o norte para cima enquanto você dirige. Toque na bússola durante a viagem para alternar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mapa fica plano e com o norte para cima enquanto você dirige. Toque na bússola durante a viagem para alternar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În timpul deplasării, harta rămâne orientată cu nordul în partea de sus. Atinge busola în timpul deplasării pentru a schimba orientarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время поездки карта остаётся плоской, север вверху. Нажмите на компас во время поездки, чтобы переключить."
