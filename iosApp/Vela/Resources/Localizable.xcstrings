    "settings_building_debug_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt ein kleines Kennzeichen auf der Karte mit dem Status der Gebäudeergänzung (aus / keine hier / ausgeblendet / wird gezeichnet). Testhilfe; für den normalen Gebrauch ausschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows a small badge on the map reporting the fill-buildings state (off / none here / hidden / drawing). Testing aid; turn off for normal use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una pequeña insignia en el mapa con el estado del relleno de edificios (desactivado / ninguno aquí / oculto / dibujando). Es una ayuda para pruebas; desactívalo para el uso normal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche un petit badge sur la carte indiquant l'état du remplissage des bâtiments (désactivé / aucun ici / masqué / en cours). Aide au test, à désactiver en usage normal."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציג תג קטן על המפה עם מצב השלמת הבניינים (כבוי / אין כאן / מוסתר / משרטט). עזר לבדיקות; כבה לשימוש רגיל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kis jelvényt jelenít meg a térképen, ami az épület-kitöltés állapotát mutatja (ki / itt nincs / elrejtve / rajzolás). Tesztelési segédeszköz; normál használathoz kapcsold ki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra sulla mappa un piccolo badge con lo stato del completamento edifici (disattivo / nessuno qui / nascosti / in disegno). Strumento di test; disattivalo per l'uso normale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建物補完の状態（オフ／データなし／非表示／描画中）を示す小さなバッジを地図に表示します。テスト用です。通常はオフにしてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont een klein label op de kaart met de status van het aanvullen van gebouwen (uit / niets hier / verborgen / tekenen). Hulpmiddel om te testen; zet uit voor normaal gebruik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje na mapie małą plakietkę ze stanem uzupełniania budynków (wył. / brak tutaj / ukryte / rysowanie). Pomoc przy testach; wyłącz do zwykłego użytku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra um pequeno emblema no mapa com o estado do preenchimento de edifícios (desativado / nenhum aqui / oculto / desenhando). Ajuda de teste; desative para uso normal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra um pequeno emblema no mapa com o estado do preenchimento de edifícios (desligado / nenhum aqui / oculto / a desenhar). Ajuda de teste; desligue para uso normal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează o mică insignă pe hartă care raportează starea clădirilor de umplere (dezactivat / niciuna aici / ascuns / desenat). Ajutor de testare; dezactivează pentru utilizare normală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает на карте небольшой значок с состоянием дорисовки зданий (выкл. / здесь нет / скрыто / рисуется). Нужно для тестирования, при обычной работе выключите."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na zemljevidu prikaže majhno oznako stanja dopolnjevanja stavb (izklopljeno, ni podatkov, skrito ali izrisovanje). Namenjeno preizkušanju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar en liten bricka på kartan med status för byggnadsifyllningen (av / inga här / dolda / ritar). Testhjälpmedel; stäng av vid normal användning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує на карті невеликий значок зі станом домальовування будівель (вимк. / тут немає / приховано / малюється). Допоміжний засіб для тестування; для звичайного користування вимкніть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在地图上显示一个小角标，报告补全建筑的状态（关闭 / 此处无数据 / 已隐藏 / 绘制中）。仅用于测试，日常使用请关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在地圖上顯示小徽章，回報補建築物的狀態（關閉／此處沒有／已隱藏／繪製中）。這是測試用途，日常使用請關閉。"
          }
        }
      }
    },
