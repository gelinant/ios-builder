    "settings_google_uses_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalten Sie einen davon aus, und Vela hört auf, Google danach zu fragen. Jeder Schalter befindet sich zudem auf einer eigenen Seite."
