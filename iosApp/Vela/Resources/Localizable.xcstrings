    "settings_building_overlay_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet Gebäudeumrisse in Vororten, wo die Karte sie nicht hat. Wird in dichten Gegenden, die sie bereits haben, automatisch übersprungen. Aus = es werden keine zusätzlichen Gebäude gezeichnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draws building shapes in suburbs where the map is missing them. Auto-skipped in dense areas that already have them. Turn off to render no extra buildings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja la forma de los edificios en zonas residenciales donde el mapa no los tiene. Se omite automáticamente en zonas densas que ya los incluyen. Desactívalo para no dibujar ningún edificio adicional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessine la forme des bâtiments dans les zones pavillonnaires où la carte ne les a pas. Ignoré automatiquement dans les zones denses qui les ont déjà. Désactivez pour n'ajouter aucun bâtiment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משרטט צורות של בניינים בפרברים שבהם הם חסרים במפה. מדולג אוטומטית באזורים צפופים שכבר יש בהם בניינים. כבה כדי לא לשרטט בניינים נוספים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épületformákat rajzol azokon a külvárosi területeken, ahol a térképről hiányoznak. Sűrűn lakott területeken, ahol már megvannak, automatikusan kihagyja. Kikapcsolva nem rajzol extra épületet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna la sagoma degli edifici nelle zone residenziali dove la mappa non li ha. Saltato automaticamente nelle aree dense che già li hanno. Disattiva per non disegnare edifici aggiuntivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図に建物が登録されていない郊外で、建物の形を描画します。すでに建物がある密集地では自動的にスキップされます。オフにすると、追加の建物は描画しません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekent gebouwvormen in buitenwijken waar de kaart ze mist. Wordt automatisch overgeslagen in dichtbebouwde gebieden die ze al hebben. Zet uit om geen extra gebouwen te tekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rysuje kształty budynków na przedmieściach, gdzie mapa ich nie ma. Automatycznie pomijane w gęstej zabudowie, która już je zawiera. Wyłącz, aby nie rysować żadnych dodatkowych budynków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenha a forma dos edifícios nos subúrbios onde o mapa não os tem. Ignorado automaticamente nas zonas densas que já os têm. Desative para não desenhar edifícios extras."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenha a forma dos edifícios nos subúrbios onde o mapa não os tem. Ignorado automaticamente nas zonas densas que já os têm. Desligue para não desenhar edifícios extra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenează forme de clădiri în suburbii unde acestea lipsesc pe hartă. Se omit automat în zonele dense care deja le au. Dezactivează pentru a nu reda clădiri suplimentare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рисует контуры зданий в пригородах, где на карте их нет. В плотной застройке, где здания уже есть, пропускается автоматически. Выкл. = никаких дополнительных зданий."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na območjih brez vrisanih stavb dopolni njihove obrise. Na gosto pozidanih območjih jih ne dodaja. Izklopite za prikaz brez dodatnih stavb."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritar byggnadsformer i förorter där kartan saknar dem. Hoppas över automatiskt i täta områden som redan har dem. Stäng av för att inte rita några extra byggnader."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Малює контури будівель у передмістях, де їх бракує на карті. Автоматично пропускається в щільній забудові, де вони вже є. Вимкніть, щоб не малювати додаткових будівель."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在地图缺少建筑轮廓的郊区绘制建筑形状。已有建筑的密集城区会自动跳过。关闭后不额外绘制任何建筑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在地圖缺少建築物的郊區繪製建築物輪廓。已有建築物的密集地區會自動略過。關閉後不會額外繪製建築物。"
          }
        }
      }
    },
