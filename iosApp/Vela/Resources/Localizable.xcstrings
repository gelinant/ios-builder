    "settings_trip_share_summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt %1$ld der aufgezeichneten Punkte, %2$ld bleiben. Das sind %3$ld m am Anfang und %4$ld m am Ende."
