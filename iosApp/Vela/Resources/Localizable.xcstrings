    "settings_quick_chips_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Restaurants, Coffee, Gas… buttons under the search bar, on a route and in the car. Switch one off to take it off the rows, or drag the handle to change the order. A button that is off still works as a typed search."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyciski „Restauracje”, „Kawa”, „Stacje paliw…” znajdują się pod paskiem wyszukiwania – zarówno podczas planowania trasy jak i w trakcie jazdy. Możesz wyłączyć wybrany przycisk aby usunąć go z paska lub przeciągnąć go za pomocą uchwytu aby zmienić kolejność. Nawet jeśli przycisk jest wyłączony nadal możesz skorzystać z danej kategorii wpisując ją w wyszukiwarkę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Butoanele „Restaurante”, „Cafenea”, „Benzinărie…” afișate sub bara de căutare, pe traseu și în mașină. Dezactivează unul dintre ele pentru a-l elimina din rânduri sau trage de mâner pentru a schimba ordinea. Un buton dezactivat funcționează în continuare ca o căutare prin tastare."
          }
        }
      }
    },
