    "settings_zoom_next_turn_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إلى أي مدى يمكن أن تذهب الخريطة للحفاظ على المنعطف التالي على الشاشة. المدينة والمنطقة والبعيدة تصل حوالي أربع مرات أبعد في كل خطوة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit darf die Karte hinausgehen, um die nächste Abzweigung auf dem Bildschirm zu behalten? Stadt, Region und Ferne reichen bei jedem Schritt etwa viermal weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How far out the map may go to keep the next turn on screen. Town, region and far reach about four times farther at each step."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How far out the map may go to keep the next turn on screen. Town, region and far reach about four times farther at each step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué tan lejos puede llegar el mapa para mantener el siguiente giro en la pantalla. La ciudad, la región y los lugares lejanos llegan aproximadamente cuatro veces más lejos en cada paso."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui kaugele võib kaart minna, et järgmine pööre ekraanil püsiks. Linn, piirkond ja kaugulatus igal sammul umbes neli korda kaugemal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu'où la carte peut aller pour garder le prochain tour à l'écran. Ville, région et distance environ quatre fois plus loin à chaque étape."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה רחוק המפה עשויה להגיע כדי לשמור על הפנייה הבאה על המסך. עיר, אזור ומרחק בערך פי ארבעה בכל צעד."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milyen messze lehet a térkép ahhoz, hogy a következő forduló a képernyőn maradjon. Város, régió és távoli távolság körülbelül négyszer távolabb minden lépésnél."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto lontano può spingersi la mappa per mantenere sullo schermo la svolta successiva. Città, regione e lontano raggiungono circa quattro volte più distanza ad ogni passo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のターンを画面上に表示し続けるために、マップがどれだけ遠くまで移動できるか。街、地域、遠くは各ステップで約 4 倍の距離に到達します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe ver de kaart mag gaan om de volgende afslag op het scherm te houden. Stad, regio en verre reiken bij elke stap ongeveer vier keer verder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak daleko może się znajdować mapa, aby następny zakręt pozostał na ekranie. Miasto, region i odległość sięgają około cztery razy dalej na każdym kroku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quão longe o mapa pode ir para manter a próxima curva na tela. Cidade, região e distância alcançam cerca de quatro vezes mais longe em cada etapa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quão longe o mapa pode ir para manter a próxima curva na tela. Cidade, região e distância alcançam cerca de quatro vezes mais longe em cada etapa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât de departe poate merge harta pentru a menține următoarea viraj pe ecran. Oraș, regiune și distanță de aproximativ patru ori mai departe la fiecare pas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько далеко может отойти карта, чтобы следующий поворот оставался на экране. Город, регион и дальнее расстояние на каждом шагу простираются примерно в четыре раза дальше."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako daleč lahko sega zemljevid, da bo naslednji zavoj na zaslonu. Mesto, regija in daleč dosežejo približno štirikrat dlje na vsakem koraku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur långt ut kartan kan gå för att behålla nästa sväng på skärmen. Stad, region och avstånd cirka fyra gånger längre vid varje steg."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sonraki dönüşü ekranda tutmak için haritanın ne kadar uzağa gidebileceği. Her adımda kasaba, bölge ve uzak mesafeye yaklaşık dört kat daha fazla ulaşılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як далеко може просуватися карта, щоб утримати наступний поворот на екрані. Місто, регіон і далеко досягають приблизно в чотири рази далі на кожному кроці."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地图可以走多远才能在屏幕上保留下一个转弯。每一步，城镇、地区和远方的距离大约是四倍。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地圖可以走多遠才能在螢幕上保留下一個轉彎。每一步，城鎮、地區和遠方的距離大約是四倍。"
          }
        }
      }
    },
    "settings_zoom_to_turn" : {
      "extractionState" : "manual",
      "localizations" : {
