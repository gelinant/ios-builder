    "settings_dynamic_color_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färbt Buttons und Akzente nach deinem Hintergrundbild. Die Karte bleibt neutral."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tints buttons and accents from your wallpaper. The map stays neutral."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiñe botones y acentos según tu fondo de pantalla. El mapa se mantiene neutro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teinte les boutons et accents d'après votre fond d'écran. La carte reste neutre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צובע כפתורים והדגשות לפי הטפט שלך. המפה נשארת ניטרלית."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gombokat és kiemeléseket a háttérképedhez igazítja. A térkép semleges marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colora pulsanti e accenti in base allo sfondo. La mappa resta neutra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙に合わせてボタンやアクセントの色を付けます。地図の色は変わりません。"
          }
        },
        "kmr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rengên bişkok û devokan ji wêneyê dîwarê te digire. Nexşe bêalî dimîne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleurt knoppen en accenten naar je achtergrond. De kaart blijft neutraal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barwi przyciski i akcenty według tapety. Mapa pozostaje neutralna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colore botões e detalhes conforme o papel de parede. O mapa continua neutro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colore botões e detalhes conforme o fundo. O mapa continua neutro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorează butoanele și accentele pentru a se potrivi cu imaginea de fundal. Harta rămâne neutră."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окрашивает кнопки и акценты под обои. Карта остаётся нейтральной."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barve gumbov in poudarkov prilagodi ozadju telefona. Barve zemljevida ostanejo nespremenjene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färgar knappar och accenter efter bakgrunden. Kartan förblir neutral."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duvar kağıdınızdaki düğmeleri ve vurguları renklendirir. Harita nötr kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забарвлює кнопки й акценти під шпалери. Карта лишається нейтральною."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据您的壁纸为按钮和强调元素着色。地图保持中性配色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依你的桌布為按鈕和強調色上色，地圖維持中性色調。"
          }
        }
      }
    },
    "settings_every_recorded_drive_on_this_phone" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم إزالة كل محرك أقراص مسجل على هذا الهاتف. لا يمكن التراجع عن هذا. تبقى الأماكن والقوائم المحفوظة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle aufgezeichneten Laufwerke auf diesem Telefon werden entfernt. Dies kann nicht rückgängig gemacht werden. Gespeicherte Orte und Listen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every recorded drive on this phone will be removed. This cannot be undone. Saved places and lists stay."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every recorded drive on this phone will be removed. This cannot be undone. Saved places and lists stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todas las unidades grabadas en este teléfono. Esto no se puede deshacer. Los lugares y listas guardados permanecen."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõik selle telefoni salvestatud draivid eemaldatakse. Seda ei saa tagasi võtta. Salvestatud kohad ja loendid jäävad alles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque lecteur enregistré sur ce téléphone sera supprimé. Cela ne peut pas être annulé. Les lieux et les listes enregistrés restent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל כונן מוקלט בטלפון הזה יוסר. לא ניתן לבטל זאת. מקומות ורשימות שמורים נשארים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen a telefonon minden rögzített meghajtó el lesz távolítva. Ezt nem lehet visszavonni. A mentett helyek és listák megmaradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni unità registrata su questo telefono verrà rimossa. Questa operazione non può essere annullata. I luoghi e gli elenchi salvati rimangono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この電話機上のすべての記録ドライブが削除されます。これを元に戻すことはできません。保存した場所とリストは残ります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke opgenomen schijf op deze telefoon wordt verwijderd. Dit kan niet ongedaan worden gemaakt. Opgeslagen plaatsen en lijsten blijven staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy nagrany dysk na tym telefonie zostanie usunięty. Tego nie można cofnąć. Zapisane miejsca i listy pozostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada unidade gravada neste telefone será removida. Isto não pode ser desfeito. Os lugares e listas salvos permanecem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada unidade gravada neste telefone será removida. Isto não pode ser desfeito. Os lugares e listas salvos permanecem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare unitate înregistrată de pe acest telefon va fi eliminată. Acest lucru nu poate fi anulat. Locurile și listele salvate rămân."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все записанные диски на этом телефоне будут удалены. Это невозможно отменить. Сохраненные места и списки остаются."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsaka posneta vožnja v tem telefonu bo odstranjena. Tega ni mogoče razveljaviti. Shranjena mesta in seznami ostanejo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje inspelad enhet på den här telefonen kommer att tas bort. Detta kan inte ångras. Sparade platser och listor stannar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu telefondaki kayıtlı tüm sürücüler kaldırılacak. Bu geri alınamaz. Kaydedilen yerler ve listeler kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі записані диски на цьому телефоні буде видалено. Це неможливо скасувати. Збережені місця та списки залишаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此手机上记录的所有驱动器都将被删除。此操作无法撤消。已保存地点并列出住宿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此手機上記錄的所有磁碟機都將被刪除。此操作無法撤銷。已保存地點並列出住宿。"
          }
        }
      }
    },
