    "settings_saved_places_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichern Sie Ihre markierten Orte in einer Datei oder stellen Sie sie auf einem anderen Gerät wieder her. Der Import wird mit Ihren vorhandenen Orten zusammengeführt, es wird nie etwas überschrieben oder entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back up your starred places to a file, or restore them on another device. Import merges into what you already have. It never overwrites or removes anything, and it also reads GPX, KML and GeoJSON files exported from other map apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una copia de seguridad de tus lugares favoritos en un archivo o restáuralos en otro dispositivo. La importación se combina con lo que ya tienes: nunca sobrescribe ni elimina nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegardez vos lieux favoris dans un fichier, ou restaurez-les sur un autre appareil. L'importation fusionne avec ce que vous avez déjà, elle n'écrase et ne supprime jamais rien."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גבה את המקומות המסומנים בכוכב לקובץ, או שחזר אותם במכשיר אחר. ייבוא ממזג עם מה שכבר יש לך. הוא לעולם לא דורס או מוחק דבר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentsd el a csillagozott helyeidet egy fájlba, vagy állítsd vissza egy másik eszközön. Az importálás beolvasztja a már meglévők közé. Soha nem ír felül és nem töröl semmit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui il backup dei luoghi preferiti su un file o ripristinali su un altro dispositivo. L'importazione si unisce a ciò che hai già: non sovrascrive né rimuove nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した場所をファイルにバックアップしたり、別の端末で復元したりできます。インポートは既存のデータに統合されるだけで、上書きや削除は一切行いません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een back-up van uw plaatsen met een ster naar een bestand, of herstel ze op een ander toestel. Importeren voegt samen met wat u al hebt, het overschrijft of verwijdert nooit iets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz kopię zapasową oznaczonych miejsc w pliku lub przywróć je na innym urządzeniu. Import scala z tym co już masz, nigdy niczego nie nadpisuje ani nie usuwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça um backup dos locais marcados com estrela em um arquivo ou restaure-os em outro dispositivo. A importação soma ao que você já tem, nunca substitui nem remove nada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça uma cópia de segurança dos locais marcados com estrela num ficheiro ou restaure-os noutro dispositivo. A importação junta ao que já tem, nunca substitui nem remove nada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creează o copie de rezervă a locațiilor marcate cu stea într-un fișier sau restaurează-le pe un alt dispozitiv. Importul se îmbină cu ceea ce ai deja. Nu suprascrie și nu elimină niciodată nimic și citește, de asemenea, fișiere GPX, KML și GeoJSON exportate din alte aplicații de hărți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте резервную копию отмеченных мест в файл или восстановите их на другом устройстве. Импорт объединяется с уже имеющимися, он никогда ничего не перезаписывает и не удаляет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säkerhetskopiera dina stjärnmärkta platser till en fil, eller återställ dem på en annan enhet. Import slås samman med det du redan har, den skriver aldrig över eller tar bort något."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створіть резервну копію позначених місць у файл або відновіть їх на іншому пристрої. Імпорт додається до наявного, він ніколи нічого не перезаписує й не видаляє."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将收藏的地点备份到文件，或在其他设备上恢复。导入会合并到现有数据中，绝不会覆盖或删除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將加星號的地點備份到檔案，或在另一部裝置上還原。匯入會與現有內容合併，絕不會覆寫或移除任何資料。"
          }
        }
      }
    },
