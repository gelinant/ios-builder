    "transit_lines_and_times_come_from_the" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأسطر والأوقات تأتي من البث المفتوح Transitous. لا يتم إدراج الخط الذي لا يخدمه أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeilen und Zeiten stammen aus dem offenen Transitous-Feed. Eine Leitung, die nicht bedient wird, wird nie aufgeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lines and times come from the Transitous open feed. A line it does not serve is never listed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lines and times come from the Transitous open feed. A line it does not serve is never listed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las líneas y los tiempos provienen del feed abierto de Transitous. Una línea a la que no presta servicio nunca aparece en la lista."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read ja kellaajad pärinevad Transitous avatud voost. Rida, mida see ei teeninda, ei kuvata kunagi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lignes et les heures proviennent du flux ouvert Transitous. Une ligne qu'il ne dessert pas n'est jamais répertoriée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שורות וזמנים מגיעים מהפיד הפתוח של Transitous. קו שהיא לא משרתת לעולם לא מופיעה ברשימה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sorok és az időpontok a Transitous nyitott hírfolyamból származnak. Az a sor, amelyet nem szolgál ki, soha nem szerepel a listán."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le linee e gli orari provengono dal feed aperto Transitous. Una riga che non serve non viene mai elencata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行数と時間は Transitous オープン フィードから取得されます。サービスを提供しない回線はリストに表示されません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lijnen en tijden komen uit de open feed van Transitous. Een lijn die niet wordt bediend, wordt nooit vermeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linie i godziny pochodzą z otwartego kanału Transitous. Linia, której nie obsługuje, nigdy nie jest wymieniona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As linhas e os tempos vêm do feed aberto do Transitous. Uma linha que não atende nunca é listada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As linhas e os tempos vêm do feed aberto do Transitous. Uma linha que não atende nunca é listada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liniile și orele provin din fluxul deschis Transitous. O linie pe care nu o servește nu este niciodată listată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Строки и время берутся из открытой подачи Transitous. Линия, которую он не обслуживает, никогда не указывается."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrstice in časi prihajajo iz odprtega vira Transitous. Linija, ki je ne služi, ni nikoli navedena."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rader och tider kommer från Transitous öppet flöde. En linje som den inte tjänar listas aldrig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satırlar ve saatler Transitous açık beslemesinden gelir. Hizmet vermediği bir hat asla listelenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рядки та час надходять із відкритого каналу Transitous. Лінія, яку він не обслуговує, ніколи не відображається в списку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "线路和时间来自 Transitous 开放式馈送。它不服务的线路永远不会列出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "線路和時間來自 Transitous 開放式饋送。它不服務的線路永遠不會列出。"
          }
        }
      }
    },
