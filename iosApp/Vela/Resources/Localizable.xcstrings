    "nav_precise_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Navigation folgt dir per GPS und braucht dafür den genauen Standort. Aktuell kennt Vela nur deine ungefähre Umgebung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn-by-turn follows you with GPS, which needs precise location. Right now Vela only knows your rough area."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La navegación te sigue por GPS, y eso requiere la ubicación precisa. Ahora mismo Vela solo conoce tu zona aproximada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La navigation vous suit par GPS, ce qui demande la position précise. Pour l'instant, Vela ne connaît que votre zone approximative."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניווט מונחה עוקב אחריך עם GPS, שדורש מיקום מדויק. כרגע Vela יודע רק את האזור המשוער שלך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az útvonalvezetés GPS-szel követ, amihez pontos helyzet kell. A Vela jelenleg csak a hozzávetőleges körzetedet ismeri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La navigazione ti segue con il GPS, che richiede la posizione precisa. Al momento Vela conosce solo la tua zona approssimativa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターンバイターン案内は GPS で現在地を追跡するため、正確な位置情報が必要です。今の Vela はおおよそのエリアしか分かりません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigatie volgt je via gps en heeft daarvoor de precieze locatie nodig. Op dit moment kent Vela alleen je globale omgeving."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawigacja śledzi cię przez GPS, a to wymaga dokładnej lokalizacji. Na razie Vela zna tylko twoją przybliżoną okolicę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A navegação acompanha você pelo GPS, o que exige a localização precisa. No momento o Vela só conhece a sua área aproximada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A navegação segue você pelo GPS, o que exige a localização precisa. No momento o Vela só conhece a sua área aproximada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funcția de navigare te ghidează prin GPS, ceea ce necesită o localizare precisă. În acest moment, Vela cunoaște doar zona aproximativă în care te afli."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навигация следит за вами по GPS, для этого нужно точное местоположение. Сейчас Vela знает только ваш примерный район."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigeringen följer dig via GPS, vilket kräver exakt plats. Just nu känner Vela bara till ditt ungefärliga område."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навігація стежить за вами через GPS, і для цього потрібне точне місцезнаходження. Наразі Vela знає лише ваш приблизний район."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐向导航需要用 GPS 跟随您，因此需要精确位置权限。目前 Vela 只知道您的大致范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "導航會透過 GPS 跟著你移動，因此需要精確位置。目前 Vela 只知道你的概略區域。"
          }
        }
      }
    },
