    "transit_line_error_budget_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela stops before the published Transitous fair-use limit. Try again later; nothing is refreshed automatically."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela s'arrête avant la limite d'usage raisonnable publiée par Transitous. Réessayez plus tard ; rien n'est actualisé automatiquement."
          }
        }
      }
    },
    "transit_line_error_budget_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela reached its daily share"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela a atteint son quota quotidien"
          }
        }
      }
    },
    "transit_line_error_default_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The last answer could not be used. The sheet keeps no time and no stop from a failed request."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière réponse n'a pas pu être utilisée. La fiche ne garde ni heure ni arrêt d'une requête échouée."
          }
        }
      }
    },
    "transit_line_error_default_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The feed did not answer"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le flux n'a pas répondu"
          }
        }
      }
    },
    "transit_line_error_no_departures_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous lists no departure for this stop. Vela shows nothing rather than an invented time."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous ne liste aucun départ pour cet arrêt. Vela n'affiche rien plutôt qu'une heure inventée."
          }
        }
      }
    },
    "transit_line_error_no_line_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The feed's board for this stop does not carry this line and direction. Open the stop board to see what it serves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tableau de cet arrêt ne dessert pas cette ligne dans cette direction. Ouvrez le tableau de l'arrêt pour voir ce qu'il dessert."
          }
        }
      }
    },
    "transit_line_error_no_line_title" : {
      "extractionState" : "manual",
