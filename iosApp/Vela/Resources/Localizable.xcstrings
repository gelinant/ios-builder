    "transit_transitous_did_not_send_this_run" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يرسل Transitous تسلسل إيقاف التشغيل هذا. يتم عرض رحلات المغادرة أعلاه فقط؛ لا يخترع Vela نقاط التوقف بينهما."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous hat die Stoppsequenz dieses Laufs nicht gesendet. Es werden nur die oben genannten Abweichungen angezeigt; Vela erfindet die Stopps dazwischen nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous did not send this run's stop sequence. Only the departures above are shown; Vela does not invent the stops in between."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous did not send this run's stop sequence. Only the departures above are shown; Vela does not invent the stops in between."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous no envió la secuencia de parada de esta ejecución. Sólo se muestran las salidas anteriores; Vela no inventa las paradas intermedias."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous ei saatnud selle käitamise peatamisjärjestust. Kuvatakse ainult ülaltoodud väljumised; Vela ei leiuta vahepealseid peatusi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous n'a pas envoyé la séquence d'arrêts de ce trajet. Seuls les départs ci-dessus sont affichés ; Vela n'invente pas les arrêts intermédiaires."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous לא שלח את רצף העצירה של ריצה זו. רק היציאות לעיל מוצגות; Vela לא ממציא את העצירות שביניהם."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Transitous nem küldte el a futás leállítási sorozatát. Csak a fenti indulások láthatók; A Vela nem találja ki a köztes megállókat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous non ha inviato la sequenza di arresto di questa esecuzione. Vengono mostrate solo le partenze sopra; Vela non inventa le fermate intermedie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous はこの実行の停止シーケンスを送信しませんでした。上記の出発便のみが表示されています。 Vela は中間の停止を発明しません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous heeft de stopreeks van deze run niet verzonden. Alleen de bovenstaande vertrektijden worden getoond; Vela bedenkt de tussenstops niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous nie wysłał sekwencji zatrzymania tego przebiegu. Pokazane są tylko powyższe odloty; Vela nie wymyśla przystanków pomiędzy nimi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous não enviou a sequência de parada desta execução. Apenas as saídas acima são mostradas; O Vela não inventa as paradas intermediárias."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous não enviou a sequência de parada desta execução. Apenas as saídas acima são mostradas; O Vela não inventa as paradas intermediárias."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous nu a trimis secvența de oprire a acestei rulări. Sunt afișate doar plecările de mai sus; Vela nu inventează opririle între ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous не отправил последовательность остановки этого запуска. Показаны только указанные выше отклонения; Vela не изобретает промежуточных остановок."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous ni poslal zaporedja zaustavitve tega postopka. Prikazani so samo zgornji odhodi; Vela si ne izmišlja vmesnih postankov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous skickade inte denna körnings stoppsekvens. Endast avgångarna ovan visas; Vela uppfinner inte stopperna däremellan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous bu çalıştırmanın durdurma sırasını göndermedi. Yalnızca yukarıdaki kalkışlar gösterilmektedir; Vela aradaki durakları icat etmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous не надіслав цю послідовність зупинки запуску. Показані лише відправлення вище; Vela не винаходить зупинки між ними."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous 未发送本次运行的停止序列。仅显示上述出发航班； Vela 并没有发明中间的停靠点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous 未發送本次運行的停止序列。僅顯示上述出發航班； Vela 並未發明中間的停靠點。"
          }
        }
      }
    },
    "transit_transitous_has_no_such_search_field" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحتوي Transitous على حقل بحث كهذا: عمليات نقل أقل ومشي أقل، يعيد ترتيب الرحلات التي أعادها، ولا يزيل الرحلات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous hat kein solches Suchfeld: weniger Transfers und weniger Fußwege. Die zurückgegebenen Fahrten werden neu angeordnet, Fahrten werden nicht entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous has no such search field: fewer transfers and less walking reorder the trips it returned, they do not remove trips."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous has no such search field: fewer transfers and less walking reorder the trips it returned, they do not remove trips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous no tiene ese campo de búsqueda: menos traslados y menos caminatas reordenan los viajes que devolvió, no eliminan viajes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous-l sellist otsinguvälja pole: vähem ümberistumisi ja vähem kõndimist korraldavad tagastatud reisid ümber, need ei eemalda reise."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous n'a pas un tel champ de recherche : moins de correspondances et moins de marche réordonnent les trajets renvoyés, elles n'en suppriment pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ל-Transitous אין שדה חיפוש כזה: פחות העברות ופחות הליכה מסדרים מחדש את הנסיעות שהיא החזירה, הם לא מסירים נסיעות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Transitous-nek nincs ilyen keresőmezője: kevesebb átszállás és kevesebb gyaloglás újrarendeli a visszaküldött utakat, nem távolítják el az utakat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous non ha un campo di ricerca di questo tipo: meno trasferimenti e meno passeggiate riordinano i viaggi restituiti, non rimuovono i viaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous にはそのような検索フィールドはありません。乗換回数や徒歩回数が少ないと、返された旅行の順序が変更されますが、旅行は削除されません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous heeft zo'n zoekveld niet: minder overstappen en minder lopen, herschik de geretourneerde reizen, ze verwijderen geen reizen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous nie ma takiego pola wyszukiwania: mniej przesiadek i mniej pieszych. Zmień kolejność zwróconych podróży, nie usuwają podróży."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Transitous não possui esse campo de busca: menos transferências e menos caminhadas reordenam as viagens retornadas, eles não removem viagens."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Transitous não possui esse campo de busca: menos transferências e menos caminhadas reordenam as viagens retornadas, eles não removem viagens."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous nu are un astfel de câmp de căutare: mai puține transferuri și mai puține mers pe jos reordonează călătoriile pe care le-a întors, nu elimină călătoriile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У Transitous нет такого поля поиска: меньше пересадок и меньше прогулок, переупорядочивайте возвращенные поездки, они не удаляют поездки."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous nima takšnega iskalnega polja: manj prestopov in manj hoje prerazporedi potovanja, ki jih je vrnil, ne odstranijo potovanj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous har inget sådant sökfält: färre överföringar och mindre promenader gör om resorna den returnerade, de tar inte bort resor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous'nin böyle bir arama alanı yoktur: daha az transfer ve daha az yürüyüş, geri getirdiği yolculukları yeniden sıralar, yolculukları kaldırmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У Transitous немає такого поля пошуку: менше пересадок і менше пішоходів, переупорядковуйте поїздки, які він повернув, вони не видаляють поїздки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous 没有这样的搜索字段：更少的换乘和更少的步行对其返回的行程重新排序，它们不会删除行程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous 沒有這樣的搜尋欄位：更少的換乘和更少的步行對其返回的行程重新排序，它們不會刪除行程。"
          }
        }
      }
    },
    "transit_transitous_may_not_cover_this_stop" : {
