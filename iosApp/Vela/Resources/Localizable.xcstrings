    "settings_adds_zoom_in_and_zoom_out" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف أزرار التكبير والتصغير الموجودة أسفل البوصلة، للأشياء التي يقوم بها التمرير السريع أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt unter dem Kompass Schaltflächen zum Vergrößern und Verkleinern hinzu, für die Dinge, die auch ein Wischen bewirkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds zoom in and zoom out buttons under the compass, for the things a swipe also does."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds zoom in and zoom out buttons under the compass, for the things a swipe also does."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega botones para acercar y alejar debajo de la brújula, para las cosas que también hace un deslizamiento."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisab kompassi alla sisse- ja väljasuumimisnupud nende toimingute jaoks, mida teeb ka pühkimine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute des boutons de zoom avant et arrière sous la boussole, pour les choses qu'un balayage fait également."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוסיף לחצני הגדלה והקטנה מתחת למצפן, עבור הדברים שהחלקה גם עושה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagyítási és kicsinyítési gombokat ad az iránytű alá, azokhoz a funkciókhoz, amelyeket egy csúsztatás is megtesz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge i pulsanti di zoom avanti e indietro sotto la bussola, per le cose che fa anche uno scorrimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スワイプでもできるように、コンパスの下にズームインとズームアウトのボタンを追加します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt knoppen voor in- en uitzoomen toe onder het kompas, voor de dingen die een veegbeweging ook doet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje przyciski powiększania i pomniejszania pod kompasem, służące również do wykonywania funkcji przesuwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona botões de aumentar e diminuir o zoom sob a bússola, para as coisas que um deslizar também faz."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona botões de aumentar e diminuir o zoom sob a bússola, para as coisas que um deslizar também faz."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă butoane de mărire și micșorare sub busolă, pentru lucrurile pe care le face și o glisare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет кнопки увеличения и уменьшения масштаба под компасом, которые также можно выполнить с помощью смахивания."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doda gumbe za povečavo in pomanjšavo pod kompasom za stvari, ki jih naredi tudi vlečenje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger till knappar för att zooma in och ut under kompassen, för de saker som ett svep också gör."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydırmanın da yaptığı şeyler için pusulanın altına yakınlaştırma ve uzaklaştırma düğmeleri eklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додано кнопки збільшення та зменшення масштабу під компасом для тих речей, які також виконуються пальцем."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在指南针下方添加放大和缩小按钮，以实现滑动也可以完成的操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在指南針下方新增放大和縮小按鈕，以實現滑動也可以完成的操作。"
          }
        }
      }
    },
    "settings_advanced" : {
      "extractionState" : "manual",
