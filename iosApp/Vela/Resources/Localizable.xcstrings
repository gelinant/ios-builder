          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivandone una, Vela smette di chiedere a Google quel dato. Ogni tasto si trova inoltre su una pagina a sé stante."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz jeden z nich a Vela przestanie wysyłać do Google zapytania na jego temat. Każdy przełącznik znajduje się również na osobnej stronie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligue uma opção, e o Vela deixa de enviar para a Google. Cada opção está também na sua própria página."
