    "settings_route_picker_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt jeweils eine Route, die anderen einen Tipp entfernt und ihre Zeiten auf der Karte, und „Starten“ unten. Schalten Sie dies aus für Velas klassisches Feld, das alle Routen auf einmal auflistet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows one route at a time, with the others behind a tap and their times on the map, and Start along the bottom. Turn it off for Vela's classic panel, which lists every route at once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una ruta cada vez, con las demás a un toque y sus tiempos en el mapa, e Iniciar en la parte inferior. Desactívalo para usar el panel clásico de Vela, que muestra todas las rutas a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche un itinéraire à la fois, les autres à portée d'un geste avec leurs durées sur la carte, et Démarrer en bas. Désactivez-le pour retrouver le panneau classique de Vela, qui liste tous les itinéraires à la fois."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציג מסלול אחד בכל פעם, כשהאחרים במרחק הקשה והזמנים שלהם על המפה, ו\"התחל\" בתחתית. כבה את זה כדי לחזור לחלונית הקלאסית של Vela, שמציגה את כל המסלולים בבת אחת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyszerre egy útvonalat mutat, a többit egy koppintással éred el, az idejük a térképen látszik, az Indítás gomb pedig alul van. Kapcsold ki a Vela klasszikus paneljéhez, amely minden útvonalat egyszerre listáz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un percorso alla volta, con gli altri a un tocco di distanza e i loro tempi sulla mappa, e Avvia in basso. Disattivalo per il pannello classico di Vela, che elenca tutti i percorsi insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルートを 1 本ずつ表示し、ほかのルートはタップで切り替えて所要時間を地図上に示し、下部に「開始」を置きます。オフにすると、すべてのルートを一度に並べる Vela の従来のパネルになります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont één route tegelijk, met de andere achter een tik en hun tijden op de kaart, en Start onderaan. Zet dit uit voor het klassieke paneel van Vela, dat alle routes tegelijk toont."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje jedną trasę naraz, pozostałe po dotknięciu z czasami na mapie a Start na dole. Wyłącz aby wrócić do klasycznego panelu Veli który pokazuje wszystkie trasy naraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra uma rota de cada vez, com as outras a um toque e os tempos delas no mapa, e Iniciar embaixo. Desative para o painel clássico do Vela, que lista todas as rotas de uma vez."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra uma rota de cada vez, com as outras a um toque e os tempos delas no mapa, e Iniciar em baixo. Desligue para o painel clássico da Vela, que lista todas as rotas de uma vez."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează câte un traseu pe rând, celelalte fiind accesibile printr-o atingere, cu duratele lor indicate pe hartă, iar butonul „Start” afișat în partea de jos. Dezactivează această opțiune pentru a afișa panoul clasic al aplicației Vela, care afișează toate traseele simultan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает по одному маршруту: остальные открываются нажатием, их время видно на карте, а кнопка «Начать» внизу. Выключите, чтобы вернуть классическую панель Vela со всеми маршрутами сразу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar en rutt i taget, med de andra ett tryck bort och deras tider på kartan, och Starta längst ned. Stäng av det för Velas klassiska panel, som listar alla rutter på en gång."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує по одному маршруту: інші відкриваються дотиком, їхній час видно на карті, а кнопка «Почати» внизу. Вимкніть, щоб повернути класичну панель Vela з усіма маршрутами одразу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次只显示一条路线，其他路线点按即可切换并在地图上标出用时，“开始”位于底部。关闭后使用 Vela 的经典面板，一次列出所有路线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次只顯示一條路線，其他路線點一下即可切換，並在地圖上標出所需時間，「開始」位於底部。關閉後改用 Vela 的經典面板，一次列出所有路線。"
          }
        }
      }
    },
