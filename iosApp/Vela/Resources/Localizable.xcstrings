          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android deschide linkurile Google Maps în browser. Pentru a le deschide în Vela, activează opțiunea „Deschide linkurile compatibile” și adaugă linkurile la „Deschide implicit”."
