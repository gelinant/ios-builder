          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochodzą one z nowego wyszukiwania Transitous. Powyższa podróż ma swoje własne godziny, dopóki nie wybierzesz jednego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
