    "settings_clear_history_confirm_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letzte Suchen, zuletzt verwendete Orte, der Parkverlauf und jede aufgezeichnete Fahrt werden gelöscht. Das lässt sich nicht rückgängig machen. Gespeicherte Orte und Listen sind nicht betroffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recent searches, recent places, parking history and every recorded trip will be deleted. This cannot be undone. Saved places and lists are not affected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán las búsquedas recientes, los lugares recientes, el historial de aparcamiento y todos los trayectos grabados. Esto no se puede deshacer. Los lugares guardados y las listas no se ven afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les recherches récentes, les lieux récents, l'historique de stationnement et tous les trajets enregistrés seront supprimés. Cette action est irréversible. Les lieux enregistrés et les listes ne sont pas concernés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חיפושים אחרונים, מקומות אחרונים, היסטוריית חניות וכל נסיעה מוקלטת יימחקו. אי אפשר לבטל את זה. מקומות שמורים ורשימות לא מושפעים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A legutóbbi keresések, a legutóbbi helyek, a parkolási előzmények és minden rögzített út törlődik. Ez nem vonható vissza. A mentett helyeket és listákat nem érinti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricerche recenti, luoghi recenti, cronologia dei parcheggi e ogni viaggio registrato verranno eliminati. L'operazione non può essere annullata. Luoghi salvati e liste non vengono toccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近の検索、最近の場所、駐車履歴、記録した移動がすべて削除されます。元に戻すことはできません。保存済みの場所とリストには影響しません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recente zoekopdrachten, recente plaatsen, parkeergeschiedenis en elke opgenomen rit worden verwijderd. Dit kan niet ongedaan worden gemaakt. Opgeslagen plaatsen en lijsten blijven ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostatnie wyszukiwania, ostatnie miejsca, historia parkowania i każda zapisana podróż zostaną usunięte. Tej operacji nie można cofnąć. Zapisane miejsca i listy pozostają bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pesquisas recentes, os locais recentes, o histórico de estacionamento e todas as viagens gravadas serão excluídos. Não é possível desfazer. Os locais salvos e as listas não são afetados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pesquisas recentes, os locais recentes, o histórico de estacionamento e todas as viagens gravadas serão eliminados. Não é possível anular. Os locais guardados e as listas não são afetados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Căutările recente, locurile recente, istoricul parcărilor și fiecare traseu înregistrat vor fi șterse. Această acțiune nu poate fi anulată. Locurile și listele salvate nu sunt afectate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недавние запросы, недавние места, история парковок и все записанные поездки будут удалены. Отменить это нельзя. Сохранённых мест и списков это не коснётся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senaste sökningar, senaste platser, parkeringshistorik och alla inspelade resor tas bort. Det går inte att ångra. Sparade platser och listor påverkas inte."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недавні пошуки, недавні місця, історію паркування та всі записані поїздки буде видалено. Це не можна скасувати. Збережених місць і списків це не стосується."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近搜索、最近地点、停车记录和每一条已记录的行程都将被删除，且无法恢复。收藏的地点和列表不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近搜尋、最近地點、停車記錄和每一筆已記錄的行程都會被刪除，而且無法復原。已儲存的地點和清單不受影響。"
          }
        }
      }
    },
