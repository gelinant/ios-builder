    "settings_faster_auto_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn unterwegs eine schnellere Route auftaucht, wird sie genommen, sofern Sie nicht innerhalb weniger Sekunden reagieren. Ist dies aus, wird ein unbeantwortetes Angebot stattdessen verworfen. So oder so bleibt das Angebot nie wartend auf der Karte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a faster route comes up mid drive, it is taken if you do not answer within a few seconds. Turn this off and an unanswered offer is dismissed instead. Either way the offer never stays on the map waiting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando aparece una ruta más rápida durante el trayecto, se toma si no respondes en unos segundos. Si lo desactivas, una oferta sin respuesta se descarta. En ambos casos, la oferta nunca se queda esperando en el mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand un itinéraire plus rapide apparaît en cours de trajet, il est pris si vous ne répondez pas en quelques secondes. Désactivez cette option pour qu'une proposition sans réponse soit plutôt ignorée. Dans les deux cas, la proposition ne reste jamais en attente sur la carte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשמסלול מהיר יותר מופיע באמצע הנסיעה, עוברים אליו אם לא תענה תוך כמה שניות. אם תכבה את זה, הצעה שלא נענתה תיסגר במקום זאת. בכל מקרה ההצעה אף פעם לא נשארת על המפה בהמתנה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha vezetés közben gyorsabb útvonal adódik, a Vela átvált rá, ha néhány másodpercen belül nem válaszolsz. Ha ezt kikapcsolod, a megválaszolatlan ajánlat inkább eltűnik. Az ajánlat egyik esetben sem marad várakozva a térképen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando durante la guida compare un percorso più veloce, viene scelto se non rispondi entro pochi secondi. Se disattivi questa opzione, una proposta senza risposta viene invece scartata. In ogni caso la proposta non resta mai in attesa sulla mappa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走行中により速いルートが見つかったとき、数秒以内に応答しなければそのルートに切り替えます。オフにすると、応答しなかった提案は取り消されます。どちらの場合も、提案が地図上に残り続けることはありません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als er onderweg een snellere route opduikt, wordt die genomen als je niet binnen een paar seconden reageert. Zet dit uit en een onbeantwoord aanbod verdwijnt in plaats daarvan. Hoe dan ook blijft het aanbod nooit wachtend op de kaart staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy w trakcie jazdy pojawi się szybsza trasa, zostanie wybrana, jeśli nie odpowiesz w ciągu kilku sekund. Po wyłączeniu propozycja bez odpowiedzi zostanie odrzucona. Tak czy inaczej propozycja nigdy nie czeka na mapie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando surge uma rota mais rápida no meio da viagem, ela é seguida se você não responder em poucos segundos. Desative isto e uma proposta sem resposta é descartada. De qualquer forma, a proposta nunca fica esperando no mapa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando surge uma rota mais rápida a meio da viagem, é seguida se não responder em poucos segundos. Desligue isto e uma proposta sem resposta é descartada. De qualquer forma, a proposta nunca fica à espera no mapa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când apare un traseu mai rapid în timpul călătoriei, acesta este selectat dacă nu răspunzi în câteva secunde. Dacă dezactivezi această opțiune, oferta la care nu ai răspuns va fi ignorată. În orice caz, oferta nu rămâne niciodată afișată pe hartă în așteptare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если в пути появляется более быстрый маршрут, он выбирается, когда вы не отвечаете в течение нескольких секунд. Если выключить, предложение без ответа просто закрывается. В любом случае оно не висит на карте в ожидании."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När en snabbare rutt dyker upp under körning väljs den om du inte svarar inom några sekunder. Stäng av detta så avfärdas ett obesvarat erbjudande i stället. Hur som helst ligger erbjudandet aldrig kvar och väntar på kartan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо в дорозі з'являється швидший маршрут, його буде вибрано, коли ви не відповісте протягом кількох секунд. Якщо вимкнути, пропозиція без відповіді просто закривається. Так чи так, вона не висить на карті в очікуванні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行驶途中出现更快路线时，如果您几秒内没有回应，就会自动采用。关闭后，未回应的提示会被忽略。无论哪种情况，提示都不会一直停留在地图上等待。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行車途中出現更快的路線時，如果你幾秒內沒有回應，就會自動改走。關閉後，沒有回應的提示會直接略過。無論哪一種，提示都不會一直停留在地圖上等待。"
          }
        }
      }
    },
