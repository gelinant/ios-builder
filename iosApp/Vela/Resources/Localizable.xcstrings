    "settings_reviews_on_tap_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ort zeigt eine Schaltfläche Bewertungen anzeigen, statt sie zu laden. Bewertungen sind die größte Google-Anfrage auf einer Ortsseite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A place shows a Show reviews button instead of loading them. Reviews are the largest Google request on a place page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lugar muestra un botón Mostrar reseñas en vez de cargarlas. Las reseñas son la mayor petición a Google en la página de un lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lieu affiche un bouton Afficher les avis au lieu de les charger. Les avis sont la plus grosse requête Google d'une page de lieu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "במקום טעינה, יוצג כפתור הצגת ביקורות. הביקורות הן הבקשה הגדולה ביותר לגוגל בדף של מקום."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A helyoldalon egy Értékelések megjelenítése gomb jelenik meg a betöltés helyett. Az értékelések a helyoldal legnagyobb Google-kérései."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un luogo mostra un pulsante Mostra recensioni invece di caricarle. Le recensioni sono la richiesta a Google più pesante della pagina di un luogo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クチコミを読み込む代わりに「クチコミを表示」ボタンを出します。クチコミは場所ページで最も大きなGoogleへのリクエストです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een plaats toont een knop Reviews tonen in plaats van ze te laden. Reviews zijn het grootste Google-verzoek op een plaatspagina."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsce pokazuje przycisk Pokaż opinie zamiast je wczytywać. Opinie to największe zapytanie do Google na stronie miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O local mostra um botão Mostrar avaliações em vez de carregá-las. As avaliações são a maior solicitação ao Google na página de um local."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O local mostra um botão Mostrar avaliações em vez de carregá-las. As avaliações são o maior pedido ao Google na página de um local."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În locul încărcării recenziilor, pe pagina locației va apărea butonul „Afișează recenziile”. Recenziile reprezintă cea mai mare solicitare către Google de pe pagina locației."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вместо загрузки отзывов на странице места появится кнопка Показать отзывы. Отзывы это самый большой запрос к Google на странице места."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En plats visar knappen Visa recensioner i stället för att läsa in dem. Recensioner är den största Google-förfrågan på en platssida."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замість завантаження відгуків на сторінці місця з'явиться кнопка Показати відгуки. Відгуки це найбільший запит до Google на сторінці місця."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地点页显示“显示评价”按钮，而不是直接加载。评价是地点页面向 Google 发出的最大请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地點頁會顯示「顯示評論」按鈕，而不是直接載入。評論是地點頁面向 Google 發出的最大請求。"
          }
        }
      }
    },
