    "transit_these_pass_through_picking_one_keeps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمر هذه عبر %1$@. يؤدي اختيار واحدة إلى إبقاء شاشة الرحلة وورقة التفاصيل في نفس خط سير الرحلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese passieren %1$@. Wenn Sie eine Option auswählen, bleiben der Reisebildschirm und das Detailblatt auf derselben Reiseroute."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These pass through %1$@. Picking one keeps the trip screen and the detail sheet on the same itinerary."
