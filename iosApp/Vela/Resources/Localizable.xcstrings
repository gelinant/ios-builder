    "settings_map_theme_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte für sich: helle Straßen unter einer dunklen App oder dunkle Straßen unter einer hellen. Tag und Nacht beim Fahren gilt weiterhin für die Karte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The map on its own: light streets under a dark app, or dark streets under a light one. Day and night while driving still applies to the map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa por su cuenta: calles claras bajo una app oscura, o calles oscuras bajo una clara. El modo día y noche al conducir se sigue aplicando al mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte à part : des rues claires sous une application sombre, ou des rues sombres sous une application claire. Le mode jour et nuit en conduite s'applique toujours à la carte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המפה בנפרד: הצגת הרחובות בעיצוב בהיר כאשר היישום בעיצוב כהה, או להפך. יום ולילה בזמן נהיגה עדיין יחולו על המפה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A térkép külön: világos utcák sötét alkalmazás alatt, vagy sötét utcák világos alatt. Vezetés közben a nappali és éjszakai mód továbbra is érvényes a térképre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mappa per conto suo: strade chiare sotto un'app scura, o strade scure sotto un'app chiara. Giorno e notte durante la guida vale comunque per la mappa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図だけ別のテーマにできます。ダークのアプリに明るい地図、またはライトのアプリに暗い地図です。運転中の昼と夜の切り替えは、引き続き地図に適用されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kaart apart: lichte straten onder een donkere app, of donkere straten onder een lichte. Dag en nacht tijdens het rijden geldt nog steeds voor de kaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa niezależnie od aplikacji: jasne ulice przy ciemnej aplikacji albo ciemne przy jasnej. Tryb dzienny i nocny podczas jazdy nadal dotyczy mapy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mapa separado do app: ruas claras com o app escuro, ou ruas escuras com o app claro. O modo dia e noite ao dirigir continua valendo para o mapa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mapa à parte: ruas claras com a aplicação escura, ou ruas escuras com a aplicação clara. O modo de dia e de noite durante a condução continua a aplicar-se ao mapa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harta în sine: străzi deschise la culoare într-o aplicație cu fundal întunecat sau străzi întunecate într-una cu fundal deschis. Distincția dintre zi și noapte în timpul conducerii se aplică și în cazul hărții."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отдельная тема для карты: светлые улицы при тёмном приложении или тёмные при светлом. Дневной и ночной режим во время поездки по-прежнему действует на карту."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartan för sig: ljusa gator under en mörk app, eller mörka gator under en ljus. Dag och natt under körning gäller fortfarande för kartan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта окремо: світлі вулиці в темному застосунку або темні у світлому. День і ніч під час їзди й далі діють для карти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单独设置地图：深色应用配浅色街道，或浅色应用配深色街道。驾驶时的日夜切换仍会作用于地图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地圖可以單獨設定：深色應用程式搭配淺色街道，或淺色應用程式搭配深色街道。開車時的日夜切換仍會套用到地圖。"
          }
        }
      }
    },
