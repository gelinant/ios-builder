    "settings_update_auto_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft etwa täglich auf GitHub und bietet neuere Versionen an. Ausschalten, wenn du über Obtainium aktualisierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks GitHub about once a day and offers newer releases. Turn off if you update through Obtainium."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta GitHub una vez al día y ofrece versiones más nuevas. Desactívalo si actualizas con Obtainium."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulte GitHub environ une fois par jour et propose les nouvelles versions. Désactivez si vous mettez à jour via Obtainium."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בודק ב־GitHub בערך פעם ביום ומציע גרסאות חדשות יותר. אפשר לכבות אם משתמשים ביישום מעדכן."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naponta kb. egyszer ellenőrzi a GitHubot, és felkínálja az újabb kiadásokat. Kapcsold ki, ha Obtainiumon keresztül frissítesz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla GitHub circa una volta al giorno e propone versioni più recenti. Disattiva se aggiorni con Obtainium."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 日 1 回ほど GitHub を確認し、新しいリリースを案内します。Obtainium で更新している場合はオフにしてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleert GitHub ongeveer eens per dag en biedt nieuwere versies aan. Zet uit als je via Obtainium bijwerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdza GitHub mniej więcej raz dziennie i proponuje nowsze wydania. Wyłącz jeśli aktualizujesz przez Obtainium."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica o GitHub cerca de uma vez por dia e propõe versões mais recentes. Desative se você atualiza pelo Obtainium."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica o GitHub cerca de uma vez por dia e propõe versões mais recentes. Desliga se atualizas pelo Obtainium."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifică GitHub cam o dată pe zi și oferă versiuni mai noi. Dezactivează această opțiune dacă efectuezi actualizările prin Obtainium."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяет GitHub примерно раз в день и предлагает новые версии. Отключите, если обновляетесь через Obtainium."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kollar GitHub ungefär en gång om dagen och erbjuder nyare versioner. Stäng av om du uppdaterar via Obtainium."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевіряє GitHub приблизно раз на день і пропонує новіші версії. Вимкніть, якщо оновлюєтеся через Obtainium."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大约每天检查一次 GitHub 并提示较新的版本。若您通过 Obtainium 更新，请关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大約每天透過 GitHub 檢查一次，並提供較新的版本。如果你透過 Obtainium 更新，請關閉。"
          }
        }
      }
    },
