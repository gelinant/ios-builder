    "settings_delete_offline_all_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa %1$@ an heruntergeladenen Karten, Routing- und Ortsdaten werden entfernt. Gespeicherte Orte, Fahrten und Stimmen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About %1$@ of downloaded maps, routing and places will be removed. Saved places, trips and voices are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitarán unos %1$@ de mapas, rutas y lugares descargados. Los lugares guardados, los trayectos y las voces se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ %1$@ de cartes, d'itinéraires et de lieux téléchargés seront supprimés. Les lieux enregistrés, les trajets et les voix sont conservés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כ-%1$@ של מפות, ניתוב ומקומות שהורדו יוסרו. מקומות שמורים, נסיעות וקולות נשמרים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Körülbelül %1$@ letöltött térkép, útvonaltervezési adat és hely törlődik. A mentett helyek, utak és hangok megmaradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno rimossi circa %1$@ di mappe, percorsi e luoghi scaricati. Luoghi salvati, viaggi e voci restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードした地図、経路データ、場所データの約 %1$@ が削除されます。保存済みの場所、移動記録、音声は残ります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongeveer %1$@ aan gedownloade kaarten, routering en plaatsen wordt verwijderd. Opgeslagen plaatsen, ritten en stemmen blijven bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostanie usunięte około %1$@ pobranych map, tras i miejsc. Zapisane miejsca, podróże i głosy zostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serão removidos cerca de %1$@ de mapas, rotas e locais baixados. Os locais salvos, as viagens e as vozes são mantidos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serão removidos cerca de %1$@ de mapas, percursos e locais transferidos. Os locais guardados, as viagens e as vozes são mantidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aproximativ %1$@ din hărțile, rutele și locațiile descărcate vor fi eliminate. Locurile, călătoriile și vocile salvate sunt păstrate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет удалено около %1$@ загруженных карт, маршрутов и мест. Сохранённые места, поездки и голоса останутся."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstranjenih bo približno %1$@ prenesenih zemljevidov, poti in krajev. Shranjeni kraji, potovanja in glasovi ostanejo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirka %1$@ hämtade kartor, ruttning och platser tas bort. Sparade platser, resor och röster behålls."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буде видалено приблизно %1$@ завантажених карт, маршрутизації та місць. Збережені місця, поїздки й голоси залишаться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将移除约 %1$@ 已下载的地图、路线和地点数据。收藏的地点、行程和语音会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將移除約 %1$@ 已下載的地圖、路線規劃和地點資料。已儲存的地點、行程和語音會保留。"
          }
        }
      }
    },
    "settings_delete_offline_all_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt alle gespeicherten Bereiche, alle heruntergeladenen Regionen (Routing, Orte, Karte), die Gebäude- und Adress-Overlays sowie den Karten-Cache und verkleinert die Kartendatenbank. Stimmen bleiben erhalten. Nutzen Sie dies, wenn die Speicherangaben oben nicht zu dem passen, was Sie in den Listen sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes every saved area, every downloaded region (routing, places, map), the building and address overlays and the browsing cache, and shrinks the map database. Voices are kept. Use this if the storage figures above do not add up to what you can see in the lists."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita todas las zonas guardadas, todas las regiones descargadas (rutas, lugares, mapa), las capas de edificios y direcciones y la caché del mapa, y reduce la base de datos del mapa. Las voces se conservan. Úsalo si las cifras de almacenamiento de arriba no cuadran con lo que ves en las listas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime toutes les zones enregistrées, toutes les régions téléchargées (itinéraires, lieux, carte), les couches de bâtiments et d'adresses et le cache de la carte, et réduit la base de données de la carte. Les voix sont conservées. Utilisez cette option si les chiffres de stockage ci-dessus ne correspondent pas à ce que vous voyez dans les listes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסיר כל אזור שמור, כל אזור שהורד (ניתוב, מקומות, מפה), את שכבות הבניינים והכתובות ואת מטמון העיון, ומכווץ את מסד הנתונים של המפה. הקולות נשמרים. השתמש בזה אם נתוני האחסון למעלה לא תואמים את מה שאתה רואה ברשימות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolít minden mentett területet, minden letöltött régiót (útvonaltervezés, helyek, térkép), az épület- és címrétegeket és a böngészési gyorsítótárat, majd összezsugorítja a térkép-adatbázist. A hangok megmaradnak. Akkor használd, ha a fenti tárhelyadatok nem egyeznek azzal, amit a listákban látsz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove ogni area salvata, ogni regione scaricata (percorsi, luoghi, mappa), i livelli di edifici e indirizzi e la cache dell'esplorazione, e riduce il database della mappa. Le voci restano. Usalo se lo spazio indicato sopra non corrisponde a ciò che vedi negli elenchi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みのエリア、ダウンロードした地域（経路、場所、地図）、建物と住所のオーバーレイ、閲覧キャッシュをすべて削除し、地図データベースを縮小します。音声は残ります。上のストレージの数値が一覧の内容と合わないときに使ってください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert elk opgeslagen gebied, elke gedownloade regio (routering, plaatsen, kaart), de gebouw- en adreslagen en de browsecache, en verkleint de kaartdatabase. Stemmen blijven bewaard. Gebruik dit als de opslagcijfers hierboven niet kloppen met wat je in de lijsten ziet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa każdy zapisany obszar, każdy pobrany region (trasy, miejsca, mapa), nakładki budynków i adresów oraz pamięć podręczną przeglądania a także zmniejsza bazę danych mapy. Głosy zostają. Użyj tego jeśli liczby zajętej pamięci powyżej nie zgadzają się z tym co widać na listach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove todas as áreas salvas, todas as regiões baixadas (rotas, locais, mapa), as camadas de edifícios e endereços e o cache de navegação, e reduz o banco de dados do mapa. As vozes são mantidas. Use isto se os valores de armazenamento acima não corresponderem ao que você vê nas listas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove todas as áreas guardadas, todas as regiões transferidas (percursos, locais, mapa), as camadas de edifícios e moradas e a cache de navegação, e reduz a base de dados do mapa. As vozes são mantidas. Use isto se os valores de armazenamento acima não corresponderem ao que vê nas listas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimină fiecare zonă salvată, fiecare regiune descărcată (rute, locuri, hartă), suprapunerile de clădiri, adrese, memoria cache de navigare și micșorează baza de date a hărților. Vocile sunt păstrate. Folosește această opțiune dacă volumele de stocare de mai sus nu corespund cu ceea ce vezi în liste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет все сохранённые области, все загруженные регионы (маршруты, места, карту), слои зданий и адресов и кэш просмотра, а также сжимает базу данных карты. Голоса остаются. Воспользуйтесь этим, если объёмы в хранилище выше не сходятся с тем, что видно в списках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar bort alla sparade områden, alla hämtade regioner (ruttning, platser, karta), byggnads- och adresslagren och webbcachen, och krymper kartdatabasen. Röster behålls. Använd detta om lagringssiffrorna ovan inte stämmer med det du ser i listorna."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє всі збережені області, усі завантажені регіони (маршрутизацію, місця, карту), шари будівель і адрес та кеш перегляду, а також стискає базу даних карти. Голоси залишаються. Скористайтеся цим, якщо обсяги в сховищі вище не збігаються з тим, що видно у списках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除所有已保存的区域、所有已下载的区域（路线、地点、地图）、建筑和地址叠加层以及浏览缓存，并压缩地图数据库。语音会保留。如果上方的存储数据与列表中看到的内容对不上，可使用此项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除所有已儲存的區域、所有已下載的區域（路線規劃、地點、地圖）、建築物與地址疊加層以及瀏覽快取，並縮減地圖資料庫。語音會保留。如果上方的儲存空間數字和清單中看到的對不起來，可以使用這個選項。"
          }
        }
      }
    },
