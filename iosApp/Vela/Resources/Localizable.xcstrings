    "settings_vela_bright_positron_fiord_and_black" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela، وBright، وPositron، وFiord، وBlack هي المستندات الستة ذات النمط المحلي. يؤدي المظهر واختيار اللون الفاتح/الغامق إلى إعادة تحميل الخريطة دون طلب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord und Black sind die sechs Dokumente im lokalen Stil. Ein Blick und eine Hell/Dunkel-Auswahl laden die Karte ohne Aufforderung neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord and Black are the six local style documents. A look and a light/dark choice reload the map without a request."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord and Black are the six local style documents. A look and a light/dark choice reload the map without a request."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord y Black son los seis documentos de estilo locales. Una mirada y una opción de claro/oscuro recargan el mapa sin una solicitud."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord ja Black on kuus kohalikku laadi dokumenti. Pilk ja hele/tume valik laadige kaart uuesti ilma nõudmiseta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord et Black sont les six documents de style local. Un regard et un choix clair/obscur rechargent la carte sans demande."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord ו-Black הם ששת המסמכים בסגנון המקומי. מבט ובחירה באור/חושך טען מחדש את המפה ללא בקשה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord és Black a hat helyi stílusú dokumentum. Egy pillantás és egy világos/sötét választás kérés nélkül töltse újra a térképet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord e Black sono i sei documenti di stile locale. Uno sguardo e una scelta chiaro/scuro ricaricano la mappa senza alcuna richiesta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela、Bright、Positron、Fiord、Black の 6 つのローカル スタイル ドキュメントです。見た目と明暗の選択により、リクエストなしでマップがリロードされます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord en Black zijn de zes lokale stijldocumenten. Een blik en een licht/donker-keuze, herlaad de kaart zonder een verzoek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord i Black to sześć dokumentów w stylu lokalnym. Spojrzenie i wybór jasnego/ciemnego ponownego załadowania mapy bez żądania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord e Black são os seis documentos de estilo local. Uma olhada e uma escolha claro/escuro recarregam o mapa sem solicitação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord e Black são os seis documentos de estilo local. Uma olhada e uma escolha claro/escuro recarregam o mapa sem solicitação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord și Black sunt cele șase documente de stil local. O privire și o alegere deschisă/întunecată reîncarcă harta fără o solicitare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord и Black - шесть документов местного стиля. Взгляд и выбор светлого/темного перезагружает карту без запроса."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord in Black je šest lokalnih slogovnih dokumentov. Pogled in izbira svetlo/temno znova naložita zemljevid brez zahteve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord och Black är de sex lokala dokumenten. En blick och ett ljus/mörkt val laddar om kartan utan förfrågan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord ve Black yerel stildeki altı belgedir. Bir görünüm ve açık/koyu seçimi, haritayı istek olmadan yeniden yükler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, Bright, Positron, Fiord і Black - це шість документів місцевого стилю. Вигляд і вибір світло/темно перезавантажують карту без запиту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela、Bright、Positron、Fiord 和 Black 是六个本地风格文档。外观和明/暗选择无需请求即可重新加载地图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela、Bright、Positron、Fiord 和 Black 是六個本地風格文件。外觀和明/暗選擇無需請求即可重新載入地圖。"
          }
        }
      }
