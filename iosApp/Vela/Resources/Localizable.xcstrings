    "transit_times_are_scheduled_unless_the_feed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم جدولة الأوقات ما لم يتم وضع علامة على البث المباشر. لا يقوم Vela بتقدير المفقودين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeiten sind geplant, es sei denn, der Feed markierte den Lauf als Live. Vela schätzt die fehlenden Daten nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Times are scheduled unless the feed marked the run Live. Vela does not estimate the missing ones."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Times are scheduled unless the feed marked the run Live. Vela does not estimate the missing ones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los horarios están programados a menos que la transmisión marque la ejecución en vivo. Vela no estima los que faltan."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajad on ajastatud, välja arvatud juhul, kui voog on märgitud otseülekandeks. Puuduvaid Vela ei hinda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les horaires sont théoriques sauf si le flux a marqué le trajet comme en direct. Vela n'estime pas les horaires manquants."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זמנים מתוכננים אלא אם כן העדכון סימן את ההפעלה Live. Vela אינו מעריך את החסרים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az idők ütemezve vannak, kivéve, ha a hírcsatorna az Élő futást jelölte meg. A Vela nem becsüli meg a hiányzókat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli orari sono programmati a meno che il feed non abbia contrassegnato la corsa in diretta. Vela non stima quelli mancanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードで実行がライブとしてマークされていない限り、時間はスケジュールされます。 Vela は欠損値を推定しません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijden worden gepland, tenzij de feed de run Live markeert. Vela schat de ontbrekende niet in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godziny są zaplanowane, chyba że w kanale oznaczono bieg na żywo. Vela nie szacuje brakujących."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os horários são agendados, a menos que o feed marque a execução ao vivo. O Vela não estima os que faltam."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os horários são agendados, a menos que o feed marque a execução ao vivo. O Vela não estima os que faltam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orele sunt programate, cu excepția cazului în care feedul a marcat rularea Live. Vela nu le estimează pe cele lipsă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время запланировано, если в ленте не отмечен запуск в прямом эфире. Vela не оценивает недостающие."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časi so načrtovani, razen če je v viru označen tek v živo. Vela ne ocenjuje manjkajočih."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tider är schemalagda såvida inte flödet markerade körningen Live. Vela uppskattar inte de saknade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akış, çalıştırmayı Canlı olarak işaretlemediği sürece zamanlar planlanır. Vela eksik olanları tahmin etmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часи заплановано, якщо у стрічці не позначено запуск у прямому ефірі. Vela не оцінює відсутні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非源标记为实时运行，否则时间已安排好。 Vela 不会估计缺失的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非來源標記為即時運行，否則時間已安排好。 Vela 不會估計缺失的。"
          }
        }
      }
    },
