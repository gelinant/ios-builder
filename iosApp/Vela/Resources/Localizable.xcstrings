    "transit_turn_by_turn_from_the_walk" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطوة بخطوة من مسار المشي. أسماء الشوارع غير متوفرة لهذه المحطة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schritt für Schritt vom Gehweg aus. Für diese Etappe sind keine Straßennamen verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn-by-turn from the walk path. Street names are unavailable for this leg."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn-by-turn from the walk path. Street names are unavailable for this leg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paso a paso desde el sendero. Los nombres de las calles no están disponibles para este tramo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pööre-pöördelt jalutusteelt. Selle jala jaoks pole tänavanimed saadaval."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tour par tour depuis le sentier pédestre. Les noms de rues ne sont pas disponibles pour cette étape."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סיבוב אחר סיבוב משביל ההליכה. שמות רחובות אינם זמינים עבור רגל זו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sétaútról kanyarról-fordulóra. Ehhez a szakaszhoz nem állnak rendelkezésre utcanevek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn-by-turn dal percorso a piedi. I nomi delle strade non sono disponibili per questa tratta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊歩道からターンバイターンで進みます。この区間では通りの名前は利用できません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn-by-turn vanaf het wandelpad. Straatnamen zijn niet beschikbaar voor deze etappe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakręt po zakręcie od ścieżki spacerowej. Nazwy ulic są niedostępne dla tego odcinka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passo a passo a partir do caminho de caminhada. Os nomes das ruas não estão disponíveis para este trecho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passo a passo a partir do caminho de caminhada. Os nomes das ruas não estão disponíveis para este trecho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas cu pas de pe poteca. Numele străzilor nu sunt disponibile pentru acest segment."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По очереди от пешеходной дорожки. Названия улиц для этого участка недоступны."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
