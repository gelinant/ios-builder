    "saved_a_drive_past_one_of_this" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تشغيله بالسيارة عبر أحد الأماكن في هذه القائمة. إنه يعمل عندما يكون Vela مفتوحًا أو موجهًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Fahrt an einem der Orte dieser Liste vorbei spielt es ab. Es funktioniert, während Vela geöffnet ist oder führt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A drive past one of this list's places plays it. It works while Vela is open or guiding."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A drive past one of this list's places plays it. It works while Vela is open or guiding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un paseo por uno de los lugares de esta lista lo reproduce. Funciona mientras Vela está abierto o guiando."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle loendi ühest kohast möödasõit mängib seda. See töötab, kui Vela on avatud või juhib."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un passage devant l’un des lieux de cette liste le joue. Cela fonctionne lorsque Vela est ouvert ou guidé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נסיעה על פני אחד ממקומות הרשימה הזו משמיעה אותו. זה עובד בזמן ש-Vela פתוח או מנחה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lista egyik helye melletti autózás lejátssza. Működik, amíg a Vela nyitva van vagy irányít."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene riprodotto un passaggio davanti a uno dei luoghi di questo elenco. Funziona mentre Vela è aperto o guida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリストの場所の 1 つを車で通り過ぎると、この曲が再生されます。 Velaが開いているとき、またはガイドしているときに動作します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u langs een van de plaatsen op deze lijst rijdt, wordt deze afgespeeld. Het werkt terwijl Vela open of geleidend is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarza go przejazd obok jednego z miejsc z tej listy. Działa, gdy Vela jest otwarty lub prowadzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passar por um dos lugares desta lista é reproduzido. Funciona enquanto o Vela está aberto ou guiando."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passar por um dos lugares desta lista é reproduzido. Funciona enquanto o Vela está aberto ou guiando."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conduce pe lângă unul dintre locurile acestei liste. Funcționează în timp ce Vela este deschis sau ghidează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проезжая мимо одного из мест из этого списка, он воспроизводится. Он работает, пока Vela открыт или направляет."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predvaja se vožnja mimo enega od krajev s tega seznama. Deluje, ko je Vela odprt ali voden."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kör förbi en av listans platser spelar den upp. Det fungerar medan Vela är öppen eller vägledande."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
