    "settings_diag_consent_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela führt ein kurzes lokales Protokoll Ihrer Suchanfragen, Routen und etwaiger Fehler. Es verlässt das Telefon nie, es sei denn, Sie tippen auf „Exportieren“ und wählen ein Ziel. Zum Löschen des Protokolls jederzeit deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela will keep a short local log of your searches, routes and any errors. It never leaves the phone unless you tap Export and choose where to send it. Turn it off any time to wipe the log."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela guardará un breve registro local de tus búsquedas, rutas y cualquier error. Nunca sale del teléfono salvo que toques Exportar y elijas a dónde enviarlo. Desactívalo cuando quieras para borrar el registro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela conservera un court journal local de vos recherches, itinéraires et erreurs éventuelles. Il ne quitte jamais le téléphone tant que vous n'appuyez pas sur Exporter et ne choisissez pas une destination. Désactivez-le à tout moment pour effacer le journal."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela תשמור יומן מקומי קצר של החיפושים, המסלולים וכל שגיאה. הוא לעולם לא עוזב את הטלפון אלא אם תקיש \"ייצא\" ותבחר לאן לשלוח. כבה בכל עת כדי למחוק את היומן."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vela egy rövid helyi naplót vezet a kereséseidről, útvonalaidról és a hibákról. Soha nem hagyja el a telefont, hacsak nem koppintasz az Exportálásra és választasz egy célt. Bármikor kikapcsolhatod a napló törléséhez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela conserverà un breve registro locale delle tue ricerche, dei percorsi e di eventuali errori. Non lascia mai il telefono finché non tocchi Esporta e scegli dove inviarlo. Disattivala in qualsiasi momento per cancellare il registro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela は検索、経路、エラーの短いログを端末内に保存します。「エクスポート」をタップして送信先を選ばない限り、端末の外に出ることはありません。いつでもオフにでき、オフにするとログは消去されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela houdt een kort lokaal logboek bij van uw zoekopdrachten, routes en eventuele fouten. Het verlaat de telefoon nooit tenzij u op Exporteren tikt en kiest waar het naartoe gaat. Schakel het op elk moment uit om het logboek te wissen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela będzie prowadzić krótki lokalny dziennik Twoich wyszukiwań, tras i wszelkich błędów. Nigdy nie opuszcza telefonu chyba że dotkniesz Eksportuj i wybierzesz miejsce docelowe. Wyłącz w dowolnej chwili aby wyczyścić dziennik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela vai manter um breve registro local das suas pesquisas, trajetos e quaisquer erros. Nunca sai do celular, a menos que você toque em Exportar e escolha para onde enviar. Desative quando quiser para apagar o registro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela vai manter um breve registo local das suas pesquisas, percursos e quaisquer erros. Nunca sai do telemóvel a menos que toque em Exportar e escolha para onde o enviar. Desligue quando quiser para apagar o registo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela va păstra un jurnal local succint al căutărilor, traseelor și eventualelor erori. Acesta nu părăsește niciodată telefonul, cu excepția cazului în care apeși pe „Export” și alegi unde să-l trimiți. Poți dezactiva această funcție oricând pentru a șterge jurnalul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela будет вести короткий локальный журнал ваших поисков, маршрутов и любых ошибок. Он никогда не покидает телефон, пока вы не нажмёте «Экспорт» и не выберете, куда его отправить. Выключите в любой момент, чтобы стереть журнал."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela håller en kort lokal logg över dina sökningar, rutter och eventuella fel. Den lämnar aldrig telefonen om du inte trycker på Exportera och väljer var den ska skickas. Slå av den när som helst för att radera loggen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela вестиме короткий локальний журнал ваших пошуків, маршрутів і будь-яких помилок. Він ніколи не залишає телефон, доки ви не натиснете «Експорт» і не оберете, куди його надіслати. Вимкніть будь-коли, щоб стерти журнал."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 将在本地保留一份关于您的搜索、路线和错误的简短日志。除非您点按“导出”并选择发送位置，否则它绝不离开手机。可随时关闭以清除日志。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 會在本機保留簡短記錄，內容包含你的搜尋、路線和任何錯誤。除非你點按「匯出」並選擇傳送對象，否則資料絕不會離開手機。隨時可以關閉以清除記錄。"
          }
        }
      }
    },
