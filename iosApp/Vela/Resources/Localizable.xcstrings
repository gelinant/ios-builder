    "settings_trip_share_also" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ziel, der Fahrtname, die Sprachansagen an beiden Enden und der Anfang der Routenlinie gehen ebenfalls. Die Zeiten werden verschoben, damit die Datei nicht verrät, wann Sie gefahren sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The destination, trip name, spoken directions at either end and the start of the route line go too. Times are rebased so the file does not say when you drove."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se quitan el destino, el nombre del trayecto, las indicaciones habladas de ambos extremos y el comienzo de la línea de la ruta. Las horas se reajustan para que el archivo no revele cuándo condujiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La destination, le nom du trajet, les instructions vocales aux deux extrémités et le début du tracé partent aussi. Les horodatages sont décalés pour que le fichier n'indique pas quand vous avez roulé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גם היעד, שם הנסיעה, ההוראות המדוברות בשני הקצוות ותחילת קו המסלול נמחקים. הזמנים מאופסים מחדש כך שהקובץ לא מסגיר מתי נסעת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A célpont, az út neve, a két végén elhangzott útvonalvezetés és az útvonalvonal eleje szintén törlődik. Az időpontok újraszámolódnak, így a fájl nem árulja el, mikor vezettél."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono rimossi anche la destinazione, il nome del viaggio, le indicazioni vocali alle due estremità e l'inizio della linea del percorso. Gli orari vengono ricalcolati così il file non rivela quando hai guidato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目的地、移動の名前、両端の音声案内、ルート線の始まりも削除されます。時刻は基準を振り直すため、いつ走行したかはファイルに残りません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bestemming, de ritnaam, de gesproken aanwijzingen aan beide uiteinden en het begin van de routelijn gaan er ook af. Tijden worden verschoven zodat het bestand niet verklapt wanneer je reed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cel, nazwa podróży, wskazówki głosowe na obu końcach i początek linii trasy również znikają. Czasy są przeliczane od nowa, więc plik nie zdradza, kiedy jechałeś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O destino, o nome da viagem, as instruções faladas nas duas pontas e o início da linha da rota também desaparecem. Os tempos são reajustados para que o arquivo não diga quando você dirigiu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O destino, o nome da viagem, as indicações faladas nas duas pontas e o início da linha da rota também desaparecem. Os tempos são reajustados para o ficheiro não dizer quando conduziu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destinația, denumirea călătoriei, indicațiile vocale de la început și de la sfârșit, precum și punctul de plecare al traseului sunt, de asemenea, șterse. Timpul este recalculat, astfel încât să nu se poată afla din fișier când ai călătorit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пункт назначения, название поездки, голосовые подсказки в начале и в конце и начало линии маршрута тоже удаляются. Время пересчитывается, чтобы из файла нельзя было узнать, когда вы ехали."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Målet, resans namn, talade vägbeskrivningar i båda ändar och början av ruttlinjen följer också med bort. Tiderna räknas om så att filen inte avslöjar när du körde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пункт призначення, назва поїздки, голосові вказівки на обох кінцях і початок лінії маршруту теж зникнуть. Час зміщується, щоб файл не показував, коли ви їхали."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目的地、行程名称、两端的语音播报以及路线起始段也会一并删除。时间会重新基准化，因此文件不会透露您的出行时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目的地、行程名稱、頭尾的語音指引和路線起始線段也會一併移除。時間會重新校準，檔案不會透露你何時開的車。"
          }
        }
      }
    },
    "settings_trip_share_explain" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine aufgezeichnete Fahrt beginnt und endet dort, wo Sie es tun. Beim Kürzen werden alle Punkte nahe dem Start, dem Ende, dem Ziel sowie Zuhause und Arbeit gelöscht, die Mitte bleibt in voller Genauigkeit erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A recorded drive starts and ends where you do. Trimming deletes every fix near the start, the end, the destination and your Home and Work, keeping the middle at full precision."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un trayecto grabado empieza y termina donde tú. Al recortarlo se eliminan todos los puntos cercanos al inicio, al final, al destino y a tu Casa y tu Trabajo, y se conserva la parte central con toda su precisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un trajet enregistré commence et se termine là où vous êtes. Le rognage supprime tous les points près du départ, de l'arrivée, de la destination et de vos adresses Domicile et Travail, en gardant le milieu en pleine précision."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נסיעה מוקלטת מתחילה ומסתיימת היכן שאתה. גזימה מוחקת כל נקודה קרובה להתחלה, לסוף, ליעד ולבית ולעבודה שלך, ומשאירה את האמצע בדיוק מלא."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy rögzített út ott kezdődik és ott ér véget, ahol te. A levágás törli az összes pontot a kezdet, a vég, a célpont, valamint az Otthonod és a Munkahelyed közelében, a közepét pedig teljes pontossággal hagyja meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un viaggio registrato inizia e finisce dove sei tu. Il taglio elimina ogni punto vicino alla partenza, all'arrivo, alla destinazione e a Casa e Lavoro, mantenendo la parte centrale a piena precisione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録した走行は、自分が出発した場所から始まり、到着した場所で終わります。トリミングすると、出発地・到着地・目的地・自宅・職場の近くの測位点をすべて削除し、途中は元の精度のまま残します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een opgenomen rit begint en eindigt waar jij bent. Inkorten verwijdert elke meting bij het begin, het einde, de bestemming en je Thuis en Werk, en houdt het middenstuk op volle nauwkeurigheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisany przejazd zaczyna się i kończy tam, gdzie ty. Przycięcie usuwa wszystkie punkty w pobliżu startu, końca, celu oraz twojego Domu i Pracy, zachowując środek w pełnej dokładności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um trajeto gravado começa e termina onde você está. Cortar exclui todos os pontos perto do início, do fim, do destino e da sua Casa e Trabalho, mantendo o meio com toda a precisão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um trajeto gravado começa e acaba onde você está. Cortar elimina todos os pontos perto do início, do fim, do destino e da sua Casa e Trabalho, mantendo o meio com toda a precisão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un traseu înregistrat începe și se termină acolo unde începi și termini tu. Funcția de tăiere șterge toate punctele de localizare din apropierea începutului, sfârșitului, destinației, precum și a locurilor „Acasă” și „Serviciu”, păstrând precizia maximă pentru porțiunea din mijloc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записанная поездка начинается и заканчивается там же, где вы. Обрезка удаляет все точки рядом с началом, концом, пунктом назначения, а также с домом и работой, оставляя середину с полной точностью."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En inspelad körning börjar och slutar där du gör det. Beskärning tar bort varje punkt nära starten, slutet, målet och ditt Hem och Arbete, och behåller mitten med full precision."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записана поїздка починається й закінчується там, де ви. Обрізання видаляє всі точки біля початку, кінця, пункту призначення, а також вашої домівки та роботи, зберігаючи середину з повною точністю."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录的行程从您出发的地方开始，在您到达的地方结束。裁剪会删除起点、终点、目的地以及家和公司附近的所有定位点，中间部分保持完整精度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記錄下來的行程會從你的出發地開始、在目的地結束。修剪會刪除起點、終點、目的地以及住家和公司附近的所有定位點，中段則保留完整精度。"
          }
        }
      }
    },
