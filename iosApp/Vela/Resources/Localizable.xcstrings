    "settings_speeding_alert_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt „Sie fahren zu schnell“, sobald Sie ein paar Sekunden über dem ausgeschilderten Tempolimit waren, und erneut, wenn Sie langsamer werden und wieder darüber geraten. Nur dort, wo ein Tempolimit bekannt ist, dasselbe, das die Tempoanzeige zeigt. Aus, bis Sie es einschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Says \"You're over the speed limit\" once you have been over the posted limit for a few seconds, and again after you slow down and creep back over it. Only where a posted limit is known, the one the speed badge shows. Off unless you turn it on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dice «Vas por encima del límite de velocidad» cuando llevas unos segundos por encima del límite señalizado, y de nuevo si reduces y vuelves a superarlo. Solo donde se conoce el límite señalizado, el que muestra la insignia de velocidad. Desactivado salvo que lo actives."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annonce \"Vous dépassez la limitation de vitesse\" après quelques secondes au-dessus de la limite affichée, puis de nouveau si vous ralentissez et repassez au-dessus. Uniquement là où une limite est connue, celle qu'indique le badge de vitesse. Désactivé tant que vous ne l'activez pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הכרזת „מעל למהירות המותרת” אחרי כמה שניות של נסיעה מעל למהירות המותרת, ושוב לאחר חריגות חוזרות. ההכרזה תפעל רק היכן שידוע מה המהירות המותרת, זו שמוצגת בתג המהירות. ההכרזה כבויה כברירת מחדל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bemondja, hogy „Túlléped a sebességhatárt”, ha néhány másodperce a kitáblázott határ fölött haladsz, és újra, miután lelassítasz, majd ismét fölé kúszol. Csak ott, ahol ismert a kitáblázott sebességhatár, amit a sebességjelvény mutat. Alapból ki van kapcsolva, amíg be nem kapcsolod."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dice \"Stai superando il limite di velocità\" quando hai superato per qualche secondo il limite indicato, e di nuovo se rallenti e poi lo risuperi. Solo dove il limite indicato è noto, quello mostrato dal riquadro della velocità. Disattivo finché non lo attivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制限速度を数秒超えた状態が続くと「制限速度を超えています」と読み上げ、減速したあとにまた超えたときにも再度お知らせします。速度バッジに表示される制限速度が分かっている場所でのみ動作します。オンにしない限り無効です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zegt \"Je rijdt te hard\" zodra je een paar seconden boven de aangegeven limiet zit, en opnieuw nadat je bent afgeremd en er weer overheen kruipt. Alleen waar een aangegeven limiet bekend is, dezelfde die het snelheidsbord toont. Staat uit tenzij je het aanzet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mówi „Przekraczasz dozwoloną prędkość”, gdy od kilku sekund jedziesz powyżej oznakowanego limitu, i ponownie, gdy zwolnisz i znów go przekroczysz. Tylko tam, gdzie znany jest oznakowany limit, ten sam, który pokazuje plakietka prędkości. Wyłączone, dopóki tego nie włączysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diz “Você está acima do limite de velocidade” quando passa alguns segundos acima do limite indicado, e outra vez depois de reduzir e voltar a ultrapassá-lo. Só onde o limite indicado é conhecido, o mesmo que o emblema de velocidade mostra. Desativado até você ativar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diz “Está acima do limite de velocidade” quando passa alguns segundos acima do limite indicado, e outra vez depois de abrandar e voltar a ultrapassá-lo. Só onde o limite indicado é conhecido, o mesmo que o emblema de velocidade mostra. Desligado até o ligar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spune „Ai depășit viteza” dacă conduci cu o viteză mai mare decât cea permisă timp de câteva secunde și repetă mesajul atunci când ai redus viteza și ai depășit-o din nou. Funcționează doar acolo unde se cunoaște limita de viteză, adică cea afișată de pictograma de viteză. În mod implicit, această funcție este dezactivată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Произносит «Вы превышаете скорость», если вы несколько секунд едете быстрее разрешённого, и повторяет, когда вы сбросили скорость и снова её превысили. Только там, где известно ограничение, то самое, что показывает значок скорости. По умолчанию выключено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säger \"Du kör för fort\" när du legat över skyltad hastighet några sekunder, och igen efter att du saktat ner och krupit över den på nytt. Bara där en skyltad gräns är känd, den som hastighetsmärket visar. Av tills du slår på det."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Промовляє «Ви перевищуєте швидкість», коли ви кілька секунд їдете понад дозволену швидкість, і ще раз, якщо після сповільнення знову її перевищите. Лише там, де відома дозволена швидкість, та сама, що показує значок швидкості. Вимкнено, доки ви не ввімкнете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您超过限速持续几秒后播报“您已超速”，减速后再次超速时会再播报一次。仅在已知限速（速度标记所显示的限速）的路段生效。默认关闭，需手动开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你超過速限數秒後，會唸出「你已超過速限」；減速後又再次超速時會再提醒一次。僅在已知速限（速限標誌顯示的那個）的路段有效。預設關閉，需自行開啟。"
          }
        }
      }
    },
