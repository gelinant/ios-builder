    "settings_privacy_delete_saved" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved places, lists, Home and Work, settings and downloaded regions are deleted from their own screens, never from here."
