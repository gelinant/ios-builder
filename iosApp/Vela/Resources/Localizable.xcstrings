    "settings_trims_speculative_map_work_as_the" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقليم عمل الخريطة التخمينية، كما تفعل علامة LowRamMode على نظام Android. معطل افتراضيًا على نظام iOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschneidet spekulative Kartenarbeit, wie es das LowRamMode-Flag auf Android tut. Unter iOS standardmäßig deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trims speculative map work, as the LowRamMode flag does on Android. Off by default on iOS."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trims speculative map work, as the LowRamMode flag does on Android. Off by default on iOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorta el trabajo de mapas especulativos, como lo hace la bandera LowRamMode en Android. Desactivado de forma predeterminada en iOS."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kärbib spekulatiivset kaarditööd, nagu LowRamMode'i lipp Androidis. IOS-is vaikimisi väljas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime le travail de carte spéculative, comme le fait l'indicateur LowRamMode sur Android. Désactivé par défaut sur iOS."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מקצץ את עבודת המפה הספקולטיבית, כפי שעושה דגל LowRamMode באנדרואיד. כבוי כברירת מחדל ב-iOS."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levágja a spekulatív térképmunkát, ahogy a LowRamMode zászló teszi Androidon. Alapértelmezés szerint ki van kapcsolva iOS rendszeren."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina il lavoro speculativo sulla mappa, come fa il flag LowRamMode su Android. Disattivato per impostazione predefinita su iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android の LowRamMode フラグと同様に、投機的なマップの動作をトリミングします。 iOS ではデフォルトでオフになっています。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trimt speculatief kaartwerk, zoals de LowRamMode-vlag op Android doet. Standaard uitgeschakeld op iOS."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogranicza działanie map spekulacyjnych, tak jak robi to flaga LowRamMode na Androidzie. Domyślnie wyłączone w systemie iOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta o trabalho especulativo do mapa, como o sinalizador LowRamMode faz no Android. Desativado por padrão no iOS."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta o trabalho especulativo do mapa, como o sinalizador LowRamMode faz no Android. Desativado por padrão no iOS."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decupează lucrările speculative ale hărților, așa cum face steagul LowRamMode pe Android. Dezactivat în mod implicit pe iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обрезает работу спекулятивной карты, как это делает флаг LowRamMode на Android. По умолчанию на iOS отключено."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogoča špekulativno delo z zemljevidi, kot to počne zastavica LowRamMode v sistemu Android. Privzeto izklopljeno v sistemu iOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trimmar spekulativt kartarbete, som LowRamMode-flaggan gör på Android. Av som standard på iOS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LowRamMode bayrağının Android'de yaptığı gibi spekülatif harita çalışmasını düzeltir. iOS'ta varsayılan olarak kapalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Урізає спекулятивну роботу з картою, як це робить прапорець LowRamMode на Android. Вимкнено за умовчанням на iOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修剪推测地图工作，就像 Android 上的 LowRamMode 标志一样。 iOS 上默认关闭。"
