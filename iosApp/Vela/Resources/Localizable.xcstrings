    "settings_buildings_3d_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhöhte Gebäude bei starkem Zoom, wenn die Karte geneigt ist. Ausschalten kann das Schwenken auf älteren Geräten flüssiger machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raised buildings at close zoom when the map is tilted. Turning this off can make panning smoother on older phones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edificios en relieve al acercar con el mapa inclinado. Desactivarlo puede suavizar el desplazamiento en móviles antiguos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bâtiments en relief au zoom rapproché quand la carte est inclinée. Le désactiver peut fluidifier le défilement sur les vieux téléphones."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בניינים מוגבהים בהתקרבות כשהמפה מוטה. כיבוי יכול להחליק את הגלילה בטלפונים ישנים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiemelt épületek közeli nagyításnál, ha a térkép meg van döntve. Kikapcsolása simábbá teheti a mozgatást régebbi telefonokon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edifici in rilievo a zoom ravvicinato quando la mappa è inclinata. Disattivarlo può rendere più fluido lo scorrimento sui telefoni datati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図を傾けてズームインすると、建物を立体表示します。オフにすると、古い端末では地図の動きが滑らかになることがあります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhoogde gebouwen bij dichtbij zoomen als de kaart gekanteld is. Uitzetten kan het pannen soepeler maken op oudere telefoons."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wypukłe budynki przy dużym zbliżeniu, gdy mapa jest pochylona. Wyłączenie może wygładzić przesuwanie na starszych telefonach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edifícios em relevo com zoom próximo quando o mapa está inclinado. Desativar pode deixar o arrastar mais suave em celulares antigos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edifícios em relevo com zoom próximo quando o mapa está inclinado. Desligar pode tornar o arrastar mais suave em telemóveis antigos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clădiri volumetrice la zoom apropiat când harta este înclinată. Dezactivarea acestei opțiuni poate face panoramarea mai lină pe telefoanele mai vechi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объёмные здания при сильном приближении, когда карта наклонена. Отключение может сделать прокрутку плавнее на старых телефонах."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri večji povečavi in nagnjenem zemljevidu prikaže stavbe v 3D. Izklop lahko izboljša tekočnost pomikanja na starejših telefonih."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upphöjda byggnader vid nära zoom när kartan är lutad. Att stänga av kan göra panorering mjukare på äldre telefoner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Об'ємні будівлі при сильному наближенні, коли карту нахилено. Вимкнення може зробити прокручування плавнішим на старих телефонах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地图倾斜并近距离缩放时显示立体建筑。关闭后，旧手机上平移地图会更流畅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地圖傾斜並拉近時顯示立體建築物。關閉後，舊手機平移地圖時會更順暢。"
          }
        }
      }
    },
