    "loc_approx_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela kennt nur deine ungefähre Umgebung, nicht deinen genauen Standort. Die Karte zeigt einen großen Kreis statt eines Punkts, und die Navigation funktioniert nicht. Du kannst jederzeit auf den genauen Standort wechseln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela only knows your rough area, not where you are. The map shows a wide circle instead of a dot, and turn-by-turn navigation won't work. You can switch to precise location whenever you want."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela solo conoce tu zona aproximada, no dónde estás. El mapa muestra un círculo amplio en vez de un punto, y la navegación no funcionará. Puedes cambiar a la ubicación precisa cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela ne connaît que votre zone approximative, pas votre position exacte. La carte affiche un large cercle au lieu d'un point, et la navigation ne fonctionnera pas. Vous pouvez passer à la position précise quand vous voulez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela יודע רק את אזורך המשוער, לא את מיקומך המדויק. המפה מציגה עיגול רחב במקום נקודה, וניווט מונחה לא יעבוד. אפשר לעבור למיקום מדויק בכל עת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vela csak a hozzávetőleges körzetedet ismeri, nem a pontos helyzetedet. A térkép egy tág kört mutat pont helyett, és a hangos útvonalvezetés nem fog működni. Bármikor átválthatsz pontos helyzetre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela conosce solo la tua zona approssimativa, non dove sei. La mappa mostra un cerchio ampio invece di un punto, e la navigazione non funzionerà. Puoi passare alla posizione precisa quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela が分かるのはおおよそのエリアだけで、正確な現在地は分かりません。地図には点の代わりに大きな円が表示され、ターンバイターンのナビは動作しません。正確な位置情報にはいつでも切り替えられます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela kent alleen je globale omgeving, niet waar je bent. De kaart toont een grote cirkel in plaats van een punt, en navigatie werkt niet. Je kunt altijd overstappen op de precieze locatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela zna tylko twoją przybliżoną okolicę, nie to, gdzie jesteś. Mapa pokazuje szerokie koło zamiast punktu, a nawigacja nie zadziała. Na dokładną lokalizację możesz przejść w każdej chwili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela só conhece a sua área aproximada, não onde você está. O mapa mostra um círculo largo em vez de um ponto, e a navegação não vai funcionar. Você pode mudar para a localização precisa quando quiser."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela só conhece a sua área aproximada, não onde você está. O mapa mostra um círculo largo em vez de um ponto, e a navegação não vai funcionar. Você pode mudar para a localização precisa quando quiser."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela cunoaște doar zona în care te afli aproximativ, nu și locația exactă. Harta afișează un cerc larg în loc de un punct, iar navigația pas cu pas nu va funcționa. Poți trece la localizarea precisă oricând dorești."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela знает только ваш примерный район, а не где вы находитесь. Карта показывает широкий круг вместо точки, и навигация работать не будет. Перейти на точное местоположение можно в любой момент."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela känner bara till ditt ungefärliga område, inte var du är. Kartan visar en stor cirkel i stället för en punkt, och navigeringen fungerar inte. Du kan byta till exakt plats när du vill."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela знає лише ваш приблизний район, а не де ви є. Карта показує широке коло замість точки, і навігація не працюватиме. Перейти на точне місцезнаходження можна будь-коли."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 只知道您的大致范围，而不是您的确切位置。地图会显示一个大圆圈而不是圆点，逐向导航也无法使用。您可以随时改用精确位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 只知道你的概略區域，不知道你的確切位置。地圖會顯示一個大圓圈而不是定位點，導航也無法使用。你隨時可以改用精確位置。"
          }
        }
      }
    },
