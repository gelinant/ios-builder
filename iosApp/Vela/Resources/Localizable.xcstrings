    "transit_times_come_from_the_selected_itinerary" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأوقات تأتي من خط سير الرحلة المحدد. يمكن أن تعرض ورقة سطر الخريطة الخط بأكمله عندما يوفره مضيف الخريطة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeiten ergeben sich aus der ausgewählten Reiseroute. Das Linienblatt der Karte kann die gesamte Linie anzeigen, wenn ein Kartenhost dies bereitstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Times come from the selected itinerary. The map's line sheet can show the whole line when a map host provides it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Times come from the selected itinerary. The map's line sheet can show the whole line when a map host provides it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los horarios provienen del itinerario seleccionado. La hoja de líneas del mapa puede mostrar la línea completa cuando un servidor de mapas la proporciona."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajad pärinevad valitud teekonnast. Kui kaardi host pakub seda, võib kaardi jooneleht näidata kogu joont."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les horaires proviennent de l'itinéraire sélectionné. La feuille de lignes de la carte peut afficher la ligne entière lorsqu'un hôte de carte la fournit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזמנים מגיעים ממסלול הטיול שנבחר. גיליון השורות של המפה יכול להציג את כל הקו כאשר מארח מפה מספק אותו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az időpontok a kiválasztott útvonalból származnak. A térkép vonallapja megjelenítheti a teljes vonalat, ha egy térképgazda biztosítja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli orari provengono dall'itinerario selezionato. Il foglio di linea della mappa può mostrare l'intera linea quando un host della mappa lo fornisce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間は選択した旅程に基づいて計算されます。マップ ホストが提供する場合、マップのライン シートにはライン全体を表示できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tijden komen uit het geselecteerde reisschema. Het lijnschema van de kaart kan de hele lijn weergeven als een kaarthost deze verstrekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godziny pochodzą z wybranej trasy. Arkusz liniowy mapy może pokazać całą linię, jeśli udostępnia ją dostawca mapy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os horários vêm do itinerário selecionado. A folha de linhas do mapa pode mostrar a linha inteira quando um host do mapa a fornece."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os horários vêm do itinerário selecionado. A folha de linhas do mapa pode mostrar a linha inteira quando um host do mapa a fornece."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timpurile provin din itinerariul ales. Foaia de linie a hărții poate afișa întreaga linie atunci când o oferă o gazdă a hărții."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время взято из выбранного маршрута. Лист линий карты может отображать всю линию, если ее предоставляет хост карты."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časi izhajajo iz izbranega itinerarja. Vrstni list zemljevida lahko prikaže celotno vrstico, če jo zagotovi gostitelj zemljevida."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiderna kommer från den valda resplanen. Kartans linjeblad kan visa hela linjen när en kartvärd tillhandahåller den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamanlar seçilen seyahat programından gelir. Haritanın satır sayfası, bir harita sunucusu sağladığında tüm satırı gösterebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Час виходить із вибраного маршруту. Лінійний аркуш карти може відображати весь рядок, якщо його надає хост карти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间来自所选行程。当地图主机提供时，地图的线路表可以显示整条线路。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間來自所選行程。當地圖主機提供時，地圖的線路表可以顯示整條線路。"
          }
        }
      }
    },
