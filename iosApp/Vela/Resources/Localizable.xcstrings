    "settings_privacy_limits" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limits"
          }
        }
      }
    },
    "settings_privacy_limits_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela cannot make Google forget a request it has already answered, and it cannot hide your IP address. Use a VPN or Tor for that. The session cookie is what links lookups while a session lasts; the weekly rotation caps it but does not erase the past. Google may also give a new session a limited view: fewer photos per page, popular times missing, and More reviews loading nothing."
          }
        }
      }
    },
    "settings_privacy_page" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy controls"
          }
        }
      }
    },
    "settings_privacy_what_google" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What reaches Google"
          }
        }
      }
    },
    "settings_privacy_what_google_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google's public servers answer searches, place lookups, routes and the hidden pages. They see your IP address, the words you type, the map area or the route's endpoints, and Google's own logged-out session cookie. They never see a Google account, a name or an API key that marks the traffic as Vela's."
          }
        }
      }
    },
    "settings_privacy_what_local" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What stays on this phone"
          }
        }
      }
    },
    "settings_privacy_what_local_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved places, lists, Home and Work, recent searches, parking history, settings and downloaded regions are stored only here. Vela has no server, no analytics and no crash reporting, and nothing on this screen is uploaded."
          }
        }
      }
    },
