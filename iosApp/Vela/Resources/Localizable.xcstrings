    "root_diag_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beides bleibt auf Ihrem Telefon, nichts wird gesendet, es sei denn, Sie exportieren es. In den Einstellungen jederzeit änderbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both stay on your phone. Nothing is sent unless you export it. Change either any time in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos permanecen en tu teléfono: no se envía nada salvo que lo exportes. Cambia cualquiera cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux restent sur votre téléphone - rien n'est envoyé tant que vous ne l'exportez pas. Modifiable à tout moment dans les Paramètres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שניהם נשארים בטלפון שלך. שום דבר לא נשלח אלא אם תייצא אותו. ניתן לשנות כל אחד בכל עת בהגדרות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindkettő a telefonodon marad. Semmi nem kerül elküldésre, hacsak nem exportálod. Bármikor módosíthatod a Beállításokban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrambi restano sul telefono: nulla viene inviato finché non lo esporti. Puoi modificarli in qualsiasi momento nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらも端末内に保存されます。エクスポートしない限り送信されません。設定でいつでも変更できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide blijven op uw telefoon - er wordt niets verzonden tenzij u het exporteert. U kunt beide op elk moment wijzigen in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oba pozostają na telefonie - nic nie jest wysyłane, dopóki tego nie wyeksportujesz. Możesz je zmienić w dowolnej chwili w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos permanecem no seu celular: nada é enviado a menos que você exporte. Altere qualquer um a qualquer momento nas Configurações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos permanecem no seu telemóvel - nada é enviado a menos que o exporte. Altere qualquer um a qualquer momento nas Definições."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambele rămân pe telefonul tău. Nu se trimite nimic decât dacă le exporți. Poți modifica oricare dintre aceste setări oricând în Setări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оба параметра остаются на вашем телефоне - ничего не отправляется, пока вы не экспортируете это сами. Изменить любой из них можно в любой момент в настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Båda stannar på din telefon, inget skickas om du inte exporterar det. Ändra endera när som helst i Inställningar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обидва залишаються на вашому телефоні - нічого не надсилається, доки ви не експортуєте. Змінити кожен можна будь-коли в Налаштуваннях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两者都保留在您的手机上。除非您导出，否则不会发送任何内容。可随时在设置中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩者都保留在您的手機上。除非您匯出，否則不會傳送任何內容。可隨時在設定中變更。"
          }
        }
      }
    },
