    "settings_map_names_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umschriebene Namen entstehen maschinell, wo OpenStreetMap keinen englischen Namen hat, und lesen sich auf Hebräisch und in einigen anderen Schriften schlecht. App-Sprache und Stimme ändern sich nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romanized names are made by machine where OpenStreetMap has no English name, and read badly in Hebrew and some other scripts. The app language and the voice do not change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres romanizados se generan a máquina donde OpenStreetMap no tiene nombre en inglés, y se leen mal en hebreo y en otros alfabetos. El idioma de la app y la voz no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms romanisés sont produits par une machine là où OpenStreetMap n'a pas de nom anglais, et se lisent mal en hébreu et dans d'autres écritures. La langue de l'appli et la voix ne changent pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמות בתעתיק לטיני נוצרים אוטומטית כשב-OpenStreetMap אין שם באנגלית, ונקראים גרוע בעברית ובכמה כתבים אחרים. שפת האפליקציה והקול לא משתנים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az átírt neveket gép készíti ott, ahol az OpenStreetMapen nincs angol név, és héberül meg néhány más írásban rosszul olvashatók. Az alkalmazás nyelve és a hang nem változik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nomi romanizzati sono generati a macchina dove OpenStreetMap non ha un nome inglese, e si leggono male in ebraico e in altre scritture. La lingua dell'app e la voce non cambiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローマ字の名前は、OpenStreetMapに英語名がない場所で機械的に作られ、ヘブライ語などいくつかの文字では読みにくくなります。アプリの言語と音声は変わりません。"
          }
        },
        "kmr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navên bi tîpên latînî ji aliyê makîneyê ve çêdibin li cihên ku OpenStreetMap navê îngilîzî tune, û di îbranî û hin nivîsên din de xirab tên xwendin. Zimanê sepanê û deng naguherin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geromaniseerde namen worden machinaal gemaakt waar OpenStreetMap geen Engelse naam heeft, en lezen slecht in het Hebreeuws en enkele andere schriften. De app-taal en de stem veranderen niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwy w transliteracji są tworzone maszynowo tam, gdzie OpenStreetMap nie ma nazwy angielskiej, i źle się je czyta w hebrajskim i niektórych innych pismach. Język aplikacji i głos się nie zmieniają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomes romanizados são gerados automaticamente onde o OpenStreetMap não tem nome em inglês, e ficam ruins em hebraico e em outros alfabetos. O idioma do app e a voz não mudam."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os nomes romanizados são gerados automaticamente onde o OpenStreetMap não tem nome em inglês, e leem-se mal em hebraico e noutros alfabetos. A língua da app e a voz não mudam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denumirile în alfabetul latin sunt generate automat în cazul în care OpenStreetMap nu conține o denumire în limba engleză și sunt greu de citit pentru limba ebraică și alte sisteme de scriere. Limba aplicației și vocea nu se modifică."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Названия латиницей создаются машиной там, где в OpenStreetMap нет английского названия, и плохо читаются для иврита и некоторых других письменностей. Язык приложения и голос не меняются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Romaniserade namn görs av en maskin där OpenStreetMap saknar engelskt namn, och läses dåligt på hebreiska och några andra skriftsystem. Appens språk och rösten ändras inte."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назви латиницею створює машина там, де в OpenStreetMap немає англійської назви, і вони погано читаються для івриту та деяких інших письмен. Мова застосунку й голос не змінюються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拉丁转写名称在 OpenStreetMap 没有英文名时由机器生成，在希伯来文等一些文字中可读性很差。应用语言和语音不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拉丁轉寫名稱在 OpenStreetMap 沒有英文名時由機器產生，在希伯來文等一些文字中可讀性很差。應用程式語言和語音不受影響。"
          }
        }
      }
    },
