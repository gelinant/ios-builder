    "settings_crash_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela wurde kürzlich unerwartet beendet. Das Senden des Absturzberichts (Stack-Trace) hilft bei der Behebung, es ist eine reine Textdatei ohne personenbezogene Daten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela closed unexpectedly recently. Sending the crash report (stack trace) helps fix it. It's a plain text file, no personal data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela se cerró de forma inesperada hace poco. Enviar el informe de fallo (traza de la pila) ayuda a corregirlo: es un archivo de texto plano, sin datos personales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela s'est fermé de façon inattendue récemment. Envoyer le rapport de plantage (trace de la pile) aide à le corriger, c'est un simple fichier texte, sans données personnelles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela נסגרה במפתיע לאחרונה. שליחת דוח הקריסה (עקבות הערימה) עוזרת לתקן זאת. זהו קובץ טקסט פשוט, ללא נתונים אישיים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vela nemrég váratlanul bezáródott. A hibajelentés (stack trace) elküldése segít kijavítani. Egy egyszerű szöveges fájl, nincs benne személyes adat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela si è chiusa inaspettatamente di recente. Inviare il rapporto sull'arresto (stack trace) aiuta a risolverlo: è un file di testo semplice, senza dati personali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela が最近予期せず終了しました。クラッシュレポート（スタックトレース）を送っていただくと修正に役立ちます。個人データを含まない、ただのテキストファイルです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela is onlangs onverwacht gesloten. Het crashrapport (stacktrace) sturen helpt het op te lossen, het is een gewoon tekstbestand, zonder persoonlijke gegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela zamknęła się niespodziewanie. Wysłanie raportu o awarii (ślad stosu) pomaga ją naprawić, to zwykły plik tekstowy, bez danych osobowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela fechou inesperadamente há pouco. Enviar o relatório de erro (rastreio da pilha) ajuda a corrigi-lo. É um arquivo de texto simples, sem dados pessoais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela fechou-se inesperadamente há pouco. Enviar o relatório de erro (rastreio da pilha) ajuda a corrigi-lo, é um ficheiro de texto simples, sem dados pessoais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela s-a închis neașteptat de curând. Trimiterea raportului de eroare (stack trace) ajută la remedierea problemei. Este un fișier text simplu, fără date personale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недавно Vela неожиданно закрылась. Отправка отчёта о сбое (трассировки стека) поможет это исправить, это обычный текстовый файл без личных данных."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela stängdes oväntat nyligen. Att skicka kraschrapporten (stackspår) hjälper till att åtgärda det, det är en vanlig textfil, inga personuppgifter."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нещодавно Vela несподівано закрилася. Надсилання звіту про збій (трасування стека) допомагає це виправити, це звичайний текстовий файл без особистих даних."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 最近意外退出。发送崩溃报告（堆栈跟踪）有助于修复问题。它是纯文本文件，不含个人数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 最近曾意外關閉。傳送當機報告（堆疊追蹤）有助於修正問題。這是純文字檔，不含個人資料。"
          }
        }
      }
    },
