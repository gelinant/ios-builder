    "settings_speed_cam_warn_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt während der Navigation etwa zwölf Sekunden im Voraus die Meldung „Blitzer voraus“ an und blendet eine Karte ein, wenn Sie sich einem Blitzer nähern. Die Funktion richtet sich nach Ihren Einstellungen für die Sprachansagen. Da Warnungen vor Blitzern während der Fahrt in einigen Ländern eingeschränkt sind, ist diese Funktion deaktiviert, sofern Sie sie nicht selbst aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Says \"Speed camera ahead\" and shows a card as you approach one while navigating, about twelve seconds ahead. Follows your spoken-directions setting. Warning about cameras while driving is restricted in some countries, so this is off unless you turn it on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dice «Radar más adelante» al acercarte a uno mientras navegas, con unos doce segundos de antelación. Sigue tu ajuste de indicaciones habladas. Avisar de radares al conducir está restringido en algunos países, así que está desactivado salvo que lo actives."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annonce \"Radar devant\" à l'approche d'un radar pendant la navigation, environ douze secondes à l'avance. Suit votre réglage d'instructions vocales. Avertir de la présence de radars au volant est réglementé dans certains pays : l'option reste désactivée tant que vous ne l'activez pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הכרזת „מצלמת ניווט לפניך” כשמתקרבים למצלמת כזו במהלך הניווט, כשתים עשרה שניות מראש. ההכרזה פועלת לפי הגדרות ההוראות הקוליות. ההתרעה על מצלמות במהלך הניווט מוגבלת במדינות מסוימות, ולכן הגדרה זו כבויה כברירת מחדל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigáció közben bemondja, hogy „Traffipax következik”, amikor közelítesz egyhez, nagyjából tizenkét másodperccel előtte. A hangos útvonalvezetés beállítását követi. A traffipaxokra való vezetés közbeni figyelmeztetés néhány országban korlátozott, ezért alapból ki van kapcsolva, amíg be nem kapcsolod."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuncia \"Autovelox in arrivo\" e visualizza un avviso con circa dodici secondi di anticipo mentre segui un percorso. La funzione rispetta le impostazioni relative alle indicazioni vocali. Poiché in alcuni paesi gli avvisi sugli autovelox durante la guida sono soggetti a restrizioni, la funzione è disattivata per impostazione predefinita e deve essere abilitata manualmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ナビ中に速度取締りカメラへ近づくと、約 12 秒前に「この先に速度取締りカメラがあります」と読み上げます。音声案内の設定に従います。運転中のカメラ警告が制限されている国もあるため、オンにしない限り無効です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zegt \"Flitspaal vooruit\" wanneer je er tijdens het navigeren een nadert, zo'n twaalf seconden van tevoren. Volgt je instelling voor gesproken aanwijzingen. Waarschuwen voor flitspalen tijdens het rijden is in sommige landen beperkt, dus dit staat uit tenzij je het aanzet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mówi „Fotoradar przed tobą” gdy podczas nawigacji zbliżasz się do jednego z nich z około dwunastosekundowym wyprzedzeniem. Podlega ustawieniu wskazówek głosowych. Ostrzeganie o fotoradarach podczas jazdy jest w niektórych krajach zabronione dlatego jest wyłączone dopóki tego nie włączysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diz “Radar à frente” quando você se aproxima de um durante a navegação, com cerca de doze segundos de antecedência. Segue a configuração das instruções faladas. Avisar sobre radares ao volante é restrito em alguns países, por isso isto fica desativado até você ativar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diz \"Radar de velocidade à frente\" e mostra um cartão quando se aproxima de um radar durante a navegação, com um tempo de aviso de aproximadamente doze segundos. Ele segue as suas instruções de voz. O aviso sobre radares durante a condução é restrito em alguns países, pelo que está desativado a menos que o ative."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rostește „Cameră de viteză înainte” și afișează un card pe măsură ce te apropii de una în timp ce navighezi, cu aproximativ doisprezece secunde înainte. Urmează setarea indicațiilor vocale. Avertismentul privind radarele în timpul conducerii este restricționat în unele țări, așa că este dezactivat dacă nu îl activezi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Произносит «Впереди камера контроля скорости» при приближении к ней во время навигации, примерно за двенадцать секунд. Зависит от настройки голосовых подсказок. В некоторых странах предупреждать о камерах за рулём запрещено, поэтому по умолчанию выключено."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med navigacijo približno dvanajst sekund pred kamero izgovori »Pozor, radar« in prikaže opozorilo. Upošteva nastavitev glasovnih navodil."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säger \"Fartkamera längre fram\" när du närmar dig en under navigering, cirka tolv sekunder i förväg. Följer din inställning för talade vägbeskrivningar. Att varna för kameror under körning är begränsat i vissa länder, så detta är av tills du slår på det."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Промовляє «Попереду камера контролю швидкості», коли ви наближаєтеся до неї під час навігації, приблизно за дванадцять секунд. Залежить від налаштування голосових вказівок. У деяких країнах попереджати про камери за кермом заборонено, тому цю опцію вимкнено, доки ви її не ввімкнете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导航中接近测速摄像头时播报“前方有测速摄像头”，大约提前十二秒提醒。遵循您的语音播报设置。部分国家/地区限制在驾驶中提示摄像头，因此默认关闭，需手动开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "導航時接近測速照相會唸出「前方有測速照相」，約提前十二秒提醒。會依照你的語音指引設定。部分國家限制行車中提示測速照相，因此預設關閉，需自行開啟。"
          }
        }
      }
    },
