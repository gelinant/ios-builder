    "settings_places_source_open_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Symbole stammen aus Velas eigenen Daten. Beim Verschieben wird nie Google gefragt, und es funktioniert offline."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icons come from Vela's own data. Panning never contacts Google, and it works offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los iconos salen de los datos propios de Vela. Desplazar el mapa nunca consulta a Google y funciona sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les icônes viennent des données de Vela. Déplacer la carte n'interroge jamais Google, et cela fonctionne hors ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסמלים מגיעים מהנתונים של Vela. גלילה במפה אף פעם לא יוצרת קשר עם Google, והיא עובדת גם כשאין חיבור לרשת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ikonok a Vela saját adataiból származnak. A térkép mozgatása soha nem fordul a Google-höz, és offline is működik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le icone vengono dai dati di Vela. Spostare la mappa non interroga mai Google e funziona anche offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイコンは Vela 独自のデータから表示します。地図を動かしても Google に問い合わせず、オフラインでも動作します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De pictogrammen komen uit Vela's eigen gegevens. Pannen vraagt nooit iets aan Google en het werkt offline."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikony pochodzą z własnych danych Veli. Przesuwanie mapy nigdy nie odpytuje Google i działa offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ícones vêm dos dados do próprio Vela. Arrastar o mapa nunca consulta o Google, e funciona off-line."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ícones vêm dos dados da própria Vela. Arrastar o mapa nunca consulta a Google, e funciona offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pictogramele provin din datele proprii ale Vela. Panoramarea nu contactează niciodată Google și funcționează off-line."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значки берутся из собственных данных Vela. При перемещении карты запросы к Google не уходят, и всё работает офлайн."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikone prihajajo iz podatkov Vela. Premikanje zemljevida ne pošilja zahtev Googlu, delujejo pa tudi brez povezave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikonerna kommer från Velas egna data. Panorering frågar aldrig Google, och det fungerar offline."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значки беруться з власних даних Vela. Рух картою ніколи не звертається до Google, і це працює офлайн."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图标来自 Vela 自己的数据。平移地图时从不请求 Google，离线也能使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖示來自 Vela 自己的資料。平移地圖時不會向 Google 發出請求，離線也能用。"
          }
        }
      }
    },
