    "settings_nav_north_up_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte bleibt beim Fahren flach und genordet. Tippe während der Fahrt auf den Kompass, um umzuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
