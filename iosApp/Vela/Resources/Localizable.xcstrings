    "settings_app_name_generic_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt das Launcher-Symbol als schlichtes „Karten“ statt Vela Maps, für einen unauffälligen Look. Nach dem Wechsel muss die Verknüpfung auf dem Startbildschirm eventuell neu angelegt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the launcher icon as plain Maps instead of Vela Maps, for a stock look. You may need to re-add a home screen shortcut after switching."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el icono del lanzador como «Mapas» en vez de «Vela Maps», para un aspecto de serie. Puede que tengas que volver a añadir el acceso directo en la pantalla de inicio después del cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche l'icône du lanceur sous le nom Maps plutôt que Vela Maps, pour un rendu d'origine. Il faudra peut-être replacer le raccourci sur l'écran d'accueil après le changement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציג את אייקון המפעיל בשם מפות במקום Vela Maps, למראה סטנדרטי. ייתכן שתצטרך להוסיף מחדש קיצור דרך למסך הבית אחרי המעבר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A launcher ikonon „Vela” helyett „Térképek” jelenik meg a gyári megjelenés érdekében. A váltás után lehet, hogy újra hozzá kell adnod a parancsikont a kezdőképernyőhöz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra l'icona nel launcher come semplice Mappe invece di Vela Maps, per un aspetto standard. Dopo il cambio potrebbe essere necessario ricreare il collegamento nella schermata Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランチャーのアイコン名を Vela Maps ではなく Maps にして、標準アプリのような見た目にします。切り替えたあと、ホーム画面のショートカットを追加し直す必要がある場合があります。"
          }
        },
        "kmr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îkona destpêkê li şûna nexşeyên Vela wekî nexşe nîşan dide, ji bo xuyaniyek berdest. Dibe ku piştî guhertinê pêdivî bi tevlîkirina kurteriyek dîmendera destpêkê hebe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont het pictogram als gewoon Maps in plaats van Vela Maps, voor een standaarduiterlijk. Mogelijk moet je na het wisselen een snelkoppeling op je startscherm opnieuw toevoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje ikonę w menu aplikacji jako zwykłe Maps zamiast Vela Maps, dla systemowego wyglądu. Po przełączeniu może być konieczne ponowne dodanie skrótu na ekranie głównym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o ícone na tela inicial como Mapas em vez de Vela Maps, para um aspecto discreto. Você pode ter que adicionar o atalho na tela inicial novamente depois de mudar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o ícone no ecrã inicial como Mapas em vez de Vela Maps, para um aspeto discreto. Pode ter de voltar a adicionar o atalho no ecrã inicial depois de mudar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează pictograma lansatorului ca Maps în loc de Vela Maps, pentru un aspect standard. Este posibil să fie nevoie să adaugi din nou o comandă rapidă pe ecranul de pornire după schimbare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значок в списке приложений будет подписан просто «Карты», а не Vela Maps, как у стандартного приложения. После переключения ярлык на главном экране, возможно, придётся добавить заново."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namesto imena Vela Maps bo pod ikono prikazano samo Zemljevidi. Po spremembi bo morda treba znova dodati bližnjico na začetni zaslon."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar appikonen som bara Kartor i stället för Vela Maps, för ett standardutseende. Du kan behöva lägga till genvägen på startskärmen igen efter bytet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan görünüm için launcher simgesini Vela Haritalar yerine düz Haritalar olarak gösterir. Değişiklikten sonra ana ekran kısayolunu yeniden eklemeniz gerekebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує значок запуску як звичайні Maps замість Vela Maps, для стандартного вигляду. Після перемикання, можливо, доведеться знову додати ярлик на головний екран."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动器图标显示为“地图”而不是 Vela Maps，更接近原生外观。切换后可能需要重新添加桌面快捷方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓啟動器圖示顯示為「地圖」而非 Vela Maps，看起來更像原生應用程式。切換後可能需要重新在主畫面新增捷徑。"
          }
        }
      }
    },
