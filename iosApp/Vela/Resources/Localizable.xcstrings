    "settings_flock_nav_card_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet während der Navigation einen Hinweis ein, wenn Sie sich einer Kennzeichenkamera auf Ihrer Route nähern. Kameras, die quer zu Ihrer Straße ausgerichtet sind, werden übersprungen. Standardmäßig aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While navigating, shows a card as you get close to a license plate camera on your route. Cameras aimed across your road are skipped. Off by default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la navegación, muestra una tarjeta al acercarte a una cámara de matrículas en tu ruta. Se omiten las cámaras colocadas en perpendicular a tu calle. Desactivado por defecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la navigation, affiche un encart quand vous approchez d'une caméra de lecture de plaques sur votre itinéraire. Les caméras orientées en travers de votre route sont ignorées. Désactivé par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת כרטיס ככל שמתקרבים למצלמת זיהוי של לוחיות רישוי במהלך ניווט במסלול. המצלמות שפונות לאורך הכביש שעליו נמצאים אינן נכללות. האפשרות כבויה כברירת מחדל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigálás közben egy kártyát mutat, amikor az útvonaladon egy rendszámfelismerő kamerához közeledsz. Az utadra keresztben néző kamerákat kihagyja. Alapból ki van kapcsolva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la navigazione mostra una scheda quando ti avvicini a una telecamera di lettura targhe sul percorso. Le telecamere puntate di traverso sulla tua strada vengono ignorate. Disattivato di default."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ナビ中、ルート上のナンバープレート読み取りカメラに近づくとカードを表示します。走っている道路を横切る向きのカメラは対象外です。初期状態ではオフです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont tijdens het navigeren een melding wanneer je een kentekencamera op je route nadert. Camera's die op een kruisende weg gericht zijn, worden overgeslagen. Standaard uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas nawigacji pokazuje kartę, gdy zbliżasz się do kamery odczytującej tablice rejestracyjne na twojej trasie. Kamery skierowane na drogę poprzeczną są pomijane. Domyślnie wyłączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante a navegação, mostra um cartão quando você se aproxima de uma câmera de leitura de placas no seu trajeto. As câmeras voltadas para uma rua transversal são ignoradas. Desativado por padrão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante a navegação, mostra um cartão quando se aproxima de uma câmara de leitura de matrículas no seu percurso. As câmaras viradas para uma rua transversal são ignoradas. Desligado por predefinição."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În timpul navigării, afișează un card pe măsură ce te apropii de o cameră de supraveghere a plăcuțelor de înmatriculare de pe traseu. Camerele îndreptate în direcția opusă drumului tău sunt omise. Dezactivat în mod implicit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время навигации показывает карточку, когда вы приближаетесь к камере распознавания номеров на маршруте. Камеры, направленные поперёк вашей дороги, пропускаются. По умолчанию выключено."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med navigacijo prikaže opozorilo, ko se približate kameri za prepoznavanje registrskih tablic na svoji poti. Kamere, usmerjene prečno na cesto, so izključene. Privzeto je izklopljeno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under navigering visas ett kort när du närmar dig en nummerplåtskamera längs rutten. Kameror som är riktade tvärs över din väg hoppas över. Av som standard."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час навігації показує картку, коли ви наближаєтеся до камери розпізнавання номерів на маршруті. Камери, спрямовані впоперек вашої дороги, пропускаються. Типово вимкнено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导航时，接近路线上的车牌识别摄像头时显示提示卡片。镜头横对您所在道路的摄像头会被跳过。默认关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "導航時，接近路線上的車牌辨識攝影機會顯示提示卡片。鏡頭橫向對著你所在道路的攝影機會略過。預設關閉。"
          }
        }
      }
    },
