    "route_save_keep_stops_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: Die Stopps bestimmen nur den Verlauf, und die Route wird neben den anderen für diese Fahrt angeboten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: the stops only shape the way, and the route is offered next to the others for this trip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: las paradas solo dan forma al recorrido, y la ruta se ofrece junto a las demás para este trayecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : les arrêts ne servent qu'à tracer le chemin, et l'itinéraire est proposé à côté des autres pour ce trajet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבוי: העצירות רק קובעות את הדרך, והמסלול מוצע לצד האחרים לנסיעה הזו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kikapcsolva: a megállók csak az útvonal vonalát alakítják, és az útvonal a többi mellett jelenik meg ennél az útnál."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato: le tappe servono solo a tracciare la strada, e il percorso viene proposto accanto agli altri per questo tragitto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、経由地は道順を決めるためだけに使われ、ルートはこの区間のほかのルートと並んで表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit: de tussenstops bepalen alleen de weg, en de route wordt naast de andere aangeboden voor deze rit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączone: przystanki tylko kształtują przebieg, a trasa jest proponowana obok pozostałych dla tej podróży."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado: as paradas só definem o caminho, e a rota é oferecida junto das outras para este trajeto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado: as paragens só definem o caminho, e a rota é proposta junto das outras para este trajeto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezactivat: opririle doar conturează traseul, iar ruta este afișată alături de celelalte opțiuni pentru această călătorie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выкл.: остановки только задают путь, а маршрут предлагается рядом с остальными для этой поездки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av: stoppen formar bara vägen, och rutten erbjuds bredvid de andra för den här resan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalı: Duraklar sadece yolu şekillendirir ve bu yolculuk için rota diğerlerinin yanında sunulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкнено: зупинки лише задають шлях, а маршрут пропонується поруч з іншими для цієї поїздки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，经停点只用来确定走法，这条路线会和此行程的其他路线一起提供。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉時，停靠站只用來決定走法，這條路線會和這趟行程的其他路線一起提供。"
          }
        }
      }
    },
