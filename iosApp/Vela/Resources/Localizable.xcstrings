    "transit_updates_require_vela_to_be_running" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب التحديثات تشغيل Vela. يتوقفون بعد الإقلاع عن التدخين بالقوة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Updates muss Vela ausgeführt werden. Sie stoppen nach dem erzwungenen Beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates require Vela to be running. They stop after force-quit."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates require Vela to be running. They stop after force-quit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actualizaciones requieren que Vela esté en ejecución. Se detienen después de un abandono forzado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värskendused nõuavad, et Vela töötaks. Nad peatuvad pärast sunniviisilist loobumist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour nécessitent que Vela soit en cours d'exécution. Ils s'arrêtent après un arrêt forcé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדכונים מחייבים את Vela כדי לפעול. הם מפסיקים לאחר הפסקה בכוח."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frissítésekhez a Vela futásához szükséges. Kényszerkilépés után abbahagyják."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti richiedono che Vela sia in esecuzione. Si fermano dopo la chiusura forzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートには Vela が実行されている必要があります。強制終了後に停止します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates vereisen dat Vela actief is. Ze stoppen na een gedwongen stop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizacje wymagają działania Vela. Zatrzymują się po wymuszeniu rezygnacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As atualizações exigem que o Vela esteja em execução. Eles param após a saída forçada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As atualizações exigem que o Vela esteja em execução. Eles param após a saída forçada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizările necesită ca Vela să ruleze. Se opresc după renunțarea forțată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для обновлений требуется запуск Vela. Они останавливаются после принудительного выхода."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posodobitve zahtevajo, da se izvaja Vela. Ustavijo se po prisilni opustitvi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdateringar kräver att Vela körs. De slutar efter tvångsavslut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncellemeler Vela'nin çalışmasını gerektirir. Zorla bıraktıktan sonra dururlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлення потребують запуску Vela. Вони припиняються після примусового виходу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新需要运行 Vela。他们在强制退出后停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新需要運行 Vela。他們在強制退出後停止。"
          }
        }
      }
    },
