          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech becomes a search right on your phone: no other app needed and nothing is uploaded. Download one or more engines and pick which the mic uses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voz se convierte en busqueda en el telefono. Nada se sube. Elige el motor del microfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parole devient une recherche sur le telephone. Rien n'est envoye. Choisissez le moteur du micro."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דיבור הופך לחיפוש בטלפון. שום דבר לא מועלה. בחרו מנוע למיקרופון."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beszéd közvetlenül a telefonodon válik kereséssé: nincs szükség másik appra, és semmi nem kerül feltöltésre. Tölts le egy vagy több motort, és válaszd ki, melyiket használja a mikrofon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voce diventa una ricerca sul telefono. Nulla viene caricato. Scegli il motore del microfono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声が端末内で検索になります。何もアップロードされません。マイクのエンジンを選択。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spraak wordt een zoekopdracht op de telefoon. Niets wordt geupload. Kies de engine voor de mic."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mowa zamienia się w wyszukiwanie bezpośrednio w Twoim telefonie – nie potrzeba żadnej dodatkowej aplikacji a dane nie są nigdzie przesyłane. Pobierz jeden lub więcej silników rozpoznawania mowy i wybierz ten z którego ma korzystać mikrofon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fala vira pesquisa no celular. Nada é enviado. Escolha o mecanismo do microfone."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fala vira pesquisa no telefone. Nada e enviado. Escolha o motor do microfone."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recunoașterea vocală devine o funcție de căutare direct pe telefonul tău: nu ai nevoie de nicio altă aplicație și nu se încarcă nimic. Descarcă unul sau mai multe motoare de recunoaștere și alege-l pe cel pe care să-l folosească microfonul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Речь становится поиском на телефоне. Ничего не отправляется. Выберите движок микрофона."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tal blir en sokning pa telefonen. Inget laddas upp. Valj motor for mikrofonen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мовлення стає пошуком на телефоні. Нічого не надсилається. Оберіть рушій мікрофона."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音在手机上变成搜索。不上传任何内容。选择麦克风使用的引擎。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語音在手機上變成搜尋。不上傳任何內容。選擇麥克風使用的引擎。"
          }
        }
      }
    },
