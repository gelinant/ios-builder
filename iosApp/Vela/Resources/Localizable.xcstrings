    "settings_nav_day_night_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält Ihr gewähltes Design überall sonst bei und wechselt nur während der Fahrt nach Tageslicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps your chosen theme everywhere else, and switches by daylight only while you are driving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene el tema que elegiste en el resto de la app y cambia según la luz del día solo mientras conduces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve votre thème partout ailleurs et bascule selon la lumière du jour uniquement quand vous conduisez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שומר על ערכת הנושא שבחרת בכל מקום אחר, ומחליף לפי אור היום רק בזמן נהיגה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindenhol máshol megtartja a választott témádat, és csak vezetés közben vált a napszak szerint."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene il tema che hai scelto ovunque e cambia in base alla luce del giorno solo mentre guidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふだんは選んだテーマのままにし、運転中だけ明るさに応じて切り替えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt overal je gekozen thema aan en schakelt alleen tijdens het rijden mee met het daglicht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszędzie indziej zachowuje wybrany motyw, a przełącza się według światła dziennego tylko podczas jazdy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém o tema que você escolheu em todo o resto e muda conforme a luz do dia apenas enquanto você dirige."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém o tema que escolheu em todo o resto e muda conforme a luz do dia apenas enquanto conduz."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvează tema aleasă de peste tot și comută în funcție de luminozitate doar în timpul navigării."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Везде сохраняет выбранную вами тему и переключается по освещённости только во время поездки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behåller ditt valda tema överallt annars och växlar efter dagsljus bara medan du kör."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрізь залишає обрану вами тему, а перемикається за освітленням лише поки ви за кермом."
          }
