    "settings_save_trips_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet die GPS-Spur jeder Fahrt auf diesem Gerät auf, um sie später abzuspielen. Verlässt das Gerät nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records each drive's GPS trace on this phone, so it can be replayed later. Never leaves the phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba el rastro GPS de cada viaje en este teléfono, para reproducirlo después. Nunca sale del teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre la trace GPS de chaque trajet sur ce téléphone, pour la rejouer plus tard. Ne quitte jamais le téléphone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מקליט את מסלול ה-GPS של כל נסיעה בטלפון הזה, כך שאפשר לשדר אותה מחדש. לעולם לא עוזב את הטלפון."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rögzíti minden út GPS-nyomvonalát ezen a telefonon, hogy később visszajátszható legyen. Soha nem hagyja el a telefont."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra la traccia GPS di ogni viaggio su questo telefono, per riprodurla in seguito. Non lascia mai il telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各走行の GPS 軌跡をこの端末に記録し、後からリプレイできるようにします。記録が端末の外に出ることはありません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaat het gps-spoor van elke rit op deze telefoon op, om later af te spelen. Verlaat de telefoon nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje ślad GPS każdej trasy na tym telefonie, do późniejszego odtworzenia. Nigdy nie opuszcza telefonu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava o rastro de GPS de cada viagem neste celular, para reproduzir depois. Nunca sai do celular."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava o rasto GPS de cada viagem neste telemóvel, para reproduzir depois. Nunca sai do telemóvel."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrează traseul GPS al fiecărei călătorii pe acest telefon, astfel încât să poată fi redat ulterior. Nu părăsește niciodată telefonul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает GPS-след каждой поездки на этом телефоне для повтора позже. Никогда не покидает телефон."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tem telefonu beleži sled GPS vsake vožnje, da si jo lahko pozneje ponovno ogledaš. Podatki nikoli ne zapustijo telefona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparar varje resas GPS-spår på den här telefonen, för uppspelning senare. Lämnar aldrig telefonen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записує GPS-слід кожної поїздки на цьому телефоні для відтворення пізніше. Ніколи не залишає телефон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在本机记录每次行程的 GPS 轨迹，供日后回放。绝不离开手机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
