    "settings_map_look_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Vela“ ist der „Liberty“-Stil von OpenFreeMap mit Vela-eigenen Farben, Symbolen und Straßenbreiten. Die anderen sind die OpenFreeMap-Stile „Bright“, „Positron“, „Fiord“ und „Dark“ in ihrer Standardausführung; „Fiord“ und „Dark“ sind unabhängig vom Thema immer dunkel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela is OpenFreeMap's Liberty style with Vela's own colors, icons and road widths. The others are OpenFreeMap's Bright, Positron, Fiord and Black (its Dark style) as they come; Fiord and Black are dark whatever the theme."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela to styl z OpenFreeMap bazujący na stylu Liberty lecz wzbogacony o własną kolorystykę, ikony oraz szerokości dróg. Pozostałe style – Jasny, Pozyton, Fiord oraz Czarny (wariant ciemny) – pochodzą bezpośrednio z OpenFreeMap; style Fiord i Czarny pozostają ciemne niezależnie od wybranego motywu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela é o estilo Liberty do OpenFreeMap com cores, ícones e larguras de estradas próprias do Vela. Os outros são os estilos Claro, Positron, Fiord e Dark do OpenFreeMap, tal como vêm nas suas versões originais; Fiord e Dark são escuros independentemente do tema."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela este stilul „Liberty” al OpenFreeMap, cu culori, pictograme și lățimi de drum specifice Vela. Celelalte sunt stilurile „Bright”, „Positron”, „Fiord” și „Black” (varianta „Dark”) ale OpenFreeMap, așa cum sunt ele; „Fiord” și „Black” sunt întunecate indiferent de temă."
          }
        }
      }
    },
