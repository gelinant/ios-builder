    "settings_route_bar_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Streifen neben der Karte, der den Verkehr und das zeigt, was auf dem Rest Ihrer Route kommt. Zeigt nur, was Vela wirklich weiß: Staus, Ampeln, Stoppschilder, Bahnübergänge, Bodenschwellen und Überwachungskameras. Nur im Hochformat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A strip beside the map showing traffic and what is coming up on the rest of your route. Shows only what Vela actually knows: congestion, lights, stop signs, level crossings, speed bumps and surveillance cameras. Portrait only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una franja junto al mapa que muestra el tráfico y lo que viene en el resto de tu ruta. Solo muestra lo que Vela sabe de verdad: retenciones, semáforos, señales de stop, pasos a nivel, badenes y cámaras de vigilancia. Solo en vertical."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une bande à côté de la carte qui montre le trafic et ce qui arrive sur le reste de votre itinéraire. N'affiche que ce que Vela sait réellement : embouteillages, feux, stops, passages à niveau, ralentisseurs et radars. Mode portrait uniquement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רצועה לצד המפה שמציגה תנועה ואת מה שמגיע בהמשך המסלול. מציגה רק את מה ש-Vela באמת יודע: עומסים, רמזורים, תמרורי עצור, מפגשי מסילה, פסי האטה ומצלמות אכיפה. במצב לאורך בלבד."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy sáv a térkép mellett, ami a forgalmat és az útvonalad hátralévő részén következő dolgokat mutatja. Csak azt jeleníti meg, amit a Vela tényleg tud: torlódás, lámpák, stoptáblák, vasúti átjárók, fekvőrendőrök és térfigyelő kamerák. Csak álló tájolásban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una striscia accanto alla mappa che mostra il traffico e cosa ti aspetta nel resto del percorso. Mostra solo ciò che Vela sa davvero: congestione, semafori, stop, passaggi a livello, dossi e telecamere di sorveglianza. Solo in verticale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図の横に、交通状況とこの先のルートの様子を示す帯を表示します。表示されるのは Vela が実際に把握している情報だけです（渋滞、信号、一時停止、踏切、ハンプ、監視カメラ）。縦画面のみ対応です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een strook naast de kaart die het verkeer toont en wat er op de rest van je route aankomt. Toont alleen wat Vela echt weet: files, verkeerslichten, stopborden, spoorwegovergangen, verkeersdrempels en camera's. Alleen staand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasek obok mapy pokazujący ruch i to, co czeka cię na dalszej części trasy. Pokazuje tylko to, co Vela naprawdę wie: korki, sygnalizację, znaki stop, przejazdy kolejowe, progi zwalniające i kamery monitoringu. Tylko w pionie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma faixa ao lado do mapa que mostra o trânsito e o que vem pela frente no resto da rota. Mostra apenas o que o Vela sabe de fato: congestionamento, semáforos, placas de pare, passagens de nível, lombadas e câmeras de vigilância. Só na vertical."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma faixa ao lado do mapa que mostra o trânsito e o que aí vem no resto da rota. Mostra apenas o que a Vela sabe mesmo: congestionamento, semáforos, sinais de stop, passagens de nível, lombas e câmaras de vigilância. Só na vertical."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bandă situată lângă hartă, care afișează situația traficului și ce urmează pe restul traseului. Afișează doar informațiile de care dispune efectiv Vela: aglomerație, semafoare, semne de oprire, treceri la nivel cu calea ferată, denivelări de viteză și camere de supraveghere. Doar în orientare verticală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полоса рядом с картой, показывающая пробки и то, что ждёт вас на оставшемся маршруте. Показывает только то, что Vela действительно знает: заторы, светофоры, знаки «стоп», железнодорожные переезды, лежачих полицейских и камеры наблюдения. Только в портретной ориентации."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En remsa bredvid kartan som visar trafiken och vad som kommer på resten av rutten. Visar bara det Vela faktiskt känner till: köer, trafikljus, stoppskyltar, järnvägsövergångar, farthinder och övervakningskameror. Endast i stående läge."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смуга збоку карти, яка показує затори й те, що чекає на решті маршруту. Показує лише те, що Vela справді знає: затори, світлофори, знаки «стоп», залізничні переїзди, лежачі поліцейські та камери спостереження. Лише в портретній орієнтації."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地图旁的一条状栏，显示路况以及剩余路线上即将出现的情况。只显示 Vela 确实掌握的信息：拥堵、红绿灯、停车标志、铁路道口、减速带和监控摄像头。仅限竖屏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地圖旁的長條，顯示路況和剩餘路線上即將遇到的狀況。只顯示 Vela 確實知道的資訊：壅塞、紅綠燈、停車再開標誌、平交道、減速丘和監視攝影機。僅限直向模式。"
          }
        }
      }
    },
