    "settings_voice_variant_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Stimme hat Hunderte von Sprechern, tippen Sie auf ◀ ▶, um einen nach dem anderen anzuhören, oder geben Sie eine Variantennummer ein und tippen Sie auf „Los“, um direkt dorthin zu springen (es wird ein Beispiel gesprochen). Behalten Sie die, die Ihnen gefällt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This voice has hundreds of speakers. Tap ◀ ▶ to audition one at a time, or type a variant number and Go to jump straight to it (it speaks a sample). Keep the one you like."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta voz tiene cientos de locutores: toca ◀ ▶ para escucharlos uno a uno, o escribe un número de variante y pulsa Ir para saltar directamente a ella (reproduce un ejemplo). Conserva la que más te guste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette voix compte des centaines de locuteurs, appuyez sur ◀ ▶ pour les écouter un par un, ou saisissez un numéro de variante puis OK pour y accéder directement (un exemple est lu). Conservez celle qui vous plaît."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לקול הזה מאות דוברים. הקש ◀ ▶ כדי להאזין לאחד בכל פעם, או הקלד מספר גרסה והקש \"עבור\" כדי לקפוץ אליו ישירות (הוא ישמיע דוגמה). השאר את זה שאהבת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennek a hangnak több száz felolvasója van. Koppints a ◀ ▶ gombra, hogy egyesével meghallgasd, vagy írj be egy változatszámot és nyomj Ugrást, hogy egyenesen odaugorj (egy mintát mond). Tartsd meg, amelyik tetszik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa voce ha centinaia di interpreti: tocca ◀ ▶ per ascoltarli uno alla volta, oppure digita il numero di una variante e tocca Vai per passarvi direttamente (pronuncia un esempio). Mantieni quella che preferisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この音声には数百人の話者が含まれています。◀ ▶ をタップして 1 人ずつ試聴するか、バリエーション番号を入力して「移動」をタップすると直接切り替えられます（サンプルを読み上げます）。気に入った声を選んでください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze stem heeft honderden sprekers, tik op ◀ ▶ om ze een voor een te beluisteren, of typ een variantnummer en tik op Ga om er direct naartoe te springen (er wordt een voorbeeld afgespeeld). Bewaar degene die u bevalt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten głos ma setki lektorów, dotknij ◀ ▶, aby odsłuchiwać je pojedynczo, albo wpisz numer wariantu i dotknij Przejdź, aby przejść od razu do niego (odtworzy próbkę). Zachowaj ten, który Ci odpowiada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta voz tem centenas de locutores. Toque em ◀ ▶ para ouvi-los um a um, ou digite um número de variante e toque em Ir para ir direto a ela (reproduz uma amostra). Fique com a que preferir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta voz tem centenas de locutores, toque em ◀ ▶ para os ouvir um a um, ou escreva um número de variante e toque em Ir para ir diretamente para ela (reproduz uma amostra). Fique com a que preferir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această voce are sute de vorbitori. Atinge ◀ ▶ pentru a asculta pe rând sau introdu numărul unei variante și apasă Mergi pentru a accesa direct vocea (se rostește un eșantion). Păstrează varianta preferată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этого голоса сотни дикторов, нажимайте ◀ ▶, чтобы прослушивать их по одному, или введите номер варианта и нажмите «Перейти», чтобы сразу перейти к нему (проиграется пример). Оставьте тот, что понравится."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta glas ima na stotine govorcev. Z gumboma ◀ in ▶ jih lahko poslušate enega za drugim, lahko pa vnesete številko različice in izberete »Pojdi«. Ob tem se predvaja primer. Obdržite glas, ki vam je najbolj všeč."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här rösten har hundratals talare, tryck på ◀ ▶ för att lyssna på en i taget, eller skriv ett variantnummer och tryck Kör för att hoppa direkt dit (ett exempel läses upp). Behåll den du gillar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей голос має сотні дикторів, натискайте ◀ ▶, щоб прослухати їх по черзі, або введіть номер варіанта й натисніть «Перейти», щоб одразу до нього перескочити (озвучується приклад). Залиште той, що сподобався."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该语音包含数百位说话人。点按 ◀ ▶ 逐个试听，或输入变体编号后点按“跳转”直接切换（会朗读示例）。保留您喜欢的那一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個語音內含數百種音色。點按 ◀ ▶ 逐一試聽，或輸入音色編號後點「前往」直接跳到該音色（會朗讀範例）。保留你喜歡的那一個。"
          }
        }
      }
    },
