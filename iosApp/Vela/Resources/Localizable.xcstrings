    "transit_these_come_from_a_new_transitous" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه تأتي من بحث Transitous جديد. الرحلة أعلاه تحتفظ بأوقاتها الخاصة حتى تختار واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese stammen aus einer neuen Transitous-Suche. Die obige Reise behält ihre eigenen Zeiten, bis Sie eine auswählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These come from a new Transitous search. The trip above keeps its own times until you pick one."
          }
