    "settings_the_label_step_multiplies_the_dynamic" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل خطوة التسمية على مضاعفة حجم النوع الديناميكي. فهو لا يحل محل إعدادات النظام أبدًا، لذلك يتم إضافة حجم نص أكبر على iPhone وهذه الخطوة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Beschriftungsschritt vervielfacht die Größe des dynamischen Typs. Es ersetzt nie die Systemeinstellung, daher summieren sich eine größere iPhone-Textgröße und dieser Schritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The label step multiplies the Dynamic Type size. It never replaces the system setting, so a larger iPhone text size and this step add up."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The label step multiplies the Dynamic Type size. It never replaces the system setting, so a larger iPhone text size and this step add up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paso de la etiqueta multiplica el tamaño del tipo dinámico. Nunca reemplaza la configuración del sistema, por lo que un tamaño de texto de iPhone más grande y este paso se suman."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sildi samm korrutab dünaamilise tüübi suuruse. See ei asenda kunagi süsteemiseadeid, nii et iPhone'i tekstisuurus ja see samm liidetakse kokku."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’étape d’étiquetage multiplie la taille du type dynamique. Il ne remplace jamais les paramètres du système, donc une taille de texte plus grande sur l'iPhone et cette étape s'additionnent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלב התווית מכפיל את גודל הסוג הדינמי. זה אף פעם לא מחליף את הגדרת המערכת, אז גודל טקסט גדול יותר באייפון והשלב הזה מסתכמים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A címke lépése megszorozza a dinamikus típus méretét. Soha nem helyettesíti a rendszerbeállításokat, így a nagyobb iPhone szövegméret és ez a lépés összeadódik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il passaggio dell'etichetta moltiplica la dimensione del tipo dinamico. Non sostituisce mai l'impostazione di sistema, quindi una dimensione del testo dell'iPhone più grande e questo passaggio si sommano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ラベル ステップにより、ダイナミック タイプのサイズが増加します。システム設定が置き換えられることはないため、iPhone のテキスト サイズが大きくなり、この手順が追加されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De labelstap vermenigvuldigt de dynamische tekstgrootte. Het vervangt nooit de systeeminstelling, dus een grotere iPhone-tekstgrootte en deze stap tellen op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krok etykiety mnoży rozmiar typu dynamicznego. Nigdy nie zastępuje ustawień systemowych, więc większy rozmiar tekstu iPhone'a i ten krok się sumują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A etapa do rótulo multiplica o tamanho do Tipo Dinâmico. Ele nunca substitui a configuração do sistema, portanto, um tamanho de texto maior do iPhone e esta etapa se somam."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A etapa do rótulo multiplica o tamanho do Tipo Dinâmico. Ele nunca substitui a configuração do sistema, portanto, um tamanho de texto maior do iPhone e esta etapa se somam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasul de etichetă înmulțește dimensiunea tipului dinamic. Nu înlocuiește niciodată setarea sistemului, așa că o dimensiune mai mare a textului iPhone și acest pas se adună."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаг метки умножает размер динамического типа. Он никогда не заменяет системные настройки, поэтому больший размер текста iPhone и этот шаг суммируются."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korak oznake pomnoži velikost dinamične vrste. Nikoli ne nadomesti sistemske nastavitve, zato se večja velikost besedila iPhone in ta korak seštejeta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etikettsteget multiplicerar storleken Dynamic Type. Det ersätter aldrig systeminställningen, så en större iPhone-textstorlek och det här steget läggs ihop."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiket adımı Dinamik Tip boyutunu çarpar. Hiçbir zaman sistem ayarının yerini almaz, dolayısıyla daha büyük bir iPhone metin boyutu ve bu adım eklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крок мітки збільшує розмір динамічного типу. Він ніколи не замінює системні налаштування, тому більший розмір тексту iPhone і цей крок додають."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签步长会乘以动态类型大小。它永远不会替换系统设置，因此较大的 iPhone 文本大小和此步骤会累加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤步長會乘以動態型別大小。它永遠不會替換系統設置，因此較大的 iPhone 文字大小和此步驟會累積。"
          }
        }
      }
    },
    "settings_the_notices_file_is_missing_from" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملف الإشعارات مفقود من الحزمة. أعد تثبيت Vela أو أبلغ عن هذا الإصدار."
          }
        },
        "de" : {
