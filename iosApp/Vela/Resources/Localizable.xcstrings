          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous plaanib kahe otsa vahel. Peatused jäävad teiste režiimide jaoks salvestatuks."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
