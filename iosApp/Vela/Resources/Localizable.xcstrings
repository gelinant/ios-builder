        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek egy új Transitous keresésből származnak. A fenti utazás megtartja a saját időpontját, amíg nem választ egyet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi provengono da una nuova ricerca Transitous. Il viaggio qui sopra mantiene i suoi tempi finché non ne scegli uno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
