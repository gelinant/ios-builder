    "mapscreen_location_tip_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS allein kann in Innenräumen oft keine Position bestimmen. Aktivieren Sie unter GrapheneOS die Option „Standort über Netzwerk“ unter „Einstellungen“ > „Standort“ > „Standortdienste“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS alone often cannot get a fix indoors. On GrapheneOS, turn on Network location in Settings > Location > Location services."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spesso il GPS da solo non riesce a ottenere una posizione al chiuso. Su GrapheneOS, attiva la posizione tramite rete in Impostazioni > Posizione > Servizi di localizzazione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sam GPS często nie jest w stanie ustalić pozycji wewnątrz budynków. W systemie GrapheneOS włącz lokalizację sieciową w sekcji Ustawienia > Lokalizacja > Usługi lokalizacji."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas o GPS nem sempre consegue boa localozação em interiores. No GrapheneOS, ative a localização de rede em Definições > Localização > Serviços de localização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adesea, GPS-ul nu reușește să determine poziția în interior. Pe GrapheneOS, activează opțiunea „Localizare prin rețea” din Setări > Localizare > Servicii de localizare."
          }
        }
      }
    },
