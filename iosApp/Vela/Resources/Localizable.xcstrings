    "settings_route_trail_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet den bereits gefahrenen Teil der Route grau hinter dem Pfeil. Aus blendet ihn aus, sodass nur die Strecke voraus gezeichnet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the part of the route you have already driven drawn in gray behind the arrow. Off hides it, so only the road ahead is drawn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene dibujada en gris, detrás de la flecha, la parte de la ruta que ya has recorrido. Desactivado la oculta, así que solo se dibuja el camino por delante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde la partie de l'itinéraire déjà parcourue tracée en gris derrière la flèche. Désactivé la masque : seule la route à venir est tracée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משאיר את החלק מהמסלול שכבר נסעת משורטט באפור מאחורי החץ. כיבוי מסתיר אותו, כך שמשורטט רק הכביש שלפניך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szürkével kirajzolva hagyja az útvonal már megtett részét a nyíl mögött. Kikapcsolva elrejti, így csak az előtted lévő út látszik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene disegnata in grigio dietro la freccia la parte di percorso che hai già fatto. Disattivato la nasconde, così viene disegnata solo la strada davanti a te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに走ったルートの部分を、矢印の後ろにグレーで表示したままにします。オフにすると非表示になり、この先の道だけを描画します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt het deel van de route dat je al hebt gereden in grijs achter de pijl getekend. Uit verbergt het, zodat alleen de weg vooruit wordt getekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowuje przejechaną część trasy narysowaną na szaro za strzałką. Wył. ukrywa ją, więc rysowana jest tylko droga przed tobą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém a parte da rota que você já percorreu desenhada em cinza atrás da seta. Desativado a esconde, ficando apenas a rua à frente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém a parte da rota que já percorreu desenhada a cinzento atrás da seta. Desligado esconde-a, ficando apenas a estrada à frente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează în gri, în spatele săgeții, porțiunea de traseu pe care ai parcurs-o deja. Opțiunea „Oprit” o ascunde, astfel încât să fie afișat doar drumul din față."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставляет уже пройденную часть маршрута нарисованной серым позади стрелки. Выкл. скрывает её, и рисуется только дорога впереди."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behåller den del av rutten du redan kört ritad i grått bakom pilen. Av döljer den, så att bara vägen framåt ritas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залишає пройдену частину маршруту намальованою сірим позаду стрілки. Вимк. приховує її, тож малюється лише дорога попереду."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将已驶过的路线部分以灰色绘制在箭头后方。关闭后不再显示，只绘制前方的道路。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已經行駛過的路線會以灰色繪製在箭頭後方。關閉後會隱藏，只繪製前方的道路。"
          }
        }
      }
    },
