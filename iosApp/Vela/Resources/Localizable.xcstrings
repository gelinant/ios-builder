    "settings_offline_download_viewport_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichert die Karte, die du gerade siehst, mit ihren Straßen und Adressen, damit dieser Bereich auch ohne Empfang funktioniert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the map with a frame over it. Move and zoom until the frame covers the area you want, from a neighborhood to half a state; you'll see the size before anything downloads. Everything in the frame is saved at full street detail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda el mapa que estás viendo, con sus calles y direcciones, para que esta zona siga funcionando sin señal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre la carte affichée, avec ses routes et adresses, pour que cette zone continue de fonctionner sans réseau."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elmenti a teljes látott térképet, az utcáival, házszámaival és épületeivel, valamint az útvonalvezetést a körülötte lévő régióhoz. Itt minden jelzés nélkül is tovább működik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva la mappa che stai guardando, con strade e indirizzi, così questa zona continua a funzionare senza segnale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示中の地図を道路や住所ごと保存し、電波がなくてもこのエリアを使えるようにします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaart de kaart die je bekijkt, met wegen en adressen, zodat dit gebied zonder bereik blijft werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje mapę którą oglądasz wraz z drogami i adresami aby ten obszar działał bez zasięgu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva o mapa que você está vendo, com as ruas e endereços, para que esta área continue funcionando sem rede."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda o mapa que estás a ver, com as estradas e moradas, para que esta zona continue a funcionar sem rede."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deschide harta cu un cadru deasupra. Mută și mărește harta până când cadrul acoperă zona dorită, de la un cartier la jumătate de stat; vei vedea dimensiunea înainte de a descărca ceva. Tot ce se află în cadru este salvat cu detalii complete."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняет карту, которую вы видите, вместе с дорогами и адресами, чтобы эта область работала без связи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparar kartan du tittar på, med vägar och adresser, så att området fortsätter fungera utan täckning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігає карту, яку ви бачите, разом із дорогами та адресами, щоб ця область працювала без зв'язку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存您正在查看的地图及其道路和地址，没有信号时该区域也能正常使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存你正在查看的地圖，連同道路和地址，讓這個區域在沒有訊號時仍可使用。"
          }
        }
      }
    },
    "settings_offline_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Wege, Vela offline zu nutzen: Speichere den Bereich, in dem du bist, für kurze Wege, oder unten ein ganzes Bundesland oder Land für längere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saving the area around you is usually all you need: the full map, addresses and places nearby, plus routing. Whole states and countries are for long trips with no signal, and they are large."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos formas de usar Vela sin conexión: guarda la zona en la que estás para trayectos cortos, o un estado o país entero más abajo para los largos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavaliselt piisab sulle vaid oma ümbruse kaartide salvestamisest: täielik kaart, aadressid ja lähedal asuvad kohad ning marsruudi planeerimine. Kogu osariigi või riigi kaardid on mõeldud pikkadeks reisideks, kus puudub levi ja need on mahukad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux façons d'utiliser Vela hors ligne : enregistrez la zone où vous êtes pour les petits trajets, ou un état ou pays entier ci-dessous pour les longs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמירת הסביבה היא לרוב כל מה שצריכים: המפה המלאה, הכתובות והמקומות הקרובים, וגם המסלולים. מחוזות ומדינות שלמים נועדו למסעות ארוכים יותר מבלי קליטה, והם תופסים הרבה מקום."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kétféleképp mehetsz offline. Mentsd el a jelenlegi területedet a teljes térképhez itt, vagy egy egész államot/országot lent az útvonaltervezéshez és kereséshez a teljes területén."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due modi per usare Vela offline: salva l'area in cui ti trovi per i tragitti brevi, oppure un intero stato o paese qui sotto per quelli lunghi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela をオフラインで使う方法は 2 つあります。近場の移動には今いるエリアを、遠出には下から州や国全体を保存してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twee manieren om Vela offline te gebruiken: bewaar het gebied waar je bent voor korte ritten, of hieronder een hele staat of een heel land voor langere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwa sposoby na Velę offline: zapisz obszar w którym jesteś na krótkie trasy albo poniżej cały stan lub kraj na dłuższe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duas formas de usar o Vela off-line: salve a área onde você está para trajetos curtos, ou um estado ou país inteiro abaixo para os longos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duas formas de usar a Vela offline: guarda a zona onde estás para trajetos curtos, ou um estado ou país inteiro abaixo para os longos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De obicei, tot ce ai nevoie este să salvezi zona din jurul tău: harta completă, adresele și locurile din apropiere, plus rutarea. State și țări întregi sunt pentru călătorii lungi fără semnal și sunt mari."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два способа пользоваться Vela офлайн: сохраните область, где вы находитесь, для коротких поездок, или целый регион или страну ниже для дальних."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Två sätt att använda Vela offline: spara området där du är för korta resor, eller en hel delstat eller ett helt land nedan för längre."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два способи користуватися Vela офлайн: збережіть область, де ви є, для коротких поїздок, або цілий регіон чи країну нижче для дальших."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两种方式让 Vela 离线可用：保存您所在的区域应对短途出行，或在下方下载整个州或国家用于长途出行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓 Vela 離線可用有兩種方式：儲存你所在的區域方便短程使用，或在下方下載整個州或國家以備長途旅行。"
          }
        }
      }
    },
