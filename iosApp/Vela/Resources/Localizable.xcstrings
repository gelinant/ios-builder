    "settings_turn_declutter_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während die Karte durch eine Abbiegung schwenkt, bleiben nur Straßennamen sichtbar. Orte, Schilder und Kameras kehren zurück, sobald sie zur Ruhe kommt. Hält Abbiegungen auf langsameren Telefonen flüssig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the map swings through a turn, only street names stay on it. Places, signs and cameras come back as soon as it settles. Keeps turns smooth on slower phones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras el mapa gira en una curva, solo quedan los nombres de las calles. Los lugares, las señales y las cámaras vuelven en cuanto se estabiliza. Mantiene los giros fluidos en teléfonos más lentos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant que la carte pivote dans un virage, seuls les noms de rues restent affichés. Les lieux, les panneaux et les caméras reviennent dès qu'elle se stabilise. Garde les virages fluides sur les téléphones plus lents."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בזמן שהמפה מסתובבת בפנייה, נשארים עליה רק שמות הרחובות. מקומות, שלטים ומצלמות חוזרים ברגע שהיא מתייצבת. שומר על פניות חלקות בטלפונים איטיים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amíg a térkép elfordul egy kanyarban, csak az utcanevek maradnak rajta. A helyek, táblák és kamerák visszatérnek, amint megnyugszik. Lassabb telefonokon is simán tartja a kanyarokat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre la mappa ruota in una svolta restano visibili solo i nomi delle strade. Luoghi, segnali e telecamere tornano appena si stabilizza. Mantiene fluide le svolte sui telefoni più lenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲がり角で地図が回転している間は、道路名だけを表示します。回転が落ち着くと、場所、標識、カメラがすぐに戻ります。処理の遅い端末でも曲がり角の動きが滑らかになります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terwijl de kaart door een bocht draait, blijven alleen straatnamen zichtbaar. Plaatsen, borden en camera's komen terug zodra de kaart tot rust komt. Houdt bochten vloeiend op tragere telefoons."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy mapa obraca się na zakręcie zostają na niej tylko nazwy ulic. Miejsca, znaki i kamery wracają, gdy tylko się ustabilizuje. Dzięki temu zakręty są płynne na wolniejszych telefonach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto o mapa gira em uma curva, só os nomes das ruas ficam nele. Locais, placas e câmeras voltam assim que ele se estabiliza. Mantém as curvas suaves em celulares mais lentos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto o mapa roda numa curva, só ficam os nomes das ruas. Os locais, os sinais e as câmaras voltam assim que ele estabiliza. Mantém as curvas fluidas em telemóveis mais lentos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În timp ce harta se reîmprospătează la viraje, pe ea rămân doar numele străzilor. Locurile, indicatoarele și camerele de supraveghere reapar imediat ce harta se stabilizează. Virajele rămân fluide chiar și pe telefoanele cu performanțe reduse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока карта разворачивается на повороте, на ней остаются только названия улиц. Места, знаки и камеры возвращаются, как только она успокоится. Повороты остаются плавными на медленных телефонах."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medan kartan vrider sig genom en sväng ligger bara gatunamnen kvar. Platser, skyltar och kameror kommer tillbaka så fort den stannat upp. Håller svängarna mjuka på långsammare telefoner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки карта обертається на повороті, на ній лишаються тільки назви вулиць. Місця, знаки й камери повертаються, щойно вона заспокоїться. Так повороти лишаються плавними на повільніших телефонах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地图随转弯转动时，只保留街道名称。地图稳定后，地点、标志和摄像头会立即恢复显示。可让较慢的手机在转弯时保持流畅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地圖在轉彎中旋轉時，只保留街道名稱。地圖一穩定下來，地點、標誌和攝影機就會重新顯示。可讓較慢的手機轉彎時保持流暢。"
          }
