    "settings_photos_on_tap_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ort zeigt eine Schaltfläche Fotos anzeigen, statt die Fotos zu laden. Spart eine Google-Anfrage pro Ort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A place shows a Show photos button instead of loading its photos. Saves a Google request per place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lugar muestra un botón Mostrar fotos en vez de cargarlas. Ahorra una petición a Google por lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lieu affiche un bouton Afficher les photos au lieu de les charger. Économise une requête Google par lieu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "במקום טעינת התמונות יוצג כפתור הצגת תמונות. חוסך בקשה אחת לגוגל לכל מקום."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A helyoldalon egy Fotók megjelenítése gomb jelenik meg a betöltés helyett. Helyenként egy Google-kérést takarít meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un luogo mostra un pulsante Mostra foto invece di caricarle. Risparmia una richiesta a Google per luogo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を読み込む代わりに「写真を表示」ボタンを出します。場所ごとにGoogleへのリクエストが1回減ります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een plaats toont een knop Foto's tonen in plaats van de foto's te laden. Scheelt één Google-verzoek per plaats."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsce pokazuje przycisk Pokaż zdjęcia zamiast je wczytywać. Oszczędza jedno zapytanie do Google na miejsce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O local mostra um botão Mostrar fotos em vez de carregá-las. Economiza uma solicitação ao Google por local."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O local mostra um botão Mostrar fotos em vez de carregá-las. Economiza um pedido ao Google por local."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru o anumită locație, se afișează butonul „Afișează fotografiile” în loc să se încarce fotografiile respective. Se economisește o solicitare către Google pentru fiecare locație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вместо загрузки фото на странице места появится кнопка Показать фото. Экономит один запрос к Google на место."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En plats visar knappen Visa foton i stället för att läsa in fotona. Sparar en Google-förfrågan per plats."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замість завантаження фото на сторінці місця з'явиться кнопка Показати фото. Заощаджує один запит до Google на місце."
