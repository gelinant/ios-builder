    "settings_voice_test_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen Sie auf „Stimme testen“, um sie zu hören. Die Vela-Stimme wird empfohlen; Sie können jede installierte Text-zu-Sprache-Engine verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Test voice to hear it. The Vela Voice is recommended; you can override to any installed text-to-speech engine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Probar voz para escucharla. Se recomienda la voz de Vela; puedes usar en su lugar cualquier motor de texto a voz instalado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur Tester la voix pour l'écouter. La voix Vela est recommandée ; vous pouvez la remplacer par n'importe quel moteur de synthèse vocale installé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקש \"בדיקת קול\" כדי לשמוע. Vela Voice מומלץ; אפשר לעבור לכל מנוע טקסט-לדיבור מותקן."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppints a Hang tesztelésére, hogy halld. A Vela Hang ajánlott; bármelyik telepített szövegfelolvasó motorra átválthatsz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Prova voce per ascoltarla. Si consiglia la voce Vela; puoi impostare qualsiasi motore di sintesi vocale installato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「音声をテスト」をタップすると試聴できます。Vela 音声がおすすめですが、インストール済みの任意のテキスト読み上げエンジンに変更することもできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op Stem testen om te luisteren. De stem van Vela wordt aanbevolen; u kunt overschakelen naar elke geïnstalleerde tekst-naar-spraak-engine."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij Przetestuj głos aby go usłyszeć. Zalecany jest głos Vela; możesz go zastąpić dowolnym zainstalowanym silnikiem syntezy mowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Testar voz para ouvi-la. A voz Vela é recomendada; você pode optar por qualquer mecanismo de texto para voz instalado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Testar voz para a ouvir. Recomenda-se a voz Vela; pode optar por qualquer motor de texto para voz instalado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atinge Testează vocea pentru a o auzi. Se recomandă Vela Voice; poți înlocui cu orice motor de text-în-vorbire instalat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Проверить голос», чтобы прослушать. Рекомендуется голос Vela; можно выбрать любой установленный движок синтеза речи."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotaknite se »Preizkusi glas«, da ga slišite. Priporočamo Vela Voice, izberete pa lahko kateri koli nameščeni mehanizem za pretvorbo besedila v govor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på Testa rösten för att höra den. Vela-rösten rekommenderas; du kan byta till valfri installerad text-till-tal-motor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses örneğini dinlemek için “Sesi test et” seçeneğine dokunun. Vela Voice önerilir; ancak bunu, yüklü olan herhangi bir metin-konuşma motoruyla değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть «Перевірити голос», щоб почути його. Рекомендовано голос Vela; ви можете вибрати будь-який встановлений рушій синтезу мовлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按“试听语音”即可试听。推荐使用 Vela 语音；您也可以改用任何已安装的文字转语音引擎。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按「測試語音」即可試聽。建議使用 Vela 語音；你也可以改用任何已安裝的文字轉語音引擎。"
          }
        }
      }
    },
