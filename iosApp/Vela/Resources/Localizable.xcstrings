    "settings_a_link_from_another_app_still" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال الرابط من تطبيق آخر مفتوحًا في مكانه الخاص. ينتقل موقع حيث أكون إلى موقعك عندما يكون متاحًا؛ يتم فتح منظر المدينة عند التكبير/التصغير الافتراضي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Link von einer anderen App wird weiterhin an seiner eigenen Stelle geöffnet. Wo ich bin, wechselt zu Ihrer Position, sobald eine verfügbar ist; Eine Stadtansicht wird mit dem Standardzoom geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A link from another app still opens on its own place. Where I am moves onto your position when one is available; a city view opens at the default zoom."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A link from another app still opens on its own place. Where I am moves onto your position when one is available; a city view opens at the default zoom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un enlace de otra aplicación todavía se abre en su propio lugar. Donde estoy pasa a tu posición cuando hay una disponible; Se abre una vista de la ciudad con el zoom predeterminado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teise rakenduse link avaneb ikka omal kohal. Kus ma olen, liigub teie positsioonile, kui see on saadaval; vaikesuumiga avaneb linnavaade."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lien provenant d'une autre application s'ouvre toujours à sa propre place. Où je suis passe à votre poste lorsqu'il y en a un disponible ; une vue de la ville s'ouvre avec le zoom par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קישור מאפליקציה אחרת עדיין נפתח במקום משלו. איפה אני עובר לעמדה שלך כאשר אחד זמין; תצוגת עיר נפתחת בזום ברירת המחדל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy másik alkalmazásból származó hivatkozás továbbra is megnyílik a saját helyén. Ahol én vagyok, az Ön pozíciójába kerül, amikor elérhető; városnézet nyílik meg az alapértelmezett nagyítással."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un collegamento da un'altra app si apre ancora al suo posto. Il punto in cui mi trovo si sposta nella tua posizione quando ce n'è una disponibile; si apre una vista della città con lo zoom predefinito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のアプリからのリンクは依然として独自の場所で開きます。私がいる場所は、空席があるときにあなたの場所に移動します。市街ビューがデフォルトのズームで開きます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een link van een andere app wordt nog steeds op een eigen plek geopend. Waar ik ben, verhuist naar jouw positie zodra er een beschikbaar is; een stadsweergave wordt geopend met de standaardzoom."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link z innej aplikacji nadal otwiera się w swoim własnym miejscu. Opcja „Gdzie jestem” przenosi się na twoją pozycję, gdy jest ona dostępna; widok miasta otwiera się przy domyślnym powiększeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um link de outro aplicativo ainda abre em seu próprio local. Onde estou passa para sua posição quando uma estiver disponível; uma visualização da cidade é aberta com o zoom padrão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um link de outro aplicativo ainda abre em seu próprio local. Onde estou passa para sua posição quando uma estiver disponível; uma visualização da cidade é aberta com o zoom padrão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un link de la o altă aplicație se deschide în continuare pe propriul loc. Unde mă aflu trece pe poziția dvs. atunci când este disponibil; se deschide o vizualizare a orașului la zoom-ul implicit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ссылка из другого приложения по-прежнему открывается на своем месте. «Там, где я нахожусь», переходит на вашу позицию, когда она доступна; вид на город открывается с масштабом по умолчанию."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povezava iz druge aplikacije se še vedno odpre na svojem mestu. Kje sem, se premakne na vaš položaj, ko je na voljo; pogled mesta se odpre s privzeto povečavo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En länk från en annan app öppnas fortfarande på sin egen plats. Where I am flyttar till din position när en är tillgänglig; en stadsvy öppnas med standardzoom."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir uygulamanın bağlantısı hâlâ kendi yerinde açılıyor. Bulunduğum yer uygun olduğunda sizin konumunuza geçer; varsayılan yakınlaştırmada bir şehir görünümü açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посилання з іншої програми все одно відкривається на своєму місці. Де я переміщується на вашу позицію, коли вона доступна; вікно міста відкривається зі стандартним масштабуванням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自另一个应用程序的链接仍会在自己的位置打开。当有人有空时，我所在的位置就会转移到你的位置；城市视图以默认缩放打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來自另一個應用程式的連結仍會在自己的位置打開。當有人有空時，我所在的位置就會轉移到你的位置；城市視圖以預設縮放打開。"
          }
        }
      }
    },
