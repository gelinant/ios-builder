    "settings_light_dark_or_the_system_setting" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الضوء أو الظلام أو إعداد النظام. يؤدي هذا إلى تغيير تطبيق Chrome فقط؛ تحتفظ الخريطة باختيارها الخاص أدناه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hell, dunkel oder die Systemeinstellung. Dadurch ändert sich nur das App-Chrome; Die Karte behält unten ihre eigene Auswahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light, dark or the system setting. This changes the app chrome only; the map keeps its own choice below."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light, dark or the system setting. This changes the app chrome only; the map keeps its own choice below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claro, oscuro o la configuración del sistema. Esto cambia la aplicación Chrome únicamente; el mapa mantiene su propia elección a continuación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hele, tume või süsteemi seadistus. See muudab ainult rakenduse Chrome'i; kaart jätab oma valiku allpool."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clair, sombre ou réglage du système. Cela modifie uniquement le chrome de l'application ; la carte garde son propre choix ci-dessous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אור, כהה או הגדרת המערכת. זה משנה את האפליקציה כרום בלבד; המפה שומרת את הבחירה שלה למטה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Világos, sötét vagy a rendszerbeállítás. Ez csak az alkalmazás Chrome-ot módosítja; a térkép megtartja a saját választását alább."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiaro, scuro o l'impostazione del sistema. Ciò modifica solo l'app Chrome; la mappa mantiene la propria scelta qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明るい、暗い、またはシステム設定。これにより変更されるのはアプリのクロムのみです。マップは以下に独自の選択を保持します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licht, donker of de systeeminstelling. Dit verandert alleen het chroom van de app; de kaart behoudt hieronder zijn eigen keuze."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasne, ciemne lub ustawienie systemowe. Spowoduje to zmianę tylko wyglądu aplikacji; mapa zachowuje swój własny wybór poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claro, escuro ou a configuração do sistema. Isso altera apenas o aplicativo Chrome; o mapa mantém sua própria escolha abaixo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claro, escuro ou a configuração do sistema. Isso altera apenas o aplicativo Chrome; o mapa mantém sua própria escolha abaixo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumină, întuneric sau setarea sistemului. Acest lucru schimbă doar aplicația Chrome; harta își păstrează propria alegere mai jos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Светлый, темный или настройки системы. Это изменяет только Chrome приложения; карта сохраняет свой выбор ниже."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svetlo, temno ali sistemska nastavitev. To spremeni samo aplikacijo chrome; zemljevid ohranja lastno izbiro spodaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljus, mörk eller systeminställningen. Detta ändrar endast appen chrome; kartan behåller sitt eget val nedan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık, koyu veya sistem ayarı. Bu yalnızca uygulama kromunu değiştirir; harita kendi seçimini aşağıda tutuyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Світло, темно або налаштування системи. Це змінює лише додаток chrome; карта зберігає власний вибір нижче."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浅色、深色或系统设置。这仅更改应用程序镶边；地图在下面保留了自己的选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "淺色、深色或系統設定。這僅更改應用程式鑲邊；地圖在下面保留了自己的選擇。"
          }
        }
      }
    },
