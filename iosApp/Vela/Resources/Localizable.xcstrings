    "settings_trip_consent_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela zeichnet die GPS-Spur jeder Navigation auf diesem Telefon auf, sodass eine Fahrt zum Testen wiedergegeben werden kann, ohne sie erneut zu fahren. Das ist aufschlussreicher als die Diagnose, es erfasst Ihre genauen Routen, bleibt aber auf dem Telefon und wird nie hochgeladen. Jederzeit deaktivierbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela will record the GPS trace of each navigation on this phone, so a drive can be replayed for testing without driving it again. This is more revealing than diagnostics (it captures your exact routes) but it stays on the phone and is never uploaded. Turn it off any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela grabará el rastro GPS de cada navegación en este teléfono, para que un trayecto pueda reproducirse en pruebas sin volver a conducirlo. Esto revela más que el diagnóstico (captura tus rutas exactas), pero permanece en el teléfono y nunca se sube. Puedes desactivarlo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela enregistrera la trace GPS de chaque navigation sur ce téléphone, afin qu'un trajet puisse être rejoué pour des tests sans le refaire. C'est plus révélateur que les diagnostics, cela capture vos itinéraires exacts, mais cela reste sur le téléphone et n'est jamais envoyé. Vous pouvez le désactiver à tout moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela תקליט את מסלול ה-GPS של כל ניווט בטלפון הזה, כך שאפשר לשדר נסיעה מחדש לבדיקה בלי לנסוע אותה שוב. זה חושפני יותר מאבחון (הוא לוכד את המסלולים המדויקים שלך) אך זה נשאר בטלפון ולעולם לא מועלה. כבה בכל עת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vela minden navigáció GPS-nyomvonalát rögzíti ezen a telefonon, hogy egy út visszajátszható legyen teszteléshez, anélkül hogy újra le kellene vezetni. Ez érzékenyebb, mint a diagnosztika (rögzíti a pontos útvonalaidat), de a telefonon marad és soha nem kerül feltöltésre. Bármikor kikapcsolhatod."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela registrerà la traccia GPS di ogni navigazione su questo telefono, così un tragitto può essere riprodotto per i test senza rifarlo. È più rivelatore della diagnostica (cattura i tuoi percorsi esatti) ma resta sul telefono e non viene mai caricato. Puoi disattivarlo in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela はナビのたびに GPS 軌跡をこの端末に記録します。走り直さなくても、テスト用に走行をリプレイできるようになります。診断データより踏み込んだ記録（実際のルートそのもの）ですが、端末内にとどまり、アップロードされることはありません。いつでもオフにできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela legt het GPS-spoor van elke navigatie op deze telefoon vast, zodat een rit kan worden herhaald om te testen zonder opnieuw te rijden. Dit is onthullender dan diagnostiek, het legt uw exacte routes vast, maar het blijft op de telefoon en wordt nooit geüpload. U kunt het op elk moment uitschakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela będzie zapisywać ślad GPS każdej nawigacji na tym telefonie, aby przejazd można było odtworzyć do testów bez ponownej jazdy. Jest to bardziej ujawniające niż diagnostyka, rejestruje Twoje dokładne trasy, ale pozostaje na telefonie i nigdy nie jest przesyłane. Możesz to wyłączyć w dowolnej chwili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela vai gravar o traço de GPS de cada navegação neste celular, para que uma viagem possa ser reproduzida para testes sem percorrê-la novamente. Isto é mais revelador do que o diagnóstico, pois captura seus percursos exatos, mas permanece no celular e nunca é enviado. Desative quando quiser."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela vai gravar o traço GPS de cada navegação neste telemóvel, para que uma viagem possa ser reproduzida para testes sem a percorrer novamente. Isto é mais revelador do que o diagnóstico, captura os seus percursos exatos, mas permanece no telemóvel e nunca é carregado. Desligue quando quiser."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela va înregistra traseul GPS al fiecărei deplasări pe acest telefon, astfel încât un traseu să poată fi redat în scopuri de testare, fără a mai fi necesar să îl parcurgi din nou. Această funcție oferă informații mai detaliate decât diagnosticarea (înregistrează traseele exacte), iar datele rămân pe telefon și nu sunt încărcate niciodată. O poți dezactiva oricând."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela будет записывать GPS-трек каждой навигации на этом телефоне, чтобы поездку можно было воспроизвести для проверки без повторной поездки. Это раскрывает больше, чем диагностика, записываются ваши точные маршруты, но всё остаётся на телефоне и никогда не выгружается. Выключить можно в любой момент."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela spelar in GPS-spåret för varje navigering på den här telefonen, så att en körning kan spelas upp för testning utan att köra den igen. Detta avslöjar mer än diagnostik, det fångar dina exakta rutter, men det stannar på telefonen och laddas aldrig upp. Slå av det när som helst."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela записуватиме GPS-трек кожної навігації на цьому телефоні, щоб поїздку можна було відтворити для перевірки, не проїжджаючи її знову. Це розкриває більше, ніж діагностика, фіксуються ваші точні маршрути, але все залишається на телефоні й ніколи не завантажується. Вимкнути можна будь-коли."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 将在本机记录每次导航的 GPS 轨迹，这样无需再跑一趟即可回放行程用于测试。它比诊断信息更敏感（会记录您的确切路线），但只保存在手机上，绝不上传。可随时关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 會在這支手機上記錄每次導航的 GPS 軌跡，讓行程可以重播測試，不必再開一次。這比診斷資料更敏感（會記下你的確切路線），但資料只留在手機上，絕不會上傳。你隨時可以關閉。"
          }
        }
      }
    },
