    "settings_downloaded_none" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts heruntergeladen. Speichern Sie oben den angezeigten Bereich oder wählen Sie unten ein Bundesland oder Land."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing downloaded yet. Save the area you are looking at above, or pick a state or country below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay nada descargado. Guarda arriba la zona que estás viendo o elige un estado o país abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien de téléchargé pour l'instant. Enregistrez la zone affichée ci-dessus, ou choisissez un état ou un pays ci-dessous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיין לא הורדת כלום. אפשר לשמור למעלה את האזור שרואים על המסך, או לבחור מחוזות ומדינות אחרים למטה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincs letöltve semmi. Mentsd el fent a megtekintett területet, vagy válassz lent egy államot vagy országot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nulla di scaricato. Salva l'area che stai guardando qui sopra, oppure scegli uno stato o un paese qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ何もダウンロードしていません。上で表示中のエリアを保存するか、下から州や国を選んでください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niets gedownload. Bewaar hierboven het gebied dat je bekijkt, of kies hieronder een staat of land."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic jeszcze nie pobrano. Zapisz powyżej oglądany obszar albo wybierz poniżej stan lub kraj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda nada baixado. Salve acima a área que você está vendo, ou escolha um estado ou país abaixo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda nada transferido. Guarde acima a área que está a ver, ou escolha um estado ou país abaixo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimic descărcat încă. Salvează zona pe care o vizualizezi mai sus sau alege un stat sau o țară mai jos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока ничего не загружено. Сохраните видимую область выше или выберите регион или страну ниже."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nič še ni preneseno. Shranite trenutno območje ali spodaj izberite državo oziroma regijo."
