    "settings_data_privacy_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela spricht Googles öffentliche Endpunkte direkt von diesem Gerät an: kein Backend, kein Konto, kein API-Schlüssel. Google sieht IP, Anfrage und Kartenausschnitt, nicht wer du bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela talks to Google's public endpoints straight from this device: no backend, no account, no API key. Google sees your IP, query and map area, not who you are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela habla con los endpoints públicos de Google directamente desde este dispositivo: sin backend, sin cuenta, sin clave de API. Google ve tu IP, la búsqueda y la zona del mapa, no quién eres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela interroge les points publics de Google directement depuis cet appareil : pas de serveur, pas de compte, pas de clé d'API. Google voit votre IP, la requête et la zone de carte, pas qui vous êtes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היישום Vela יוצר קשר עם נקודות הקצה הציבוריות של Google ישירות מהמכשיר הזה: בלי שרת, בלי חשבון, בלי מפתח API. ל־Google יש גישה לכתובת ה־IP, לשאילתה ולאזור המפה המוצג, אך לא לזהותך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vela közvetlenül erről az eszközről beszél a Google nyilvános végpontjaival: nincs háttérrendszer, nincs fiók, nincs API-kulcs. A Google látja az IP-címedet, a keresésedet és a térképterületet, de nem tudja, ki vagy."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela parla con gli endpoint pubblici di Google direttamente da questo dispositivo: niente backend, niente account, niente chiave API. Google vede IP, ricerca e area della mappa, non chi sei."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela はこの端末から直接 Google の公開エンドポイントと通信します。バックエンドなし、アカウント不要、API キーも不要です。Google に見えるのは IP アドレス、検索内容、地図の表示範囲だけで、あなたが誰かは分かりません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela praat rechtstreeks vanaf dit apparaat met Googles publieke endpoints: geen backend, geen account, geen API-sleutel. Google ziet je IP, zoekopdracht en kaartgebied, niet wie je bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela łączy się z publicznymi punktami Google prosto z tego urządzenia: bez backendu, konta i klucza API. Google widzi IP, zapytanie i obszar mapy, nie to kim jesteś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela fala com os endpoints públicos do Google diretamente deste aparelho: sem backend, sem conta, sem chave de API. O Google vê seu IP, a pesquisa e a área do mapa, não quem você é."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vela fala com os endpoints públicos do Google diretamente deste aparelho: sem backend, sem conta, sem chave de API. O Google vê o teu IP, a pesquisa e a área do mapa, não quem és."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela comunică cu endpoint-urile publice ale Google direct de pe acest dispozitiv: fără backend, fără cont, fără cheie API. Google îți vede adresa IP, interogarea și zona de pe hartă, nu cine ești."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela обращается к публичным точкам Google прямо с этого устройства: без сервера, аккаунта и ключа API. Google видит IP, запрос и область карты, но не вас."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela pratar med Googles publika endpoints direkt från den här enheten: ingen backend, inget konto, ingen API-nyckel. Google ser din IP, sökning och kartområde, inte vem du är."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela звертається до публічних точок Google просто з цього пристрою: без бекенда, акаунта і ключа API. Google бачить IP, запит і область карти, але не вас."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 直接从本设备访问 Google 的公开接口：无后端、无账号、无 API 密钥。Google 能看到您的 IP、搜索词和地图区域，但不知道您是谁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 直接從這部裝置存取 Google 的公開端點：沒有後端伺服器、不需帳戶、沒有 API 金鑰。Google 只會看到你的 IP、查詢內容和地圖範圍，不會知道你是誰。"
          }
        }
      }
    },
