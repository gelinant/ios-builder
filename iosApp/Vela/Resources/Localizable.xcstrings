    "saved_preview_only_no_stored_eta_live" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معاينة فقط. لا يوجد وقت وصول مقدر مخزن أو حركة مرور حية أو خطوات انعطاف. اختر طريقًا محسوبًا للبدء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Vorschau. Keine gespeicherte voraussichtliche Ankunftszeit, Live-Verkehr oder Abbiegeschritte. Wählen Sie zum Starten eine berechnete Route."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preview only. No stored ETA, live traffic or turn steps. Choose a computed route to start."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preview only. No stored ETA, live traffic or turn steps. Choose a computed route to start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo vista previa. No hay ETA almacenado, tráfico en vivo ni pasos de giro. Elija una ruta calculada para comenzar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainult eelvaade. Pole salvestatud ETA, reaalajas liiklust ega pöördesamme. Valige alustamiseks arvutatud marsruut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu uniquement. Pas d'ETA stocké, de trafic en direct ou de pas de virage. Choisissez un itinéraire calculé pour commencer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תצוגה מקדימה בלבד. אין זמן הגעה מאוחסן, תנועה חיה או שלבי פנייה. בחר מסלול מחושב כדי להתחיל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak előnézet. Nincs tárolt várható várható érkezési idő, élő forgalom vagy kanyarodási lépések. Az induláshoz válasszon egy kiszámított útvonalat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo anteprima. Nessun ETA memorizzato, traffico in tempo reale o indicazioni di svolta. Scegli un percorso calcolato per iniziare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビューのみ。保存された到着予定時刻、現在の交通状況、または方向転換ステップはありません。計算されたルートを選択して開始します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen voorbeeld. Geen opgeslagen verwachte aankomsttijd, live verkeer of afslagstappen. Kies een berekende route om te starten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko podgląd. Brak zapisanego ETA, ruchu na żywo i kroków do skrętu. Aby rozpocząć, wybierz obliczoną trasę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas visualização. Nenhum ETA armazenado, tráfego ao vivo ou etapas de conversão. Escolha uma rota calculada para começar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas visualização. Nenhum ETA armazenado, tráfego ao vivo ou etapas de conversão. Escolha uma rota calculada para começar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doar previzualizare. Fără ETA memorată, trafic live sau pași de viraj. Alegeți o rută calculată pentru a începe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только предварительный просмотр. Нет сохраненного расчетного времени прибытия, трафика в реальном времени или шагов поворота. Выберите рассчитанный маршрут для начала."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo predogled. Ni shranjenega predvidenega časa prihoda, prometa v živo ali korakov za obračanje. Za začetek izberite izračunano pot."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast förhandsgranskning. Ingen lagrad ETA, livetrafik eller svängsteg. Välj en beräknad rutt att starta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca önizleme. Kayıtlı ETA, canlı trafik veya dönüş adımları yok. Başlamak için hesaplanmış bir rota seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тільки попередній перегляд. Немає збережених даних про прибуття, поточний трафік або кроки повороту. Виберіть розрахований маршрут для початку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅预览。没有存储的预计到达时间、实时路况或转弯步数。选择计算出的路线开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅預覽。沒有儲存的預計到達時間、即時路況或轉彎步數。選擇計算出的路線開始。"
          }
        }
      }
    },
