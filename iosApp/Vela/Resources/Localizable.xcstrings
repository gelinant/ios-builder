    "settings_texture_render_auto_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf %1$@ automatisch eingeschaltet, nachdem die Karte zweimal beim Start abgestürzt ist. Wenn die Karte auch ohne diese Option funktioniert, lassen Sie sie aus: Sie ist langsamer und kann die Karte während der Fahrt stocken lassen. Wirkt erst nach einem Neustart der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turned on automatically on %1$@ after the map crashed at startup twice. If the map works with this off, leave it off: it is slower and can make the map stutter while driving. Needs an app restart to apply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se activó automáticamente en %1$@ después de que el mapa provocara dos cierres al iniciar. Si el mapa funciona con esto desactivado, déjalo desactivado: es más lento y puede hacer que el mapa dé tirones al conducir. Requiere reiniciar la app para aplicarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé automatiquement sur %1$@ après deux plantages de la carte au démarrage. Si la carte fonctionne sans, laissez-le désactivé : c'est plus lent et la carte peut saccader en conduisant. Nécessite un redémarrage de l'application."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הופעל אוטומטית ב-%1$@ אחרי שהמפה קרסה פעמיים בהפעלה. אם המפה עובדת כשזה כבוי, השאר את זה כבוי: זה איטי יותר ויכול לגרום למפה לגמגם בזמן נהיגה. דורש הפעלה מחדש של האפליקציה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatikusan bekapcsolt ezen: %1$@, miután a térkép kétszer összeomlott induláskor. Ha a térkép kikapcsolva is működik, hagyd kikapcsolva: lassabb, és vezetés közben szaggathatja a térképet. Az alkalmazás újraindítása szükséges hozzá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivato automaticamente su %1$@ dopo che la mappa ha fatto chiudere l'app all'avvio due volte. Se la mappa funziona con questa opzione disattiva, lasciala disattiva: è più lenta e può far scattare la mappa durante la guida. Per applicarla serve riavviare l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動時に地図が 2 回クラッシュしたため、%1$@ では自動的にオンになりました。オフでも地図が正常に動くなら、オフのままにしてください。オンでは動作が遅くなり、運転中に地図がカクつくことがあります。適用にはアプリの再起動が必要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch ingeschakeld op %1$@ nadat de kaart bij het starten twee keer crashte. Werkt de kaart ook zonder, laat het dan uit: het is trager en kan de kaart tijdens het rijden laten haperen. Vereist een herstart van de app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączone automatycznie na %1$@ po dwóch awariach mapy przy starcie. Jeśli mapa działa z tą opcją wyłączoną, zostaw ją wyłączoną: jest wolniejsza i może powodować zacinanie mapy podczas jazdy. Wymaga ponownego uruchomienia aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativado automaticamente no %1$@ depois de o mapa ter feito o app fechar duas vezes na inicialização. Se o mapa funcionar com isto desativado, deixe desativado: é mais lento e pode fazer o mapa engasgar durante a condução. É preciso reiniciar o app para aplicar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligado automaticamente no %1$@ depois de o mapa ter feito a app fechar duas vezes no arranque. Se o mapa funcionar com isto desligado, deixe-o desligado: é mais lento e pode fazer o mapa engasgar durante a condução. É preciso reiniciar a app para aplicar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activat automat pe %1$@ după ce harta s-a blocat de două ori la pornire. Dacă harta funcționează cu această opțiune dezactivată, las-o dezactivată: este mai lentă și poate face ca harta să se tremure în timpul conducerii. Necesită o repornire a aplicației pentru a se aplica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включено автоматически на %1$@ после того, как карта дважды уронила приложение при запуске. Если карта работает и без этого, оставьте выключенным: так медленнее и карта может дёргаться за рулём. Нужен перезапуск приложения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slogs på automatiskt på %1$@ efter att kartan kraschat vid start två gånger. Om kartan fungerar med detta av, låt det vara av: det är långsammare och kan göra kartan ryckig under körning. Kräver omstart av appen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкнено автоматично на %1$@ після того, як карта двічі спричинила збій під час запуску. Якщо карта працює без нього, залиште вимкненим: він повільніший і може призводити до ривків карти за кермом. Щоб застосувати, потрібно перезапустити застосунок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因地图在启动时连续两次崩溃，已在 %1$@ 上自动开启。若关闭后地图正常，请保持关闭：它速度更慢，可能导致驾驶中地图卡顿。需重启应用才能生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %1$@ 上，因為地圖啟動時連續當機兩次而自動開啟。如果關閉後地圖仍正常，請保持關閉：這個模式較慢，行車中地圖可能卡頓。需重新啟動應用程式才會生效。"
          }
        }
      }
    },
    "settings_texture_render_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet die Karte über einen Kompatibilitätspfad, der Grafiktreiber-Fehler mancher Geräte umgeht. Schaltet sich selbst ein, wenn die Karte die App beim Start zum Absturz gebracht hat. Etwas langsamer; wirkt erst nach einem Neustart der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draws the map through a compatibility path that avoids some devices' graphics driver bugs. Turns itself on if the map crashed the app at startup. Slightly slower; needs an app restart to apply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja el mapa por una vía de compatibilidad que evita los fallos del controlador gráfico de algunos dispositivos. Se activa solo si el mapa provocó un cierre de la app al iniciarla. Es algo más lento y requiere reiniciar la app para aplicarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessine la carte par un chemin de compatibilité qui contourne les bugs de pilote graphique de certains appareils. S'active tout seul si la carte a fait planter l'application au démarrage. Légèrement plus lent ; nécessite un redémarrage de l'application."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משרטט את המפה דרך מסלול תאימות שעוקף באגים במנהלי ההתקן הגרפיים של חלק מהמכשירים. נדלק מעצמו אם המפה הקריסה את האפליקציה בהפעלה. מעט איטי יותר; דורש הפעלה מחדש של האפליקציה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A térképet egy kompatibilitási úton rajzolja ki, ami elkerül bizonyos eszközök grafikai driver-hibáit. Magától bekapcsol, ha a térkép induláskor összeomlasztotta az appot. Kicsit lassabb; az alkalmazás újraindítása szükséges hozzá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna la mappa attraverso un percorso di compatibilità che aggira i bug dei driver grafici di alcuni dispositivi. Si attiva da solo se la mappa ha fatto chiudere l'app all'avvio. Un po' più lento; per applicarlo serve riavviare l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部の端末のグラフィックドライバの不具合を避ける互換経路で地図を描画します。起動時に地図が原因でアプリが落ちた場合は自動的にオンになります。動作はやや遅くなり、適用にはアプリの再起動が必要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekent de kaart via een compatibiliteitspad dat de bugs in de grafische driver van sommige toestellen omzeilt. Gaat vanzelf aan als de kaart de app bij het starten liet crashen. Iets trager; vereist een herstart van de app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rysuje mapę ścieżką zgodności która omija błędy sterowników graficznych niektórych urządzeń. Włącza się samo jeśli mapa wywołała awarię aplikacji przy starcie. Nieco wolniejsze; wymaga ponownego uruchomienia aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenha o mapa por um caminho de compatibilidade que evita erros do driver gráfico de alguns dispositivos. Ativa-se sozinho se o mapa fez o app fechar na inicialização. Um pouco mais lento; é preciso reiniciar o app para aplicar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenha o mapa por um caminho de compatibilidade que evita erros do controlador gráfico de alguns dispositivos. Liga-se sozinho se o mapa fez a app fechar no arranque. Um pouco mais lento; é preciso reiniciar a app para aplicar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenează harta printr-o cale de compatibilitate care evită erorile driverelor grafice ale unor dispozitive. Se pornește automat dacă harta a blocat aplicația la pornire. Puțin mai lent; necesită o repornire a aplicației pentru a se aplica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рисует карту через путь совместимости, который обходит ошибки графических драйверов на некоторых устройствах. Включается сам, если карта уронила приложение при запуске. Немного медленнее, нужен перезапуск приложения."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zemljevid izrisuje v združljivostnem načinu, ki prepreči nekatere napake grafičnih gonilnikov. Če se aplikacija ob zagonu zemljevida sesuje, se lahko vklopi samodejno. Je nekoliko počasnejši."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritar kartan via en kompatibilitetsväg som undviker grafikdrivrutinsfel på vissa enheter. Slås på av sig själv om kartan kraschade appen vid start. Något långsammare; kräver omstart av appen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Малює карту через режим сумісності, який обходить помилки графічних драйверів на деяких пристроях. Вмикається сам, якщо карта спричинила збій застосунку під час запуску. Трохи повільніший; щоб застосувати, потрібно перезапустити застосунок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过兼容渲染路径绘制地图，可规避部分设备的图形驱动缺陷。若地图在启动时导致应用崩溃，会自动开启。速度略慢；需重启应用才能生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以相容模式繪製地圖，避開部分裝置的繪圖驅動程式錯誤。如果地圖在啟動時造成應用程式當機，會自動開啟。速度稍慢，需重新啟動應用程式才會生效。"
          }
        }
      }
    },
    "settings_the_buttons_floating_over_the_map" : {
