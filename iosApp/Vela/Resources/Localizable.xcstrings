    "settings_on_the_open_bicycle_router_favors" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشغيل: جهاز التوجيه المفتوح للدراجات يفضل مسارات الدراجات المميزة وممرات الدراجات والشوارع الهادئة. إيقاف: أسرع طريق للدراجات. ينطبق على المسار التالي وكل إعادة تخطيط؛ لا يغير وضع السفر أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein: Der offene Fahrradrouter bevorzugt ausgeschilderte Radwege, Radwege und ruhige Straßen. Aus: die schnellste Radroute. Gilt für die nächste Route und jede Neuplanung; Der Reisemodus wird nie geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On: the open bicycle router favors signed cycle routes, bike lanes and quiet streets. Off: the fastest bike route. Applies to the next route and every replan; it never changes the travel mode."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On: the open bicycle router favors signed cycle routes, bike lanes and quiet streets. Off: the fastest bike route. Applies to the next route and every replan; it never changes the travel mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En marcha: el enrutador abierto para bicicletas favorece las rutas ciclistas señalizadas, los carriles bici y las calles tranquilas. Off: la ruta en bicicleta más rápida. Se aplica a la siguiente ruta y a cada replanificación; nunca cambia el modo de viaje."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sees: avatud jalgrattamarsruuter eelistab märgistatud jalgrattateid, jalgrattateid ja vaikseid tänavaid. Väljas: kiireim rattamarsruut. Kehtib järgmisele marsruudile ja igale ümberplaneerimisele; see ei muuda kunagi reisirežiimi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On : le véloroute ouvert privilégie les itinéraires cyclables balisés, les pistes cyclables et les rues calmes. Off : l'itinéraire cyclable le plus rapide. S'applique à l'itinéraire suivant et à chaque replanification ; il ne change jamais le mode de déplacement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פועל: נתב האופניים הפתוח מעדיף מסלולי אופניים חתומים, שבילי אופניים ורחובות שקטים. כבוי: מסלול האופניים המהיר ביותר. חל על המסלול הבא ועל כל תכנון מחדש; זה אף פעם לא משנה את מצב הנסיעה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be: a nyitott kerékpárútvonal a jelzett kerékpárutakat, a kerékpárutakat és a csendes utcákat részesíti előnyben. Off: a leggyorsabb kerékpárút. A következő útvonalra és minden újratervezésre vonatkozik; soha nem változtatja meg az utazási módot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sì: il percorso ciclabile aperto privilegia le piste ciclabili segnalate, le piste ciclabili e le strade tranquille. Off: il percorso ciclabile più veloce. Si applica al percorso successivo e ad ogni ripianificazione; non cambia mai la modalità di viaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オン: オープン自転車ルーターは、署名された自転車ルート、自転車レーン、静かな通りを優先します。オフ: 最速の自転車ルート。次のルートとすべての再計画に適用されます。旅行モードは決して変更されません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aan: de open fietsrouter geeft de voorkeur aan bewegwijzerde fietsroutes, fietspaden en rustige straten. Uit: de snelste fietsroute. Geldt voor de volgende route en elke herplanning; het verandert nooit de reismodus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wł.: otwarty router rowerowy preferuje oznakowane trasy rowerowe, ścieżki rowerowe i ciche ulice. Wył.: najszybsza trasa rowerowa. Dotyczy następnej trasy i każdej zmiany planu; nigdy nie zmienia trybu podróży."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligado: o ciclovia aberta favorece ciclovias sinalizadas, ciclovias e ruas tranquilas. Desligado: o percurso de bicicleta mais rápido. Aplica-se à próxima rota e a cada replanejamento; nunca muda o modo de viagem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligado: o ciclovia aberta favorece ciclovias sinalizadas, ciclovias e ruas tranquilas. Desligado: o percurso de bicicleta mais rápido. Aplica-se à próxima rota e a cada replanejamento; nunca muda o modo de viagem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activat: routerul deschis pentru biciclete favorizează traseele de biciclete semnate, pistele pentru biciclete și străzile liniștite. Off: cel mai rapid traseu de biciclete. Se aplică la următoarea rută și la fiecare replanificare; nu schimbă niciodată modul de călătorie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включено: открытый велосипедный маршрутизатор предпочитает обозначенные велосипедные маршруты, велосипедные дорожки и тихие улицы. Off: самый быстрый велосипедный маршрут. Применяется к следующему маршруту и ​​каждому перепланированию; он никогда не меняет режим движения."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vklopljeno: odprti kolesarski usmerjevalnik daje prednost označenim kolesarskim potem, kolesarskim stezam in mirnim ulicam. Off: najhitrejša kolesarska pot. Velja za naslednjo pot in vsak ponovni načrt; nikoli ne spremeni načina potovanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På: den öppna cykelroutern gynnar skyltade cykelvägar, cykelbanor och lugna gator. Av: den snabbaste cykelvägen. Gäller nästa rutt och varje omplanering; den ändrar aldrig reseläget."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık: Açık bisiklet yönlendiricisi imzalı bisiklet yollarını, bisiklet yollarını ve sessiz sokakları tercih eder. Kapalı: en hızlı bisiklet rotası. Bir sonraki rota ve her yeniden planlama için geçerlidir; seyahat modunu asla değiştirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкнено: відкритий велосипедний маршрут надає перевагу веломаршрутам із знаками, велосипедним доріжкам і тихим вулицям. Вимкнено: найшвидший велосипедний маршрут. Застосовується до наступного маршруту та кожного перепланування; він ніколи не змінює спосіб подорожі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启：开放式自行车路由器有利于有标志的自行车道、自行车道和安静的街道。 Off：最快的自行车路线。适用于下一条路线和每次重新计划；它永远不会改变旅行模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟：開放式自行車路由器有利於有標誌的自行車道、自行車道和安靜的街道。 Off：最快的自行車路線。適用於下一條路線和每次重新計劃；它永遠不會改變旅行模式。"
          }
        }
      }
    },
