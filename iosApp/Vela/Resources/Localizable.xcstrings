    "settings_tilt_driving_map_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تميل كاميرا القيادة إلى الأمام، ومتوجة بزاوية 60 درجة في MapLibre. مطفأ: يظل محرك الأقراص مسطحًا وتتم القراءة من الشمال إلى الأعلى مثل خريطة التصفح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fahrkamera neigt sich nach vorne und ist auf die 60-Grad-Neigung von MapLibre begrenzt. Aus: Die Fahrt bleibt flach und die Richtung Norden zeigt sich wie auf der Karte zum Durchsuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The drive camera leans forward, capped at MapLibre's 60 degree pitch. Off: the drive stays flat and north-up reads like the browse map."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The drive camera leans forward, capped at MapLibre's 60 degree pitch. Off: the drive stays flat and north-up reads like the browse map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara de la unidad se inclina hacia adelante, enfocada en la inclinación de 60 grados de MapLibre. Apagado: el camino permanece plano y el norte arriba se lee como el mapa de exploración."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sõidukaamera kaldub ettepoole ja on MapLibre'i 60-kraadise nurga all. Väljas: draiv jääb tasaseks ja põhja-üles näeb nagu sirvimiskaarti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La caméra du lecteur se penche vers l'avant, plafonnée à l'inclinaison de 60 degrés de MapLibre. Désactivé : le lecteur reste plat et vers le nord se lit comme la carte de navigation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצלמת הכונן רוכנת קדימה, מוגבלת לגובה של 60 מעלות של MapLibre. כבוי: הכונן נשאר שטוח וצפון למעלה נקרא כמו מפת הגלישה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A meghajtó kamera előrehajlik, a MapLibre 60 fokos dőlésszögében. Ki: a meghajtó sík marad, és az észak felfelé néz, mint a böngészési térkép."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La telecamera di guida si sporge in avanti, limitata all'inclinazione di 60 gradi di MapLibre. Spento: il percorso rimane pianeggiante e la direzione nord è simile alla mappa sfogliata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドライブカメラは前傾しており、MapLibre の 60 度のピッチに制限されています。オフ: ドライブは平らなままで、ブラウズ マップのように北が上になります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De aandrijfcamera leunt naar voren, met een hoek van 60 graden van MapLibre. Uit: de schijf blijft vlak en het noorden boven leest als de bladerkaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera jazdy pochyla się do przodu i jest skierowana pod kątem 60 stopni MapLibre. Wył.: napęd pozostaje płaski, a kierunek północny jest wyświetlany jak na mapie przeglądania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A câmera da unidade se inclina para frente, limitada na inclinação de 60 graus do MapLibre. Desligado: a unidade permanece plana e o norte aparece como o mapa de navegação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A câmera da unidade se inclina para frente, limitada na inclinação de 60 graus do MapLibre. Desligado: a unidade permanece plana e o norte aparece como o mapa de navegação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera de rulare se înclină înainte, acoperită la înclinarea de 60 de grade a MapLibre. Dezactivat: unitatea rămâne plată, iar nordul în sus arată ca pe harta de răsfoire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера привода наклоняется вперед, ее угол наклона составляет 60 градусов, как в MapLibre. Выключено: диск остается ровным, а направление на север читается как карта обзора."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogonska kamera je nagnjena naprej, omejena na 60-stopinjski naklon MapLibre. Izklopljen: pogon ostane raven in sever navzgor se bere kot brskanje po zemljevidu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilkameran lutar sig framåt, begränsad till MapLibres 60 graders stigning. Av: enheten förblir platt och norr upp läses som på kartan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürüş kamerası ileri doğru eğilir ve MapLibre'nin 60 derecelik açısıyla sınırlandırılır. Kapalı: sürücü düz kalır ve kuzeye doğru tarama haritası gibi okunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера приводу нахиляється вперед, обмежена кутом нахилу MapLibre 60 градусів. Вимк.: диск залишається рівним, а північ угорі читається як карта для перегляду."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行车摄像头向前倾斜，限制在 MapLibre 的 60 度倾斜范围内。关闭：行驶保持平坦，向北向上读起来就像浏览地图一样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行車攝影機向前傾斜，限制在 MapLibre 的 60 度傾斜範圍內。關閉：行駛保持平坦，向北向上讀起來就像瀏覽地圖一樣。"
          }
        }
      }
    },
