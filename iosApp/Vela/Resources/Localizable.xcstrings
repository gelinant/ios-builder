    "mapvm_still_offline" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch offline. Vela merkt sofort, wenn die Verbindung wieder da ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still offline. Vela will notice the moment the connection is back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigues sin conexión. Vela lo notará en cuanto vuelva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours hors ligne. Vela le remarquera dès que la connexion reviendra."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיין לא מקוון. Vela יזהה מיד כשהחיבור יחזור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még mindig offline. A Vela azonnal észreveszi, amint visszatér a kapcsolat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora offline. Vela se ne accorgerà appena torna la connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだオフラインです。接続が戻りしだい、Vela が自動で検知します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog steeds offline. Vela merkt het meteen als de verbinding terug is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadal offline. Vela zauważy, gdy tylko połączenie wróci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda off-line. O Vela vai perceber assim que a conexão voltar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda offline. A Vela dá por isso assim que a ligação voltar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încă fără conexiune. Vela va observa imediat ce conexiunea va fi restabilită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Связи всё ещё нет. Vela заметит, как только подключение вернётся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortfarande offline. Vela märker det så fort anslutningen är tillbaka."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Досі офлайн. Vela помітить, щойно з'єднання відновиться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仍处于离线状态。网络一恢复，Vela 就会察觉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仍然離線。連線一恢復，Vela 就會立刻察覺。"
          }
        }
      }
