    "welcome_donate_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela ist kostenlos und werbefrei, mit minimalen Mitteln entwickelt. Wenn es Ihnen nützlich geworden ist, hilft eine kleine einmalige Spende, es am Laufen zu halten, völlig freiwillig, und nur dieses eine Mal wird danach gefragt. In den Einstellungen gibt es außerdem immer einen Eintrag zum Unterstützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela is free and ad-free, built on a shoestring. If it's become useful, a small one-off donation helps keep it going. Entirely optional, and this is the only time it'll ask. There's always a Support entry in Settings too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela es gratis y sin anuncios, hecha con muy pocos recursos. Si te resulta útil, una pequeña donación única ayuda a mantenerla en marcha, completamente opcional, y es la única vez que se te pedirá. Siempre habrá también una opción de Apoyar en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela est gratuit et sans publicité, développé avec très peu de moyens. S'il vous est devenu utile, un petit don ponctuel aide à le maintenir, entièrement facultatif, et c'est la seule fois où il vous sera demandé. Une entrée Soutien reste toujours disponible dans les Paramètres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היישום Vela הוא חופשי ונטול פרסומות, נבנה בתקציב זעום. אם הוא שימושי עבורך, תרומה חד־פעמית קטנה תעזור לשמור עליו. זו לא חובה, וזו הפעם היחידה שנבקש זאת ממך. תמיד יש גם רשומת „תמיכה” בהגדרות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vela ingyenes és reklámmentes, szűkös keretből épül. Ha hasznosnak bizonyult, egy kis egyszeri adomány segít fenntartani. Teljesen opcionális, és csak most kérdezzük meg. A Beállítások menüben mindig van egy Támogatás pont is."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela è gratuita e senza pubblicità, realizzata con risorse minime. Se ti è diventata utile, una piccola donazione una tantum aiuta a portarla avanti, del tutto facoltativa, e questa è l'unica volta che te lo chiederà. C'è sempre anche una voce Supporto nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela は無料・広告なしで、ごくわずかな資金で開発されています。役に立っていると感じたら、一度きりの少額の寄付が継続の支えになります。完全に任意で、このお願いが表示されるのは今回だけです。設定にはいつでも「支援」の項目があります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela is gratis en reclamevrij, gebouwd met een minimaal budget. Als het nuttig is geworden, helpt een kleine eenmalige donatie het voort te zetten, geheel optioneel, en dit is de enige keer dat het erom vraagt. Er staat ook altijd een item Ondersteunen in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela jest darmowa i bez reklam, tworzona za grosze. Jeśli okazała się przydatna, mała jednorazowa darowizna pomaga ją utrzymać, całkowicie dobrowolnie i tylko ten jeden raz o to poprosimy. W Ustawieniach zawsze jest też pozycja Wsparcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela é gratuito e sem anúncios, criado com poucos recursos. Se ele se tornou útil, uma pequena doação única ajuda a mantê-lo, totalmente opcional, e esta é a única vez que ele vai pedir. Também há sempre uma entrada Apoiar nas Configurações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela é gratuito e sem anúncios, criado com poucos recursos. Se se tornou útil, um pequeno donativo único ajuda a mantê-lo, totalmente opcional, e esta é a única vez que o pedirá. Há sempre também uma entrada Apoiar nas Definições."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela este gratuită și fără reclame, fiind dezvoltată cu un buget foarte redus. Dacă ți s-a dovedit utilă, o mică donație unică ne ajută să o menținem în funcțiune. Este o acțiune complet opțională, iar aceasta este singura dată când ți se va solicita acest lucru. De asemenea, în Setări vei găsi întotdeauna o secțiune dedicată sprijinului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela бесплатна и без рекламы, создана на энтузиазме. Если она стала полезной, небольшое разовое пожертвование поможет ей развиваться, полностью по желанию, и об этом спрашивается лишь один раз. В настройках всегда есть раздел «Поддержка»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela är gratis och reklamfri, byggd på en knapp budget. Om den blivit användbar hjälper en liten engångsdonation till att hålla den igång, helt frivilligt, och det här är enda gången den frågar. Det finns alltid en Stöd-post i Inställningar också."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela безкоштовна й без реклами, створена на голому ентузіазмі. Якщо вона стала корисною, невелика разова пожертва допомагає її розвивати, цілком за бажанням, і про це запитають лише цього разу. У Налаштуваннях завжди є розділ «Підтримати»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 免费且无广告，靠微薄的经费开发。如果它对您有用，一笔小额的一次性捐助能帮助它走下去。完全自愿，而且只会问这一次。设置中也始终有“支持”入口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 免費、無廣告，靠極少的資源開發。如果它對你有幫助，小額的一次性捐款能讓它持續下去。完全自願，而且只會詢問這一次。「設定」中也隨時找得到「贊助」選項。"
          }
        }
      }
    },
