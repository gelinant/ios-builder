          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Android abre os links do Google Maps no navegador. Para abri-los no Vela, ative Abrir links compatíveis e adicione os links em Abrir por padrão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
