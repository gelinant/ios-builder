    "settings_start_view_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo sich die Karte befindet, wenn Sie Vela starten. Ein Link aus einer anderen App wird weiterhin an seiner eigenen Stelle geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where the map is when you start Vela. Driving mode is the map alone in the drive's layout, for a mounted phone or tablet. A link from another app still opens on its own place."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W momencie uruchomienia aplikacji Vela wyświetlana jest mapa. W trybie jazdy (przeznaczonym dla telefonu lub tabletu zamontowanego w uchwycie) widoczna jest wyłącznie mapa. Linki otwierane z poziomu innych aplikacji otwierają się w swoich własnych oknach."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde o mapa se encontra ao iniciar o Vela. Um link para outra app ainda abre no seu local."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unde se află harta la pornirea aplicației Vela. Modul de conducere reprezintă afișarea exclusivă a hărții în interfața sistemului de navigație, pentru un telefon sau o tabletă montată. Un link din altă aplicație se deschide totuși în propria fereastră."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Določa začetni prikaz ob zagonu Vele. Način vožnje prikaže samo zemljevid v postavitvi za vožnjo. Povezava iz druge aplikacije še vedno odpre posredovano lokacijo."
          }
        }
      }
    },
