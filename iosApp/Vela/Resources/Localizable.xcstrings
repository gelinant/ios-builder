    "settings_zoom_to_turn_floor_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How far out the map may zoom to keep the next turn on screen. Each step reaches about four times as far; the far ones trade street names for the stretch ahead."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa może oddalać się w takim stopniu aby kolejny manewr pozostał widoczny na ekranie. Każdy kolejny poziom przybliżenia obejmuje obszar mniej więcej cztery razy większy; przy większym oddaleniu nazwy ulic ustępują miejsca podglądowi dalszego odcinka trasy."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât de mult se poate mări harta pentru a menține următoarea cotitură pe ecran. Fiecare pas acoperă o distanță de aproximativ patru ori mai mare; la cele mai îndepărtate, numele străzilor sunt înlocuite cu denumirea tronsonului următor."
          }
        }
      }
    },
    "settings_zoom_to_turn_floor_region" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Region"
          }
        },
        "pl" : {
          "stringUnit" : {
