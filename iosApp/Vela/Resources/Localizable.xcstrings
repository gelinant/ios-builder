    "settings_route_traffic_on_tap_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routen kommen allein vom offenen Router, bis du in der Routenliste auf Verkehr anzeigen tippst. Bis dahin sind die Zeiten ohne Verkehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routes come from the open router alone until you tap Show traffic on the route list. Until then, times are without traffic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las rutas vienen solo del enrutador abierto hasta que tocas Mostrar tráfico en la lista de rutas. Hasta entonces, los tiempos no incluyen tráfico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les itinéraires viennent du seul routeur libre jusqu'à ce que vous touchiez Afficher le trafic dans la liste. Jusque-là, les durées sont sans trafic."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המסלולים מגיעים רק מהנתב הפתוח עד שתקיש על הצגת תנועה ברשימת המסלולים. עד אז הזמנים הם ללא תנועה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az útvonalak csak a nyílt útvonaltervezőből jönnek, amíg nem koppintasz a Forgalom megjelenítése gombra az útvonallistán. Addig az idők forgalom nélküliek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I percorsi arrivano solo dal router aperto finché non tocchi Mostra traffico nell'elenco dei percorsi. Fino ad allora i tempi sono senza traffico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルート一覧で「交通情報を表示」をタップするまで、ルートはオープンなルーターだけで作ります。それまでの所要時間は交通情報なしです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routes komen alleen van de open router totdat je in de routelijst op Verkeer tonen tikt. Tot dan zijn de tijden zonder verkeer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasy pochodzą wyłącznie z otwartego routera, dopóki nie dotkniesz Pokaż ruch na liście tras. Do tego czasu czasy są bez ruchu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As rotas vêm só do roteador aberto até você tocar em Mostrar trânsito na lista de rotas. Até lá, os tempos são sem trânsito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As rotas vêm só do roteador aberto até você tocar em Mostrar trânsito na lista de rotas. Até lá, os tempos são sem trânsito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traseele sunt calculate doar de un router deschis, până când faci clic pe „Afișează ambuteiajele” în lista de trasee. Până în acel moment, timpul indicat nu ține cont de ambuteiaje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маршруты строятся только открытым маршрутизатором, пока вы не нажмёте Показать пробки в списке маршрутов. До этого время указано без учёта пробок."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutter kommer bara från den öppna routern tills du trycker på Visa trafik i ruttlistan. Till dess är tiderna utan trafik."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маршрути будуються лише відкритим маршрутизатором, доки ви не торкнетеся Показати затори у списку маршрутів. До того час указано без заторів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在路线列表中点按“显示路况”之前，路线只来自开放路由器，时间不含路况。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在路線清單中點按「顯示路況」之前，路線只來自開放路由器，時間不含路況。"
          }
        }
      }
    },
