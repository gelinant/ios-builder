    "settings_pip_turn_card_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt während der Navigation im Bild-im-Bild-Modus die nächste Abbiegung als Karte am oberen Rand und die verbleibende Zeit am unteren. Aus: eine Leiste am unteren Rand mit der Straße, der Entfernung bis zur Abbiegung und der Ankunftszeit, wie in Googles Minikarte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During navigation in picture-in-picture, shows the next turn as a card across the top and the time left along the bottom. Off: one bar along the bottom with the road, the distance to the turn and the arrival time, like Google's mini map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la navegación en imagen en imagen, muestra el próximo giro en una tarjeta en la parte superior y el tiempo restante en la inferior. Desactivado: una sola barra en la parte inferior con la calle, la distancia hasta el giro y la hora de llegada, como el minimapa de Google."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la navigation en mode image dans l'image, affiche le prochain virage dans une carte en haut et le temps restant en bas. Désactivé : une seule barre en bas avec la route, la distance jusqu'au virage et l'heure d'arrivée, comme la mini-carte de Google."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בזמן ניווט במצב תמונה בתוך תמונה, מציג את הפנייה הבאה ככרטיס בחלק העליון ואת הזמן שנותר בחלק התחתון. כבוי: סרגל אחד בתחתית עם הכביש, המרחק לפנייה ושעת ההגעה, כמו במפה המוקטנת של Google."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigáció közben, kép a képben módban a következő kanyart kártyaként mutatja felül, a hátralévő időt pedig alul. Kikapcsolva: egyetlen sáv alul az úttal, a kanyarig hátralévő távolsággal és az érkezési idővel, mint a Google minitérképén."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la navigazione in picture-in-picture mostra la prossima svolta in una scheda in alto e il tempo rimanente in basso. Disattivato: un'unica barra in basso con la strada, la distanza dalla svolta e l'orario di arrivo, come la mini mappa di Google."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピクチャー イン ピクチャーでのナビ中、次の曲がり角を上部のカードに、残り時間を下部に表示します。オフにすると、Google のミニマップのように、道路名、曲がり角までの距離、到着時刻を下部の 1 本のバーにまとめます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont tijdens het navigeren in beeld-in-beeld de volgende afslag als kaart bovenaan en de resterende tijd onderaan. Uit: één balk onderaan met de weg, de afstand tot de afslag en de aankomsttijd, zoals de minikaart van Google."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas nawigacji w trybie obraz w obrazie pokazuje następny skręt jako kartę u góry a pozostały czas u dołu. Wył.: jeden pasek u dołu z drogą, odległością do skrętu i godziną przyjazdu jak na minimapie Google."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante a navegação em picture-in-picture, mostra a próxima curva em um cartão no topo e o tempo restante embaixo. Desativado: uma única barra embaixo com a rua, a distância até a curva e o horário de chegada, como o minimapa do Google."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante a navegação em picture-in-picture, mostra a próxima curva num cartão no topo e o tempo restante em baixo. Desligado: uma só barra em baixo com a estrada, a distância até à curva e a hora de chegada, como o mini mapa da Google."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În timpul navigării, în modul „imagine în imagine”, afișează următoarea cotitură pe o fereastră din partea de sus, iar timpul rămas în partea de jos. Oprit: o singură bandă în partea de jos cu drumul, distanța până la viraj și ora de sosire, ca pe mini-harta Google."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время навигации в режиме «картинка в картинке» показывает следующий поворот карточкой вверху, а оставшееся время внизу. Выкл.: одна полоса внизу с дорогой, расстоянием до поворота и временем прибытия, как на мини-карте Google."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under navigering i bild-i-bild visas nästa sväng som ett kort längst upp och återstående tid längst ned. Av: ett enda fält längst ned med vägen, avståndet till svängen och ankomsttiden, som i Googles minikarta."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час навігації в режимі «картинка в картинці» показує наступний поворот карткою вгорі, а час, що лишився, внизу. Вимкнено: одна панель унизу з дорогою, відстанню до повороту й часом прибуття, як на мінікарті Google."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在画中画模式下导航时，顶部以卡片显示下一个转弯，底部显示剩余时间。关闭后：底部只有一条栏，显示道路、到转弯处的距离和到达时间，与 Google 的小窗地图类似。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以子母畫面導航時，在頂端以卡片顯示下一個轉彎，底部顯示剩餘時間。關閉時：只在底部顯示一列，包含道路、到轉彎處的距離和抵達時間，就像 Google 的迷你地圖。"
          }
        }
      }
    },
