    "settings_offline_places_with_downloads_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Regions-Download bringt auch Velas Ortsdaten dafür mit, sodass die Geschäfte auf der Karte ohne Empfang erscheinen. Rund ein halbes Gigabyte für ein großes Bundesland. Aus = Orte werden nur online geladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A region download also brings Vela's place data for it, so the businesses on the map show with no signal. Around half a gigabyte for a big state. Off = places only stream while online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al descargar una región también se traen los datos de lugares de Vela, para que los negocios aparezcan en el mapa sin señal. Alrededor de medio gigabyte para un estado grande. Desactivado = los lugares solo se cargan con conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléchargement d'une région apporte aussi les données de lieux de Vela, pour que les commerces s'affichent sur la carte sans réseau. Environ un demi-gigaoctet pour un grand état. Désactivé = les lieux ne se chargent qu'en ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הורדה של אזור מביאה גם את נתוני המקומות של Vela עבורו, כך שהעסקים על המפה מוצגים גם ללא קליטה. בערך חצי ג\"ב למדינה גדולה. כבוי = מקומות נטענים רק כשיש חיבור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy régió letöltése a hozzá tartozó Vela-helyadatot is elhozza, így az üzletek jelzés nélkül is látszanak a térképen. Egy nagy államnál nagyjából fél gigabájt. Ki = a helyek csak online töltődnek be."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il download di una regione porta con sé anche i dati sui luoghi di Vela, così le attività compaiono sulla mappa senza segnale. Circa mezzo gigabyte per uno stato grande. Disattivo = i luoghi arrivano solo online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地域をダウンロードすると Vela の場所データも一緒に取得し、電波がなくても地図上に店舗などが表示されます。大きな州で 0.5 GB ほどです。オフの場合、場所はオンライン時のみ読み込まれます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij het downloaden van een regio komen ook Vela's plaatsgegevens mee, zodat de bedrijven op de kaart zonder bereik zichtbaar zijn. Ongeveer een halve gigabyte voor een grote staat. Uit = plaatsen komen alleen online binnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobieranie regionu zawiera również dane miejsc Veli dzięki czemu firmy na mapie widać bez zasięgu. Około pół gigabajta dla dużego stanu. Wył. = miejsca wczytują się tylko online."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O download de uma região traz também os dados de locais do Vela, para que os estabelecimentos apareçam no mapa sem rede. Cerca de meio gigabyte para um estado grande. Desativado = os locais só chegam on-line."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A transferência de uma região traz também os dados de locais da Vela, para que os estabelecimentos apareçam no mapa sem rede. Cerca de meio gigabyte para um estado grande. Desligado = os locais só chegam online."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O descărcare a regiunii aduce și datele despre locațiile Vela, astfel încât afacerile de pe hartă sunt afișate fără semnal. Aproximativ o jumătate de gigabyte pentru un stat mare. Dezactivat = locațiile sunt transmise în flux doar când sunt online."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вместе с регионом загружаются и данные Vela о местах, чтобы организации были видны на карте без связи. Около половины гигабайта для крупного региона. Выкл. = места подгружаются только онлайн."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En regionnedladdning tar även med Velas platsdata för den, så att företagen på kartan syns utan täckning. Runt en halv gigabyte för en stor delstat. Av = platser strömmas bara när du är online."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантаження регіону приносить і дані Vela про місця для нього, тож заклади на карті видно без зв'язку. Приблизно пів гігабайта для великої області. Вимк. = місця завантажуються лише онлайн."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载区域时一并获取 Vela 的地点数据，没有信号时地图上也能显示商家。较大的州约需半 GB。关闭则地点仅在联网时加载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載區域時會一併取得 Vela 的地點資料，沒有訊號時地圖上仍會顯示商家。大的州約需半 GB。關閉時，地點只會在連線時載入。"
          }
        }
      }
    },
    "settings_on_a_mobile_connection_place_pages" : {
      "extractionState" : "manual",
