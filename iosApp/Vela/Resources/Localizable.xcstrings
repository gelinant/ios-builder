    "settings_speed_cams_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt feste Radarfallen und Blitzer, die in OpenStreetMap erfasst sind. Nur fest installierte Anlagen; die Abdeckung richtet sich nach der Karte und ist in Europa am besten. Standardmäßig aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows fixed radar and speed cameras mapped in OpenStreetMap. Fixed installations only; coverage follows the map, strongest in Europe. Off by default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra los radares fijos mapeados en OpenStreetMap. Solo instalaciones fijas; la cobertura depende del mapa y es mayor en Europa. Desactivado por defecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche les radars fixes cartographiés dans OpenStreetMap. Installations fixes uniquement ; la couverture suit la carte, surtout fournie en Europe. Désactivé par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציג מצלמות רדאר ומהירות קבועות הממופות ב-OpenStreetMap. מתקנים קבועים בלבד; הכיסוי נגזר מהמפה, והוא החזק ביותר באירופה. כבוי כברירת מחדל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az OpenStreetMap-ben térképezett fix radarokat és traffipaxokat jeleníti meg. Csak fix telepítések; a lefedettség a térképet követi, Európában a legerősebb. Alapból kikapcsolva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra gli autovelox e i radar fissi mappati in OpenStreetMap. Solo installazioni fisse; la copertura segue la mappa, più completa in Europa. Disattivo di default."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenStreetMap に登録されている固定式のレーダーや速度取締りカメラを表示します。固定設置のもののみで、収録範囲は地図に準じ、ヨーロッパが最も充実しています。初期状態ではオフです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont vaste flitspalen en radars die in OpenStreetMap staan. Alleen vaste installaties; de dekking volgt de kaart en is het best in Europa. Standaard uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje stacjonarne radary i fotoradary naniesione w OpenStreetMap. Tylko stałe instalacje; zasięg zależy od mapy, najlepszy w Europie. Domyślnie wyłączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra os radares fixos mapeados no OpenStreetMap. Apenas instalações fixas; a cobertura segue o mapa e é mais forte na Europa. Desativado por padrão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra os radares fixos mapeados no OpenStreetMap. Apenas instalações fixas; a cobertura segue o mapa e é mais forte na Europa. Desligado por predefinição."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează radarele fixe și camerele de viteză cartografiate în OpenStreetMap. Doar instalațiile fixe; acoperirea variază în funcție de hartă și este cea mai completă în Europa. Dezactivat în mod implicit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает стационарные радары и камеры контроля скорости, отмеченные в OpenStreetMap. Только стационарные; охват зависит от карты и полнее всего в Европе. По умолчанию выключено."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaže stacionarne radarje in kamere za nadzor hitrosti, označene v OpenStreetMap. Pokritost je odvisna od zemljevida in je najboljša v Evropi. Privzeto je izklopljeno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar fasta radar- och fartkameror som finns i OpenStreetMap. Endast fasta installationer; täckningen följer kartan och är bäst i Europa. Av som standard."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує стаціонарні радари та камери швидкості, нанесені в OpenStreetMap. Лише стаціонарні; покриття залежить від карти й найповніше в Європі. Типово вимкнено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示 OpenStreetMap 中标注的固定雷达和测速摄像头。仅限固定设备；覆盖范围取决于地图数据，欧洲最完整。默认关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示 OpenStreetMap 中標示的固定式雷達與測速照相。僅限固定式裝置；涵蓋範圍取決於地圖資料，以歐洲最完整。預設關閉。"
          }
        }
      }
    },
