        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceux-ci passent par %1$@. En choisir un permet de conserver l’écran du voyage et la fiche détaillée sur le même itinéraire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אלה עוברים דרך %1$@. בחירת אחד שומרת את מסך הטיול ואת דף הפרטים באותו מסלול."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek áthaladnak a következőn: %1$@. Ha kiválaszt egyet, az utazási képernyő és a részletező lap ugyanazon az útvonalon marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi passano attraverso %1$@. Scegliendone uno si mantengono la schermata del viaggio e la scheda dettagli sullo stesso itinerario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらは %1$@ を通過します。 1 つを選択すると、旅行画面と詳細シートが同じ旅程上に表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze passeren %1$@. Als u er één kiest, blijven het reisscherm en het detailblad op hetzelfde reisschema staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechodzą one przez %1$@. Wybranie jednej powoduje, że ekran podróży i arkusz szczegółów pozostają na tym samym planie podróży."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
