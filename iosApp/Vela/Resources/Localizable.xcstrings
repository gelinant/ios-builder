    "settings_page_transitions_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animiert Seiten und untere Bedienfelder beim Öffnen und Schließen und zeigt beim Zurückwischen eine Vorschau der vorherigen Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animate pages and bottom sheets as they open and close, and preview the previous page as you swipe back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anima las páginas y los paneles inferiores al abrirse y cerrarse, y muestra una vista previa de la página anterior al deslizar para volver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anime les pages et les panneaux inférieurs à l'ouverture et à la fermeture, et affiche un aperçu de la page précédente lors du geste de retour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מנפיש דפים וחלוניות תחתונות בעת פתיחה וסגירה, ומציג תצוגה מקדימה של הדף הקודם בעת החלקה לחזרה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animálja az oldalak és az alsó panelek megnyitását és bezárását, és a visszalépési kézmozdulat közben megjeleníti az előző oldal előnézetét."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anima pagine e pannelli inferiori all'apertura e alla chiusura e mostra un'anteprima della pagina precedente quando scorri per tornare indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページや画面下部のパネルの開閉をアニメーションで表示し、戻るスワイプ操作中に前のページをプレビューします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animeert pagina's en panelen onderaan bij het openen en sluiten, en toont een voorbeeld van de vorige pagina wanneer je terugveegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animuje otwieranie i zamykanie stron oraz paneli u dołu ekranu i wyświetla podgląd poprzedniej strony podczas przesuwania wstecz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anima a abertura e o fechamento de páginas e painéis inferiores e mostra uma prévia da página anterior ao deslizar para voltar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anima a abertura e o fecho de páginas e painéis inferiores e mostra uma pré-visualização da página anterior ao deslizar para voltar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animează paginile și foile de jos pe măsură ce se deschid și se închid și previzualizează pagina anterioară atunci când glisezi înapoi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анимирует открытие и закрытие страниц и нижних панелей и показывает предыдущую страницу во время жеста возврата."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animerar sidor och bottenpaneler när de öppnas och stängs, och förhandsvisar föregående sida när du sveper bakåt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayfalar ve alt sayfalar açılıp kapanırken animasyon ekleyin ve geri kaydırdığınızda önceki sayfayı ön izleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анімує відкриття й закриття сторінок і нижніх панелей та показує попередню сторінку під час жесту повернення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为页面和底部面板的打开与关闭添加动画，并在滑动返回时预览上一页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟和關閉頁面及底部面板時播放動畫，並在滑動返回時預覽上一頁。"
          }
        }
      }
    },
