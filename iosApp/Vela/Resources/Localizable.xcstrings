    "settings_category_chips_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schnellzugriffe Restaurants, Café, Tankstellen… unter der Suchleiste. „Eine Schaltfläche“ fasst sie in einem Menü zusammen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Restaurants, Coffee, Gas… shortcuts under the search bar. One button folds them into a menu. Which ones show, and in what order, is under Search."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los accesos directos Restaurantes, Café, Gasolina… bajo la barra de búsqueda. Con un solo botón se pliegan en un menú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les raccourcis Restaurants, Café, Essence… sous la barre de recherche. Un seul bouton les regroupe dans un menu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקיצורים מסעדות, קפה, דלק… שמתחת לשורת החיפוש. \"כפתור אחד\" מקפל אותם לתפריט."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Éttermek, Kávé, Benzinkút… gyorsgombok a keresősáv alatt. Az Egy gomb beállítás egyetlen menübe vonja össze őket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scorciatoie Ristoranti, Caffè, Benzina… sotto la barra di ricerca. Un solo pulsante le raccoglie in un menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索バーの下に並ぶ「レストラン」「コーヒー」「ガソリン」などのショートカットです。「ボタン 1 つ」を選ぶとメニューにまとめます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De snelkoppelingen Restaurants, Koffie, Tankstations… onder de zoekbalk. Eén knop vouwt ze samen tot een menu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skróty takie jak „Restauracje”, „Kawa”, „Stacje paliw…” znajdują się pod paskiem wyszukiwania. Za pomocą jednego przycisku można je zwinąć do menu. To które z nich są widoczne i w jakiej kolejności można określić w sekcji „Wyszukiwanie”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os atalhos Restaurantes, Café, Combustível… abaixo da barra de pesquisa. Um botão os reúne em um menu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os atalhos Restaurantes, Café, Combustível… por baixo da barra de pesquisa. Um botão junta-os num menu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comenzile rapide „Restaurante”, „Cafea”, „Benzinărie”… afișate sub bara de căutare. Cu un singur buton, acestea se ascund într-un meniu. Setările privind elementele afișate și ordinea acestora se găsesc în secțiunea „Căutare”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопки «Рестораны», «Кофе», «Заправки»… под строкой поиска. Вариант с одной кнопкой сворачивает их в меню."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genvägarna Restauranger, Kaffe, Bensin… under sökfältet. En knapp fäller ihop dem till en meny."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ярлики «Ресторани», «Кава», «Заправки»… під рядком пошуку. «Одна кнопка» згортає їх у меню."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索栏下方的“餐厅”“咖啡”“加油站”等快捷方式。选择“一个按钮”会将它们收进菜单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜尋列下方的餐廳、咖啡、加油站…等捷徑。「單一按鈕」會把它們收進一個選單。"
          }
        }
      }
    },
