    "settings_voice_install_vela_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die empfohlene Navigationsstimme. Hier jederzeit neu installieren, falls sie fehlt oder ein Download fehlgeschlagen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recommended navigation voice. Reinstall it here any time it goes missing or a download failed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voz de navegación recomendada. Reinstálala aquí siempre que falte o falle una descarga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voix de navigation recommandée. Réinstallez-la ici si elle disparaît ou si un téléchargement a échoué."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקול המומלץ לניווט. התקן אותו כאן מחדש בכל פעם שהוא נעלם או שהורדה נכשלה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ajánlott navigációs hang. Bármikor újratelepítheted itt, ha eltűnne vagy a letöltés sikertelen lenne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voce consigliata per la navigazione. Reinstallala da qui ogni volta che sparisce o che un download non riesce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おすすめの音声案内用の音声です。見つからなくなったときやダウンロードに失敗したときは、ここから再インストールできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De aanbevolen navigatiestem. Installeer hem hier opnieuw als hij ontbreekt of een download is mislukt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zalecany głos nawigacji. Zainstaluj go tutaj ponownie gdy zniknie albo gdy pobieranie się nie powiedzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A voz de navegação recomendada. Reinstale-a aqui sempre que ela desaparecer ou um download falhar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A voz de navegação recomendada. Reinstale-a aqui sempre que desaparecer ou uma transferência falhar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vocea de navigare recomandată. Reinstaleaz-o aici de fiecare dată când dispare sau o descărcare a eșuat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рекомендуемый голос навигации. Переустановите его здесь, если он пропал или загрузка не удалась."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priporočeni glas za navigacijo. Če izgine ali prenos ne uspe, ga lahko tukaj znova namestite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den rekommenderade navigeringsrösten. Installera om den här när som helst om den försvinner eller en nedladdning misslyckades."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рекомендований голос для навігації. Перевстановіть його тут будь-коли, якщо він зник або завантаження не вдалося."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推荐的导航语音。语音丢失或下载失败时，可随时在此重新安装。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建議使用的導航語音。語音遺失或下載失敗時，都可以在這裡重新安裝。"
          }
        }
      }
    },
