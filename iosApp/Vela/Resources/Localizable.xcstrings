        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pictogramele provin de la Google. Fiecare panoramare trimite poziția ta pe hartă către Google și nimic nu se afișează off-line."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значки берутся из Google. Каждое перемещение сообщает Google, какую область карты вы смотрите, а офлайн не рисуется ничего."
