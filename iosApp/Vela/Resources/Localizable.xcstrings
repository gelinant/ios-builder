    "settings_support_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela ist kostenlos und werbefrei. Wenn es Ihnen nützlich geworden ist, hilft eine Spende, die Entwicklung am Laufen zu halten, völlig freiwillig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela is free and ad-free. If it's become useful, a donation helps keep development going. Entirely optional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela es gratis y sin anuncios. Si te resulta útil, una donación ayuda a mantener el desarrollo en marcha, completamente opcional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela est gratuit et sans publicité. S'il vous est devenu utile, un don aide à poursuivre le développement, entièrement facultatif."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela חינמי וללא פרסומות. אם הוא הפך שימושי, תרומה עוזרת לשמור על המשך הפיתוח. אופציונלי לחלוטין."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vela ingyenes és reklámmentes. Ha hasznosnak bizonyult, egy adomány segít fenntartani a fejlesztést. Teljesen opcionális."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela è gratuita e senza pubblicità. Se ti è diventata utile, una donazione aiuta a portare avanti lo sviluppo, del tutto facoltativa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela は無料で広告もありません。役に立っていると感じたら、寄付が開発の継続に役立ちます。完全に任意です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela is gratis en reclamevrij. Als het nuttig is geworden, helpt een donatie de ontwikkeling voort te zetten, geheel optioneel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela jest darmowa i bez reklam. Jeśli okazała się przydatna, darowizna pomaga kontynuować rozwój, całkowicie dobrowolnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela é gratuito e sem anúncios. Se ele se tornou útil, uma doação ajuda a manter o desenvolvimento, totalmente opcional."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela é gratuito e sem anúncios. Se se tornou útil, um donativo ajuda a manter o desenvolvimento, totalmente opcional."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela este gratuită și nu conține reclame. Dacă ți s-a dovedit utilă, o donație ne ajută să continuăm dezvoltarea aplicației. Este o opțiune complet facultativă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela бесплатна и без рекламы. Если она стала полезной, пожертвование поможет продолжать разработку, полностью по желанию."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela är gratis och reklamfri. Om den blivit användbar hjälper en donation till att hålla utvecklingen igång, helt frivilligt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela безкоштовна й без реклами. Якщо вона стала корисною, пожертва допомагає продовжувати розробку, цілком за бажанням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 免费且无广告。如果它对您有用，捐助能帮助开发继续下去。完全自愿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 免費且無廣告。如果它對你有幫助，捐款能讓開發持續下去。完全自願。"
          }
        }
      }
    },
