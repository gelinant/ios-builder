    "place_limited_view" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google zeigt gerade eine eingeschränkte Ansicht, daher können Stoßzeiten und weitere Rezensionen hier fehlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google is showing a limited view right now, so popular times and more reviews may be missing here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora mismo Google muestra una vista limitada, así que aquí pueden faltar las horas populares y más reseñas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google affiche une vue limitée en ce moment, les heures d'affluence et d'autres avis peuvent donc manquer ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google מציגה כרגע תצוגה מוגבלת, ולכן ייתכן ששעות עומס וביקורות נוספות יחסרו כאן."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Google most korlátozott nézetet mutat, ezért a népszerű időpontok és a további vélemények hiányozhatnak itt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento Google mostra una vista limitata, quindi qui potrebbero mancare gli orari di affluenza e altre recensioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在 Google が制限付きの表示を返しているため、ここでは混雑する時間帯や追加のクチコミが表示されないことがあります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google toont op dit moment een beperkte weergave, dus drukke tijden en meer recensies kunnen hier ontbreken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google pokazuje teraz ograniczony widok, więc może tu brakować popularnych godzin i dalszych opinii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Google está mostrando uma visão limitada neste momento, por isso podem faltar aqui os horários de pico e mais avaliações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Google está a mostrar uma vista limitada neste momento, por isso podem faltar aqui as horas de maior movimento e mais avaliações."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google afișează o vizualizare limitată în acest moment, așa că este posibil să lipsească orele de popularitate și mai multe recenzii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google сейчас показывает ограниченную версию, поэтому популярного времени и дополнительных отзывов здесь может не быть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google visar en begränsad vy just nu, så populära tider och fler recensioner kan saknas här."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google зараз показує обмежену версію, тому годин відвідуваності й додаткових відгуків тут може не бути."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 目前提供的是受限视图，因此这里可能缺少热门时段和更多评价。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 目前提供的是受限檢視，因此這裡可能缺少熱門時段和更多評論。"
          }
        }
      }
    },
