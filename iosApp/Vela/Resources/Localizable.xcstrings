    "settings_performance_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorab Geladenes steht sofort bereit, wenn Sie es brauchen, belegt bis dahin aber Speicher. Die Standardwerte richten sich danach, wie viel Arbeitsspeicher dieses Telefon hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loading things ahead of time makes them instant when you need them, and costs memory until then. The defaults follow how much memory this phone has."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cargar cosas por adelantado hace que estén listas al instante cuando las necesitas, y ocupa memoria hasta entonces. Los valores por defecto dependen de cuánta memoria tiene este teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charger certaines choses à l'avance les rend instantanées quand vous en avez besoin, mais occupe de la mémoire en attendant. Les valeurs par défaut dépendent de la mémoire de ce téléphone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טעינת דברים מראש מסייעת לחסוך זמן בעת פתיחתם, אך צורכת זיכרון עד אז. הגדרות ברירת המחדל נקבעות לפי כמות הזיכרון שיש בטלפון זה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ami előre betöltődik, az azonnal kéznél van, amikor kell, de addig memóriát foglal. Az alapértékek a telefon memóriájához igazodnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caricare le cose in anticipo le rende immediate quando servono, ma nel frattempo occupa memoria. I valori predefiniti dipendono da quanta memoria ha questo telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事前に読み込んでおくと必要なときにすぐ使えますが、それまではメモリを消費します。初期設定はこの端末のメモリ容量に合わせています。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dingen vooraf laden maakt ze direct beschikbaar wanneer je ze nodig hebt, en kost tot dan geheugen. De standaardinstellingen hangen af van hoeveel geheugen deze telefoon heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wczytywanie rzeczy z wyprzedzeniem sprawia, że są od razu gotowe, gdy ich potrzebujesz, ale do tego czasu zajmują pamięć. Ustawienia domyślne zależą od tego, ile pamięci ma ten telefon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carregar as coisas antecipadamente as deixa instantâneas quando você precisa delas, e até lá ocupa memória. Os padrões dependem de quanta memória este celular tem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carregar as coisas antecipadamente torna-as instantâneas quando precisa delas, e até lá ocupa memória. As predefinições dependem de quanta memória este telemóvel tem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încărcarea elementelor în avans permite accesul instantaneu la ele atunci când ai nevoie de ele, dar ocupă memorie până în acel moment. Setările implicite depind de cantitatea de memorie disponibilă pe acest telefon."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предварительная загрузка делает всё мгновенным, когда это понадобится, но до тех пор занимает память. Значения по умолчанию зависят от объёма памяти телефона."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att ladda saker i förväg gör dem direkt tillgängliga när du behöver dem, och kostar minne fram till dess. Standardvärdena följer hur mycket minne den här telefonen har."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попереднє завантаження робить усе миттєвим, коли воно знадобиться, але доти займає пам'ять. Типові значення залежать від обсягу пам'яті телефона."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预先加载的内容在需要时可立即使用，但在此之前会占用内存。默认设置取决于这部手机的内存大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預先載入的內容在需要時就能立即使用，但在那之前會占用記憶體。預設值會依這支手機的記憶體大小而定。"
          }
        }
      }
    },
