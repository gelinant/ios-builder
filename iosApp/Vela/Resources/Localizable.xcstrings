    "settings_full_place_load_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aus, lädt ein Ort seine ersten Fotos und die erste Seite Rezensionen, und „Weitere Fotos“ oder „Alle Rezensionen“ holen den Rest. Wenn an, geht jeder geöffnete Ort seine ganze Fotogalerie und bis zu 50 Rezensionen durch, was langsamer ist und deutlich mehr Anfragen an Google sendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off, a place loads its first few photos and first page of reviews, and More photos or All reviews fetch the rest. On, every place you open walks its whole photo gallery and up to 50 reviews, which is slower and sends Google many more requests."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivado, un lugar carga sus primeras fotos y la primera página de reseñas, y «Más fotos» o «Todas las reseñas» traen el resto. Si está activado, cada lugar que abres recorre toda su galería de fotos y hasta 50 reseñas, lo que es más lento y envía muchas más peticiones a Google."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé, un lieu charge ses premières photos et la première page d'avis, et « Plus de photos » ou « Tous les avis » récupèrent le reste. Activé, chaque lieu ouvert parcourt toute sa galerie photo et jusqu'à 50 avis, ce qui est plus lent et envoie beaucoup plus de requêtes à Google."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשכבוי, מקום טוען את התמונות הראשונות ואת עמוד הביקורות הראשון, ו\"תמונות נוספות\" או \"כל הביקורות\" מביאים את השאר. כשדלוק, כל מקום שאתה פותח עובר על כל גלריית התמונות שלו ועד 50 ביקורות, מה שאיטי יותר ושולח ל-Google הרבה יותר בקשות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kikapcsolva egy hely az első néhány fotót és a vélemények első oldalát tölti be, a többit a További fotók vagy az Összes vélemény hozza. Bekapcsolva minden megnyitott hely a teljes fotógalériáját és legfeljebb 50 véleményt betölt, ami lassabb, és sokkal több kérést küld a Google-nak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disattivato, un luogo carica le prime foto e la prima pagina di recensioni, e Altre foto o Tutte le recensioni recuperano il resto. Se attivo, ogni luogo che apri scorre l'intera galleria di foto e fino a 50 recensioni, il che è più lento e invia a Google molte più richieste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフの場合、場所ごとに最初の数枚の写真とクチコミの 1 ページ目だけを読み込み、残りは「写真をもっと見る」や「すべてのクチコミ」で取得します。オンにすると、開いた場所ごとに写真ギャラリー全体と最大 50 件のクチコミを読み込むため、表示が遅くなり、Google へのリクエストも大幅に増えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit: een plaats laadt de eerste paar foto's en de eerste pagina recensies, en Meer foto's of Alle recensies haalt de rest op. Aan: elke plaats die je opent laadt de hele fotogalerij en tot 50 recensies, wat trager is en Google veel meer verzoeken stuurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączone: miejsce wczytuje kilka pierwszych zdjęć i pierwszą stronę opinii a Więcej zdjęć lub Wszystkie opinie pobierają resztę. Włączone: każde otwierane miejsce wczytuje całą galerię zdjęć i do 50 opinii co jest wolniejsze i wysyła do Google znacznie więcej zapytań."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado, um local carrega as primeiras fotos e a primeira página de avaliações, e Mais fotos ou Todas as avaliações buscam o resto. Ativado, cada local que você abre percorre toda a galeria de fotos e até 50 avaliações, o que é mais lento e envia muito mais solicitações ao Google."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado, um local carrega as primeiras fotos e a primeira página de avaliações, e Mais fotos ou Todas as avaliações vão buscar o resto. Ligado, cada local que abre percorre toda a galeria de fotos e até 50 avaliações, o que é mais lento e envia muitos mais pedidos à Google."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când opțiunea este dezactivată, fiecare locație încarcă primele câteva fotografii și prima pagină de recenzii, iar opțiunile „Mai multe fotografii” sau „Toate recenziile” afișează restul. Când opțiunea este activată, fiecare locație deschisă încarcă întreaga galerie de fotografii și până la 50 de recenzii, ceea ce este mai lent și generează mult mai multe solicitări către Google."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выключено, место загружает первые несколько фото и первую страницу отзывов, а «Ещё фото» или «Все отзывы» подгружают остальное. Если включено, каждое открытое место загружает всю галерею фото и до 50 отзывов, это медленнее и отправляет Google гораздо больше запросов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av = en plats laddar sina första foton och första sidan recensioner, och Fler foton eller Alla recensioner hämtar resten. På = varje plats du öppnar går igenom hela sitt fotogalleri och upp till 50 recensioner, vilket är långsammare och skickar många fler förfrågningar till Google."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимк. = місце завантажує кілька перших фото й першу сторінку відгуків, а «Більше фото» чи «Усі відгуки» довантажують решту. Увімк. = кожне відкрите місце проходить усю галерею фото й до 50 відгуків, це повільніше й надсилає Google набагато більше запитів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时，地点只加载前几张照片和第一页评价，点按“更多照片”或“全部评价”再获取其余内容。开启后，您打开的每个地点都会加载整个相册和最多 50 条评价，速度更慢，并会向 Google 发送多得多的请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉時，地點只會載入前幾張相片和第一頁評論，其餘內容由「更多相片」或「所有評論」取得。開啟後，你開啟的每個地點都會載入整個相簿和最多 50 篇評論，速度較慢，也會向 Google 送出多出許多的請求。"
          }
        }
      }
    },
