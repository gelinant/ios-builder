    "settings_vibrate_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richtungscodierte Vibrationen bei jeder Abbiegung, unterschiedlich für links und rechts, damit Sie einer Route allein durch Fühlen folgen können. Pro Verkehrsmittel einstellbar (z. B. an beim Radfahren und Gehen, aus beim Autofahren)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direction-coded buzzes at each turn, distinct for left vs right, so you can follow a route by feel. Set it per travel mode (e.g. on for cycling and walking, off while driving)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibraciones codificadas por dirección en cada giro, distintas para izquierda y derecha, para que sigas la ruta al tacto. Configúralo por modo de transporte (p. ej. activado para bicicleta y a pie, desactivado al conducir)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des vibrations codées par direction à chaque virage, distinctes pour la gauche et la droite, pour suivre un itinéraire au ressenti. Réglable par mode de déplacement (par ex. activé à vélo et à pied, désactivé en voiture)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רטטים מקודדי כיוון בכל פנייה, שונים לשמאל ולימין, כך שאפשר לעקוב אחרי המסלול בתחושה. הגדר לכל אופן תנועה בנפרד (למשל דלוק באופניים ובהליכה, כבוי בנהיגה)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iránykódolt rezgés minden kanyarnál, balra és jobbra eltérő mintázattal, hogy tapintással is követhesd az útvonalat. Közlekedési módonként külön állítható (pl. kerékpáron/gyaloglásnál be, autózásnál ki)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibrazioni con direzione codificata a ogni svolta, distinte per sinistra e destra, così puoi seguire un percorso al tatto. Impostabile per ogni modalità di viaggio (es. attiva per bici e a piedi, disattiva in auto)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲がり角ごとに、左折と右折で異なるパターンの振動でお知らせします。感覚だけでルートをたどれます。移動手段ごとに設定できます（例：自転車と徒歩はオン、車はオフ）。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richtinggecodeerde trillingen bij elke afslag, verschillend voor links en rechts, zodat u een route op gevoel kunt volgen. Stel het per vervoerswijze in (bijv. aan voor fietsen en lopen, uit tijdens het rijden)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wibracje zakodowane kierunkowo przy każdym zakręcie, inne dla lewego, inne dla prawego, dzięki czemu możesz podążać trasą po wyczuciu. Ustaw je osobno dla każdego trybu podróży (np. włączone dla roweru i pieszo, wyłączone podczas jazdy samochodem)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibrações codificadas por direção em cada curva, distintas para esquerda e direita, para que você possa seguir um trajeto pelo tato. Configure por modo de viagem (por ex., ativado para bicicleta e a pé, desativado de carro)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibrações codificadas por direção em cada curva, distintas para esquerda e direita, para poder seguir um percurso pelo tato. Configure por modo de viagem (p. ex. ligado para bicicleta e a pé, desligado de carro)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibrații codificate în funcție de direcție la fiecare viraj, distincte pentru stânga și dreapta, astfel încât să poți urma un traseu după cum simți. Setează în funcție de modul de deplasare (de exemplu, activat pentru ciclism și mers pe jos, dezactivat în timpul conducerii)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибросигналы на каждом повороте закодированы по направлению, разные для левого и правого, чтобы следовать маршруту на ощупь. Настраивается для каждого способа передвижения (например, включено для велосипеда и ходьбы, выключено за рулём)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Različni vzorci vibriranja za levo in desno zavijanje omogočajo sledenje poti brez pogleda na zaslon. Nastavite jih za vsak način potovanja posebej."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riktningskodade vibrationer vid varje sväng, olika för vänster och höger, så att du kan följa en rutt på känsla. Ställ in per färdsätt (t.ex. på för cykel och gång, av vid bilkörning)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вібросигнали з кодуванням напрямку на кожному повороті, різні для лівого та правого, щоб рухатися маршрутом на дотик. Налаштовується для кожного режиму руху (наприклад, увімкнено для велосипеда й пішки, вимкнено за кермом)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次转弯时按方向振动，左转和右转的振动不同，凭触感即可跟随路线。可按出行方式分别设置（例如骑行和步行时开启，驾车时关闭）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個轉彎以不同方向的震動提示，左轉右轉震法不同，憑感覺就能跟著路線走。可依交通方式分別設定（例如騎自行車和步行時開啟，開車時關閉）。"
          }
        }
      }
    },
