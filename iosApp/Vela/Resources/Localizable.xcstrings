    "settings_places_lookup_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Antippen eines Ortes werden Öffnungszeiten, Rezensionen und Fotos von Google geladen, und Vela merkt sich die Zuordnung, sodass das nächste Antippen sofort geht. Aus = ein angetippter Ort zeigt nur das, was Velas Daten hergeben (Name, Art, Adresse, Telefon, Website), und nichts über das Antippen erreicht Google. Suche und Routen nutzen weiterhin Google."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapping a place fetches its hours, reviews and photos from Google, and Vela remembers the match so the next tap is instant. Off = a tapped place shows only what Vela's data has (name, type, address, phone, website) and nothing about the tap reaches Google. Search and directions still use Google."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al tocar un lugar se obtienen su horario, sus reseñas y sus fotos de Google, y Vela recuerda la coincidencia para que el siguiente toque sea instantáneo. Desactivado = un lugar que toques muestra solo lo que tienen los datos de Vela (nombre, tipo, dirección, teléfono, sitio web) y nada de ese toque llega a Google. La búsqueda y las indicaciones siguen usando Google."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toucher un lieu récupère ses horaires, avis et photos sur Google, et Vela mémorise la correspondance pour que le prochain appui soit instantané. Désactivé = un lieu touché n'affiche que ce que les données de Vela contiennent (nom, type, adresse, téléphone, site web) et rien de l'appui ne parvient à Google. La recherche et les itinéraires utilisent toujours Google."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקשה על מקום מביאה את השעות, הביקורות והתמונות שלו מ-Google, ו-Vela זוכר את ההתאמה כך שההקשה הבאה מיידית. כבוי = מקום שהקשת עליו מציג רק את מה שיש בנתונים של Vela (שם, סוג, כתובת, טלפון, אתר) ושום דבר על ההקשה לא מגיע ל-Google. חיפוש ומסלולים עדיין משתמשים ב-Google."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy helyre koppintva a Vela lekéri a nyitvatartását, véleményeit és fotóit a Google-től, és megjegyzi a találatot, így a következő koppintás azonnali. Ki = a megkoppintott hely csak azt mutatja, ami a Vela adatában szerepel (név, típus, cím, telefonszám, weboldal), és semmi nem jut el a koppintásról a Google-höz. A keresés és az útvonaltervezés továbbra is a Google-t használja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toccando un luogo, Vela recupera orari, recensioni e foto da Google e ricorda la corrispondenza, così il tocco successivo è immediato. Disattivato = un luogo toccato mostra solo ciò che contengono i dati di Vela (nome, tipo, indirizzo, telefono, sito web) e nulla del tocco arriva a Google. La ricerca e le indicazioni usano comunque Google."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場所をタップすると、営業時間・クチコミ・写真を Google から取得します。照合した結果は Vela が記憶するため、次に同じ場所をタップしたときはすぐに表示されます。オフの場合、タップした場所には Vela のデータにある情報（名称、種類、住所、電話番号、ウェブサイト）だけが表示され、タップの内容が Google に伝わることはありません。検索と経路には引き続き Google を使用します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op een plaats tikken haalt de openingstijden, recensies en foto's bij Google op, en Vela onthoudt de koppeling zodat de volgende tik direct is. Uit = een aangetikte plaats toont alleen wat Vela's eigen gegevens hebben (naam, type, adres, telefoon, website) en er bereikt niets over die tik Google. Zoeken en routes gebruiken nog steeds Google."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknięcie miejsca pobiera jego godziny, opinie i zdjęcia z Google, a Vela zapamiętuje dopasowanie, więc kolejne dotknięcie jest natychmiastowe. Wył. = dotknięte miejsce pokazuje tylko to, co mają dane Veli (nazwa, typ, adres, telefon, strona), a nic o dotknięciu nie trafia do Google. Wyszukiwanie i trasy nadal korzystają z Google."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao tocar em um local, o Vela obtém do Google os horários, as avaliações e as fotos, e memoriza a correspondência para que o toque seguinte seja imediato. Desativado = um local tocado mostra apenas o que os dados do Vela têm (nome, tipo, endereço, telefone, site) e nada sobre o toque chega ao Google. A pesquisa e as direções continuam usando o Google."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao tocar num local, o Vela obtém do Google os horários, as avaliações e as fotos, e memoriza a correspondência para que o toque seguinte seja imediato. Desligado = um local tocado mostra apenas o que os dados do Vela têm (nome, tipo, morada, telefone, site) e nada sobre o toque chega ao Google. A pesquisa e as direções continuam a usar o Google."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atingerea unui loc îi preia programul de lucru, recenziile și fotografiile de pe Google, iar Vela memorizează potrivirea, astfel încât următoarea atingere este instantanee. Dezactivat = un loc atins afișează doar datele din Vela (nume, tip, adresă, telefon, site web) și nimic despre atingere nu ajunge la Google. Căutarea și indicațiile de orientare folosesc în continuare Google."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажатие на место подгружает его часы работы, отзывы и фото из Google, а Vela запоминает соответствие, чтобы следующее нажатие было мгновенным. Выкл. = при нажатии показывается только то, что есть в данных Vela (название, тип, адрес, телефон, сайт), и о нажатии в Google ничего не уходит. Поиск и маршруты по-прежнему работают через Google."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att trycka på en plats hämtar dess öppettider, recensioner och foton från Google, och Vela kommer ihåg matchningen så att nästa tryck går direkt. Av = en plats du trycker på visar bara det som finns i Velas data (namn, typ, adress, telefon, webbplats) och inget om trycket når Google. Sökning och vägbeskrivningar använder fortfarande Google."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дотик до місця завантажує з Google його години роботи, відгуки та фото, і Vela запам'ятовує збіг, тож наступний дотик буде миттєвим. Вимк. = місце показує лише те, що є в даних Vela (назва, тип, адреса, телефон, сайт), і жодних відомостей про дотик Google не отримує. Пошук і маршрути все одно працюють через Google."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按某个地点会从 Google 获取它的营业时间、评价和照片，Vela 会记住匹配结果，下次点按即可立即显示。关闭后：点按的地点只显示 Vela 数据中已有的信息（名称、类型、地址、电话、网站），点按的内容不会发送给 Google。搜索和路线仍使用 Google。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按地點時會向 Google 取得營業時間、評論和相片，Vela 會記住配對結果，下次點按就能立即顯示。關閉時，點按的地點只會顯示 Vela 資料中既有的內容（名稱、類型、地址、電話、網站），點按的任何資訊都不會傳給 Google。搜尋和路線規劃仍會使用 Google。"
          }
        }
      }
    },
