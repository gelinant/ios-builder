    "settings_pause_in_bar_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt Pause neben die Fahrtangaben, wo sonst die Schaltfläche für die Wegbeschreibung wäre, und lässt Stumm bei den Kartenschaltflächen. Wenn aus, liegen beide auf einer Schaltfläche rechts auf der Karte. In beiden Fällen öffnen Sie die Wegbeschreibung, indem Sie nach oben wischen oder den Pfeil nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puts pause beside the trip figures, where the step list button would be, and leaves mute with the map buttons. Off puts both on one button at the right of the map. Swipe up or use the arrow to open the step list either way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pone la pausa junto a los datos del trayecto, donde iría el botón de la lista de pasos, y deja el silencio con los botones del mapa. Si está desactivado, ambos van en un solo botón a la derecha del mapa. En cualquier caso, desliza hacia arriba o usa la flecha para abrir la lista de pasos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place la pause à côté des infos du trajet, là où serait le bouton de la liste des étapes, et laisse le bouton muet avec les boutons de la carte. Désactivé, les deux sont réunis sur un bouton à droite de la carte. Dans tous les cas, balayez vers le haut ou utilisez la flèche pour ouvrir la liste des étapes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שם את ההשהיה ליד נתוני הנסיעה, במקום שבו היה כפתור רשימת השלבים, ומשאיר את ההשתקה עם כפתורי המפה. כשכבוי, שניהם על כפתור אחד בצד המפה. בכל מקרה, החלק למעלה או השתמש בחץ כדי לפתוח את רשימת השלבים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szünet gombot az út adatai mellé teszi, ahol a lépéslista gomb lenne, a némítást pedig a térképgomboknál hagyja. Kikapcsolva mindkettő egy gombon van a térkép jobb szélén. A lépéslistát mindkét esetben felfelé húzással vagy a nyíllal nyithatod meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette la pausa accanto ai dati del viaggio, dove starebbe il pulsante dell'elenco dei passaggi, e lascia il muto con i pulsanti della mappa. Se disattivato, entrambi stanno in un solo pulsante a destra della mappa. In ogni caso, scorri verso l'alto o usa la freccia per aprire l'elenco dei passaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止ボタンを走行情報の横（ルート詳細ボタンの位置）に置き、ミュートは地図のボタンと一緒に残します。オフにすると、両方を地図の右側の 1 つのボタンにまとめます。どちらの場合も、上にスワイプするか矢印を使うとルート詳細を開けます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet pauze naast de ritgegevens, waar de knop voor de stappenlijst zou staan, en laat dempen bij de kaartknoppen. Uit zet beide op één knop rechts op de kaart. Veeg in beide gevallen omhoog of gebruik de pijl om de stappenlijst te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umieszcza pauzę obok danych podróży, w miejscu przycisku listy etapów, a wyciszanie zostawia przy przyciskach mapy. Wyłączone łączy oba w jednym przycisku po prawej stronie mapy. W obu przypadkach listę etapów otwiera przesunięcie w górę lub strzałka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca a pausa ao lado dos dados da viagem, onde ficaria o botão da lista de etapas, e deixa o silenciar junto aos botões do mapa. Desativado junta os dois em um só botão à direita do mapa. Em qualquer caso, deslize para cima ou use a seta para abrir a lista de etapas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Põe a pausa ao lado dos dados da viagem, onde estaria o botão da lista de etapas, e deixa o silêncio junto aos botões do mapa. Desligado junta os dois num só botão à direita do mapa. Em qualquer caso, deslize para cima ou use a seta para abrir a lista de etapas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opțiunea „Pauză” este afișată lângă cifrele referitoare la călătorie, acolo unde ar fi butonul pentru lista pașilor, iar opțiunea „Mute” rămâne lângă butoanele hărții. Opțiunea „Oprit” le plasează pe amândouă pe un singur buton, în partea dreaptă a hărții. Poți glisa în sus sau folosi săgeata pentru a deschide lista pașilor, indiferent de metodă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставит паузу рядом с данными поездки, на место кнопки списка шагов, а кнопку звука оставляет с кнопками карты. Если выключено, обе функции собраны в одной кнопке справа на карте. Список шагов в любом случае открывается свайпом вверх или стрелкой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger paus bredvid resans siffror, där knappen för steglistan annars sitter, och låter ljud av ligga kvar bland kartknapparna. Av lägger båda på en knapp till höger på kartan. Svep uppåt eller använd pilen för att öppna steglistan i båda fallen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставить паузу поруч із даними поїздки, на місце кнопки списку кроків, а кнопку звуку лишає з кнопками карти. Вимк. = обидві дії зібрано в одній кнопці праворуч на карті. Список кроків так чи так відкривається свайпом угору або стрілкою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将暂停按钮放在行程数据旁边（即步骤列表按钮的位置），静音按钮保留在地图按钮中。关闭后，两者合并为地图右侧的一个按钮。无论哪种方式，都可上滑或使用箭头打开步骤列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把暫停按鈕放在行程數據旁（原本步驟清單按鈕的位置），靜音則留在地圖按鈕中。關閉時，兩者會合併成地圖右側的一個按鈕。無論哪一種，都可以向上滑動或使用箭頭開啟步驟清單。"
          }
        }
      }
    },
    "settings_pause_in_bar_hint_buttons" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Schaltflächen statt Wischgesten bevorzugen“ zeigt die Leiste Pause und die Schaltfläche für die Wegbeschreibung nebeneinander, und die Fahrtangaben werden passend verkleinert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With \"Prefer buttons over swipes\" on, the bar carries pause and the step list button side by side, and the trip figures shrink to fit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con «Preferir botones antes que gestos» activado, la barra lleva la pausa y el botón de la lista de pasos uno al lado del otro, y los datos del trayecto se reducen para caber."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec « Préférer les boutons aux gestes » activé, la barre affiche la pause et le bouton de la liste des étapes côte à côte, et les infos du trajet rétrécissent pour tenir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כש\"העדף כפתורים על פני מחוות\" דלוק, בסרגל יש כפתור השהיה וכפתור רשימת השלבים זה לצד זה, ונתוני הנסיעה מתכווצים כדי להתאים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a \"Gombok a húzások helyett\" be van kapcsolva, a sávon egymás mellett van a szünet és a lépéslista gomb, az út adatai pedig összébb húzódnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con \"Preferisci i pulsanti ai gesti\" attivo, la barra mostra affiancati la pausa e il pulsante dell'elenco dei passaggi, e i dati del viaggio si riducono per starci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「スワイプよりボタンを優先」がオンのときは、バーに一時停止ボタンとルート詳細ボタンが並び、走行情報は縮小して表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met \"Liever knoppen dan veegbewegingen\" aan staan pauze en de knop voor de stappenlijst naast elkaar op de balk, en worden de ritgegevens kleiner zodat ze passen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy opcja \"Przyciski zamiast gestów\" jest włączona, pasek ma pauzę i przycisk listy etapów obok siebie, a dane podróży zmniejszają się, by się zmieścić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com \"Preferir botões a gestos\" ativado, a barra mostra a pausa e o botão da lista de etapas lado a lado, e os dados da viagem encolhem para caber."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com \"Preferir botões a gestos\" ligado, a barra mostra a pausa e o botão da lista de etapas lado a lado, e os dados da viagem encolhem para caber."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când opțiunea „Preferă butoanele în locul glisărilor” este activată, bara afișează butonul de pauză și butonul listei de pași unul lângă celălalt, iar cifrele referitoare la traseu se micșorează pentru a se potrivi pe ecran."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено «Кнопки вместо жестов», на панели рядом стоят пауза и кнопка списка шагов, а данные поездки сжимаются, чтобы поместиться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med ”Föredra knappar framför svep” på har fältet paus och knappen för steglistan sida vid sida, och resans siffror krymper för att få plats."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли увімкнено «Кнопки замість жестів», на панелі поруч стоять пауза й кнопка списку кроків, а дані поїздки стискаються, щоб поміститися."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
