    "settings_crash_diag_offer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Diagnose ist aus, daher wurde vor dem Absturz nichts aufgezeichnet. Schalte sie ein, um beim nächsten Mal mehr Details zu erfassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostics is off, so nothing was recorded leading up to this. Turn it on to capture more detail if it happens again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El diagnóstico está desactivado, así que no se registró nada previo a esto. Actívalo para captar más detalles si vuelve a ocurrir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le diagnostic est désactivé, donc rien n'a été enregistré avant cet incident. Activez-le pour recueillir plus de détails la prochaine fois."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האבחון כבוי, אז לא נרשם דבר שהוביל לזה. הפעל אותו כדי ללכוד יותר פרטים אם זה יקרה שוב."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A diagnosztika ki van kapcsolva, így semmi nem lett rögzítve ez előtt. Kapcsold be, hogy több részletet rögzítsen, ha újra megtörténne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La diagnostica è disattivata, quindi non è stato registrato nulla prima di questo. Attivala per raccogliere più dettagli se succede di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "診断がオフだったため、終了直前の記録はありません。オンにしておくと、次に起きたときに詳しい情報を記録できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostiek staat uit, dus er is niets vastgelegd vlak voor deze crash. Zet het aan om de volgende keer meer details te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostyka jest wyłączona, więc nic nie zostało zapisane przed tą awarią. Włącz ją, aby następnym razem zebrać więcej szczegółów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O diagnóstico está desativado, por isso nada foi registrado antes disto. Ative-o para captar mais detalhes se acontecer de novo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O diagnóstico está desligado, por isso nada foi registado antes disto. Ative-o para captar mais detalhes se acontecer de novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funcția de diagnosticare este dezactivată, așa că nu s-a înregistrat nimic până în acest moment. Activează-o pentru a captura mai multe detalii dacă se întâmplă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диагностика выключена, поэтому перед сбоем ничего не записывалось. Включите её, чтобы в следующий раз собрать больше данных."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostik är av, så inget spelades in före kraschen. Slå på den för att fånga mer information nästa gång."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Діагностику вимкнено, тож перед збоєм нічого не записалося. Увімкніть її, щоб наступного разу зібрати більше даних."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "诊断功能处于关闭状态，因此没有记录到事发前的信息。开启后如再次发生可捕获更多细节。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "診斷功能目前關閉，因此事發前沒有留下任何記錄。開啟後如果再次發生，就能收集更多細節。"
          }
        }
      }
    },
