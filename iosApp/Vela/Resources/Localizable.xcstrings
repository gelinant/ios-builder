    "settings_update_channel_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabil bekommt eine getestete Version pro Woche. Nightly bekommt an jedem Tag mit Änderungen einen Build. Canary folgt der laufenden Entwicklung und kann jederzeit kaputtgehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stable gets one tested release a week. Nightly gets a build each day there are changes. Canary follows work in progress and can break at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estable recibe una versión probada a la semana. Nightly recibe una compilación cada día que haya cambios. Canary sigue el trabajo en curso y puede fallar en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stable reçoit une version testée par semaine. Nightly reçoit une build chaque jour où il y a des changements. Canary suit le travail en cours et peut casser à tout moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יציב מקבל גרסה נבדקת אחת בשבוע. Nightly מקבל גרסה בכל יום שיש בו שינויים. Canary עוקב אחרי עבודה בתהליך ועלול להישבר בכל רגע."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Stabil heti egy tesztelt kiadást ad. A Nightly minden nap, amikor van változás. A Canary a folyamatban lévő munkát követi, és bármikor eltörhet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabile riceve una versione testata a settimana. Nightly riceve una build ogni giorno in cui ci sono modifiche. Canary segue il lavoro in corso e può smettere di funzionare in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安定版は週に 1 回、テスト済みのリリースが届きます。ナイトリーは変更があった日に毎日ビルドが届きます。カナリアは開発中の内容をそのまま反映するため、いつ動かなくなってもおかしくありません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabiel krijgt één geteste release per week. Nightly krijgt een build op elke dag dat er wijzigingen zijn. Canary volgt werk in uitvoering en kan op elk moment stukgaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilny daje jedno przetestowane wydanie w tygodniu. Nightly daje kompilację każdego dnia, w którym są zmiany. Canary śledzi prace w toku i może w każdej chwili przestać działać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O canal estável recebe uma versão testada por semana. A nightly recebe uma compilação por dia com alterações. A canary acompanha o trabalho em andamento e pode falhar a qualquer momento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O canal estável recebe uma versão testada por semana. A nightly recebe uma compilação em cada dia com alterações. A canary segue o trabalho em curso e pode falhar a qualquer momento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versiunea Stabilă primește o versiune testată pe săptămână. Versiunea Nightly primește o versiune în fiecare zi în care se fac modificări. Versiunea Canary urmărește evoluția lucrărilor și poate prezenta erori în orice moment."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В стабильном канале выходит одна проверенная сборка в неделю. В ночном сборка появляется каждый день, когда есть изменения. Canary следует за текущей разработкой и может сломаться в любой момент."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabil ger en testad version i veckan. Nightly ger ett bygge varje dag det finns ändringar. Canary följer pågående arbete och kan gå sönder när som helst."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стабільний дає один перевірений випуск на тиждень. Нічний, збірку щодня, коли є зміни. Canary стежить за роботою в процесі й може зламатися будь-коли."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稳定版每周发布一个经过测试的版本。每夜版在有改动的日子每天构建一次。金丝雀版跟随开发进度，随时可能出问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "穩定版每週推出一個經過測試的版本。每夜版在有變更的日子每天推出一個版本。金絲雀版跟著開發中的進度走，隨時可能出問題。"
          }
        }
      }
    },
