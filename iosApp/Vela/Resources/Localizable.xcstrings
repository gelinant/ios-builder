    "settings_offline_addresses_missing" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor diesem Update gespeicherte Gebiete enthalten keine Adressdaten. Aktualisiere sie, um offline nach Adressen zu suchen und dorthin zu navigieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Areas you saved before this update don't include address data. Update them to search and route to addresses offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las áreas guardadas antes de esta actualización no incluyen datos de direcciones. Actualízalas para buscar direcciones y crear rutas sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les zones enregistrées avant cette mise à jour ne contiennent pas de données d'adresses. Mettez-les à jour pour rechercher des adresses et calculer des itinéraires hors ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אזורים ששמרת לפני העדכון הזה אינם כוללים נתוני כתובות. עדכן אותם כדי לחפש ולנתב לכתובות ללא חיבור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ezen frissítés előtt mentett területek nem tartalmaznak címadatot. Frissítsd őket a címekhez való offline kereséshez és útvonaltervezéshez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le aree salvate prima di questo aggiornamento non includono i dati degli indirizzi. Aggiornale per cercare indirizzi e calcolare percorsi offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアップデートより前に保存したエリアには住所データが含まれていません。更新すると、オフラインでも住所を検索して経路を調べられます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebieden die je vóór deze update hebt opgeslagen, bevatten geen adresgegevens. Werk ze bij om offline naar adressen te zoeken en ernaartoe te navigeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obszary zapisane przed tą aktualizacją nie zawierają danych adresowych. Zaktualizuj je, aby wyszukiwać adresy i wyznaczać do nich trasy offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As áreas salvas antes desta atualização não incluem dados de endereços. Atualize-as para pesquisar endereços e traçar rotas off-line."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As áreas guardadas antes desta atualização não incluem dados de moradas. Atualize-as para pesquisar moradas e traçar rotas offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonele salvate înainte de această actualizare nu includ date despre adrese. Actualizează-le pentru a căuta și a direcționa către adrese off-line."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Области, сохранённые до этого обновления, не содержат данные адресов. Обновите их, чтобы искать адреса и строить маршруты офлайн."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Območja, shranjena pred to posodobitvijo, ne vsebujejo naslovov. Posodobite jih za iskanje in navigacijo do naslovov brez povezave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Områden du sparade före den här uppdateringen innehåller inga adressdata. Uppdatera dem för att söka och navigera till adresser offline."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Області, збережені до цього оновлення, не містять даних адрес. Оновіть їх, щоб шукати адреси та прокладати до них маршрути офлайн."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本次更新之前保存的区域不包含地址数据。更新后即可离线搜索地址并规划路线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這次更新之前儲存的區域不含地址資料。更新後即可離線搜尋地址並規劃路線。"
          }
        }
      }
    },
