    "settings_trip_delete_selected_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausgewählten aufgezeichneten Fahrten werden von diesem Telefon entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected recorded drives are removed from this phone. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los trayectos grabados seleccionados se eliminarán de este teléfono. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les trajets enregistrés sélectionnés seront supprimés de ce téléphone. Cette action est irréversible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הנסיעות המוקלטות שנבחרו יוסרו מהטלפון הזה. אי אפשר לבטל את זה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kijelölt rögzített utak törlődnek erről a telefonról. Ez nem vonható vissza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I viaggi registrati selezionati verranno rimossi da questo telefono. L'operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した移動記録をこの端末から削除します。この操作は元に戻せません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geselecteerde opgenomen ritten worden van deze telefoon verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrane zapisane przejazdy zostaną usunięte z tego telefonu. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As viagens gravadas selecionadas serão removidas deste celular. Não é possível desfazer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os trajetos gravados selecionados são removidos deste telemóvel. Não é possível anular."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Călătoriile înregistrate selectate vor fi șterse de pe acest telefon. Această acțiune nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранные записанные поездки будут удалены с этого телефона. Отменить это нельзя."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrane zabeležene vožnje bodo izbrisane iz telefona. Tega ni mogoče razveljaviti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De valda inspelade körningarna tas bort från den här telefonen. Det går inte att ångra."
          }
        },
        "uk" : {
