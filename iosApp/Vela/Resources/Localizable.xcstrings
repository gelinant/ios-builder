          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regiune"
          }
        }
      }
    },
    "settings_zoom_to_turn_floor_town" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Town"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miasto"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oraș"
          }
        }
      }
    },
    "settings_zoom_to_turn_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The map zooms out until the next turn sits just under the turn card, turns toward a turn off to the side, and zooms back in as you near it. Made for long stretches between turns; street names and traffic lights do not show that far out. On the car screen too."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa oddala się aż kolejny manewr znajdzie się tuż pod kartą wskazówek następnie kieruje się w stronę zjazdu a gdy jesteś już blisko – ponownie przybliża widok. Funkcja ta sprawdza się na długich odcinkach między manewrami; przy takim oddaleniu nazwy ulic oraz sygnalizacja świetlna nie są widoczne. Działa to również na ekranie w samochodzie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harta se micșorează până când următoarea intersecție apare chiar sub cartonașul cu indicația de direcție, se îndreaptă spre o intersecție laterală și se mărește din nou pe măsură ce te apropii de ea. Este concepută pentru distanțe mari între intersecții; numele străzilor și semafoarele nu sunt afișate la o distanță atât de mare. Același lucru se întâmplă și pe ecranul mașinii."
          }
        }
      }
    },
