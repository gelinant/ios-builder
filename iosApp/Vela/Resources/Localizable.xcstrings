    "settings_update_nightly_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf den neuesten Nightly (Vorabversion) aktualisieren statt nur auf stabile Versionen. Nightlies sind aktueller, aber weniger getestet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update to the newest nightly (prerelease) instead of only stable releases. Nightlies are fresher but less tested."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza a la última versión nightly (preliminar) en lugar de solo versiones estables. Las nightly son más recientes pero menos probadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre à jour vers la dernière version nightly (préversion) plutôt que seulement les versions stables. Les nightly sont plus récentes mais moins testées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדכן ל-nightly החדש ביותר (טרום-שחרור) במקום רק לגרסאות יציבות. גרסאות nightly טריות יותר אך פחות נבדקו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A legújabb nightly (előzetes) verzióra frissít, nem csak a stabil kiadásokra. A nightly frissebb, de kevésbé tesztelt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna all'ultima nightly (anteprima) invece che solo alle versioni stabili. Le nightly sono più recenti ma meno testate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安定版だけでなく、最新のナイトリー（プレリリース）にも更新します。ナイトリーは新しい分、テストは少なめです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk bij naar de nieuwste nightly (voorlopige versie) in plaats van alleen stabiele versies. Nightlies zijn verser maar minder getest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizuj do najnowszej wersji nightly (przedpremierowej) zamiast tylko stabilnych. Nightly są nowsze, ale mniej przetestowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualizar para a nightly mais recente (pré-lançamento) em vez de apenas versões estáveis. As nightly são mais novas, mas menos testadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualizar para a nightly mais recente (pré-lançamento) em vez de apenas versões estáveis. As nightly são mais recentes mas menos testadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizează la cea mai recentă versiune „nightly” (prelansare), în loc să te limitezi doar la versiunile stabile. Versiunile „nightly” sunt mai recente, dar mai puțin testate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновляться до новейшей ночной сборки (предрелиз), а не только до стабильных версий. Ночные свежее, но менее протестированы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdatera till den senaste nightly (förhandsversion) istället för bara stabila versioner. Nightlies är färskare men mindre testade."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновлюватися до найновішої нічної збірки (передрелізу), а не лише до стабільних версій. Нічні свіжіші, але менш перевірені."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新到最新的每夜版（预发布版本），而不仅限于稳定版。每夜版更新更快，但测试较少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新到最新的 Nightly 版（預先發布），而不只限於穩定版。Nightly 版較新，但測試較少。"
          }
        }
      }
    },
