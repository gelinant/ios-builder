    "root_diag_trips_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet Ihre GPS-Spuren auf, sodass Fahrten zum Testen wiedergegeben werden können. Aufschlussreicher, Ihre genauen Routen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records your nav GPS traces so drives can be replayed for testing. More revealing: your exact routes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba los rastros GPS de tu navegación para poder reproducir trayectos en pruebas. Revela más: tus rutas exactas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre les traces GPS de navigation pour rejouer les trajets lors de tests. Plus révélateur - vos itinéraires exacts."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מקליט את עקבות ה-GPS של הניווט כדי שניתן יהיה לשחזר נסיעות לצורך בדיקה. חושפני יותר: המסלולים המדויקים שלך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rögzíti a navigációs GPS-nyomvonaladat, hogy az utak visszajátszhatók legyenek teszteléshez. Érzékenyebb: a pontos útvonalaidat is tartalmazza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra le tracce GPS di navigazione così i tragitti possono essere riprodotti per i test. Più rivelatore: i tuoi percorsi esatti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テスト用に運転を再生できるよう、ナビのGPS軌跡を記録します。より詳細な情報：正確な経路。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt uw GPS-navigatiesporen vast zodat ritten voor testen kunnen worden herhaald. Onthullender - uw exacte routes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje ślady GPS nawigacji, aby przejazdy można było odtworzyć do testów. Bardziej ujawniające - Twoje dokładne trasy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra os traços de GPS da navegação para que as viagens possam ser reproduzidas para testes. Mais revelador: seus percursos exatos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regista os traços GPS de navegação para que as viagens possam ser reproduzidas para testes. Mais revelador - os seus percursos exatos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrează traseele GPS de navigație, astfel încât traseele să poată fi redate în scopuri de testare. Mai dezvăluitor: traseele tale exacte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает GPS-треки навигации, чтобы поездки можно было воспроизвести для проверки. Раскрывает больше - это ваши точные маршруты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelar in dina navigerings-GPS-spår så att körningar kan spelas upp för testning. Avslöjar mer, dina exakta rutter."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записує GPS-треки навігації, щоб поїздки можна було відтворити для перевірки. Розкриває більше - ваші точні маршрути."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录您的导航 GPS 轨迹，以便回放行程进行测试。更敏感：您的精确路线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記錄您的導航 GPS 軌跡，以便回放行程進行測試。更敏感：您的精確路線。"
          }
        }
      }
    },
