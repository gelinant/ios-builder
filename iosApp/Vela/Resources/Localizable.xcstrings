    "settings_full_keeps_the_road_name_and" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كامل يحتفظ باسم الطريق والتعليمات التالية. المدمجة يسقط اسم الطريق. يحتفظ Minimal ببطاقة المناورة وتنبيهات السلامة فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vollständig behält den Straßennamen und die nächste Anweisung bei. Compact verzichtet auf den Straßennamen. Minimal behält nur die Manöverkarte und die Sicherheitswarnungen bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full keeps the road name and the next instruction. Compact drops the road name. Minimal keeps the maneuver card and the safety alerts only."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full keeps the road name and the next instruction. Compact drops the road name. Minimal keeps the maneuver card and the safety alerts only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completo mantiene el nombre de la carretera y la siguiente instrucción. Compact elimina el nombre de la carretera. Mínimo mantiene únicamente la tarjeta de maniobra y las alertas de seguridad."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full säilitab tee nime ja järgmise juhise. Kompaktne kaotab tee nime. Minimaalne säilitab ainult manöövrikaardi ja ohutushoiatused."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full conserve le nom de la route et l'instruction suivante. Compact supprime le nom de la route. Minimal conserve uniquement la carte de manœuvre et les alertes de sécurité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מלא שומר את שם הדרך ואת ההוראה הבאה. קומפקטי מפיל את שם הכביש. Minimal שומר את כרטיס התמרון ואת התראות הבטיחות בלבד."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Full megtartja az út nevét és a következő utasítást. A Compact eldobja az út nevét. A Minimális csak a manőverkártyát és a biztonsági figyelmeztetéseket tartja meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full mantiene il nome della strada e l'istruzione successiva. Compact elimina il nome della strada. Minimal conserva solo la scheda di manovra e gli avvisi di sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full は道路名と次の指示を保持します。コンパクトは道路名を削除します。 Minimal では、操作カードと安全警告のみを保持します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full bewaart de wegnaam en de volgende instructie. Compact laat de wegnaam vallen. Minimaal bewaart alleen de manoeuvrekaart en de veiligheidswaarschuwingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pełne zachowuje nazwę drogi i następną instrukcję. Compact rezygnuje z nazwy drogi. Minimal przechowuje wyłącznie kartę manewrów i ostrzeżenia dotyczące bezpieczeństwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full mantém o nome da estrada e a próxima instrução. Compact abandona o nome da estrada. Minimal guarda apenas o cartão de manobras e os alertas de segurança."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full mantém o nome da estrada e a próxima instrução. Compact abandona o nome da estrada. Minimal guarda apenas o cartão de manobras e os alertas de segurança."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full păstrează numele drumului și următoarea instrucțiune. Compact renunță la numele drumului. Minimal păstrează doar cardul de manevră și alertele de siguranță."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full сохраняет название дороги и следующую инструкцию. Компактный отказывается от названия дороги. Minimal сохраняет только карту маневров и предупреждения о безопасности."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polno ohrani ime ceste in naslednje navodilo. Compact izpusti ime ceste. Minimal ohrani samo manevrsko kartico in varnostna opozorila."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full behåller vägnamnet och nästa instruktion. Kompakt tar bort vägnamnet. Minimal behåller endast manöverkortet och säkerhetsvarningarna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam, yol adını ve bir sonraki talimatı tutar. Kompakt yol adını düşürür. Minimal, yalnızca manevra kartını ve güvenlik uyarılarını tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повний зберігає назву дороги та наступну інструкцію. Компактний пропускає назву дороги. Мінімальний зберігає лише картку маневру та сповіщення безпеки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完整保留道路名称和下一条指令。紧凑删除了道路名称。最小化仅保留机动卡和安全警报。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完整保留道路名稱和下一指令。緊湊刪除了道路名稱。最小化僅保留機動卡和安全警報。"
          }
        }
      }
    },
