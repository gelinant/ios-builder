    "settings_spoken_detail_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurz sagt jede Abbiegung einmal an, ohne Straßennamen. Nur Autobahnausfahrten bleibt in der Stadt still und meldet Ausfahrten, Gabelungen und Abbiegungen bei hohem Tempo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brief says each turn once, without the street name. Highway exits only stays quiet in town and speaks for exits, forks and turns taken at speed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breve anuncia cada giro una sola vez, sin el nombre de la calle. Solo salidas de autopista guarda silencio en ciudad y avisa de salidas, bifurcaciones y giros a alta velocidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bref annonce chaque virage une seule fois, sans le nom de la rue. Sorties d'autoroute seulement reste silencieux en ville et annonce les sorties, les bifurcations et les virages pris à vive allure."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בקצרה מכריז על כל פנייה פעם אחת, בלי שם הרחוב. רק יציאות מכביש מהיר נשאר שקט בעיר ומכריז על יציאות, התפצלויות ופניות במהירות גבוהה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Röviden minden kanyart egyszer mond be, utcanév nélkül. A Csak autópálya-lehajtók városban csendben marad, és a lehajtókat, elágazásokat és a nagy sebességnél vett kanyarokat mondja be."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breve annuncia ogni svolta una sola volta, senza il nome della strada. Solo uscite autostradali resta in silenzio in città e annuncia uscite, biforcazioni e svolte prese ad alta velocità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「簡潔」は各案内を一度だけ、道路名なしで読み上げます。「高速道路の出口のみ」は市街地では黙り、出口、分岐、高速走行中の右左折だけを読み上げます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kort meldt elke afslag één keer, zonder straatnaam. Alleen snelwegafritten blijft stil in de stad en meldt afritten, splitsingen en afslagen bij hoge snelheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krótko zapowiada każdy skręt raz, bez nazwy ulicy. Tylko zjazdy z autostrady milczy w mieście i zapowiada zjazdy, rozwidlenia oraz skręty przy dużej prędkości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breve anuncia cada curva uma só vez, sem o nome da rua. Apenas saídas de rodovia fica em silêncio na cidade e anuncia saídas, bifurcações e curvas feitas em alta velocidade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breve anuncia cada viragem uma só vez, sem o nome da rua. Apenas saídas de autoestrada fica em silêncio na cidade e anuncia saídas, bifurcações e viragens feitas a alta velocidade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instrucțiunile precizează că se spune o singură dată la fiecare viraj, fără a menționa numele străzii. În ceea ce privește ieșirile de pe autostradă, se păstrează tăcerea în interiorul localității și se anunță doar ieșirile, bifurcațiile și virajele efectuate la viteză mare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Кратко» объявляет каждый поворот один раз, без названия улицы. «Только съезды с шоссе» молчит в городе и объявляет съезды, развилки и повороты на высокой скорости."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kort säger varje sväng en gång, utan gatunamn. Endast motorvägsavfarter är tyst i stan och säger avfarter, vägdelningar och svängar i hög fart."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Коротко» оголошує кожен поворот один раз, без назви вулиці. «Лише з’їзди з автомагістралі» мовчить у місті й оголошує з’їзди, розвилки та повороти на високій швидкості."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“简短”每个转弯只播报一次，不读路名。“仅高速出口”在市区保持安静，只播报出口、岔路和高速行驶时的转弯。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「簡短」每個轉彎只播報一次，不唸路名。「僅高速公路出口」在市區保持安靜，只播報出口、岔路和高速行駛時的轉彎。"
          }
        }
      }
    },
