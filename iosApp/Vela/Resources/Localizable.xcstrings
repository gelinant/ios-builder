    "transit_colors_times_and_live_marks_come" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الألوان والأوقات والعلامات الحية تأتي من البث المفتوح Transitous. علامة المركبة هي تقدير Vela بين وقتين من أوقات الخلاصة؛ لا ينشر Transitous أي موضع للمركبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farben, Zeiten und Live-Markierungen stammen aus dem offenen Transitous-Feed. Der Fahrzeugmarker ist die Schätzung von Vela zwischen zwei eigenen Zeiten des Feeds; Transitous veröffentlicht keine Fahrzeugposition."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colors, times and live marks come from the Transitous open feed. The vehicle marker is Vela's estimate between two of the feed's own times; Transitous publishes no vehicle position."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colors, times and live marks come from the Transitous open feed. The vehicle marker is Vela's estimate between two of the feed's own times; Transitous publishes no vehicle position."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colores, tiempos y marcas en vivo provienen del feed abierto de Transitous. El marcador del vehículo es la estimación de Vela entre dos de los tiempos propios del feed; Transitous no publica ninguna posición del vehículo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värvid, ajad ja reaalajas märgid pärinevad Transitous avatud söödast. Sõiduki marker on Vela hinnang kahe sööda aja vahel; Transitous ei avalda sõiduki asukohta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les couleurs, les horaires et les repères en direct viennent du flux ouvert Transitous. Le repère du véhicule est l'estimation de Vela entre deux horaires du flux ; Transitous ne publie aucune position de véhicule."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צבעים, זמנים וסימנים חיים מגיעים מהפיד הפתוח של Transitous. סמן הרכב הוא אומדן של Vela בין שניים מהזמנים של הפיד עצמו; Transitous לא מפרסם עמדת רכב."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A színek, az idők és az élő jelek a Transitous nyitott feedből származnak. A járműjelző a Vela becslése a betáplálás két saját időpontja között; A Transitous nem tesz közzé járműpozíciót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colori, tempi e segni dal vivo provengono dal feed aperto Transitous. Il marcatore del veicolo è la stima di Vela tra due dei tempi del feed; Transitous non pubblica la posizione del veicolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カラー、時間、ライブ マークは Transitous オープン フィードから取得されます。車両マーカーは、フィード自体の 2 つの時間の間の Vela の推定値です。 Transitousは自車位置を公開しません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleuren, tijden en livemarkeringen komen uit de open feed van Transitous. De voertuigmarkering is de schatting van Vela tussen twee van de eigen tijdstippen van de feed; Transitous publiceert geen voertuigpositie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolory, czasy i znaczniki na żywo pochodzą z otwartego kanału Transitous. Znacznik pojazdu to oszacowanie Vela pomiędzy dwoma własnymi czasami źródła danych; Transitous nie publikuje pozycji pojazdu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cores, tempos e marcas ao vivo vêm do feed aberto do Transitous. O marcador do veículo é a estimativa do Vela entre dois tempos do próprio feed; Transitous não publica posição de veículo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cores, tempos e marcas ao vivo vêm do feed aberto do Transitous. O marcador do veículo é a estimativa do Vela entre dois tempos do próprio feed; Transitous não publica posição de veículo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Culorile, timpii și semnele live provin din fluxul deschis Transitous. Marcatorul vehiculului este estimarea lui Vela între doi timpi proprii a fluxului; Transitous nu publică nicio poziție a vehiculului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвета, время и живые отметки поступают из открытого канала Transitous. Маркер транспортного средства - это оценка Vela между двумя собственными моментами времени; Transitous не публикует местоположение автомобиля."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barve, časi in oznake v živo prihajajo iz odprtega vira Transitous. Oznaka vozila je ocena Vela med dvema lastnima časoma vira; Transitous ne objavlja položaja vozila."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färger, tider och livemärken kommer från Transitous öppet flöde. Fordonsmarkören är Vela:s uppskattning mellan två av flödets egna tider; Transitous publicerar ingen fordonsposition."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renkler, zamanlar ve canlı işaretler Transitous açık beslemesinden gelir. Araç işaretçisi, Vela'nin feed'in kendi zamanlarından ikisi arasındaki tahminidir; Transitous araç konumu yayınlamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кольори, час і живі позначки надходять із відкритого каналу Transitous. Маркер транспортного засобу є оцінкою Vela між двома власними часами каналу; Transitous не публікує положення автомобіля."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颜色、时间和实时标记来自 Transitous 开放式馈送。车辆标记是 Vela 在两个 feed 自身时间之间的估计； Transitous 未发布车辆位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顏色、時間和即時標記來自 Transitous 開放式饋送。車輛標記是 Vela 在兩個 feed 自身時間之間的估計； Transitous 未發布車輛位置。"
          }
        }
      }
    },
    "transit_countdowns_compare_the_feed_s_time" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم العد التنازلي بمقارنة وقت التغذية بساعتك. ولا يطلبون أوقاتًا جديدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Countdowns vergleichen die Zeit des Feeds mit Ihrer Uhr. Sie fordern keine neuen Zeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Countdowns compare the feed's time with your clock. They do not request new times."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Countdowns compare the feed's time with your clock. They do not request new times."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas regresivas comparan el tiempo del feed con su reloj. No solicitan nuevos tiempos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loendurid võrdlevad voo aega teie kellaga. Nad ei taotle uusi aegu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes à rebours comparent l'heure du flux avec votre horloge. Ils ne demandent pas de nouveaux horaires."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ספירה לאחור משווה את הזמן של הפיד עם השעון שלך. הם לא מבקשים זמנים חדשים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A visszaszámlálók összehasonlítják a hírfolyam idejét az Ön órájával. Nem kérnek új időpontokat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I conti alla rovescia confrontano l'ora del feed con il tuo orologio. Non richiedono nuovi orari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カウントダウンでは、フィードの時間を時計と比較します。彼らは新しい時間を要求しません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Countdowns vergelijken de tijd van de feed met uw klok. Ze vragen niet om nieuwe tijden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odliczanie porównuje czas kanału z zegarem. Nie żądają nowych czasów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contagens regressivas comparam o tempo do feed com o seu relógio. Eles não solicitam novos tempos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contagens regressivas comparam o tempo do feed com o seu relógio. Eles não solicitam novos tempos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numărătoarea inversă compară timpul din feed cu ceasul tău. Ei nu cer timpuri noi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обратный отсчет сравнивает время ленты с вашими часами. Они не просят новых времен."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odštevalniki primerjajo čas vira z vašo uro. Ne zahtevajo novih časov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedräkningar jämför flödets tid med din klocka. De efterfrågar inte nya tider."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri sayımlar, yayının süresini saatinizle karşılaştırır. Yeni zamanlar talep etmiyorlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зворотний відлік порівнює час стрічки з вашим годинником. Вони не вимагають нового часу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "倒计时将提要的时间与您的时钟进行比较。他们不要求新的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "倒數計時將提要的時間與您的時鐘進行比較。他們不要求新的時間。"
          }
        }
      }
    },
