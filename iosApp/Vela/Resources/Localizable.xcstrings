    "settings_two_finger_tilt_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit zwei Fingern nach oben oder unten ziehen, um die Karte in 3D zu neigen. Aus: Zwei Finger zoomen nur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag two fingers up or down to tilt the map into 3D. Off: a pinch only ever zooms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra dos dedos hacia arriba o abajo para inclinar el mapa en 3D. Desactivado: el pellizco solo hace zoom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser deux doigts vers le haut ou le bas pour incliner la carte en 3D. Désactivé : le pincement ne fait que zoomer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרור שתי אצבעות למעלה או למטה כדי להטות את המפה לתלת-ממד. כבוי: צביטה רק משנה את הזום."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzd két ujjal fel vagy le a térkép 3D-s megdöntéséhez. Kikapcsolva: a csippentés csak nagyít."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina due dita su o giù per inclinare la mappa in 3D. Disattivato: il pizzico serve solo per lo zoom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 本指で上下にドラッグすると地図を 3D に傾けられます。オフにすると、ピンチ操作はズームだけになります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep met twee vingers omhoog of omlaag om de kaart in 3D te kantelen. Uit: knijpen zoomt alleen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij dwoma palcami w górę lub w dół, aby pochylić mapę do widoku 3D. Wyłączone: uszczypnięcie zawsze tylko zmienia powiększenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste dois dedos para cima ou para baixo para inclinar o mapa em 3D. Desativado: o gesto de pinça só dá zoom."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste dois dedos para cima ou para baixo para inclinar o mapa para 3D. Desligado: o gesto de pinça só aplica zoom."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage două degete în sus sau în jos pentru a înclina harta în 3D. Dezactivat: Ciupirea degetelor modifică doar nivelul de zoom."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведите двумя пальцами вверх или вниз, чтобы наклонить карту в 3D. Выкл.: щипок только меняет масштаб."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z dvema prstoma povlecite navzgor ali navzdol za nagib zemljevida v 3D. Če je izklopljeno, ščipanje samo spreminja povečavo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra två fingrar uppåt eller nedåt för att luta kartan till 3D. Av: en nypning zoomar bara."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведіть двома пальцями вгору або вниз, щоб нахилити карту в 3D. Вимкнено: зведення пальців лише масштабує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双指向上或向下拖动，可将地图倾斜为 3D 视角。关闭后，双指捏合只会缩放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用兩指向上或向下拖曳，即可將地圖傾斜成 3D 視角。關閉時，雙指捏合只會縮放。"
          }
        }
      }
    },
