    "settings_voice_nav_sample_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biegen Sie in 400 Metern rechts in die Hauptstraße ab, Ihr Ziel liegt dann auf der linken Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a quarter mile, turn right onto Main Street, then your destination is on the left."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cuatrocientos metros, gira a la derecha hacia la calle Mayor; después tu destino estará a la izquierda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans quatre cents mètres, tournez à droite sur la rue de la Paix, puis votre destination sera sur la gauche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בעוד ארבע מאות מטר, פנה ימינה לרחוב הראשי, ואז היעד יהיה מצד שמאל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "400 méter múlva fordulj jobbra a Fő utcára, majd a célod bal oldalon lesz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tra quattrocento metri svolta a destra in Via Roma, poi la destinazione è sulla sinistra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "400メートル先、中央通りを右折です。その先、目的地は左側です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sla over 400 meter rechts af de Dorpsstraat in; uw bestemming bevindt zich dan aan de linkerkant."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za czterysta metrów skręć w prawo w ulicę Główną, a cel będzie po lewej stronie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em 400 metros, vire à direita na Rua Principal e o seu destino ficará à esquerda."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dentro de 400 metros, vire à direita para a Rua Principal e o seu destino fica à esquerda."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După un sfert de kilometru, virează la dreapta pe strada principală, apoi destinația este pe partea stângă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через четыреста метров поверните направо на Тверскую улицу, пункт назначения будет слева."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čez približno 400 metrov zavijte desno na Glavno ulico, nato je cilj na levi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om 400 meter, sväng höger in på Storgatan, sedan är ditt mål till vänster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşık 400 metre sonra sağa, Ana Cadde'ye dönün, hedefiniz solunuzda kalacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через чверть кілометра поверніть праворуч на вулицю Хрещатик, потім пункт призначення буде ліворуч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "四百米后右转，进入中山路，然后您的目的地在左侧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "四百公尺後右轉進入中山路，接著目的地就在左側。"
          }
        }
      }
    },
    "settings_voice_no_neural_language_ios" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ has no downloadable Vela voice. Directions are shown and spoken with the iPhone voice for this language."
          }
        }
      }
    },
    "settings_voice_none_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Stimme, öffnen Sie unten die Stimmenbibliothek, um eine natürliche Stimme direkt auf dem Gerät herunterzuladen (kein Konto, in Echtzeit auch auf älteren Telefonen). Eine installierte System-TTS-Engine erscheint hier ebenfalls zur Auswahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No voice yet. Open Voice library below to download a natural on-device voice (no account, real-time even on old phones). A system TTS engine you install will also appear here to pick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay voz: abre la Biblioteca de voces de más abajo para descargar una voz natural en el dispositivo (sin cuenta, en tiempo real incluso en teléfonos antiguos). Un motor de TTS del sistema que instales también aparecerá aquí para elegirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune voix pour l'instant, ouvrez la Bibliothèque de voix ci-dessous pour télécharger une voix naturelle sur l'appareil (sans compte, en temps réel même sur les anciens téléphones). Un moteur de synthèse vocale installé sur le système apparaîtra aussi ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין עדיין קול. פתח את \"ספריית הקולות\" למטה כדי להוריד קול טבעי שפועל במכשיר (ללא חשבון, בזמן אמת גם בטלפונים ישנים). גם מנוע TTS של המערכת שתתקין יופיע כאן לבחירה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincs hang. Nyisd meg lent a Hangkönyvtárat, hogy letölts egy természetes, telefonon futó hangot (fiók nélkül, valós időben régi telefonokon is). A telepített rendszer TTS-motorok is itt jelennek meg választható opcióként."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessuna voce: apri la Libreria voci qui sotto per scaricare una voce naturale sul dispositivo (nessun account, in tempo reale anche su telefoni datati). Anche un motore TTS di sistema installato apparirà qui tra le scelte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声はまだありません。下の音声ライブラリを開いて、端末上で動く自然な音声をダウンロードしてください（アカウント不要、古い端末でもリアルタイムで動作します）。インストール済みのシステム TTS エンジンもここに表示され、選択できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen stem, open hieronder de Stembibliotheek om een natuurlijke stem op het toestel te downloaden (geen account, realtime zelfs op oude telefoons). Een geïnstalleerde systeem-TTS-engine verschijnt hier ook om te kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak głosu, otwórz Bibliotekę głosów poniżej, aby pobrać naturalny głos działający na urządzeniu (bez konta, w czasie rzeczywistym nawet na starszych telefonach). Zainstalowany systemowy silnik TTS również pojawi się tutaj do wyboru."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda sem voz. Abra a Biblioteca de vozes abaixo para baixar uma voz natural no dispositivo (sem conta, em tempo real mesmo em celulares antigos). Um mecanismo de TTS do sistema que você instalar também aparecerá aqui para escolher."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda sem voz, abra a Biblioteca de vozes abaixo para transferir uma voz natural no dispositivo (sem conta, em tempo real mesmo em telemóveis antigos). Um motor TTS do sistema que instale também aparecerá aqui para escolher."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicio voce încă. Deschide biblioteca vocală de mai jos pentru a descărca o voce naturală pe dispozitiv (fără cont, în timp real chiar și pe telefoanele vechi). Un motor TTS de sistem instalat va apărea și aici, pentru a-l selecta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голос ещё не выбран, откройте «Библиотека голосов» ниже, чтобы загрузить естественный голос прямо на устройство (без учётной записи, работает в реальном времени даже на старых телефонах). Установленный вами системный движок TTS тоже появится здесь для выбора."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glas še ni nameščen. V spodnji knjižnici glasov lahko prenesete naravni glas, ki deluje v napravi brez računa in v realnem času tudi na starejših telefonih. Prikazan bo tudi nameščeni sistemski mehanizem za pretvorbo besedila v govor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen röst ännu, öppna Röstbiblioteket nedan för att hämta en naturlig röst på enheten (inget konto, i realtid även på äldre telefoner). En system-TTS-motor som du installerar visas också här att välja."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz ses yok. Aşağıdaki Ses kütüphanesini açarak cihaz üzerinde doğal bir ses indirebilirsiniz (hesap gerektirmez, eski telefonlarda bile gerçek zamanlı olarak çalışır). Yüklediğiniz bir sistem TTS motoru da burada seçilebilecek seçenekler arasında görünecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голосу ще немає, відкрийте «Бібліотеку голосів» нижче, щоб завантажити природний голос на пристрій (без облікового запису, у реальному часі навіть на старих телефонах). Встановлений вами системний рушій TTS теж з’явиться тут для вибору."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚无语音。打开下方的语音库，下载自然流畅的设备端语音（无需账号，旧手机也能实时合成）。您安装的系统 TTS 引擎也会显示在这里供选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未安裝語音。開啟下方的語音庫，即可下載自然的裝置端語音（不需帳戶，舊手機也能即時運作）。你另外安裝的系統文字轉語音引擎也會出現在這裡供選擇。"
          }
        }
      }
    },
