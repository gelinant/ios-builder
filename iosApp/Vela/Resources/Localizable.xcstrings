    "settings_lists_export_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichern Sie Ihre Listen in einer Datei oder stellen Sie sie auf einem anderen Gerät wieder her. Beim Importieren kann auch eine Liste aus dem Ordner „Gespeichert“ von Google Takeout übernommen werden (eine CSV-Datei pro Liste); dabei wird jeder Ort in der Liste nachgeschlagen, daher ist eine Internetverbindung erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back up your lists to a file, or restore them on another device. Import also takes a list from Google Takeout's Saved folder (one CSV per list); each place in it is looked up, so it needs a connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una copia de tus listas en un archivo o restáuralas en otro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegardez vos listes dans un fichier ou restaurez-les sur un autre appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גבה את הרשימות שלך לקובץ, או שחזר אותן במכשיר אחר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentsd el a listáidat egy fájlba, vagy állítsd vissza egy másik eszközön."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva le tue liste in un file o ripristinale su un altro dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストをファイルにバックアップしたり、別の端末で復元したりできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een back-up van je lijsten naar een bestand of herstel ze op een ander apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz kopię zapasową list do pliku lub przywróć je na innym urządzeniu. Funkcja importu obsługuje również listy z folderu „Zapisane” w usłudze Google Takeout (jeden plik CSV na listę); każde znajdujące się na nich miejsce jest wyszukiwane więc wymagane jest połączenie z internetem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça um backup das suas listas em um arquivo ou restaure-as em outro dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça uma cópia das suas listas num ficheiro ou restaure-as noutro dispositivo. A opção de importação também aceita listas da pasta \"Salvos\" do Google Takeout (um ficheiro CSV por lista); cada local nela é pesquisado, pelo que é necessária uma ligação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creează o copie de rezervă a listelor într-un fișier sau restaurează pe un alt dispozitiv. Funcția de import preia, de asemenea, o listă din dosarul „Salvate” al serviciului Google Takeout (un fișier CSV pentru fiecare listă); fiecare locație din aceasta este căutată, așa că este necesară o conexiune la internet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните списки в файл или восстановите их на другом устройстве."
          }
        },
        "sv" : {
          "stringUnit" : {
