    "settings_map_colors_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modern entspricht der aktuellen Google-Palette. Klassisch ist der frühere Vela-Look: weiße Straßen, gelbe Autobahnen, kräftige Grüntöne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modern matches the Google app's current palette. Classic is Vela's earlier look: white roads, yellow motorways, true greens. Contrast is a night map with warm streets on slate land, for a glance from a mount; by day it draws as Modern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderno sigue la paleta actual de Google Maps. Clásico es el aspecto anterior de Vela: carreteras blancas, autopistas amarillas, verdes intensos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderne reprend la palette actuelle de Google Maps. Classique est l'ancien style de Vela : routes blanches, autoroutes jaunes, verts francs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מודרני תואם את פלטת הצבעים הנוכחית של אפליקציית Google. קלאסי הוא המראה המוקדם של Vela: כבישים לבנים, כבישים מהירים צהובים, ירוקים אמיתיים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Modern a Google app jelenlegi palettáját követi. A Klasszikus a Vela korábbi kinézete: fehér utak, sárga autópályák, valódi zöldek. A kettő sötét módban különbözik leginkább jelenleg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderno segue la palette attuale di Google Maps. Classico è il vecchio aspetto di Vela: strade bianche, autostrade gialle, verdi pieni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モダンは Google アプリの現在の配色に合わせています。クラシックは Vela の以前の見た目です：白い道路、黄色い高速道路、本来の緑。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modern volgt het huidige palet van Google Maps. Klassiek is de eerdere look van Vela: witte wegen, gele snelwegen, echte groentinten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styl „Nowoczesny” odpowiada aktualnej palecie kolorystycznej aplikacji Google. „Klasyczny” to wcześniejszy wygląd mapy Vela: białe drogi, żółte autostrady i wyraziste odcienie zieleni. „Kontrast” to mapa w wersji nocnej – z ciepłymi barwami ulic na tle w kolorze łupka przypominająca widok z górskiego szczytu; w ciągu dnia prezentuje się natomiast tak samo jak styl „Nowoczesny”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderno segue a paleta atual do Google Maps. Clássico é o visual anterior do Vela: ruas brancas, rodovias amarelas, verdes fortes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderno segue a paleta atual do Google Maps. Clássico é o visual anterior do Vela: estradas brancas, autoestradas amarelas, verdes fortes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modul „Modern” se potrivește cu paleta actuală a aplicației Google. Modul „Classic” reprezintă aspectul anterior al aplicației Vela: drumuri albe, autostrăzi galbene, nuanțe de verde naturale. Modul „Contrast” este o hartă nocturnă cu străzi în culori calde pe un fundal de ardezie, pentru o priveliște de pe un vârf de munte; în timpul zilei, se afișează ca modul „Modern”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Современные повторяют текущую палитру Google Maps. Классические возвращают прежний вид Vela: белые дороги, жёлтые магистрали, насыщенная зелень."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modern följer Google Maps nuvarande palett. Klassisk är Velas tidigare utseende: vita vägar, gula motorvägar, riktiga gröna toner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сучасні повторюють поточну палітру Google Maps. Класичні повертають попередній вигляд Vela: білі дороги, жовті магістралі, насичена зелень."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现代与 Google 应用当前的配色一致。经典是 Vela 早期的样式：白色道路、黄色高速公路、纯正的绿色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現代與 Google 應用程式目前的配色一致。經典是 Vela 早期的樣式：白色道路、黃色高速公路、純正的綠色。"
          }
        }
      }
    },
