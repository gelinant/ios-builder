    "transit_ferry_is_not_offered_by_the" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتم تقديم العبارة بواسطة مخطط Transitous. إن ترك كل مركبة خارج الخدمة يتطلب كل الأربعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fähren werden vom Transitous-Planer nicht angeboten. Wenn Sie jedes Fahrzeug abstellen, werden alle vier benötigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry is not offered by the Transitous planner. Leaving every vehicle off asks for all four."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferry is not offered by the Transitous planner. Leaving every vehicle off asks for all four."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El planificador Transitous no ofrece ferry. Al dejar todos los vehículos apagados se solicitan los cuatro."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parvlaeva Transitous planeerija ei paku. Iga sõiduki väljajätmine nõuab kõiki nelja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ferry n'est pas proposé par le planificateur Transitous. Laisser chaque véhicule à l’arrêt demande les quatre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעבורת אינה מוצעת על ידי מתכנן Transitous. השארת כל רכב מחייבת את כל הארבעה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kompot a Transitous tervező nem kínálja. Ha minden járművet kikapcsolunk, az mind a négyet kéri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il traghetto non è offerto dal pianificatore Transitous. Lasciando spenti tutti i veicoli, sono necessari tutti e quattro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フェリーは Transitous プランナーでは提供されません。すべての車両を停止したままにすると、4 台すべてが要求されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veerboot wordt niet aangeboden door de Transitous planner. Als u elk voertuig uitzet, vraagt ​​u om alle vier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prom nie jest oferowany przez planistę Transitous. Pozostawienie każdego pojazdu wyłączonego wymaga włączenia wszystkich czterech."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A balsa não é oferecida pelo planejador Transitous. Deixar todos os veículos desligados exige todos os quatro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A balsa não é oferecida pelo planejador Transitous. Deixar todos os veículos desligados exige todos os quatro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feribotul nu este oferit de planificatorul Transitous. Lăsând fiecare vehicul oprit, sunt necesare pe toate patru."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планировщик Transitous не предлагает переправу. Если оставить каждое транспортное средство выключенным, требуются все четыре."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planer Transitous ne ponuja trajekta. Če izpustite vsako vozilo, zahtevate vsa štiri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färja erbjuds inte av Transitous-planeraren. Att lämna varje fordon avstängd kräver alla fyra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feribot Transitous planlayıcısı tarafından sunulmamaktadır. Her aracı kapalı bırakmak dördünü de gerektirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пором не пропонує планувальник Transitous. Залишаючи всі транспортні засоби вимкненими, запитує всі чотири."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous 规划者不提供轮渡。让每辆车都关闭需要所有四辆车。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous 規劃者不提供渡輪。讓每輛車都關閉需要所有四輛車。"
          }
        }
      }
    },
