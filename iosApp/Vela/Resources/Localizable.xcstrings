    "search_without_google_search_uses_photon_and" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون Google، يستخدم البحث الفوتون والمناطق التي تم تنزيلها. لا يفعلون ذلك"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Google verwendet die Suche Photon und heruntergeladene Regionen. Das tun sie nicht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without Google, search uses Photon and downloaded regions. They do not"
