    "settings_voice_speed_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsamere oder schnellere Ansagen, tippen Sie auf − / + (es wird ein Beispiel gesprochen). 1,00× ist normal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slower or faster spoken directions. Tap − / + (it speaks a sample). 1.00× is normal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicaciones habladas más lentas o más rápidas: toca − / + (reproduce un ejemplo). 1,00× es la velocidad normal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instructions vocales plus lentes ou plus rapides, appuyez sur − / + (un exemple est lu). 1,00× correspond à la vitesse normale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוראות מדוברות איטיות או מהירות יותר. הקש − / + (הוא ישמיע דוגמה). 1.00× היא המהירות הרגילה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lassabb vagy gyorsabb hangos útvonalvezetés. Koppints a −/+ gombra (egy mintát mond). 1,00× a normál."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicazioni più lente o più veloci: tocca − / + (pronuncia un esempio). 1,00× è la velocità normale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声案内をゆっくり、または速くします。− / + をタップしてください（サンプルを読み上げます）。標準は 1.00× です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langzamere of snellere gesproken instructies, tik op − / + (er wordt een voorbeeld afgespeeld). 1,00× is normaal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wolniejsze lub szybsze wskazówki głosowe, dotknij − / + (odtworzy próbkę). 1,00× to tempo normalne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instruções faladas mais lentas ou mais rápidas: toque em − / + (reproduz uma amostra). 1,00× é o normal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicações faladas mais lentas ou mais rápidas, toque em − / + (reproduz uma amostra). 1,00× é normal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicații rostite mai lent sau mai rapid. Atinge − / + (se rostește un eșantion). 1,00× este normal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замедлить или ускорить голосовые подсказки, нажимайте − / + (проиграется пример). Обычная скорость: 1,00×."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počasnejša ali hitrejša govorna navodila. Dotaknite se − ali + za predvajanje primera. 1,00× je običajna hitrost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Långsammare eller snabbare talade vägbeskrivningar, tryck på − / + (ett exempel läses upp). 1,00× är normalt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повільніші або швидші голосові вказівки, натискайте − / + (озвучується приклад). Звичайна швидкість: 1,00×."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调慢或调快语音播报。点按 − / +（会朗读示例）。1.00× 为正常语速。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓語音指引更慢或更快。點按 − / +（會朗讀範例）。1.00× 為正常速度。"
          }
        }
      }
