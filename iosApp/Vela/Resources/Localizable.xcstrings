    "settings_details_retry_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google lässt die Stoßzeiten in der ersten Antwort oft weg, daher fragt Vela bis zu zweimal nach. Aus = eine Anfrage pro Ort, und die Stoßzeiten können fehlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google often leaves popular times out of its first answer, so Vela asks up to twice more. Off = one request per place, and popular times may be missing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google suele omitir la afluencia en su primera respuesta, así que Vela vuelve a preguntar hasta dos veces. Desactivado = una petición por lugar, y puede faltar la afluencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google omet souvent l'affluence dans sa première réponse, alors Vela redemande jusqu'à deux fois. Désactivé = une requête par lieu, et l'affluence peut manquer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גוגל משמיט לעיתים קרובות את שעות העומס בתשובה הראשונה, ולכן Vela שואל עד פעמיים נוספות. כבוי = בקשה אחת לכל מקום, ושעות העומס עלולות לחסור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Google az első válaszból gyakran kihagyja a forgalmas időszakokat, ezért a Vela legfeljebb még kétszer rákérdez. Ki = helyenként egy kérés, és a forgalmas időszakok hiányozhatnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google spesso omette gli orari di punta nella prima risposta, quindi Vela richiede fino ad altre due volte. Disattivato = una richiesta per luogo, e gli orari di punta possono mancare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Googleは最初の応答で混雑する時間帯を省くことが多いため、Velaは最大2回まで再度問い合わせます。オフにすると場所ごとに1回だけになり、混雑する時間帯が表示されないことがあります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google laat de drukke tijden vaak weg in het eerste antwoord, dus Vela vraagt tot twee keer opnieuw. Uit = één verzoek per plaats, en de drukke tijden kunnen ontbreken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google często pomija godziny szczytu w pierwszej odpowiedzi, więc Vela pyta ponownie do dwóch razy. Wyłączone = jedno zapytanie na miejsce, a godzin szczytu może zabraknąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Google costuma omitir os horários de pico na primeira resposta, então o Vela pergunta de novo até duas vezes. Desativado = uma solicitação por local, e os horários de pico podem faltar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Google costuma omitir os horários de pico na primeira resposta, então o Vela pergunta de novo até duas vezes. Desligado = um pedido por local, e os horários de pico podem faltar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google omite adesea orele de vârf din primul răspuns, așa că Vela mai face încă două încercări. Opțiunea „Oprit” înseamnă o singură solicitare per locație, iar orele de vârf ar putea lipsi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google часто не включает загруженность в первый ответ, поэтому Vela переспрашивает до двух раз. Выключено = один запрос на место, и загруженность может не показаться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google utelämnar ofta populära tider i första svaret, så Vela frågar upp till två gånger till. Av = en förfrågan per plats, och populära tider kan saknas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google часто не включає завантаженість у першу відповідь, тому Vela перепитує до двох разів. Вимкнено = один запит на місце, і завантаженість може не з'явитися."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 常在第一次答复中省略热门时段，因此 Vela 最多再询问两次。关闭后每个地点只请求一次，可能缺少热门时段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 常在第一次回覆中省略熱門時段，因此 Vela 最多再詢問兩次。關閉後每個地點只請求一次，可能缺少熱門時段。"
          }
        }
      }
    },
