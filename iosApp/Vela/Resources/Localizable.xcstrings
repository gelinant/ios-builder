    "settings_spoken_road_names_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aus, werden Abbiegungen ohne Straßennamen angesagt, also „Links abbiegen“ statt „Links abbiegen in die Hauptstraße“. Karte und Wegbeschreibung zeigen ihn weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off, turns are announced without the street name: \"Turn left\" instead of \"Turn left onto Maple Street\". The map and the step list still show it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivado, los giros se anuncian sin el nombre de la calle: «Gira a la izquierda» en vez de «Gira a la izquierda por la calle Mayor». El mapa y la lista de pasos lo siguen mostrando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé, les changements de direction sont annoncés sans le nom de la rue : « Tournez à gauche » au lieu de « Tournez à gauche sur la rue Principale ». La carte et la liste des étapes l'affichent toujours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשכבוי, הפניות מוכרזות בלי שם הרחוב: \"פנה שמאלה\" במקום \"פנה שמאלה לרחוב הרצל\". המפה ורשימת השלבים עדיין מציגות אותו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kikapcsolva a kanyarok utcanév nélkül hangzanak el: \"Fordulj balra\" a \"Fordulj balra a Fő utcára\" helyett. A térkép és a lépéslista továbbra is mutatja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disattivato, le svolte vengono annunciate senza il nome della strada: \"Svolta a sinistra\" invece di \"Svolta a sinistra in Via Roma\". La mappa e l'elenco dei passaggi lo mostrano comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、曲がる案内で道路名を読み上げません（「中央通りを左折です」ではなく「左折です」）。地図とルート詳細には引き続き表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit, dan worden afslagen zonder straatnaam aangekondigd: \"Sla linksaf\" in plaats van \"Sla linksaf de Dorpsstraat in\". De kaart en de stappenlijst tonen hem nog steeds."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączone: skręty są zapowiadane bez nazwy ulicy, \"Skręć w lewo\" zamiast \"Skręć w lewo w ulicę Klonową\". Mapa i lista etapów nadal ją pokazują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado, as mudanças de direção são anunciadas sem o nome da rua: \"Vire à esquerda\" em vez de \"Vire à esquerda na Rua das Flores\". O mapa e a lista de etapas continuam mostrando o nome."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado, as mudanças de direção são anunciadas sem o nome da rua: \"Vire à esquerda\" em vez de \"Vire à esquerda para a Rua das Flores\". O mapa e a lista de etapas continuam a mostrá-lo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În modul „Oprit”, indicațiile de viraj sunt anunțate fără numele străzii: „Virează la stânga” în loc de „Virează la stânga pe strada București”. Harta și lista de pași continuă să afișeze acest lucru."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выключено, повороты объявляются без названия улицы: «Поверните налево» вместо «Поверните налево на Кленовую улицу». На карте и в списке шагов название остаётся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av = svängar meddelas utan gatunamnet: ”Sväng vänster” i stället för ”Sväng vänster in på Lönngatan”. Kartan och steglistan visar det fortfarande."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимк. = повороти оголошуються без назви вулиці: «Поверніть ліворуч» замість «Поверніть ліворуч на Кленову вулицю». На карті й у списку кроків назва залишається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，转弯播报不含街道名称：播报“左转”而不是“左转进入中山路”。地图和步骤列表中仍会显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉時，轉彎提示不會唸出街道名稱：只說「左轉」，而不是「左轉進入中山路」。地圖和步驟清單仍會顯示。"
          }
        }
      }
    },
