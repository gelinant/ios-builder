    "settings_other_locations_auto_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Namenssuche bei einem einzelnen Ort landet, wird Google auch nach dessen weiteren Standorten gefragt. Das sind bei jeder solchen Suche ein paar zusätzliche Anfragen an Google. Wenn aus, erledigt das die Schaltfläche „Weitere Standorte anzeigen“, sobald Sie darauf tippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a name search lands on one place, also ask Google for its other locations. That is a few more requests to Google with each such search. Off, a \"Show other locations\" button does it when you tap it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando una búsqueda por nombre da con un solo lugar, también se pregunta a Google por sus otras ubicaciones. Son unas pocas peticiones más a Google en cada búsqueda de ese tipo. Desactivado, lo hace el botón «Mostrar otras ubicaciones» cuando lo tocas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand une recherche par nom aboutit à un seul lieu, demande aussi à Google ses autres adresses. Cela représente quelques requêtes Google en plus à chaque recherche de ce type. Désactivé, un bouton « Afficher les autres adresses » le fait quand vous le touchez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשחיפוש לפי שם מגיע למקום אחד, היישום מבקש מ־Google גם את הסניפים האחרים שלו. אלה כמה בקשות נוספות ל־Google בכל חיפוש כזה. כשכבוי, כפתור \"הצגת סניפים אחרים\" עושה זאת כשמקישים עליו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha egy névre keresés egyetlen helyet talál, a Vela a Google-től a többi helyszínét is lekéri. Ez minden ilyen keresésnél néhány további kérés a Google felé. Kikapcsolva a „További helyszínek megjelenítése” gomb teszi ezt meg, amikor rákoppintasz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando la ricerca di un nome porta a un solo luogo, chiede a Google anche le sue altre sedi. Sono alcune richieste in più a Google per ogni ricerca di questo tipo. Se disattivato, lo fa il pulsante \"Mostra altre sedi\" quando lo tocchi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前で検索して 1 件の場所に絞られたとき、ほかの店舗も Google に問い合わせます。該当する検索のたびに Google へのリクエストが数回増えます。オフにすると、「ほかの店舗を表示」ボタンをタップしたときだけ問い合わせます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als een zoekopdracht op naam bij één plaats uitkomt, vraagt Vela Google ook naar de andere locaties. Dat zijn bij elke zoekopdracht van dit soort een paar extra verzoeken aan Google. Uit: een knop \"Andere locaties tonen\" doet dit wanneer je erop tikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy wyszukiwanie nazwy trafia na jedno miejsce, Vela pyta też Google o jego inne lokalizacje. To kilka dodatkowych zapytań do Google przy każdym takim wyszukiwaniu. Po wyłączeniu robi to przycisk „Pokaż inne lokalizacje”, gdy go dotkniesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando uma pesquisa por nome chega a um único local, pergunta também ao Google pelas outras unidades. São algumas solicitações a mais ao Google a cada pesquisa desse tipo. Desativado, um botão \"Mostrar outras unidades\" faz isso quando você toca nele."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando uma pesquisa por nome dá um só local, pede também à Google as outras localizações. São mais alguns pedidos à Google em cada pesquisa desse tipo. Desligado, um botão \"Mostrar outras localizações\" faz isso quando lhe toca."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atunci când căutarea după denumire găsește o singură locație, Vela solicită, de asemenea, de la Google informații despre celelalte locații ale acesteia. Aceasta înseamnă câteva cereri suplimentare către Google la fiecare astfel de căutare. Dacă această opțiune este dezactivată, butonul „Afișează alte locații” are același efect atunci când îl apeși."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда поиск по названию находит одно место, Vela также запрашивает у Google другие его филиалы. Это несколько дополнительных запросов к Google при каждом таком поиске. Если выключено, то же самое делает кнопка «Показать другие филиалы», когда вы её нажимаете."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När en namnsökning hamnar på en enda plats frågar Vela också Google efter dess andra filialer. Det blir några fler förfrågningar till Google vid varje sådan sökning. Av: knappen ”Visa andra filialer” gör det när du trycker på den."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли пошук за назвою знаходить одне місце, Vela також запитує в Google про інші його розташування. Це ще кілька запитів до Google на кожен такий пошук. Якщо вимкнено, це робить кнопка «Показати інші розташування», коли ви її натискаєте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按名称搜索只找到一个地点时，同时向 Google 查询它的其他分店。每次这样的搜索会向 Google 多发几次请求。关闭后，点按“显示其他分店”按钮时才会查询。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當名稱搜尋只找到一個地點時，也會向 Google 查詢它的其他分店。每次這類搜尋都會多向 Google 發出幾次請求。關閉時，改由「顯示其他分店」按鈕在你點按時查詢。"
          }
        }
      }
    },
