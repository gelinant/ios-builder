    "voice_download_a_speech_model_to_search" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحميل نموذج كلام للبحث بالصوت بدون شبكة. مع عدم تثبيت أي شيء، يستخدم Vela ميزة التعرف على الجهاز من Apple عندما يكون متاحًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laden Sie ein Sprachmodell herunter, um ohne Netzwerk per Sprache zu suchen. Wenn keine installiert ist, nutzt Vela die Geräteerkennung von Apple, sofern diese verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download a speech model to search by voice without a network. With none installed, Vela uses Apple's on-device recognition when it is available."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download a speech model to search by voice without a network. With none installed, Vela uses Apple's on-device recognition when it is available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga un modelo de voz para buscar por voz sin red. Sin ninguno instalado, Vela utiliza el reconocimiento del dispositivo de Apple cuando está disponible."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laadige alla kõnemudel, et otsida häält ilma võrguta. Kui ühtegi pole installitud, kasutab Vela Apple'i seadmesisest tuvastamist, kui see on saadaval."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez un modèle vocal pour effectuer une recherche vocale sans réseau. Sans aucun installé, Vela utilise la reconnaissance sur l'appareil d'Apple lorsqu'elle est disponible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הורד דגם דיבור לחיפוש בקול ללא רשת. כאשר אף אחד לא מותקן, Vela משתמש בזיהוי במכשיר של אפל כאשר הוא זמין."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Töltse le a beszédmodellt a hangalapú kereséshez hálózat nélkül. Ha nincs telepítve, a Vela az Apple eszközfelismerését használja, amikor az elérhető."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica un modello vocale per effettuare ricerche vocali senza rete. Senza nessuno installato, Vela utilizza il riconoscimento sul dispositivo di Apple quando è disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声モデルをダウンロードすると、ネットワークを介さずに音声で検索できます。何もインストールされていない場合、Vela は Apple のオンデバイス認識が利用可能な場合にはそれを使用します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download een spraakmodel om spraakgestuurd te zoeken zonder netwerk. Als er geen is geïnstalleerd, gebruikt Vela de herkenning op het apparaat van Apple wanneer deze beschikbaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobierz model mowy, aby wyszukiwać głosowo bez sieci. Jeśli nie jest on zainstalowany, Vela korzysta z rozpoznawania urządzenia Apple, jeśli jest ono dostępne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixe um modelo de fala para pesquisar por voz sem rede. Sem nenhum instalado, o Vela usa o reconhecimento no dispositivo da Apple quando está disponível."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixe um modelo de fala para pesquisar por voz sem rede. Sem nenhum instalado, o Vela usa o reconhecimento no dispositivo da Apple quando está disponível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descărcați un model de vorbire pentru a căuta prin voce fără o rețea. Cu niciunul instalat, Vela folosește recunoașterea Apple pe dispozitiv atunci când este disponibilă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузите модель речи для голосового поиска без сети. Если ничего не установлено, Vela использует распознавание Apple на устройстве, когда оно доступно."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenesite govorni model za glasovno iskanje brez omrežja. Ker ni nameščen noben, Vela uporablja Applovo prepoznavanje v napravi, ko je na voljo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladda ner en talmodell för att söka med röst utan nätverk. Med ingen installerad använder Vela Apples igenkänning på enheten när den är tillgänglig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ olmadan sesle arama yapmak için bir konuşma modeli indirin. Hiçbiri kurulu olmadığında Vela, kullanılabilir olduğunda Apple'ın cihaz içi tanıma özelliğini kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантажте модель мовлення для голосового пошуку без мережі. Якщо жодного не встановлено, Vela використовує функцію розпізнавання Apple на пристрої, якщо вона доступна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载语音模型，无需网络即可进行语音搜索。如果未安装任何设备，Vela 会使用 Apple 的设备上识别功能（如果可用）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載語音模型，無需網路即可進行語音搜尋。如果未安裝任何設備，Vela 會使用 Apple 的裝置上識別功能（如果可用）。"
          }
        }
      }
    },
