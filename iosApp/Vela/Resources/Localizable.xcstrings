    "settings_routing_regions_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, um offline durch ein ganzes Bundesland, eine Provinz oder ein Land zu kommen: Straßen und Orte, damit Navigation und Suche überall darin funktionieren. Hol dir, wohin du fährst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directions, place search and the map picture for an entire state, province or country, so you can navigate and look things up anywhere inside it offline. The map picture is the biggest part of a download; the smaller areas you save above cover just a city."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo necesario para moverte por un estado, provincia o país entero sin conexión: sus calles y lugares, para que las rutas y la búsqueda funcionen en todo su territorio. Descarga a donde vayas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qu'il faut pour parcourir un état, une province ou un pays entier hors ligne : ses routes et ses lieux, pour que l'itinéraire et la recherche fonctionnent partout. Prenez là où vous allez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוראות ניווט, חיפוש מקומות ומיפוי של מדינה שלמה, מחוז או ארץ, כך שיהיה אפשר לחפש מקומות ולעיין במידע עליהם גם ללא חיבור לרשת. המיפוי הוא החלק הגדול בהורדה, האזורים הקטנים יותר ששמרת למעלה מכסים רק עיר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útvonaltervezés és helykeresés egy teljes állam, tartomány vagy ország területén, hogy bárhol navigálhass és kereshess benne offline. Ez nem tartalmazza a részletes térképképet, ami egy egész országnál hatalmas lenne; az a fent mentett területekről vagy online állapotból jön."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto il necessario per girare un intero stato, provincia o paese offline: strade e luoghi, così indicazioni e ricerca funzionano ovunque al suo interno. Scarica dove sei diretto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "州や国をまるごとオフラインで移動するために必要なデータ一式（道路と場所）です。範囲内ならどこでも経路検索と場所検索が使えます。行き先の地域をダウンロードしておきましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles om offline door een hele staat, provincie of een heel land te reizen: de wegen en plekken, zodat routes en zoeken overal daarbinnen werken. Pak waar je heen gaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskazówki dojazdu, wyszukiwanie miejsc oraz mapa obejmująca cały stan, prowincję lub kraj – dzięki temu możesz nawigować i wyszukiwać informacje w dowolnym miejscu na danym obszarze nawet bez dostępu do internetu. Plik mapy stanowi największą część pobieranych danych; mniejsze obszary które możesz zapisać (jak wspomniano powyżej) obejmują zazwyczaj tylko jedno miasto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que você precisa para percorrer um estado, província ou país inteiro off-line: as ruas e os locais, para que as direções e a pesquisa funcionem em toda a área. Baixe para onde você vai."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que precisas para percorrer um estado, província ou país inteiro offline: as estradas e os lugares, para que as direções e a pesquisa funcionem em toda a área. Transfere para onde vais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicații rutiere, căutare de locații și imaginea hărții pentru un întreg stat, provincie sau țară, astfel încât să poți naviga și căuta informații oriunde în interiorul acesteia off-line. Imaginea hărții este cea mai mare parte a unei descărcări; zonele mai mici pe care le salvezi mai sus acoperă doar un oraș."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё, чтобы передвигаться по целому региону, области или стране офлайн: дороги и места, чтобы маршруты и поиск работали на всей территории. Скачайте туда, куда едете."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt som behövs för att ta sig runt i en hel delstat, provins eller ett helt land offline: vägar och platser, så att vägbeskrivningar och sökning fungerar överallt där. Hämta dit du ska."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе, щоб пересуватися цілим регіоном, областю чи країною офлайн: дороги та місця, щоб маршрути й пошук працювали всюди. Завантажте туди, куди їдете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离线走遍整个州、省或国家所需的一切：道路和地点数据，让路线和搜索在其境内任何地方都可用。下载您要去的地区即可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離線暢行整個州、省或國家所需的一切：道路和地點都包含在內，區域內任何地方都能規劃路線和搜尋。要去哪裡就下載哪裡。"
          }
        }
      }
    },
