    "place_avoid_not_honored" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Routen nutzen eventuell trotzdem Mautstraßen, Autobahnen oder Fähren: Google war nicht erreichbar, um sie zu umfahren, und der offene Routing-Dienst kann das nicht. In einem heruntergeladenen Gebiet vermeidet Vela sie offline."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These routes may still use tolls, highways, or ferries: Google could not be reached to route around them, and the open router cannot. In a downloaded area Vela avoids them offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas rutas pueden seguir usando peajes, autopistas o ferris: no se pudo contactar con Google para evitarlos, y el servicio de rutas abierto no puede hacerlo. En una zona descargada, Vela los evita sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces itinéraires peuvent encore emprunter des péages, des autoroutes ou des ferries : Google était injoignable pour les éviter, et le calcul d'itinéraire libre ne le peut pas. Dans une zone téléchargée, Vela les évite hors ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המסלולים האלה עדיין עשויים לעבור בכבישי אגרה, כבישים מהירים או מעבורות: לא ניתן היה להגיע ל-Google כדי לעקוף אותם, והנתב הפתוח לא יכול לעשות זאת. באזור שהורד Vela נמנע מהם ללא חיבור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek az útvonalak továbbra is tartalmazhatnak díjköteles utakat, autópályákat vagy kompokat: a Google nem volt elérhető a kikerülésükhöz, a nyílt útvonaltervező pedig erre nem képes. Letöltött területen a Vela offline is elkerüli őket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi percorsi potrebbero comunque includere pedaggi, autostrade o traghetti: non è stato possibile raggiungere Google per evitarli, e il router aperto non può farlo. In un'area scaricata Vela li evita offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのルートは有料道路、高速道路、フェリーを通る可能性があります。Google に接続できず回避ルートを検索できなかったためで、オープンな経路検索では回避できません。ダウンロード済みのエリアでは、Vela がオフラインで回避します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze routes kunnen nog steeds tolwegen, snelwegen of veerboten gebruiken: Google was niet bereikbaar om eromheen te plannen, en de open routeplanner kan dat niet. In een gedownload gebied vermijdt Vela ze offline."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te trasy mogą nadal prowadzić płatnymi drogami, autostradami lub promami: nie udało się połączyć z Google, żeby je ominąć, a otwarty planer tras tego nie potrafi. W pobranym obszarze Vela omija je offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas rotas ainda podem usar pedágios, rodovias ou balsas: não foi possível contatar o Google para evitá-los, e o planejador de rotas aberto não consegue. Em uma área baixada, o Vela os evita off-line."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas rotas podem ainda usar portagens, autoestradas ou ferries: não foi possível contactar a Google para as evitar, e o planeador de rotas aberto não consegue. Numa área transferida a Vela evita-as offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este posibil ca aceste trasee să includă în continuare porțiuni cu taxă, autostrăzi sau feriboturi: nu s-a putut contacta Google pentru a le ocoli, iar aplicația OpenRouter nu are această posibilitate. Într-o zonă descărcată, Vela le ocolește în modul off-line."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти маршруты всё же могут проходить по платным дорогам, шоссе или паромам: Google недоступен, чтобы их объехать, а открытый маршрутизатор этого не умеет. В загруженной области Vela объезжает их офлайн."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessa rutter kan ändå gå via vägtullar, motorvägar eller färjor: Google gick inte att nå för att runda dem, och den öppna ruttjänsten kan inte. I ett hämtat område undviker Vela dem offline."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці маршрути все ж можуть проходити платними дорогами, шосе чи поромами: Google недоступний, щоб їх оминути, а відкритий маршрутизатор цього не вміє. У завантаженій області Vela оминає їх офлайн."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些路线仍可能经过收费路段、高速公路或轮渡：无法连接 Google 来绕开它们，而开放路线服务做不到。在已下载的区域内，Vela 可以离线避开它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些路線仍可能經過收費路段、高速公路或渡輪：無法連上 Google 來避開它們，而開放路線規劃服務做不到。在已下載的區域內，Vela 可以離線避開。"
          }
        }
      }
    },
