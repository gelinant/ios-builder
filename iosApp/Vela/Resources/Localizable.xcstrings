    "settings_exports_the_same_text_file_as" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصدر نفس الملف النصي مثل الإعدادات والخصوصية. فهو يحتوي على الإصدار والبنية، وإصدار المعايرة، ومفاتيح الخصوصية، وما لا يقل عن 200 سطر سجل منقح. لا يتم تضمين سجلات البحث والتوجيه والتحليل في Kotlin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiert dieselbe Textdatei wie „Einstellungen“, „Datenschutz“. Es enthält die Version und den Build, die Kalibrierungsversion, die Datenschutzschalter und höchstens 200 geschwärzte Protokollzeilen. Die Kotlin-Such-, Routen- und Parsing-Protokolle sind nicht enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exports the same text file as Settings, Privacy. It holds the version and build, the calibration version, the privacy switches and at most 200 redacted log lines. The Kotlin search, route and parsing logs are not included."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exports the same text file as Settings, Privacy. It holds the version and build, the calibration version, the privacy switches and at most 200 redacted log lines. The Kotlin search, route and parsing logs are not included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta el mismo archivo de texto que Configuración, Privacidad. Contiene la versión y compilación, la versión de calibración, los interruptores de privacidad y como máximo 200 líneas de registro redactadas. Los registros de búsqueda, ruta y análisis de Kotlin no están incluidos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekspordib sama tekstifaili nagu Seaded, Privaatsus. Sellel on versioon ja versioon, kalibreerimisversioon, privaatsuslülitid ja maksimaalselt 200 redigeeritud logirida. Kotlini otsingu-, marsruudi- ja sõelumislogid ei sisaldu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte le même fichier texte que Paramètres, Confidentialité. Il contient la version et le build, la version d'étalonnage, les commutateurs de confidentialité et au maximum 200 lignes de journal expurgées. Les journaux de recherche, d'itinéraire et d'analyse Kotlin ne sont pas inclus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מייצא את אותו קובץ טקסט כמו הגדרות, פרטיות. הוא מכיל את הגרסה והמבנה, גרסת הכיול, מתגי הפרטיות ולכל היותר 200 שורות יומן ערוכים. יומני החיפוש, המסלול והניתוח של Kotlin אינם כלולים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugyanazt a szövegfájlt exportálja, mint a Beállítások, Adatvédelem. Ez tartalmazza a verziót és a buildet, a kalibrációs verziót, az adatvédelmi kapcsolókat és legfeljebb 200 szerkesztett naplósort. A Kotlin keresési, útvonal- és elemzési naplók nem tartoznak bele."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esporta lo stesso file di testo di Impostazioni, Privacy. Contiene la versione e la build, la versione di calibrazione, gli interruttori della privacy e al massimo 200 righe di registro redatte. I registri di ricerca, percorso e analisi di Kotlin non sono inclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定、プライバシーと同じテキスト ファイルをエクスポートします。これには、バージョンとビルド、調整バージョン、プライバシー スイッチ、および最大 200 の編集されたログ行が保持されます。 Kotlin の検索、ルート、解析のログは含まれません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporteert hetzelfde tekstbestand als Instellingen, Privacy. Het bevat de versie en build, de kalibratieversie, de privacyschakelaars en maximaal 200 geredigeerde logregels. De zoek-, route- en parseerlogboeken van Kotlin zijn niet inbegrepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportuje ten sam plik tekstowy, co Ustawienia, Prywatność. Zawiera wersję i kompilację, wersję kalibracyjną, przełączniki prywatności i maksymalnie 200 zredagowanych linii dziennika. Dzienniki wyszukiwania, tras i analizowania Kotlin nie są uwzględniane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta o mesmo arquivo de texto que Configurações, Privacidade. Ele contém a versão e a compilação, a versão de calibração, as opções de privacidade e no máximo 200 linhas de registro redigidas. Os logs de pesquisa, rota e análise do Kotlin não estão incluídos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta o mesmo arquivo de texto que Configurações, Privacidade. Ele contém a versão e a compilação, a versão de calibração, as opções de privacidade e no máximo 200 linhas de registro redigidas. Os logs de pesquisa, rota e análise do Kotlin não estão incluídos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportă același fișier text ca Setări, Confidențialitate. Conține versiunea și versiunea, versiunea de calibrare, comutatoarele de confidențialitate și cel mult 200 de linii de jurnal redactate. Jurnalele de căutare, traseu și analiza Kotlin nu sunt incluse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспортирует тот же текстовый файл, что и «Настройки», «Конфиденциальность». Он содержит версию и сборку, версию калибровки, переключатели конфиденциальности и не более 200 отредактированных строк журнала. Журналы поиска, маршрутизации и анализа Kotlin не включены."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvozi isto besedilno datoteko kot Nastavitve, Zasebnost. Vsebuje različico in zgradbo, različico za umerjanje, stikala za zasebnost in največ 200 redigiranih vrstic dnevnika. Dnevniki iskanja, poti in razčlenjevanja Kotlin niso vključeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporterar samma textfil som Inställningar, Sekretess. Den innehåller versionen och byggnaden, kalibreringsversionen, sekretessbrytarna och som mest 200 redigerade loggrader. Kotlins sök-, rutt- och analysloggar ingår inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı metin dosyasını Ayarlar, Gizlilik ile dışa aktarır. Sürümü ve yapıyı, kalibrasyon sürümünü, gizlilik anahtarlarını ve en fazla 200 düzeltilmiş günlük satırını içerir. Kotlin arama, rota ve ayrıştırma günlükleri dahil değildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Експортує той самий текстовий файл, що й налаштування, конфіденційність. Він містить версію та збірку, версію калібрування, перемикачі конфіденційності та щонайбільше 200 редагованих рядків журналу. Журнали пошуку, маршруту та аналізу Kotlin не включені."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出与“设置”、“隐私”相同的文本文件。它保存版本和构建、校准版本、隐私开关以及最多 200 条经过编辑的日志行。不包括 Kotlin 搜索、路由和解析日志。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匯出與「設定」、「隱私權」相同的文字檔案。它保存版本和建置、校準版本、隱私開關以及最多 200 條經過編輯的日誌行。不包括 Kotlin 搜尋、路由和解析日誌。"
          }
        }
      }
    },
