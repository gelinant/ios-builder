    "route_transitous_plans_between_the_two_ends" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطط Transitous بين الطرفين. تظل نقاط التوقف محفوظة للأوضاع الأخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous plant zwischen den beiden Enden. Für die anderen Modi bleiben Stopps gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous plans between the two ends. Stops remain saved for the other modes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
