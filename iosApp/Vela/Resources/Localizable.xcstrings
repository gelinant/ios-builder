    "settings_navigation_camera_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنسحب الخريطة إلى الخارج حتى يقع المنعطف التالي أسفل بطاقة المنعطف، وتتجه نحو المنعطف الجانبي، وتعود عندما تقترب منه. معطل افتراضيًا، كما هو الحال في Android."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte wird herausgezogen, bis die nächste Abzweigung unter der Abzweigungskarte liegt, dreht sich in Richtung einer seitlichen Abzweigung und kommt wieder hinein, wenn Sie sich ihr nähern. Standardmäßig deaktiviert, wie bei Android."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The map pulls out until the next turn sits under the turn card, turns toward a turn off to the side, and comes back in as you near it. Off by default, as on Android."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The map pulls out until the next turn sits under the turn card, turns toward a turn off to the side, and comes back in as you near it. Off by default, as on Android."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa se abre hasta que el siguiente turno se ubica debajo de la carta de turno, gira hacia un desvío lateral y regresa a medida que te acercas. Desactivado de forma predeterminada, como en Android."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaart tõmbub välja, kuni järgmine pööre jääb pöördekaardi alla, pöörab pöördele küljele ja tuleb tagasi, kui olete selle lähedal. Vaikimisi väljas, nagu Androidis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte se retire jusqu'au prochain tour et se place sous la carte de tour, se tourne vers un virage sur le côté et revient lorsque vous vous en approchez. Désactivé par défaut, comme sur Android."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המפה נשלפת החוצה עד שהפנייה הבאה יושבת מתחת לקלף התור, פונה לעבר פנייה בצד, וחוזרת פנימה כשאתה מתקרב אליה. כבוי כברירת מחדל, כמו באנדרואיד."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A térkép kihúzódik, amíg a következő kanyar a kanyarkártya alá nem kerül, oldalra fordul egy kanyar felé, és a közelébe kerül vissza. Alapértelmezés szerint ki, mint az Androidon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mappa si estrae finché il turno successivo non si trova sotto la carta del turno, gira verso una svolta laterale e rientra quando ti avvicini. Disattivato per impostazione predefinita, come su Android."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップは、次のターンがターン カードの下に収まるまで引き出し、横に曲がる方向に向きを変え、それに近づくと戻ってきます。 Android と同様、デフォルトではオフです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kaart wordt uitgetrokken totdat de volgende beurt onder de beurtkaart ligt, draait naar een afslag opzij en komt weer naar binnen als je er dichtbij komt. Standaard uitgeschakeld, net als op Android."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa wysuwa się, aż następna tura znajdzie się pod kartą tury, skręca w stronę zakrętu z boku i wraca, gdy się do niej zbliżysz. Domyślnie wyłączone, tak jak w Androidzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mapa se estende até a próxima curva ficar sob a carta de curva, vira em direção a uma curva lateral e volta quando você se aproxima dela. Desativado por padrão, como no Android."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mapa se estende até a próxima curva ficar sob a carta de curva, vira em direção a uma curva lateral e volta quando você se aproxima dela. Desativado por padrão, como no Android."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harta se retrage până când următorul turn se află sub cartea de turnare, se întoarce spre o cotitură în lateral și revine pe măsură ce te apropii de ea. Dezactivat implicit, ca pe Android."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта выдвигается до тех пор, пока следующий поворот не окажется под картой поворота, поворачивается к повороту в сторону и возвращается обратно, когда вы приближаетесь к нему. По умолчанию выключено, как на Android."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zemljevid se izvleče, dokler naslednji zavoj ne sede pod zavojno karto, se obrne proti zavoju na stran in se vrne, ko se mu približate. Privzeto izklopljeno, kot v sistemu Android."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartan dras ut tills nästa sväng sitter under turkortet, vänder sig mot en sväng åt sidan och kommer tillbaka när du närmar dig den. Av som standard, som på Android."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harita, bir sonraki dönüş dönüş kartının altına gelinceye kadar dışarı çekilir, yan taraftaki bir sapağa doğru döner ve siz ona yaklaştığınızda geri gelir. Android'de olduğu gibi varsayılan olarak kapalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта висувається, доки наступний хід не опиниться під карткою черги, повертається до повороту вбік і повертається, коли ви наближаєтеся до нього. За замовчуванням вимкнено, як на Android."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地图会拉出，直到下一个转弯位于转弯卡下方，然后转向侧面的转弯，并在您靠近它时返回。默认情况下关闭，就像在 Android 上一样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地圖會拉出，直到下一個轉彎位於轉彎卡下方，然後轉向側面的轉彎，並在您靠近它時返回。預設情況下關閉，就像在 Android 上一樣。"
          }
        }
      }
    },
