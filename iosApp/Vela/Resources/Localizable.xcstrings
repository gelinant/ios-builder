    "settings_bridge_openings_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In den Niederlanden wird angezeigt, wann eine bewegliche Brücke auf Ihrer Route geöffnet ist oder geöffnet werden soll, sobald Sie diese erreichen. Geplante und aktuelle Öffnungszeiten stammen aus den Open-Road-Daten der NDW und werden erst abgefragt, wenn Ihre Route in die Niederlande führt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the Netherlands, says when a movable bridge on your route is open or due to open as you reach it. Planned and live openings come from NDW's open road data, asked only when your route enters the Netherlands."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W Holandii system informuje czy most zwodzony na trasie jest otwarty lub czy zostanie otwarty w momencie gdy do niego dotrzesz. Dane o planowanych i bieżących otwarciach pochodzą z zasobów NDW dotyczących infrastruktury drogowej; zapytanie jest wysyłane tylko wtedy gdy trasa prowadzi przez terytorium Holandii."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos Países Baixos, o sistema indica quando uma ponte móvel no seu percurso está aberta ou com previsão de abertura, à medida que se aproxima da mesma. As informações sobre as aberturas planeadas e em curso são obtidas a partir dos dados de estradas abertas da NDW, consultados apenas quando a sua rota entra nos Países Baixos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În Țările de Jos, aplicația te informează când un pod mobil de pe traseul tău este deschis sau urmează să se deschidă în momentul în care ajungi la el. Informațiile privind deschiderile programate și în timp real provin din baza de date „Open Road” a NDW și sunt solicitate doar atunci când traseul tău intră pe teritoriul Țărilor de Jos."
          }
        }
      }
    },
