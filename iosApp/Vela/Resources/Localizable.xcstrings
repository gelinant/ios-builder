    "notif_ask_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Navigation zeigt die nächste Abbiegung in einer Benachrichtigung, damit die Hinweise auch bei ausgeschaltetem Bildschirm oder in anderen Apps bei dir bleiben. Ohne sie gibt es Hinweise nur in Vela selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigation keeps your next turn in a notification, so directions stay with you when the screen is off or you switch apps. Without it, directions only show inside Vela."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La navegación mantiene tu próximo giro en una notificación, para que las indicaciones te acompañen con la pantalla apagada o en otra app. Sin ella, solo hay indicaciones dentro de Vela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La navigation garde votre prochain virage dans une notification, pour que les indications vous suivent quand l'écran est éteint ou que vous changez d'appli. Sans elle, les indications ne s'affichent que dans Vela."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הניווט שומר את הפנייה הבאה בתור התראה, כך שהוראות הניווט יישארו איתך גם כאשר המסך כבוי או בעת מעבר בין יישומים. בלי הגדרה זו, הוראות הניווט יוצגו בתוך Vela בלבד."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A navigáció egy értesítésben tartja a következő kanyarodat, hogy az útvonalvezetés akkor is veled maradjon, ha a képernyő ki van kapcsolva, vagy másik appra váltasz. Enélkül az útvonalvezetés csak a Velán belül jelenik meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La navigazione tiene la prossima svolta in una notifica, così le indicazioni ti seguono a schermo spento o in un'altra app. Senza, le indicazioni restano solo dentro Vela."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ナビ中は次の曲がり角が通知に表示されるため、画面が消えていても、他のアプリに切り替えても案内を確認できます。通知がないと、案内は Vela 内でのみ表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigatie houdt je volgende afslag in een melding, zodat de aanwijzingen bij je blijven met het scherm uit of in een andere app. Zonder melding zie je aanwijzingen alleen in Vela."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawigacja trzyma następny zakręt w powiadomieniu, więc wskazówki są z tobą przy zgaszonym ekranie albo w innej aplikacji. Bez niego wskazówki widać tylko w Veli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A navegação mantém a próxima curva em uma notificação, para as instruções ficarem com você com a tela apagada ou em outro app. Sem ela, as instruções só aparecem dentro do Vela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A navegação mantém a próxima curva numa notificação, para as instruções ficarem com você com a tela apagada ou em outro app. Sem ela, as instruções só aparecem dentro do Vela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funcția de navigare afișează următorul viraj într-o notificare, astfel încât indicațiile de navigare rămân disponibile chiar și când ecranul este oprit sau când comuți între aplicații. Fără această funcție, indicațiile de navigare se afișează doar în aplicația Vela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навигация держит следующий поворот в уведомлении, чтобы подсказки оставались с вами при выключенном экране или в другом приложении. Без него подсказки видны только внутри Vela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigeringen håller nästa sväng i en avisering, så att anvisningarna följer med när skärmen är släckt eller du byter app. Utan den syns anvisningar bara inne i Vela."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навігація тримає наступний поворот у сповіщенні, щоб підказки лишалися з вами з вимкненим екраном чи в іншому застосунку. Без нього підказки видно лише у Vela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导航会把下一个转弯放在通知里，即使熄屏或切换应用，指示也随时可见。若不允许，指示只会显示在 Vela 内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "導航會把下一個轉彎顯示在通知中，即使螢幕關閉或切換到其他應用程式，指引仍會跟著你。沒有通知的話，路線指引只會顯示在 Vela 裡。"
          }
        }
      }
    },
