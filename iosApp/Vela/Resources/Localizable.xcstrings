    "settings_road_label_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo der Name der Straße, auf der Sie fahren, während der Fahrt angezeigt wird. Über der Leiste bleibt er mittig und auch bei langen Namen lesbar; unter dem Pfeil folgt er dem Pfeil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where the name of the road you are on is shown while driving. Above the bar keeps it centered and readable for long names; under the arrow follows the arrow around."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dónde se muestra el nombre de la calle por la que circulas mientras conduces. Encima de la barra queda centrado y se lee bien con nombres largos; debajo de la flecha acompaña a la flecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où s'affiche le nom de la route sur laquelle vous roulez pendant la conduite. Au-dessus de la barre, il reste centré et lisible pour les noms longs ; sous la flèche, il suit la flèche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היכן מוצג שם הכביש שעליו נמצאים בזמן הנהיגה. מעל הסרגל שומר אותו ממורכז וקריא גם לשמות ארוכים; מתחת לחץ נע יחד עם החץ."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hol jelenjen meg vezetés közben annak az útnak a neve, amelyen haladsz. A sáv fölött középen marad, és hosszú neveknél is olvasható; a nyíl alatt együtt mozog a nyíllal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove viene mostrato il nome della strada su cui ti trovi mentre guidi. Sopra la barra lo tiene centrato e leggibile anche con i nomi lunghi; sotto la freccia lo fa seguire la freccia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運転中に、走っている道路の名前を表示する位置です。「下部バーの上」は中央に表示され、長い名前でも読みやすくなります。「矢印の下」は矢印に合わせて動きます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar de naam van de weg waarop je rijdt tijdens het rijden wordt getoond. Boven de balk blijft hij gecentreerd en leesbaar bij lange namen; onder de pijl beweegt hij met de pijl mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsce w którym podczas jazdy wyświetlana jest nazwa drogi na której się znajdujesz. Umieszczenie jej nad paskiem pozwala zachować wyśrodkowanie i czytelność nawet w przypadku długich nazw; umieszczenie pod strzałką sprawia że nazwa podąża za ruchem strzałki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde aparece o nome da rua em que você segue durante a condução. Acima da barra fica centralizado e legível para nomes longos; abaixo da seta acompanha a seta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde aparece o nome da estrada em que segue durante a condução. Por cima da barra fica centrado e legível para nomes longos; por baixo da seta acompanha a seta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează numele străzii pe care te afli în timp ce conduci. Poziția deasupra barei menține numele centrat și lizibil în cazul denumirilor lungi; poziția de sub săgeată îl deplasează odată cu mișcarea săgeții."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Где во время поездки показывать название дороги, по которой вы едете. Над панелью оно стоит по центру и читается даже в длинных названиях, под стрелкой следует за ней."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var namnet på vägen du kör på visas under körning. Ovanför fältet håller det centrerat och läsbart för långa namn; under pilen följer det med pilen runt."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де показувати назву дороги, якою ви їдете, поки кермуєте. Над панеллю, по центру й добре читається для довгих назв; під стрілкою, рухається разом зі стрілкою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驾驶时当前所在道路名称的显示位置。显示在底栏上方时居中，长名称也清晰易读；显示在箭头下方则跟随箭头移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行車時要在哪裡顯示你所在道路的名稱。顯示在列上方會置中，長名稱也看得清楚；顯示在箭頭下方則會跟著箭頭移動。"
          }
        }
      }
    },
