    "settings_voice_mode_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Funktion „Warnmeldungen“ gibt lediglich bei Geschwindigkeitsüberschreitungen und vor Kameras einen kurzen Signalton aus und sagt sonst nichts. Die Lautsprechertaste während der Fahrt öffnet dieselben drei Funktionen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts only keeps the speeding and camera alerts as a short chime and says nothing else. The speaker button during a drive opens the same three."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerty emitują jedynie krótkie sygnały dźwiękowe informujące o przekroczeniu prędkości, fotoradarach i nic więcej. Przycisk głośnika podczas jazdy otwiera te same trzy."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas Alertas exibe apenas um breve sinal sonoro para alertas de excesso de velocidade e radares, sem dizer mais nada. O botão do altifalante, durante a condução, ativa os mesmos três alertas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funcția „Alertele” afișează doar alertele privind depășirea vitezei și camerele de supraveghere sub forma unui semnal sonor scurt, fără a oferi alte informații. Butonul difuzorului, apăsat în timpul conducerii, afișează aceleași trei alerte."
          }
        }
      }
    },
