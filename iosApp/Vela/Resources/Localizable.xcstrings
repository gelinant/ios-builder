    "settings_zoom_keys_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Tasten, mit denen man die Karte von jeder beliebigen Stelle aus vergrößern kann, beispielsweise die Tasten 2 und 5 auf dem Ziffernblock. In einem Textfeld dienen sie weiterhin zur Eingabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two keys that zoom the map from anywhere on it, such as 2 and 5 on a keypad. In a text field they still type."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due tasti che consentono di ingrandire o ridurre la mappa da qualsiasi punto della stessa, come i tasti 2 e 5 di un tastierino numerico. Se utilizzati all'interno di un campo di testo, continuano a digitare i caratteri corrispondenti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwa przyciski służące do powiększania mapy z dowolnego miejsca na niej, na przykład 2 i 5 na klawiaturze numerycznej. W polu tekstowym nadal wprowadzają one znaki."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duas teclas que permitem ampliar e reduzir o mapa em qualquer ponto, como as teclas 2 e 5 de um teclado numérico. Num campo de texto, o utilizador ainda digita."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Două taste care măresc harta din orice punct al acesteia, cum ar fi tastele 2 și 5 de pe tastatură. În câmpurile de text, acestea funcționează în continuare ca taste de introducere a textului."
          }
        }
      }
    },
