    "transit_time_clock_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقات الساعة هي تلك التي أرسلها Transitous. ولا يقوم Vela بتحويلها بين المناطق؛ يستخدم التحكم في الوقت منطقة جهازك (%1$@)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Uhrzeiten sind die von Transitous gesendeten. Vela konvertiert sie nicht zwischen Zonen; Die Zeitsteuerung verwendet Ihre Gerätezone (%1$@)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clock times are the ones Transitous sent. Vela does not convert them between zones; the time control uses your device zone (%1$@)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clock times are the ones Transitous sent. Vela does not convert them between zones; the time control uses your device zone (%1$@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tiempos de reloj son los que envió el Transitous. Vela no los convierte entre zonas; el control de tiempo usa la zona de tu dispositivo (%1$@)."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kellaajad on need, mille Transitous saatis. Vela ei teisenda neid tsoonide vahel; ajakontroll kasutab teie seadme tsooni (%1$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les heures sont celles envoyées par Transitous. Vela ne les convertit pas entre fuseaux ; le contrôle horaire utilise le fuseau de votre appareil (%1$@)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זמני השעון הם אלה ש-Transitous נשלח. Vela אינו ממיר אותם בין אזורים; בקרת הזמן משתמשת באזור המכשיר שלך (%1$@)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az óraidő a Transitous által küldött óra. A Vela nem konvertálja őket zónák között; az idővezérlés az eszköz zónáját (%1$@) használja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli orari dell'orologio sono quelli inviati da Transitous. Vela non li converte tra zone; il controllo temporale utilizza la zona del tuo dispositivo (%1$@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クロック時間は Transitous が送信したものです。 Vela はゾーン間でそれらを変換しません。時間コントロールはデバイス ゾーン (%1$@) を使用します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kloktijden zijn de tijden die Transitous heeft verzonden. Vela converteert ze niet tussen zones; de tijdcontrole gebruikt uw apparaatzone (%1$@)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czasy zegara to te, które wysłał Transitous. Vela nie konwertuje ich pomiędzy strefami; kontrola czasu korzysta ze strefy Twojego urządzenia (%1$@)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os tempos de clock são os enviados pelo Transitous. O Vela não os converte entre zonas; o controle de tempo usa a zona do seu dispositivo (%1$@)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os tempos de clock são os enviados pelo Transitous. O Vela não os converte entre zonas; o controle de tempo usa a zona do seu dispositivo (%1$@)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orele de ceas sunt cele trimise de Transitous. Vela nu le convertește între zone; controlul timpului folosește zona dispozitivului dvs. (%1$@)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время на часах - это время, отправленное Transitous. Vela не преобразует их между зонами; контроль времени использует зону вашего устройства (%1$@)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časi ure so tisti, ki jih je poslal Transitous. Vela jih ne pretvori med conami; časovni nadzor uporablja območje vaše naprave (%1$@)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klocktider är de som Transitous skickat. Vela konverterar dem inte mellan zoner; tidskontrollen använder din enhetszon (%1$@)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat süreleri Transitous'nin gönderdiği saatlerdir. Vela bunları bölgeler arasında dönüştürmez; zaman kontrolü cihazınızın bölgesini (%1$@) kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часи годинника – це ті, які надіслав Transitous. Vela не перетворює їх між зонами; контроль часу використовує зону вашого пристрою (%1$@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时钟时间是 Transitous 发送的时间。 Vela 不会在区域之间转换它们；时间控制使用您的设备区域 (%1$@)。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時鐘時間是 Transitous 發送的時間。 Vela 不會在區域之間轉換它們；時間控制使用您的設備區域 (%1$@)。"
          }
        }
      }
    },
