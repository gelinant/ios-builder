    "settings_softkeys_calibrate_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Softkeys nicht zoomen, tippen Sie hier und drücken Sie erst den linken, dann den rechten Softkey, damit Vela ihre Codes lernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the soft keys don't zoom, tap here and press your left then right soft key so Vela learns their codes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si las teclas de función no hacen zoom, toca aquí y pulsa la tecla de función izquierda y luego la derecha para que Vela aprenda sus códigos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si les touches programmables ne zooment pas, touchez ici puis appuyez sur la touche de gauche, puis sur celle de droite, pour que Vela apprenne leurs codes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם מקשי הבחירה לא משנים את הזום, הקש כאן ולחץ על מקש הבחירה השמאלי ואז על הימני, כדי ש-Vela ילמד את הקודים שלהם."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a funkciógombok nem nagyítanak, koppints ide, majd nyomd meg a bal, aztán a jobb funkciógombot, hogy a Vela megtanulja a kódjaikat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se i tasti funzione non eseguono lo zoom, tocca qui e premi il tasto funzione sinistro e poi il destro, così Vela ne impara i codici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソフトキーでズームできない場合は、ここをタップしてから左、右の順にソフトキーを押してください。Vela がキーコードを記憶します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoomen de softkeys niet? Tik hier en druk eerst op je linker- en dan op je rechtersoftkey, zodat Vela hun codes leert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli klawisze funkcyjne nie zmieniają powiększenia, dotknij tutaj i naciśnij lewy, a potem prawy klawisz funkcyjny, aby Vela poznała ich kody."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se as teclas de função não derem zoom, toque aqui e pressione a tecla de função esquerda e depois a direita para o Vela aprender os códigos delas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se as teclas de função não fizerem zoom, toque aqui e prima a tecla de função esquerda e depois a direita, para a Vela aprender os códigos delas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă tastele funcționale nu activează funcția de zoom, atinge aici și apasă mai întâi tasta funcțională din stânga, apoi pe cea din dreapta, pentru ca Vela să le memoreze codurile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если софт-клавиши не меняют масштаб, нажмите здесь, а затем левую и правую софт-клавиши, чтобы Vela запомнила их коды."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om funktionsknapparna inte zoomar, tryck här och tryck sedan på vänster och därefter höger funktionsknapp så att Vela lär sig deras koder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо функціональні клавіші не змінюють масштаб, торкніться тут і натисніть ліву, а потім праву функціональну клавішу, щоб Vela запам'ятала їхні коди."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果软键无法缩放，请点按此处，然后依次按下左软键和右软键，让 Vela 记住它们的键码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
