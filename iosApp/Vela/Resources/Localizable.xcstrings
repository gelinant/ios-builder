    "settings_voice_volume_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie laut die Sprachansagen über Ihre Medien wiedergegeben werden. Die lauteren Stufen gelten für die Vela-Stimme; Systemstimmen lassen sich nur leiser stellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How loud spoken directions play over your media. Louder tiers apply to the Vela voice; system voices can only be made softer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con qué volumen suenan las indicaciones habladas por encima de tu música. Los niveles más altos se aplican a la voz de Vela; las voces del sistema solo se pueden bajar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume des instructions vocales par-dessus votre musique. Les niveaux les plus forts s'appliquent à la voix Vela ; les voix du système ne peuvent qu'être baissées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה חזק ההוראות המדוברות מושמעות מעל המדיה שלך. הרמות החזקות יותר חלות על Vela Voice; קולות מערכת אפשר רק להחליש."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milyen hangosan szól a hangos útvonalvezetés a médialejátszás felett. A hangosabb szintek csak a Vela hangra vonatkoznak; a rendszerhangok csak halkíthatók."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto forte si sentono le indicazioni vocali sopra la tua musica. I livelli più alti valgono per la voce Vela; le voci di sistema si possono solo abbassare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メディア音声に重ねて再生される音声案内の大きさです。「大きめ」以上は Vela 音声にのみ適用され、システムの音声は小さくすることしかできません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe luid gesproken aanwijzingen over je media klinken. De luidere standen gelden voor de Vela-stem; systeemstemmen kunnen alleen zachter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak głośno wskazówki głosowe odtwarzają się na tle twoich multimediów. Głośniejsze poziomy dotyczą głosu Vela; głosy systemowe można tylko ściszyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com que volume as instruções faladas tocam por cima do que você está ouvindo. Os níveis mais altos se aplicam à voz Vela; as vozes do sistema só podem ficar mais baixas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com que volume as indicações faladas tocam por cima do que está a ouvir. Os níveis mais altos aplicam-se à voz Vela; as vozes do sistema só podem ficar mais baixas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât de tare se aud instrucțiunile vocale pe dispozitivul tău media. Nivelurile mai ridicate de volum se aplică vocii Vela; volumul vocilor sistemului poate fi redus doar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько громко голосовые подсказки звучат поверх вашей музыки. Уровни выше обычного работают с голосом Vela, системные голоса можно только приглушить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur högt talade vägbeskrivningar spelas över din media. De högre nivåerna gäller Vela-rösten; systemröster går bara att göra tystare."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наскільки гучно голосові вказівки звучать поверх вашої музики. Гучніші рівні працюють для голосу Vela; системні голоси можна лише приглушити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音播报盖过媒体声音的音量。更响的档位仅适用于 Vela 语音；系统语音只能调低。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語音指引蓋過媒體播放時的音量。較大的音量層級只適用於 Vela 語音；系統語音只能調小。"
          }
        }
      }
    },
