    "settings_font_flex_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Sans Flex ist die offen lizenzierte Schwester von Googles eigener Schrift. Sie deckt lateinische Buchstaben ab; andere Schriftsysteme behalten die Systemschrift."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Sans Flex is the openly licensed sibling of Google's own font. It covers Latin letters; other scripts keep the system font."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Sans Flex es la hermana con licencia abierta de la fuente propia de Google. Cubre las letras latinas; los demás sistemas de escritura conservan la fuente del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Sans Flex est la sœur sous licence ouverte de la propre police de Google. Elle couvre les lettres latines ; les autres écritures gardent la police du système."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Sans Flex הוא האח בעל הרישיון הפתוח של הגופן של Google עצמה. הוא מכסה אותיות לטיניות; כתבים אחרים נשארים עם גופן המערכת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Google Sans Flex a Google saját betűtípusának nyílt licencű testvére. A latin betűket fedi le; a többi írásrendszer a rendszer betűtípusát használja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Sans Flex è il fratello con licenza aperta del carattere di Google. Copre le lettere latine; le altre scritture mantengono il carattere di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Sans Flex は、Google 自身のフォントの姉妹にあたるオープンライセンスのフォントです。ラテン文字に対応しており、その他の文字はシステムフォントのままです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Sans Flex is het open gelicentieerde zusje van Googles eigen lettertype. Het dekt Latijnse letters; andere schriften houden het systeemlettertype."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Sans Flex to udostępniona na otwartej licencji siostra własnej czcionki Google. Obejmuje litery łacińskie; inne pisma zachowują czcionkę systemową."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Google Sans Flex é a irmã com licença aberta da fonte do próprio Google. Ela cobre as letras latinas; os outros sistemas de escrita mantêm a fonte do sistema."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Google Sans Flex é o irmão com licença aberta do tipo de letra da própria Google. Abrange as letras latinas; os outros sistemas de escrita mantêm o tipo de letra do sistema."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Sans Flex este varianta cu licență deschisă a fontului propriu al Google. Acesta acoperă literele latine; pentru celelalte alfabete se utilizează fontul de sistem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шрифт Google Sans Flex распространяется по открытой лицензии и родственен собственному шрифту Google. Он охватывает латинские буквы; для остальных письменностей остаётся системный шрифт."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Sans Flex är det öppet licensierade syskonet till Googles eget typsnitt. Det täcker latinska bokstäver; andra skriftsystem behåller systemtypsnittet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шрифт Google Sans Flex поширюється за відкритою ліцензією і споріднений із власним шрифтом Google. Він охоплює латинські літери; для інших писемностей залишається системний шрифт."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Sans Flex 是 Google 自有字体的姊妹字体，采用开放许可。它涵盖拉丁字母；其他文字仍使用系统字体。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Sans Flex 是 Google 自家字型的姊妹字型，採用開放授權。它涵蓋拉丁字母；其他文字維持使用系統字型。"
          }
        }
      }
    },
