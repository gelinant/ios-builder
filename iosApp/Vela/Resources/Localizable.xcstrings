    "search_carry_ratings_price_levels_live_opening" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حمل التقييمات أو مستويات الأسعار أو ساعات العمل المباشرة أو بيانات إمكانية الوصول،"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "über Bewertungen, Preisniveaus, Live-Öffnungszeiten oder Erreichbarkeitsdaten verfügen,"
