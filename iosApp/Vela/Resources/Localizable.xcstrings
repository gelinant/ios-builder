    "map_asr_offer_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade die Vela-Stimme herunter, um Suchen zu sprechen. Sie läuft komplett auf deinem Gerät und lädt nichts hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download Vela Voice to speak your searches. It runs entirely on your phone and uploads nothing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga la voz de Vela para dictar tus búsquedas. Funciona por completo en tu teléfono y no sube nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez la voix Vela pour dicter vos recherches. Elle tourne entièrement sur votre téléphone et n'envoie rien."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הורד את Vela Voice כדי לחפש בדיבור. הוא פועל כולו בטלפון שלך ולא מעלה דבר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Töltsd le a Vela Hangot, hogy hangosan kereshess. Teljesen a telefonodon fut, és semmit nem tölt fel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica la voce Vela per dettare le ricerche. Gira interamente sul telefono e non carica nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 音声をダウンロードすると、話して検索できるようになります。完全に端末上で動作し、何もアップロードしません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download de Vela-stem om je zoekopdrachten in te spreken. Hij draait volledig op je telefoon en uploadt niets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobierz głos Vela, aby dyktować wyszukiwania. Działa w całości na telefonie i niczego nie wysyła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixe a voz Vela para ditar suas pesquisas. Ela roda inteiramente no celular e não envia nada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfere a voz Vela para ditar as tuas pesquisas. Corre inteiramente no telemóvel e não envia nada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarcă Voce Vela pentru a efectua căutările prin comandă vocală. Aplicația funcționează exclusiv pe telefonul tău și nu încarcă nimic pe server."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузите голос Vela, чтобы диктовать запросы. Он работает целиком на телефоне и ничего не выгружает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladda ner Vela-rösten för att tala in dina sökningar. Den körs helt på telefonen och laddar inte upp något."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантажте голос Vela, щоб диктувати запити. Він працює цілком на телефоні й нічого не надсилає."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载 Vela 语音即可用语音进行搜索。它完全在您的手机上运行，不会上传任何内容。"
