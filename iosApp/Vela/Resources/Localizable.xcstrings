    "route_avoid_hills_steps_and_unpaved_surfaces" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجنب التلال والدرجات والأسطح غير المعبدة: لا يدعمها هذا الموجه المفتوح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermeiden Sie Hügel, Stufen und unbefestigte Flächen: Wird von diesem offenen Router nicht unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid hills, steps and unpaved surfaces: not supported by this open router."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid hills, steps and unpaved surfaces: not supported by this open router."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite colinas, escalones y superficies sin pavimentar: no son compatibles con este enrutador abierto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vältige künkaid, astmeid ja sillutamata pindu: see avatud ruuter ei toeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évitez les collines, les marches et les surfaces non pavées : non pris en charge par ce routeur ouvert."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הימנע מגבעות, מדרגות ומשטחים לא מרוצפים: לא נתמך על ידי נתב פתוח זה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerülje a dombokat, lépcsőket és burkolatlan felületeket: ez a nyitott útválasztó nem támogatja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita colline, gradini e superfici non asfaltate: non supportato da questo router aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "丘、段差、未舗装の表面を避けてください。このオープンルーターではサポートされていません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermijd heuvels, trappen en onverharde oppervlakken: wordt niet ondersteund door deze open router."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unikaj wzgórz, schodów i nieutwardzonych powierzchni: nie są obsługiwane przez ten otwarty router."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite colinas, degraus e superfícies não pavimentadas: não suportadas por este roteador aberto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite colinas, degraus e superfícies não pavimentadas: não suportadas por este roteador aberto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitați dealurile, treptele și suprafețele neasfaltate: nu sunt susținute de acest router deschis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избегайте холмов, ступенек и грунтовых поверхностей: этот открытый фрезер не поддерживает их."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izogibajte se hribom, stopnicam in neasfaltiranim površinam: tega odprtega usmerjevalnika ne podpira."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undvik kullar, trappsteg och oasfalterade ytor: stöds inte av denna öppna router."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tepelerden, basamaklardan ve asfaltsız yüzeylerden kaçının: bu açık yönlendirici tarafından desteklenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уникайте пагорбів, сходів і неасфальтованих поверхонь: не підтримується цим відкритим маршрутизатором."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "避开山丘、台阶和未铺砌的表面：此开放式路由器不支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "避開山丘、階梯和未鋪砌的表面：此開放式路由器不支援。"
          }
        }
      }
    },
