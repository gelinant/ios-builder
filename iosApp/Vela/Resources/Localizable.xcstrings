          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous מתכננת בין שני הקצוות. העצירות נשארות שמורות עבור המצבים האחרים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Transitous a két vég között tervez. A többi mód számára a megállók mentve maradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous prevede tra le due estremità. Le soste rimangono salvate per le altre modalità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous は両端間の計画を立てます。ストップは他のモード用に保存されたままになります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous-plannen tussen de twee uiteinden. Stops blijven opgeslagen voor de andere modi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plany Transitous między dwoma końcami. Przystanki pozostają zapisane dla pozostałych trybów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous planeja entre as duas extremidades. As paradas permanecem salvas para os outros modos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous planeja entre as duas extremidades. As paradas permanecem salvas para os outros modos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transitous planuri între cele două capete. Opririle rămân salvate pentru celelalte moduri."
          }
        },
        "ru" : {
          "stringUnit" : {
