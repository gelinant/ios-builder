    "settings_name_trips_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einer aufgezeichneten Fahrt fragt Vela, wie sie heißen soll. Standardmäßig aus; Sie können eine Fahrt jederzeit später in der Liste unten umbenennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a recorded drive ends, Vela asks what to call it. Off by default; you can always rename a trip later in the list below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando termina un trayecto grabado, Vela te pregunta cómo llamarlo. Desactivado por defecto; siempre puedes renombrar un trayecto más tarde en la lista de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À la fin d'un trajet enregistré, Vela demande comment l'appeler. Désactivé par défaut ; vous pouvez toujours renommer un trajet plus tard dans la liste ci-dessous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אחרי שנסיעה מוקלטת מסתיימת, Vela שואל איך לקרוא לה. כבוי כברירת מחדל; תמיד אפשר לשנות שם של נסיעה מאוחר יותר ברשימה שלמטה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy rögzített út végén a Vela megkérdezi, minek nevezd el. Alapból kikapcsolva; egy utat később bármikor átnevezhetsz a lenti listában."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando un viaggio registrato finisce, Vela chiede come chiamarlo. Disattivo di default; puoi sempre rinominare un viaggio più tardi nell'elenco qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録した走行が終わるたびに、Vela が名前を尋ねます。初期状態ではオフです。後から下の一覧でいつでも名前を変更できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadat een opgenomen rit is afgelopen, vraagt Vela hoe je hem wilt noemen. Standaard uit; je kunt een rit later altijd hernoemen in de lijst hieronder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zakończeniu zapisanego przejazdu Vela pyta, jak go nazwać. Domyślnie wyłączone; nazwę podróży zawsze możesz zmienić później na liście poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando um trajeto gravado termina, o Vela pergunta que nome dar a ele. Desativado por padrão; você sempre pode renomear uma viagem depois, na lista abaixo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando um trajeto gravado termina, a Vela pergunta que nome lhe dar. Desligado por predefinição; pode sempre mudar o nome de uma viagem mais tarde, na lista abaixo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După ce se încheie o călătorie înregistrată, Vela te întreabă cum să o denumească. Opțiunea este dezactivată în mod implicit; poți oricând să redenumești o călătorie ulterior, din lista de mai jos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После окончания записанной поездки Vela спросит, как её назвать. По умолчанию выключено, переименовать поездку можно в любой момент в списке ниже."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po končani vožnji te Vela vpraša, kako jo želiš poimenovati. Privzeto je izklopljeno. Vožnjo lahko pozneje vedno preimenuješ na seznamu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När en inspelad körning avslutats frågar Vela vad den ska heta. Av som standard; du kan alltid byta namn på en resa senare i listan nedan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли записана поїздка завершиться, Vela запитає, як її назвати. Типово вимкнено; поїздку завжди можна перейменувати пізніше у списку нижче."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录的行程结束后，Vela 会询问如何命名。默认关闭；您随时可以在下方列表中重命名行程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記錄的行程結束後，Vela 會問你要取什麼名稱。預設關閉；你之後也可以隨時在下方清單中重新命名。"
          }
        }
      }
    },
