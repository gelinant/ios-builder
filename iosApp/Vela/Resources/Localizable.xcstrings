    "settings_google_usage_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird auf diesem Telefon gezählt und nie irgendwohin gesendet. Kartenkacheln für Live-Verkehr und einige Satellitenbilder sind nicht enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counted on this phone and never sent anywhere. Map tiles for live traffic and some satellite imagery are not included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cuentan en este teléfono y nunca se envían a ningún sitio. No incluye los mosaicos del tráfico en directo ni parte de las imágenes de satélite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptées sur ce téléphone et jamais envoyées. Les tuiles du trafic en direct et certaines images satellite ne sont pas incluses."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נספר בטלפון הזה ולעולם לא נשלח לשום מקום. אריחי מפה של תנועה בזמן אמת וחלק מתמונות הלוויין אינם נכללים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a telefon számolja, és soha nem küldi el sehova. Az élő forgalom térképcsempéi és egyes műholdképek nincsenek benne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conteggiate su questo telefono e mai inviate altrove. Non includono i riquadri della mappa per il traffico in tempo reale e parte delle immagini satellitari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末内でカウントし、どこにも送信しません。リアルタイム交通情報の地図タイルと一部の航空写真は含まれません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geteld op deze telefoon en nergens heen gestuurd. Kaarttegels voor live verkeer en sommige satellietbeelden tellen niet mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczone na tym telefonie i nigdzie niewysyłane. Nie obejmuje kafelków mapy z ruchem na żywo ani części zdjęć satelitarnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contadas neste celular e nunca enviadas a lugar nenhum. Os blocos do mapa de trânsito em tempo real e parte das imagens de satélite não estão incluídos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contados neste telemóvel e nunca enviados a lado nenhum. Não inclui os mosaicos do trânsito em tempo real nem parte das imagens de satélite."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acestea sunt calculate pe acest telefon și nu sunt trimise nicăieri. Dalele de trafic și unele imagini din satelit nu sunt incluse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считаются на этом телефоне и никуда не отправляются. Тайлы пробок и часть спутниковых снимков не учитываются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räknas på den här telefonen och skickas aldrig någonstans. Kartrutor för trafik i realtid och vissa satellitbilder ingår inte."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рахуються на цьому телефоні й нікуди не надсилаються. Плитки карти для трафіку в реальному часі та частина супутникових знімків не враховуються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在本机统计，绝不发送到任何地方。实时路况和部分卫星影像的地图图块不计入其中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只在這支手機上計數，絕不會傳送到任何地方。即時路況的地圖圖磚和部分衛星影像不計算在內。"
          }
        }
      }
    },
