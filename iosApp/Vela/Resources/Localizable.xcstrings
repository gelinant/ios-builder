    "settings_places_source_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Suche oder das Antippen eines Ortes fragt bei jeder Auswahl weiterhin Google nach Öffnungszeiten, Rezensionen und Fotos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Searching, or tapping a place, still asks Google for hours, reviews and photos whichever you pick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al buscar o tocar un lugar se sigue consultando a Google el horario, las reseñas y las fotos, elijas lo que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechercher ou toucher un lieu interroge toujours Google pour les horaires, les avis et les photos, quel que soit votre choix."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חיפוש או הקשה על מקום עדיין יוצרים קשר עם Google לקבלת מידע על שעות, ביקורות ותמונות לפי דרישה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A keresés vagy egy helyre koppintás bármelyik beállításnál a Google-től kéri le a nyitvatartást, a véleményeket és a fotókat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cercare o toccare un luogo passa comunque da Google per orari, recensioni e foto, qualunque opzione tu scelga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どれを選んでも、場所を検索したりタップしたりすると、営業時間・クチコミ・写真は Google から取得します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoeken of op een plaats tikken vraagt nog steeds openingstijden, recensies en foto's op bij Google, wat je ook kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukanie lub dotknięcie miejsca nadal pobiera z Google godziny, opinie i zdjęcia, niezależnie od wyboru."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquisar ou tocar em um local continua consultando o Google para horários, avaliações e fotos, seja qual for a opção escolhida."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquisar ou tocar num local continua a consultar a Google para horários, avaliações e fotos, seja qual for a opção escolhida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când cauți sau dai clic pe o locație, programul de lucru, recenziile și fotografiile provin în continuare de la Google, indiferent de ce alegi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При поиске или нажатии на место часы работы, отзывы и фото по-прежнему берутся из Google, что бы вы ни выбрали."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iskanje ali dotik kraja še vedno pošlje zahtevo Googlu za odpiralni čas, ocene in fotografije, ne glede na izbrani vir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att söka eller trycka på en plats frågar fortfarande Google om öppettider, recensioner och foton, vilket du än väljer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пошук чи дотик до місця все одно йде в Google по години роботи, відгуки та фото, хоч би що ви вибрали."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无论选择哪一项，搜索或点按某个地点时，营业时间、评价和照片仍来自 Google。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無論選哪一項，搜尋或點按地點時，仍會向 Google 取得營業時間、評論和相片。"
          }
        }
      }
    },
