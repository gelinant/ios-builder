    "settings_about_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela ist ein degoogelter Karten-Client: offene Kacheln für die Basiskarte, gescraptes Google für POIs, Routing und verkehrsabhängige Ankunftszeiten, eine Piper-Stimme, die auf dem Telefon läuft. GPLv3. Keine Play-Dienste erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela is a degoogled maps client: open tiles for the basemap, scraped Google for places, routing and traffic-aware ETAs, and a Piper voice that runs on the phone. GPLv3. No Play Services required."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela es un cliente de mapas sin Google: mosaicos abiertos para el mapa base, datos de Google extraídos para los puntos de interés, rutas y ETA con tráfico, y una voz Piper que corre en el teléfono. GPLv3. No requiere Play Services."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela est un client cartographique dégooglisé : tuiles ouvertes pour le fond de carte, extraction de Google pour les lieux, le routage et les estimations tenant compte du trafic, une voix Piper qui tourne sur le téléphone. GPLv3. Ne nécessite pas les Play Services."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela הוא לקוח מפות ללא Google: אריחים פתוחים למפת הבסיס, נתוני Google שנאספים למקומות, ניתוב וזמני הגעה מודעי-תנועה, וקול Piper שרץ על הטלפון. GPLv3. ללא צורך ב-Play Services."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vela egy degoogled térképkliens: nyílt csempék az alaptérképhez, lekapart Google-adat helyekhez, útvonaltervezéshez és forgalomfüggő érkezési időkhöz, a telefonon futó Piper hang. GPLv3. Nincs szükség Play Services-re."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela è un client di mappe degoogled: riquadri aperti per la mappa di base, dati Google estratti per i POI, percorsi ed ETA con traffico, una voce Piper che gira sul telefono. GPLv3. Nessun Play Services richiesto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela は脱Googleの地図クライアントです。ベースマップにはオープンな地図タイル、場所・経路・交通状況を反映した到着予測には Google から取得したデータ、音声には端末上で動く Piper の音声を使用しています。GPLv3。Play 開発者サービスは不要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela is een gedegoogelde kaartenclient: open tegels voor de basiskaart, gescrapet van Google voor POI's, routering en verkeersbewuste aankomsttijden, een Piper-stem die op de telefoon draait. GPLv3. Geen Play Services vereist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela to odgooglowany klient map: otwarte kafelki dla mapy podkładowej, scrapowany Google dla POI, wyznaczanie tras i czasy przyjazdu uwzględniające ruch, głos Piper działający na telefonie. GPLv3. Nie wymaga Usług Play."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela é um cliente de mapas sem Google: tiles abertos para o mapa base, dados do Google coletados para locais, rotas e horários de chegada sensíveis ao trânsito, e uma voz Piper que roda no celular. GPLv3. Não requer os Serviços do Google Play."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vela é um cliente de mapas sem Google: mosaicos abertos para o mapa base, dados da Google recolhidos para POIs, percursos e ETAs sensíveis ao trânsito, e uma voz Piper que corre no telemóvel. GPLv3. Não requer os Serviços Play."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela este un client de hărți fără servicii Google: folosește OpenTiles pentru harta de bază, preia date de la Google pentru puncte de interes (POI), oferă rute și estimări ale timpului de sosire (ETA) în funcție de trafic, iar vocea este o voce Piper care rulează pe telefon. Licențiat sub GPLv3. Nu sunt necesare serviciile Play."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, это дегуглённый клиент карт: открытые тайлы для основной карты, данные Google для мест, маршрутизация и ETA с учётом пробок, голос Piper, работающий на телефоне. GPLv3. Play Services не требуются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela är en avgooglad kartklient: öppna rutor för baskartan, skrapad Google för intressepunkter, ruttning och trafikmedvetna ankomsttider, en Piper-röst som körs på telefonen. GPLv3. Inga Play Services krävs."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela, це клієнт карт без Google: відкриті плитки для базової карти, зібрані з Google дані про місця, маршрутизація та ETA з урахуванням трафіку, голос Piper, що працює на телефоні. GPLv3. Play Services не потрібні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 是一款去谷歌化的地图客户端：底图来自开放图块，兴趣点、路线和路况预计时间来自对 Google 的抓取，语音使用在手机上运行的 Piper 语音。GPLv3 许可。无需 Play 服务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 是去 Google 化的地圖用戶端：底圖使用開放圖磚，地點、路線規劃和路況預估時間擷取自 Google，語音使用在手機上執行的 Piper 語音。GPLv3 授權，不需要 Play 服務。"
          }
        }
      }
    },
