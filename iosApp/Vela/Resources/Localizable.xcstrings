          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acestea trec prin %1$@. Alegerea unuia păstrează ecranul călătoriei și foaia de detalii pe același itinerariu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они проходят через %1$@. При выборе одного из них экран поездки и подробный лист остаются в одном и том же маршруте."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te gredo skozi %1$@. Če izberete enega, ostaneta zaslon potovanja in list s podrobnostmi na istem načrtu poti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessa passerar genom %1$@. Att välja en håller resskärmen och detaljbladet på samma resplan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunlar %1$@ üzerinden geçiyor. Birini seçtiğinizde yolculuk ekranı ve ayrıntı sayfası aynı seyahat programında kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вони проходять через %1$@. Вибравши один, екран подорожі та аркуш з деталями зберігають той самий маршрут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些通过%1$@。选择一个可使行程屏幕和详细信息表保持在同一行程上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些通過%1$@。選擇一個可將行程畫面和詳細資料表保持在同一行程上。"
          }
        }
      }
    },
