    "settings_storage_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt bereits Heruntergeladenes. Eine SD-Karte ist langsamer, und solange sie entnommen ist, sind die Offline-Karten darauf nicht verfügbar und die Karte wird online geladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves what is already downloaded. An SD card is slower, and while it is out the offline maps on it are unavailable and the map streams instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve lo que ya está descargado. Una tarjeta SD es más lenta y, mientras no esté puesta, sus mapas sin conexión no están disponibles y el mapa se carga por internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplace ce qui est déjà téléchargé. Une carte SD est plus lente, et quand elle est retirée, les cartes hors ligne qu'elle contient sont indisponibles et la carte se charge en ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעביר את מה שכבר הורד. כרטיס SD איטי יותר, וכשהוא לא בטלפון המפות הלא מקוונות שעליו אינן זמינות והמפה נטענת מהרשת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A már letöltött adatokat is áthelyezi. Az SD-kártya lassabb, és amíg ki van véve, a rajta lévő offline térképek nem érhetők el, a térkép pedig online töltődik be."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta anche ciò che è già scaricato. Una scheda SD è più lenta e, quando è rimossa, le mappe offline che contiene non sono disponibili e la mappa viene caricata online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード済みのデータを移動します。SDカードは低速で、取り外している間はそこにあるオフライン マップを使えず、地図はオンラインで読み込まれます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaatst wat al gedownload is. Een SD-kaart is trager, en zolang die eruit is zijn de offlinekaarten erop niet beschikbaar en wordt de kaart gestreamd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenosi to co już pobrano. Karta SD jest wolniejsza a gdy jest wyjęta zapisane na niej mapy offline są niedostępne i mapa wczytuje się z sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move o que já foi baixado. Um cartão SD é mais lento e, enquanto estiver fora, os mapas off-line nele ficam indisponíveis e o mapa é carregado pela rede."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move o que já está transferido. Um cartão SD é mais lento e, enquanto estiver fora, os mapas offline nele ficam indisponíveis e o mapa passa a ser carregado pela rede."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mută ceea ce a fost deja descărcat. Un card SD este mai lent și, cât timp este scos, hărțile off-line de pe acesta nu sunt disponibile, iar harta se încarcă în timp real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже скачанное тоже переносится. SD-карта медленнее, а пока её нет, офлайн-карты на ней недоступны и карта загружается из сети."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyttar det som redan är hämtat. Ett SD-kort är långsammare, och medan det är urtaget går offlinekartorna på det inte att använda och kartan strömmas i stället."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переносить уже завантажене. SD-карта повільніша, і поки її немає, офлайн-карти на ній недоступні, а карта вантажиться з мережі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会移动已下载的内容。SD 卡速度较慢；卡被取出时，其上的离线地图无法使用，地图将改为在线加载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已下載的內容會一併搬移。SD 卡速度較慢，而且取出時卡上的離線地圖無法使用，地圖會改為線上串流。"
          }
        }
      }
    },
