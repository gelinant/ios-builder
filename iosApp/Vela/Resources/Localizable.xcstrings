          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pornește traseul planificat ca o simulare în loc să utilizezi GPS-ul. Dezactivează pentru a naviga în realitate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка Старт проезжает маршрут как симуляцию вместо GPS. Отключите для настоящей навигации."
          }
        },
        "sl" : {
