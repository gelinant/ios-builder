    "root_voice_body_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velas eigene Stimme läuft komplett auf deinem Gerät: natürliche Ansagen, kein Konto, keine Extra-App. Empfohlen, ein einmaliger Download von %1$ld MB."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela's own voice runs entirely on your phone: natural spoken directions, no account, no extra app. Recommended, a one-time %1$ld MB download."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voz propia de Vela funciona por completo en tu teléfono: indicaciones naturales, sin cuenta, sin otra app. Recomendada, una descarga única de %1$ld MB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voix de Vela tourne entièrement sur votre téléphone : instructions naturelles, pas de compte, pas d'appli en plus. Recommandée, un téléchargement unique de %1$ld Mo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקול של Vela פועל כולו בטלפון שלך: הוראות מדוברות טבעיות, ללא חשבון, ללא אפליקציה נוספת. מומלץ, הורדה חד־פעמית בגודל %1$ld מ״ב."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vela saját hangja teljesen a telefonodon fut: természetes hangos útvonalvezetés, fiók nélkül, külön app nélkül. Ajánlott, egyszeri %1$ld MB-os letöltés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voce di Vela gira interamente sul telefono: indicazioni naturali, nessun account, nessun'altra app. Consigliata, un download unico di %1$ld MB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela の音声は完全に端末上で動作します。自然な音声案内で、アカウントも追加アプリも不要。おすすめです（初回のみ %1$ld MB のダウンロード）。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela's eigen stem draait volledig op je telefoon: natuurlijke aanwijzingen, geen account, geen extra app. Aanbevolen, een eenmalige download van %1$ld MB."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Własny głos Veli działa w całości na telefonie: naturalne wskazówki, bez konta i dodatkowej aplikacji. Polecany, jednorazowe pobranie %1$ld MB."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A voz própria do Vela roda inteiramente no celular: instruções naturais, sem conta, sem outro app. Recomendada, um download único de %1$ld MB."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A voz própria da Vela corre inteiramente no telemóvel: indicações naturais, sem conta, sem outra app. Recomendada, uma transferência única de %1$ld MB."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vocea Vela funcționează exclusiv pe telefonul tău: indicații vocale naturale, fără cont, fără aplicație suplimentară. Recomandat, descărcare unică de %1$ld MB."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Собственный голос Vela работает целиком на телефоне: естественные подсказки, без аккаунта и лишних приложений. Рекомендуем, разовая загрузка %1$ld МБ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velas egen röst körs helt på din telefon: naturliga anvisningar, inget konto, ingen extra app. Rekommenderas, en engångsnedladdning på %1$ld MB."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Власний голос Vela працює цілком на телефоні: природні підказки, без акаунта та зайвих застосунків. Рекомендовано, одноразове завантаження %1$ld МБ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 自带语音完全在您的手机上运行：自然的语音播报，无需账号，也无需额外应用。推荐使用，一次性下载 %1$ld MB。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 專屬語音完全在你的手機上執行：自然的語音指引，不需帳戶，也不需額外的應用程式。建議使用，只需一次性下載 %1$ld MB。"
          }
        }
      }
