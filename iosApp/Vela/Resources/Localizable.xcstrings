    "settings_flock_nav_voice_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt während der Navigation „Kennzeichenkamera voraus“ an, wenn Sie sich einer auf Ihrer Route nähern, etwa zwölf Sekunden bevor Sie sie erreichen. Richtet sich nach Ihrer Einstellung für Sprachansagen. Standardmäßig aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While navigating, says \"License plate camera ahead\" as you get close to one on your route, about twelve seconds before you reach it. Follows your spoken-directions setting. Off by default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la navegación, dice «Cámara de matrículas más adelante» al acercarte a una en tu ruta, unos doce segundos antes de llegar. Sigue tu ajuste de indicaciones por voz. Desactivado por defecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la navigation, annonce « Caméra de lecture de plaques à venir » quand vous approchez d'une caméra sur votre itinéraire, environ douze secondes avant de l'atteindre. Suit votre réglage des instructions vocales. Désactivé par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הכרזת „מצלמת לוחיות רישוי לפניך” כשמתקרבים למצלמת לוחיות רישוי במהלך הניווט, כשתים עשרה שניות מראש. פועלת לפי הגדרת ההוראות הקוליות. כבויה כברירת מחדל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigálás közben bemondja, hogy \"Rendszámfelismerő kamera előttünk\", amikor az útvonaladon egyhez közeledsz, nagyjából tizenkét másodperccel előtte. A hangos útvonalvezetés beállítását követi. Alapból ki van kapcsolva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la navigazione dice \"Telecamera lettura targhe più avanti\" quando ti avvicini a una sul percorso, circa dodici secondi prima di raggiungerla. Segue l'impostazione delle indicazioni vocali. Disattivato di default."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ナビ中にルート上のナンバープレート読み取りカメラへ近づくと、約 12 秒前に「この先にナンバー読み取りカメラがあります」と読み上げます。音声案内の設定に従います。初期状態ではオフです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zegt tijdens het navigeren \"Kentekencamera verderop\" wanneer je er een op je route nadert, ongeveer twaalf seconden voordat je hem bereikt. Volgt je instelling voor gesproken aanwijzingen. Standaard uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas nawigacji mówi \"Kamera tablic rejestracyjnych przed tobą\", gdy zbliżasz się do takiej kamery na trasie, około dwunastu sekund przed nią. Działa zgodnie z ustawieniem wskazówek głosowych. Domyślnie wyłączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante a navegação, diz \"Câmera de placas à frente\" quando você se aproxima de uma no seu trajeto, cerca de doze segundos antes de chegar lá. Segue a sua configuração de instruções por voz. Desativado por padrão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante a navegação, diz \"Câmara de matrículas à frente\" quando se aproxima de uma no seu percurso, cerca de doze segundos antes de lá chegar. Segue a sua definição de instruções por voz. Desligado por predefinição."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În timpul navigării, rostește „Cameră pentru numărul de înmatriculare înainte” când te apropii de una pe traseu, cu aproximativ doisprezece secunde înainte de a ajunge la ea. Urmează setarea indicațiilor vocale. Dezactivat în mod implicit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время навигации произносит «Впереди камера распознавания номеров», когда вы приближаетесь к ней на маршруте, примерно за двенадцать секунд до неё. Следует настройке голосовых подсказок. По умолчанию выключено."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med navigacijo približno dvanajst sekund pred kamero za prepoznavanje registrskih tablic izgovori opozorilo. Upošteva nastavitev glasovnih navodil."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under navigering säger Vela ”Nummerplåtskamera framför” när du närmar dig en längs rutten, ungefär tolv sekunder innan du når den. Följer inställningen för röstanvisningar. Av som standard."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час навігації промовляє «Попереду камера розпізнавання номерів», коли ви наближаєтеся до неї на маршруті, приблизно за дванадцять секунд до неї. Відповідає налаштуванню голосових підказок. Типово вимкнено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导航中接近路线上的车牌识别摄像头时播报“前方有车牌识别摄像头”，大约提前十二秒提醒。遵循您的语音播报设置。默认关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "導航時接近路線上的車牌辨識攝影機，會約提前十二秒唸出「前方有車牌辨識攝影機」。會依照你的語音指引設定。預設關閉。"
          }
        }
      }
    },
