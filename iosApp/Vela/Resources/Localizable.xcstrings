    "routing_offer_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt Straßen, Orte und Karte dieser Region, etwa %1$@. Neuberechnungen gehen schneller und die Führung funktioniert ohne Empfang. Downloads findest du unter Einstellungen, Offlinekarten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gets the roads, places and map for this region, about %1$@. Reroutes come faster and directions keep working with no signal. Downloads are in Settings, Offline maps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga las carreteras, los lugares y el mapa de esta región, unos %1$@. Los recálculos son más rápidos y las indicaciones funcionan sin señal. Las descargas están en Ajustes, Mapas sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupère les routes, les lieux et la carte de cette région, environ %1$@. Les recalculs sont plus rapides et le guidage marche sans réseau. Les téléchargements sont dans Paramètres, Cartes hors ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוריד את הכבישים, המקומות והמפה של האזור, כ-%1$@. חישוב מסלול מחדש מהיר יותר והניווט עובד גם בלי קליטה. ההורדות נמצאות בהגדרות, מפות לא מקוונות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letölti a régió útjait, helyeit és térképét, kb. %1$@. Gyorsabb az újratervezés, és a navigáció térerő nélkül is működik. A letöltések a Beállítások, Offline térképek alatt vannak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica strade, luoghi e mappa di questa regione, circa %1$@. I ricalcoli sono più rapidi e le indicazioni funzionano senza segnale. I download sono in Impostazioni, Mappe offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この地域の道路、スポット、地図(約 %1$@)を取得します。再検索が速くなり、電波がなくても案内が続きます。ダウンロードは設定のオフラインマップにあります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haalt de wegen, plaatsen en kaart van deze regio op, ongeveer %1$@. Omleidingen gaan sneller en de routebegeleiding werkt zonder bereik. Downloads staan onder Instellingen, Offline kaarten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobiera drogi, miejsca i mapę tego regionu, około %1$@. Przeliczanie trasy jest szybsze, a nawigacja działa bez zasięgu. Pobrane dane są w Ustawieniach, w mapach offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtém as ruas, os locais e o mapa desta região, cerca de %1$@. Os recálculos ficam mais rápidos e as instruções funcionam sem rede. Os downloads ficam em Configurações, Mapas off-line."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtém as estradas, os locais e o mapa desta região, cerca de %1$@. Os recálculos ficam mais rápidos e as indicações funcionam sem rede. As transferências estão em Definições, Mapas offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează drumurile, locațiile și harta pentru această regiune, aproximativ %1$@. Recalcularea traseului se face mai rapid, iar indicațiile de navigare funcționează în continuare chiar și fără semnal. Descărcările se găsesc în Setări, Hărți off-line."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружает дороги, места и карту региона, около %1$@. Перестроение маршрута быстрее, а навигация работает без связи. Загрузки находятся в Настройках, в разделе офлайн-карт."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hämtar vägar, platser och karta för regionen, cirka %1$@. Omräkningar går snabbare och vägvisningen fungerar utan täckning. Nedladdningar finns under Inställningar, Offlinekartor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантажує дороги, місця й карту регіону, близько %1$@. Перебудова маршруту швидша, а навігація працює без зв'язку. Завантаження є в Налаштуваннях, у розділі офлайн-карт."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载该地区的道路、地点和地图,约 %1$@。重新规划更快,没有信号也能继续导航。下载内容可在设置的离线地图中管理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載該地區的道路、地點和地圖,約 %1$@。重新規劃更快,沒有訊號也能繼續導航。下載內容可在設定的離線地圖中管理。"
          }
        }
      }
    },
