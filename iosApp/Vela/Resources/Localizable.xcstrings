    "settings_diagnostics_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig aus. Wenn an, führt Vela ein kurzes lokales Protokoll, das du exportieren und einem Entwickler geben kannst. Nichts wird hochgeladen; Ausschalten löscht es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default. When on, Vela keeps a short local log you can export and hand to a developer. Nothing is uploaded, and turning it off wipes the log."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado por defecto. Al activarlo, Vela guarda un breve registro local que puedes exportar y dar a un desarrollador. No se sube nada, y desactivarlo lo borra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé par défaut. Activé, Vela tient un court journal local que vous pouvez exporter et donner à un développeur. Rien n'est envoyé, et le désactiver l'efface."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבוי כברירת מחדל. כשדלוק, Vela שומר יומן מקומי קצר שאפשר לייצא ולמסור למפתח. שום דבר לא מועלה, וכיבוי מוחק את היומן."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alapból kikapcsolva. Bekapcsolva a Vela egy rövid helyi naplót vezet, amit exportálhatsz és átadhatsz egy fejlesztőnek. Semmi nem kerül feltöltésre, és a kikapcsolás törli a naplót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato di default. Se attivo, Vela tiene un breve registro locale che puoi esportare e dare a uno sviluppatore. Nulla viene caricato, e disattivarlo lo cancella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初期状態ではオフです。オンにすると、Vela は端末内に短いログを保存し、エクスポートして開発者に渡せます。何もアップロードされず、オフにするとログは消去されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standaard uit. Indien aan houdt Vela een kort lokaal logboek bij dat je kunt exporteren en aan een ontwikkelaar geven. Er wordt niets geüpload, en uitzetten wist het."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślnie wyłączone. Po włączeniu Vela prowadzi krótki lokalny dziennik który możesz wyeksportować i przekazać deweloperowi. Nic nie jest wysyłane a wyłączenie go czyści."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado por padrão. Quando ativado, o Vela mantém um pequeno registro local que você pode exportar e entregar a um desenvolvedor. Nada é enviado, e desativar o apaga."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado por predefinição. Ligado, a Vela mantém um pequeno registo local que podes exportar e entregar a um programador. Nada é enviado, e desligar apaga-o."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opțiunea este dezactivată în mod implicit. Când este activată, Vela păstrează un jurnal local succint pe care îl poți exporta și transmite unui dezvoltator. Nu se încarcă nimic, iar dezactivarea opțiunii șterge jurnalul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию выключено. При включении Vela ведёт короткий локальный журнал, который можно экспортировать и передать разработчику. Ничего не выгружается, а отключение стирает его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av som standard. När på för Vela en kort lokal logg som du kan exportera och ge till en utvecklare. Inget laddas upp, och att stänga av rensar den."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Типово вимкнено. Якщо ввімкнено, Vela веде короткий локальний журнал, який можна експортувати й передати розробнику. Нічого не надсилається, а вимкнення стирає його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认关闭。开启后，Vela 会在本地保留一份简短日志，可导出并交给开发者。不会上传任何内容，关闭即清除日志。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設為關閉。開啟後，Vela 會在本機保留簡短記錄，可匯出交給開發者。不會上傳任何內容，關閉時會清除記錄。"
          }
        }
      }
    },
