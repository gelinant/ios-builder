    "settings_confirm_end_nav_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zurück-Taste“ fragt während der Fahrt immer zuerst, ob die Navigation beendet werden soll. Wenn diese Option aktiviert ist, fragt auch die \"Taste-X\" danach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back during a drive always asks first. With this on, the red X asks too"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La X roja y Atrás preguntan primero durante un trayecto, para que un toque accidental no lo termine"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant un trajet, la croix rouge et Retour demandent d'abord, pour qu'un appui accidentel n'y mette pas fin"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כפתור החזרה תמיד מבקש אישור בזמן נסיעה. אפשרות זו דואגת שתוצג בקשת אישור גם בעת לחיצה על האיקס האדום"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vezetés közben a piros X és a Vissza előbb rákérdez, hogy egy véletlen koppintás ne fejezze be"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la guida, il sistema chiede sempre prima conferma. Con questa funzione attiva, anche la \"X\" rossa richiede conferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走行中は赤い × と「戻る」で確認を表示し、誤タップでナビが終了しないようにします"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De rode X en Terug vragen tijdens een rit eerst om bevestiging, zodat een verdwaalde tik de rit niet beëindigt"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas jazdy system zawsze najpierw pyta o potwierdzenie. Gdy ta funkcja jest włączona czerwony symbol X również wymaga potwierdzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O X vermelho e o botão Voltar pedem confirmação durante o trajeto, para que um toque sem querer não encerre a navegação"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O botão Voltar pede confirmação durante a condução, para que um toque acidental não a termine"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Întotdeauna întreabă mai întâi în timpul unei curse. Dacă este activat, și X-ul roșu întreabă"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Красный крестик и кнопка «Назад» во время поездки сначала спрашивают, чтобы случайное нажатие её не завершило"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumb za nazaj med vožnjo vedno zahteva potrditev. S to možnostjo jo zahteva tudi rdeči X"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det röda krysset och Tillbaka frågar först under körning, så att ett oavsiktligt tryck inte avslutar den"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Червоний хрестик і «Назад» під час поїздки спершу запитують, щоб випадковий дотик її не завершив"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行驶中点按红色 X 或返回时会先询问，以免误触结束导航"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行車中點按紅色 X 或返回時會先詢問，避免誤觸就結束導航"
          }
        }
      }
    },
