        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android は Google マップのリンクをブラウザで開きます。Vela で開くには、「サポートされているリンクを開く」をオンにして、「デフォルトで開く」でリンクを追加してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
