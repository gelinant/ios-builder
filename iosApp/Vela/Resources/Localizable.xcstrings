    "settings_trip_batch_explain" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fahrten werden zusammen als eine ZIP-Datei geteilt. Jede wird mit demselben Abstand gekürzt: Alle Punkte nahe ihrem Start, ihrem Ende, ihrem Ziel sowie Zuhause und Arbeit werden gelöscht, die Mitte bleibt in voller Genauigkeit erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The trips go out together as one zip file. Each one is trimmed at the same distance: every point near its start, its end, its destination and your Home and Work is deleted, and the middle is kept at full precision."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los trayectos se envían juntos en un solo archivo zip. Cada uno se recorta con la misma distancia: se eliminan todos los puntos cercanos a su inicio, su final, su destino y tu Casa y tu Trabajo, y la parte central se conserva con toda su precisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les trajets partent ensemble dans un seul fichier zip. Chacun est rogné à la même distance : tous les points près de son départ, de son arrivée, de sa destination et de vos adresses Domicile et Travail sont supprimés, et le milieu est gardé en pleine précision."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הנסיעות נשלחות יחד כקובץ zip אחד. כל אחת נגזמת באותו מרחק: כל נקודה קרובה להתחלה, לסוף, ליעד ולבית ולעבודה שלך נמחקת, והאמצע נשמר בדיוק מלא."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az utak együtt, egyetlen zip-fájlban mennek ki. Mindegyik ugyanakkora távolságon lesz levágva: törlődik az összes pont a kezdet, a vég, a célpont, valamint az Otthonod és a Munkahelyed közelében, a közepe pedig teljes pontossággal megmarad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I viaggi vengono inviati insieme in un unico file zip. Ognuno viene tagliato alla stessa distanza: ogni punto vicino alla partenza, all'arrivo, alla destinazione e a Casa e Lavoro viene eliminato, e la parte centrale resta a piena precisione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動記録はまとめて 1 つの zip ファイルとして送られます。どれも同じ距離でトリミングされ、出発地・到着地・目的地・自宅・職場の近くの測位点をすべて削除し、途中は元の精度のまま残します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ritten gaan samen weg als één zipbestand. Elke rit wordt op dezelfde afstand ingekort: elk punt bij het begin, het einde, de bestemming en je Thuis en Werk wordt verwijderd, en het middenstuk blijft op volle nauwkeurigheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podróże trafiają razem do jednego pliku zip. Każda jest przycinana o tę samą odległość: usuwane są wszystkie punkty w pobliżu jej startu, końca, celu oraz twojego Domu i Pracy, a środek zostaje w pełnej dokładności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As viagens seguem juntas em um único arquivo zip. Cada uma é cortada na mesma distância: todos os pontos perto do início, do fim, do destino e da sua Casa e Trabalho são excluídos, e o meio fica com toda a precisão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As viagens seguem juntas num único ficheiro zip. Cada uma é cortada à mesma distância: todos os pontos perto do início, do fim, do destino e da sua Casa e Trabalho são eliminados, e o meio fica com toda a precisão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Călătoriile sunt trimise împreună într-un singur fișier zip. Fiecare dintre ele este decupată la aceeași distanță: toate punctele aflate în apropierea punctului de plecare, a punctului de sosire, a destinației, precum și a locuinței și a locului de muncă sunt eliminate, iar partea din mijloc rămâne cu precizie maximă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поездки отправляются вместе одним zip-файлом. Каждая обрезается на одно и то же расстояние: все точки рядом с её началом, концом, пунктом назначения, а также с вашим домом и работой удаляются, а середина остаётся с полной точностью."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resorna skickas tillsammans som en zip-fil. Var och en beskärs på samma avstånd: varje punkt nära dess start, slut, mål och ditt Hem och Arbete tas bort, och mitten behålls med full precision."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поїздки надсилаються разом одним zip-файлом. Кожну обрізано на однакову відстань: усі точки біля її початку, кінця, пункту призначення, а також вашої домівки та роботи видаляються, а середина зберігається з повною точністю."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些行程会打包成一个 zip 文件一起发送。每条行程都按相同距离裁剪：删除起点、终点、目的地以及家和公司附近的所有定位点，中间部分保持完整精度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些行程會合併成一個 zip 檔一起送出。每筆行程都以相同距離修剪：刪除起點、終點、目的地以及住家和公司附近的所有定位點，中段則保留完整精度。"
          }
        }
      }
    },
    "settings_trip_batch_left_out" : {
      "extractionState" : "manual",
      "localizations" : {
