        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ikonok a Google-től származnak. Minden mozgatás elküldi a térképpozíciódat a Google-nek, és offline semmi nem rajzolódik ki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le icone vengono da Google. Ogni spostamento invia a Google la posizione della mappa e offline non si disegna nulla."
