            "state" : "translated",
            "value" : "Die Symbole stammen von Google. Jedes Verschieben sendet Ihre Kartenposition an Google, und offline wird nichts gezeichnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icons come from Google. Every pan sends your map position to Google, and nothing draws offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los iconos vienen de Google. Cada desplazamiento envía tu posición del mapa a Google y no se dibuja nada sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les icônes viennent de Google. Chaque déplacement envoie votre position sur la carte à Google, et rien ne s'affiche hors ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסמלים מגיעים מ־Google. כל גלילה במפה שולחת את מיקומך במפה ל־Google, ושום דבר לא עובד כשאין חיבור לרשת."
          }
