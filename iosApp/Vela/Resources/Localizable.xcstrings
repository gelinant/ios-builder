    "settings_contacts_search_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Tippen eines Kontaktnamens werden dessen gespeicherte Adressen vorgeschlagen, mit Foto und der Adressbezeichnung aus Ihrem Adressbuch. Ihre Kontakte bleiben auf diesem Telefon; ein ausgewählter Kontakt wird wie jede getippte Suche nachgeschlagen und unter dem Namen des Kontakts geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typing a contact's name suggests their saved addresses, with their photo and the address label from your address book. Your contacts stay on this phone; picking one looks up that address like any typed query and opens it under the contact's name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al escribir el nombre de un contacto se sugieren sus direcciones guardadas, con su foto y la etiqueta de la dirección de tu agenda. Tus contactos no salen de este teléfono; al elegir uno, esa dirección se busca como cualquier consulta escrita y se abre con el nombre del contacto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisir le nom d'un contact propose ses adresses enregistrées, avec sa photo et le libellé de l'adresse issu de votre carnet d'adresses. Vos contacts restent sur ce téléphone ; en choisir un recherche cette adresse comme n'importe quelle saisie et l'ouvre sous le nom du contact."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקלדת שם של איש קשר מציעה את כתובותיו השמורות, עם התמונה ותווית הכתובת מפנקס הכתובות שלך. אנשי הקשר נשארים בטלפון הזה; בחירה באחד מהם מחפשת את הכתובת כמו כל שאילתה מוקלדת ופותחת אותה תחת שם איש הקשר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy névjegy nevének begépelése felkínálja a mentett címét. A névjegyeid a telefonodon maradnak; egy javaslat kiválasztása ugyanúgy keres, mint egy begépelt keresés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitando il nome di un contatto compaiono i suoi indirizzi salvati, con la foto e l'etichetta dell'indirizzo presa dalla rubrica. I tuoi contatti restano su questo telefono; sceglierne uno cerca quell'indirizzo come una qualsiasi ricerca digitata e lo apre sotto il nome del contatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連絡先の名前を入力すると、保存されている住所を写真とアドレス帳のラベル付きで候補に表示します。連絡先はこの端末内にとどまります。候補を選ぶと、入力した検索と同じようにその住所を調べ、連絡先の名前で開きます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ je de naam van een contact, dan worden de opgeslagen adressen voorgesteld, met de foto en het adreslabel uit je adresboek. Je contacten blijven op deze telefoon; kies je er een, dan wordt dat adres net als elke getypte zoekopdracht opgezocht en geopend onder de naam van het contact."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisanie nazwy kontaktu podpowiada zapisane u niego adresy, wraz ze zdjęciem i etykietą adresu z książki adresowej. Twoje kontakty zostają na tym telefonie; wybranie jednego wyszukuje ten adres jak każde wpisane zapytanie i otwiera go pod nazwą kontaktu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao digitar o nome de um contato, o Vela sugere os endereços salvos, com a foto e o rótulo do endereço da agenda. Os contatos ficam neste celular; escolher um pesquisa esse endereço como qualquer pesquisa digitada e o abre com o nome do contato."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao escrever o nome de um contacto, a Vela sugere as moradas guardadas, com a foto e a etiqueta da morada do livro de endereços. Os contactos ficam neste telemóvel; escolher um procura essa morada como qualquer pesquisa escrita e abre-a com o nome do contacto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastarea numelui unui contact sugerează adresele salvate ale acestuia, împreună cu fotografia acestuia și eticheta de adresă din agendă. Contactele tale rămân pe acest telefon; alegerea unuia dintre ele caută adresa respectivă ca orice interogare tastată și o deschide sub numele contactului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При вводе имени контакта Vela предлагает сохранённые у него адреса вместе с фото и подписью адреса из адресной книги. Контакты остаются на этом телефоне; выбранный адрес ищется как обычный запрос и открывается под именем контакта."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko vnesete ime stika, aplikacija predlaga njegove shranjene naslove skupaj s fotografijo in oznako naslova iz imenika. Stiki ostanejo v telefonu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du skriver namnet på en kontakt föreslås deras sparade adresser, med foto och adressetiketten från din adressbok. Dina kontakter stannar på den här telefonen; att välja en slår upp den adressen som vilken sökning som helst och öppnar den under kontaktens namn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kişinin adını yazmaya başladığınızda, adres defterinizdeki fotoğrafı ve adres etiketi ile birlikte kaydedilmiş adresleri önerilir. Kişileriniz bu telefonda kalır; birini seçtiğinizde, herhangi bir yazılan sorguda olduğu gibi o adres aranır ve kişinin adının altında açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввести ім'я контакту, Vela запропонує збережені для нього адреси разом із фото та міткою адреси з вашої адресної книги. Контакти залишаються на цьому телефоні; вибір одного з них шукає ту адресу так само, як будь-який введений запит, і відкриває її під іменем контакту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入联系人姓名时，会推荐其保存的地址，并显示头像和通讯录中的地址标签。您的联系人始终留在本机；选择后会像普通输入的查询一样查找该地址，并以联系人姓名打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入聯絡人姓名時，會依通訊錄中的相片與地址標籤，建議他們已儲存的地址。你的聯絡人只留在這支手機上；選取後會像一般輸入的查詢一樣查詢該地址，並以聯絡人的姓名開啟。"
          }
        }
      }
    },
