        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "carry ratings, price levels, live opening hours or accessibility data,"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "carry ratings, price levels, live opening hours or accessibility data,"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "llevar calificaciones, niveles de precios, horarios de apertura en vivo o datos de accesibilidad,"
