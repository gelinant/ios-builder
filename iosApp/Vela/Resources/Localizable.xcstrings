    "settings_voice_search_model_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vela-Stimme macht aus Sprache direkt auf deinem Gerät eine Suche: keine andere App nötig, nichts wird hochgeladen. Einmaliger Download von %1$ld MB."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela Voice turns speech into a search right on your phone: no other app needed and nothing is uploaded. One-time %1$ld MB download."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voz de Vela convierte tu voz en una búsqueda directamente en el teléfono: sin otra app y sin subir nada. Descarga única de %1$ld MB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voix Vela transforme la parole en recherche directement sur votre téléphone : aucune autre appli et rien n'est envoyé. Téléchargement unique d'environ %1$ld Mo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela Voice הופך דיבור לחיפוש ישירות בטלפון שלך: לא צריך אפליקציה אחרת ושום דבר לא מועלה. הורדה חד־פעמית בגודל %1$ld מ״ב."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vela Hang beszédet alakít kereséssé közvetlenül a telefonodon: nincs szükség másik appra, és semmi nem kerül feltöltésre. Egyszeri %1$ld MB-os letöltés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voce Vela trasforma il parlato in una ricerca direttamente sul telefono: nessun'altra app e nulla viene caricato. Download una tantum di %1$ld MB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 音声は、話した言葉を端末上でそのまま検索に変えます。ほかのアプリは不要で、何もアップロードされません。初回のみ %1$ld MB のダウンロードです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Vela-stem zet spraak direct op je telefoon om in een zoekopdracht: geen andere app nodig en er wordt niets geüpload. Eenmalige download van %1$ld MB."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głos Vela zamienia mowę w wyszukiwanie bezpośrednio na telefonie: bez innej aplikacji i bez wysyłania czegokolwiek. Jednorazowe pobranie %1$ld MB."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A voz Vela transforma a fala em uma pesquisa diretamente no celular: sem outro app e sem enviar nada. Download único de %1$ld MB."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A voz Vela transforma a fala numa pesquisa diretamente no telemóvel: sem outra app e sem enviar nada. Transferência única de %1$ld MB."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voce Vela transformă vorbirea într-o căutare direct pe telefonul tău: nu ai nevoie de nicio altă aplicație și nu se încarcă nimic. Descărcare unică de %1$ld MB."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голос Vela превращает речь в поиск прямо на телефоне: без других приложений и без выгрузки данных. Разовая загрузка %1$ld МБ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela-rösten gör tal till en sökning direkt på telefonen: ingen annan app behövs och inget laddas upp. Engångsnedladdning på %1$ld MB."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голос Vela перетворює мовлення на пошук просто на телефоні: без інших застосунків і без надсилання даних. Одноразове завантаження %1$ld МБ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 语音直接在您的手机上将语音转为搜索：无需其他应用，也不会上传任何内容。一次性下载 %1$ld MB。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela 語音直接在你的手機上把語音轉成搜尋：不需要其他應用程式，也不會上傳任何內容。只需一次性下載 %1$ld MB。"
          }
        }
      }
    },
