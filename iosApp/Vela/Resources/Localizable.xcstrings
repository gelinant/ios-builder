    "settings_demo_drive_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start fährt die geplante Route als Simulation statt per GPS. Zum echten Navigieren ausschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start drives the planned route as a simulation instead of using GPS. Turn off to navigate for real."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar recorre la ruta planeada como simulación en lugar de usar GPS. Desactívalo para navegar de verdad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarrer parcourt l'itinéraire prévu en simulation au lieu du GPS. Désactivez pour naviguer réellement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"התחל\" נוסע במסלול המתוכנן כהדמיה במקום להשתמש ב-GPS. כבה כדי לנווט באמת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indításkor a tervezett útvonalat szimulálja GPS helyett. Kapcsold ki a valódi navigációhoz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia percorre il percorso pianificato in simulazione anziché col GPS. Disattiva per navigare davvero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「開始」をタップすると、GPS を使わずに予定ルートをシミュレーション走行します。実際にナビを使うときはオフにしてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start rijdt de geplande route als simulatie in plaats van met gps. Zet uit om echt te navigeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start jedzie zaplanowaną trasą jako symulacja zamiast GPS. Wyłącz aby nawigować naprawdę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar percorre a rota planejada como simulação em vez de usar o GPS. Desative para navegar de verdade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
