    "voice_cmd_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das klappt gesprochen oder in die Suchleiste getippt, in der App-Sprache oder auf Englisch. Alles andere wird normal gesucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These work spoken or typed into the search bar, in the app language or English. Anything else runs as a normal search."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funcionan dichos o escritos en la barra de búsqueda, en el idioma de la app o en inglés. Todo lo demás es una búsqueda normal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces commandes marchent à la voix ou tapées dans la barre de recherche, dans la langue de l'app ou en anglais. Le reste lance une recherche normale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפקודות עובדות בדיבור או בהקלדה בשורת החיפוש, בשפת היישום או באנגלית. כל דבר אחר מופעל כחיפוש רגיל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimondva vagy a keresősávba írva is működnek, az alkalmazás nyelvén vagy angolul. Minden más sima keresés lesz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funzionano a voce o scritti nella barra di ricerca, nella lingua dell'app o in inglese. Il resto diventa una ricerca normale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声でも検索バーへの入力でも使えます。アプリの言語か英語で話してください。それ以外は通常の検索になります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit werkt gesproken of getypt in de zoekbalk, in de apptaal of in het Engels. Al het andere wordt een gewone zoekopdracht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działają one zarówno po wypowiedzeniu jak i wpisaniu w pasek wyszukiwania – w języku aplikacji lub po angielsku. Wszystkie pozostałe zapytania są traktowane jak zwykłe wyszukiwanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funcionam falados ou digitados na barra de pesquisa, no idioma do app ou em inglês. O resto é uma pesquisa normal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funcionam falados ou escritos na barra de pesquisa, no idioma da app ou em inglês. O resto é uma pesquisa normal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comenzile se introduc prin comandă vocală sau prin tastarea textului în bara de căutare, în limba aplicației sau în engleză. Restul se caută ca de obicei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команды работают голосом или текстом в строке поиска, на языке приложения или по-английски. Всё остальное ищется как обычно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De fungerar sagda eller skrivna i sökfältet, på appens språk eller på engelska. Allt annat blir en vanlig sökning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команди працюють голосом або текстом у рядку пошуку, мовою застосунку чи англійською. Усе інше шукається як звичайно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说出或在搜索栏输入都可以,使用应用语言或英语。其他内容按普通搜索处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說出或在搜尋列輸入都可以,使用應用程式語言或英文。其他內容會以一般搜尋處理。"
          }
        }
      }
    },
