    "map_each_layer_loads_only_while_it" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تحميل كل طبقة فقط أثناء تشغيلها وتكون الخريطة قريبة بدرجة كافية لقراءتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Ebene wird nur geladen, wenn sie aktiviert ist und die Karte nah genug ist, um sie lesen zu können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each layer loads only while it is on and the map is close enough to read it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each layer loads only while it is on and the map is close enough to read it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada capa se carga solo mientras está activada y el mapa está lo suficientemente cerca para leerla."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga kiht laaditakse ainult siis, kui see on sisse lülitatud ja kaart on selle lugemiseks piisavalt lähedal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque couche se charge uniquement lorsqu'elle est activée et que la carte est suffisamment proche pour la lire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל שכבה נטענת רק כשהיא פועלת והמפה קרובה מספיק כדי לקרוא אותה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden réteg csak akkor töltődik be, ha be van kapcsolva, és a térkép elég közel van ahhoz, hogy elolvassa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni livello viene caricato solo mentre è attivo e la mappa è abbastanza vicina per poterlo leggere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各レイヤーは、それがオンになっており、マップが十分に近くにある場合にのみ読み込まれます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke laag wordt alleen geladen als deze is ingeschakeld en de kaart dichtbij genoeg is om deze te kunnen lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda warstwa ładuje się tylko wtedy, gdy jest włączona, a mapa jest wystarczająco blisko, aby ją odczytać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada camada é carregada apenas enquanto está ativada e o mapa está próximo o suficiente para lê-la."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada camada é carregada apenas enquanto está ativada e o mapa está próximo o suficiente para lê-la."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare strat se încarcă numai când este activat, iar harta este suficient de aproape pentru a o citi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый слой загружается только тогда, когда он включен и карта находится достаточно близко, чтобы его можно было прочитать."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsak sloj se naloži le, ko je vklopljen in je zemljevid dovolj blizu, da ga lahko preberete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje lager laddas bara när det är på och kartan är tillräckligt nära för att läsa den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her katman yalnızca açıkken ve harita onu okuyabilecek kadar yakınken yüklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен шар завантажується лише тоді, коли він увімкнено, а карта знаходиться достатньо близько, щоб прочитати його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个图层仅在其打开且地图足够近以读取时加载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個圖層僅在其打開且地圖足夠近以讀取時加載。"
          }
        }
      }
    },
    "map_every_layer_is_off_until_you" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم إيقاف تشغيل كل طبقة حتى تقوم بتشغيلها. تقرأ الطبقة مصدرها فقط أثناء تشغيلها، وتظهر عمر آخر بيانات لها، وتتوقف عن الرسم عندما تكون البيانات أقدم من نافذتها. الطبقات التي تم وضع علامة غير مثبتة غير موجودة في هذا الإصدار حتى الآن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Ebene ist ausgeschaltet, bis Sie sie einschalten. Ein Layer liest seine Quelle nur, während er aktiviert ist, zeigt das Alter seiner letzten Daten an und stoppt das Zeichnen, wenn die Daten älter als sein eigenes Fenster sind. Als nicht installiert markierte Layer sind in diesem Build noch nicht vorhanden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every layer is off until you turn it on. A layer reads its source only while it is on, shows the age of its last data, and stops drawing when the data is older than its own window. Layers marked not installed do not exist in this build yet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every layer is off until you turn it on. A layer reads its source only while it is on, shows the age of its last data, and stops drawing when the data is older than its own window. Layers marked not installed do not exist in this build yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada capa está apagada hasta que la enciendes. Una capa lee su fuente solo mientras está activada, muestra la antigüedad de sus últimos datos y deja de dibujar cuando los datos son más antiguos que su propia ventana. Las capas marcadas como no instaladas aún no existen en esta compilación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga kiht on välja lülitatud, kuni selle sisse lülitate. Kiht loeb oma allikat ainult siis, kui see on sisse lülitatud, näitab viimaste andmete vanust ja lõpetab joonistamise, kui andmed on vanemad kui tema enda aken. Kihid, mis on märgitud installimata, pole selles järgus veel olemas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque calque est désactivé jusqu'à ce que vous l'activiez. Un calque lit sa source uniquement lorsqu'il est activé, affiche l'âge de ses dernières données et arrête de dessiner lorsque les données sont plus anciennes que sa propre fenêtre. Les couches marquées non installées n'existent pas encore dans cette version."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל שכבה כבויה עד שאתה מפעיל אותה. שכבה קוראת את המקור שלה רק כשהיא פועלת, מציגה את גיל הנתונים האחרונים שלה ומפסיקה לצייר כשהנתונים ישנים יותר מהחלון שלה. שכבות המסומנות לא מותקנות עדיין אינן קיימות במבנה זה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden réteg ki van kapcsolva, amíg be nem kapcsolja. Egy réteg csak bekapcsolt állapotban olvassa be a forrását, megmutatja utolsó adatainak korát, és leállítja a rajzolást, ha az adatok régebbiek, mint a saját ablaka. A nem telepített megjelölésű rétegek még nem léteznek ebben a buildben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni livello è disattivato finché non lo attivi. Un livello legge la propria origine solo mentre è attivo, mostra l'età dei suoi ultimi dati e smette di disegnare quando i dati sono più vecchi della propria finestra. I livelli contrassegnati come non installati non esistono ancora in questa build."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのレイヤーは、オンにするまでオフになります。レイヤーは、オンになっている間のみソースを読み取り、最後のデータの古さを表示し、データがそのウィンドウより古い場合は描画を停止します。 「インストールされていない」とマークされたレイヤーは、このビルドにはまだ存在しません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke laag is uitgeschakeld totdat u deze inschakelt. Een laag leest zijn bron alleen als deze is ingeschakeld, toont de ouderdom van zijn laatste gegevens en stopt met tekenen wanneer de gegevens ouder zijn dan zijn eigen venster. Lagen die als niet geïnstalleerd zijn gemarkeerd, bestaan ​​nog niet in deze build."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda warstwa jest wyłączona, dopóki jej nie włączysz. Warstwa odczytuje swoje źródło tylko wtedy, gdy jest włączone, pokazuje wiek swoich ostatnich danych i przestaje rysować, gdy dane są starsze niż jej własne okno. Warstwy oznaczone jako niezainstalowane jeszcze nie istnieją w tej kompilacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada camada fica desativada até você ativá-la. Uma camada lê sua origem apenas enquanto está ativada, mostra a idade de seus últimos dados e para de desenhar quando os dados são mais antigos que sua própria janela. As camadas marcadas como não instaladas ainda não existem nesta compilação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada camada fica desativada até você ativá-la. Uma camada lê sua origem apenas enquanto está ativada, mostra a idade de seus últimos dados e para de desenhar quando os dados são mais antigos que sua própria janela. As camadas marcadas como não instaladas ainda não existem nesta compilação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare strat este dezactivat până când îl porniți. Un strat își citește sursa numai când este activat, arată vârsta ultimelor sale date și se oprește desenarea atunci când datele sunt mai vechi decât propria fereastră. Straturile marcate ca neinstalate nu există încă în această versiune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый слой отключен, пока вы его не включите. Слой считывает свой источник только тогда, когда он включен, показывает возраст последних данных и прекращает рисование, когда данные старше, чем его собственное окно. Слои, помеченные как неустановленные, еще не существуют в этой сборке."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsaka plast je izklopljena, dokler je ne vklopite. Sloj bere svoj izvor le, ko je vklopljen, prikazuje starost svojih zadnjih podatkov in preneha risati, ko so podatki starejši od lastnega okna. Sloji, označeni kot nenameščeni, še ne obstajajo v tej zgradbi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje lager är avstängt tills du slår på det. Ett lager läser bara sin källa när den är på, visar åldern på sina senaste data och slutar rita när data är äldre än sitt eget fönster. Lager som är markerade som inte installerade finns inte i denna version ännu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz açana kadar her katman kapalıdır. Katman, kaynağını yalnızca açıkken okur, son verilerinin yaşını gösterir ve veriler kendi penceresinden daha eski olduğunda çizimi durdurur. Yüklü değil olarak işaretlenen katmanlar henüz bu yapıda mevcut değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен шар вимкнено, доки ви його не ввімкнете. Шар читає своє джерело, лише коли він увімкнено, показує вік своїх останніх даних і припиняє малювання, коли дані старіші за його власне вікно. У цій збірці ще не існує шарів, позначених як не встановлені."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一层都处于关闭状态，直到您将其打开。图层仅在打开时读取其源，显示其最后数据的年龄，并在数据早于其自己的窗口时停止绘制。此版本中尚不存在标记为未安装的层。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一層都處於關閉狀態，直到您將其打開。圖層僅在開啟時讀取其來源，顯示其最後資料的年齡，並在資料早於自己的視窗時停止繪製。此版本中尚不存在標記為未安裝的圖層。"
          }
        }
      }
    },
    "map_every_look_is_a_local_style" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل مظهر هو نمط محلي تم بناؤه من قاعدة Liberty المجمعة. يمكن أن يكون مظهر Vela فاتحًا أو داكنًا؛ يحتفظ الآخرون بألواحهم الخاصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Look ist ein lokaler Stil, der auf der gebündelten Liberty-Basis basiert. Der Vela-Look kann hell oder dunkel sein; die anderen behalten ihre eigenen Paletten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every look is a local style built from the bundled Liberty base. The Vela look can be light or dark; the others keep their own palettes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every look is a local style built from the bundled Liberty base. The Vela look can be light or dark; the others keep their own palettes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada look es un estilo local construido a partir de la base Liberty incluida. El aspecto del Vela puede ser claro u oscuro; los demás mantienen sus propias paletas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga välimus on kohalik stiil, mis on ehitatud komplekteeritud Liberty baasist. Vela välimus võib olla hele või tume; teised jätavad oma paletid endale."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque look est un style local construit à partir de la base Liberty fournie. L'aspect du Vela peut être clair ou foncé ; les autres gardent leurs propres palettes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל מראה הוא סגנון מקומי שנבנה מבסיס החירות המצורף. מראה Vela יכול להיות בהיר או כהה; האחרים שומרים על פלטות משלהם."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden megjelenés egy helyi stílus, amely a kötegelt Liberty alapból épült fel. A Vela megjelenése lehet világos vagy sötét; a többiek megtartják a saját palettájukat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni look è uno stile locale costruito a partire dalla base Liberty in bundle. L'aspetto Vela può essere chiaro o scuro; gli altri mantengono le proprie tavolozze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのルックは、バンドルされたリバティ ベースから構築されたローカル スタイルです。 Vela の外観は明るくても暗くても構いません。他の人は独自のパレットを保持します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke look is een lokale stijl opgebouwd uit de gebundelde Liberty-basis. De Vela-look kan licht of donker zijn; de anderen behouden hun eigen paletten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy wygląd to lokalny styl zbudowany na podstawie dołączonej bazy Liberty. Wygląd Vela może być jasny lub ciemny; pozostali zachowują własne palety."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada look é um estilo local construído a partir da base Liberty incluída. A aparência do Vela pode ser clara ou escura; os demais mantêm suas próprias paletas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada look é um estilo local construído a partir da base Liberty incluída. A aparência do Vela pode ser clara ou escura; os demais mantêm suas próprias paletas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare aspect este un stil local construit din baza Liberty inclusă. Aspectul Vela poate fi deschis sau întunecat; ceilalți își păstrează propriile palete."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый образ - это местный стиль, созданный на основе входящей в комплект базы Liberty. Внешний вид Vela может быть светлым или темным; остальные сохраняют свои палитры."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsak videz je lokalni slog, zgrajen iz priložene baze Liberty. Videz Vela je lahko svetel ali temen; drugi hranijo svoje palete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje look är en lokal stil byggd från den medföljande Liberty-basen. Vela-utseendet kan vara ljust eller mörkt; de andra behåller sina egna paletter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her görünüm, birlikte verilen Liberty tabanından oluşturulmuş yerel bir stildir. Vela görünümü açık veya koyu olabilir; diğerleri kendi paletlerini saklıyorlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен образ - це місцевий стиль, побудований на базі Liberty. Вид Vela може бути світлим або темним; інші зберігають власні палітри."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一款造型都是基于捆绑的 Liberty 基础打造的本地风格。 Vela 外观可以是浅色或深色；其他人保留自己的调色板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一款造型都是基於捆綁的 Liberty 基礎打造的本地風格。 Vela 外觀可以是淺色或深色；其他人保留自己的調色板。"
          }
        }
      }
    },
