    "settings_trip_scrub_short" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Fahrt ist kürzer als der Kürzungsabstand, es bleibt also keine Mitte zum Teilen. Versuchen Sie es mit einem kleineren Abstand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This drive is shorter than the trim distance, so there is no middle left to share. Try a smaller one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este trayecto es más corto que la distancia de recorte, así que no queda parte central que compartir. Prueba con una distancia menor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce trajet est plus court que la distance de rognage, il ne reste donc aucun milieu à partager. Essayez une distance plus faible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הנסיעה הזו קצרה ממרחק הגזימה, ולכן לא נשאר אמצע לשיתוף. נסה מרחק קטן יותר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az út rövidebb, mint a levágási távolság, így nem marad megosztható közepe. Próbálj kisebbet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo viaggio è più corto della distanza di taglio, quindi non resta una parte centrale da condividere. Prova con una distanza minore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この走行はトリミングする距離より短いため、共有できる中間部分が残りません。もっと短い距離をお試しください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze rit is korter dan de inkortafstand, dus er blijft geen middenstuk over om te delen. Probeer een kleinere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten przejazd jest krótszy niż odległość przycięcia, więc nie zostaje żaden środek do udostępnienia. Spróbuj mniejszej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este trajeto é mais curto do que a distância de corte, por isso não sobra meio nenhum para compartilhar. Experimente uma distância menor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este trajeto é mais curto do que a distância a cortar, por isso não sobra meio nenhum para partilhar. Experimente uma distância menor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest traseu este mai scurt decât distanța de decupare, așa că nu rămâne nicio parte centrală care să poată fi partajată. Încearcă o distanță mai mică."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта поездка короче радиуса обрезки, поэтому середины, которой можно поделиться, не остаётся. Попробуйте радиус поменьше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här körningen är kortare än beskärningsavståndet, så det finns ingen mitt kvar att dela. Prova ett mindre."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця поїздка коротша за відстань обрізання, тож середини, якою можна поділитися, не залишилося. Спробуйте меншу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本次行程比裁剪距离还短，没有可分享的中间部分。请换用更小的裁剪距离。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這趟行程比修剪距離還短，沒有中段可以分享。請改用較小的距離。"
          }
        }
      }
    },
