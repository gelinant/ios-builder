    "settings_keep_car_lower_third_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقع السيارة على بعد حوالي ثلث الشاشة من الأسفل، مما يترك الطريق أمامها مرئيًا. إيقاف: تبقى السيارة في المركز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Auto befindet sich etwa ein Drittel des Bildschirms über dem unteren Bildschirmrand, so dass die Straße vor Ihnen sichtbar ist. Aus: Das Auto bleibt in der Mitte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The car sits about a third of the screen up from the bottom, leaving the road ahead visible. Off: the car stays at the centre."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The car sits about a third of the screen up from the bottom, leaving the road ahead visible. Off: the car stays at the centre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El automóvil se ubica aproximadamente a un tercio de la pantalla desde abajo, dejando visible la carretera por delante. Apagado: el coche permanece en el centro."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto istub umbes kolmandiku ekraanist alt üles, jättes eesoleva tee nähtavale. Väljas: auto jääb keskele."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voiture se trouve à environ un tiers de l’écran à partir du bas, laissant la route visible. Éteint : la voiture reste au centre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המכונית יושבת כשליש מהמסך מלמטה, ומשאירה את הדרך שלפניו גלויה. כבוי: המכונית נשארת במרכז."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az autó a képernyő körülbelül egyharmadával alulról felfelé ül, így az előtte lévő út látható. Ki: az autó a központban marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'auto si trova a circa un terzo dello schermo dal basso, lasciando visibile la strada davanti a sé. Spento: l'auto rimane al centro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車は画面の下から 3 分の 1 ほど上に表示され、前方の道路が見えるようになります。オフ: 車は中央に留まります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De auto bevindt zich op ongeveer een derde van het scherm vanaf de onderkant, waardoor de weg voor hem zichtbaar blijft. Uit: de auto blijft in het midden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samochód znajduje się mniej więcej w jednej trzeciej ekranu od dołu, dzięki czemu droga przed nim jest widoczna. Wyłączona: samochód pozostaje na środku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O carro fica a cerca de um terço da tela de baixo para cima, deixando a estrada à frente visível. Desligado: o carro permanece no centro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O carro fica a cerca de um terço da tela de baixo para cima, deixando a estrada à frente visível. Desligado: o carro permanece no centro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mașina se află la aproximativ o treime din ecran din partea de jos, lăsând vizibil drumul din față. Oprit: mașina rămâne în centru."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автомобиль занимает примерно треть экрана снизу, оставляя дорогу впереди видимой. Выкл.: автомобиль остается в центре."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avto ima približno tretjino zaslona navzgor od dna, tako da je cesta pred vami vidna. Izklopljeno: avto ostane na sredini."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilen sitter ungefär en tredjedel av skärmen upp från botten och lämnar vägen framför synlig. Av: bilen står i centrum."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Araba, ekranın yaklaşık üçte biri kadar yukarıda duruyor ve ilerideki yolu görünür bırakıyor. Kapalı: araba ortada kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автомобіль займає приблизно третину екрана від низу, залишаючи видимою дорогу попереду. Вимкнено: автомобіль залишається в центрі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汽车位于屏幕底部大约三分之一的位置，前方的道路可见。关闭：汽车停留在中心位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
