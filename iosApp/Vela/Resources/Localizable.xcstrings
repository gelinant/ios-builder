        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos pasan por %1$@. Elegir uno mantiene la pantalla del viaje y la hoja de detalles en el mismo itinerario."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Need läbivad %1$@. Ühe valimisel jäävad reisiekraan ja üksikasjade leht samale teekonnale."
