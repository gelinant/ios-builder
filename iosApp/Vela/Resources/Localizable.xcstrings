    "settings_area_confirm_region" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch %1$@ für Offline-Routen, Orte und die Karte über dieses Gebiet hinaus laden: etwa %2$@. Das gibt es nur als ganze Region."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also get %1$@ for offline directions, places and the map beyond this area: about %2$@. These only come as a whole region."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga también %1$@ para tener indicaciones, lugares y mapa sin conexión fuera de esta zona: unos %2$@. Solo se ofrecen como región completa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenir aussi %1$@ pour les itinéraires hors ligne, les lieux et la carte au-delà de cette zone : environ %2$@. Ces données ne sont disponibles que par région entière."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להוריד גם את %1$@ לצורך הוראות הגעה, מקומות ומפה ללא חיבור לרשת מחוץ לאזור זה: בסביבות %2$@. אפשרויות אלה זמינות רק בתור מחוז שלם."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Töltsd le a(z) %1$@ régiót is az offline útvonaltervezéshez, a helyekhez és a területen túli térképhez: kb. %2$@. Ezek csak teljes régióként érhetők el."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica anche %1$@ per indicazioni, luoghi e mappa offline oltre quest'area: circa %2$@. Sono disponibili solo come regione intera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ も入手すると、このエリアの外でもオフラインで経路、場所、地図を使えます（約 %2$@）。これらは地域全体でのみダウンロードできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ook %1$@ ophalen voor offline routes, plaatsen en de kaart buiten dit gebied: ongeveer %2$@. Die zijn alleen als hele regio te krijgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobierz też region %1$@ na potrzeby tras offline, miejsc i mapy poza tym obszarem: około %2$@. Te dane są dostępne tylko dla całego regionu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixar também %1$@ para ter direções, locais e o mapa off-line além desta área: cerca de %2$@. Isso só vem como uma região inteira."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transferir também %1$@ para ter direções, locais e mapa offline além desta área: cerca de %2$@. Só existem como região inteira."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De asemenea, primești %1$@ pentru indicații rutiere off-line, locații și harta dincolo de această zonă: aproximativ %2$@. Acestea sunt disponibile doar ca regiune întreagă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно также скачать регион %1$@ для офлайн-маршрутов, мест и карты за пределами этой области: около %2$@. Они скачиваются только целым регионом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hämta även %1$@ för offlinevägbeskrivningar, platser och kartan utanför det här området: cirka %2$@. Dessa finns bara som en hel region."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Також завантажити регіон %1$@ для офлайн-маршрутів, місць і карти поза цією областю: приблизно %2$@. Ці дані бувають лише для цілого регіону."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时获取%1$@的离线路线、地点以及此区域以外的地图：约 %2$@。这些只能按整个地区下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同時取得 %1$@ 的資料，讓這個區域以外也能離線規劃路線、搜尋地點和顯示地圖：約 %2$@。這些資料只能整區下載。"
          }
        }
      }
    },
