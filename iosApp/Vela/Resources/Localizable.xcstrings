    "settings_google_session_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google erkennt dieses Telefon an einem Cookie wieder, sodass alles, was Vela in dieser Zeit nachschlägt, verknüpft werden kann, ohne Namen oder Konto. Eine neue Sitzung begrenzt das. Eine neue Sitzung bekommt von Google eine Weile eine kürzere Ansicht (weniger Rezensionen, bei manchen Orten fehlen Stoßzeiten)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google remembers this phone by a cookie, so what Vela looks up while it lasts can be linked together, without any name or account. Starting a new one caps that. A new session gets a shorter view from Google for a while (fewer reviews, popular times missing on some places)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google reconoce este teléfono por una cookie, así que lo que Vela consulta mientras dura puede vincularse, sin nombre ni cuenta. Iniciar una nueva lo limita. Una sesión nueva recibe de Google una vista reducida durante un tiempo (menos reseñas, sin horas populares en algunos lugares)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google reconnaît ce téléphone grâce à un cookie, donc ce que Vela consulte pendant sa durée de vie peut être relié, sans nom ni compte. En démarrer une nouvelle limite cela. Une nouvelle session reçoit de Google une vue réduite pendant un moment (moins d'avis, heures d'affluence absentes pour certains lieux)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google מזהה את הטלפון הזה לפי עוגייה, כך שמה ש-Vela מחפש כל עוד היא בתוקף יכול להיות מקושר יחד, בלי שם או חשבון. התחלת הפעלה חדשה מגבילה את זה. הפעלה חדשה מקבלת מ-Google תצוגה מקוצרת למשך זמן מה (פחות ביקורות, שעות עומס חסרות בחלק מהמקומות)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Google egy sütivel ismeri fel ezt a telefont, így amit a Vela a süti élettartama alatt lekérdez, összekapcsolható, név vagy fiók nélkül is. Egy új munkamenet indítása ezt korlátozza. Egy új munkamenet egy ideig rövidebb nézetet kap a Google-tól (kevesebb vélemény, egyes helyeknél hiányoznak a népszerű időpontok)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google riconosce questo telefono tramite un cookie, quindi ciò che Vela cerca finché dura può essere collegato, senza nome né account. Avviarne uno nuovo limita questo collegamento. Una sessione nuova riceve per un po' una vista ridotta da Google (meno recensioni, orari di affluenza assenti per alcuni luoghi)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google は Cookie でこの端末を識別するため、その Cookie が有効な間に Vela が調べた内容は、名前やアカウントがなくても互いに結び付けられます。新しいセッションを始めると、それを区切れます。新しいセッションでは、しばらく Google の表示が制限されます（クチコミが少なく、一部の場所で混雑する時間帯が表示されない）。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google herkent deze telefoon aan een cookie, dus wat Vela opzoekt zolang die geldig is, kan aan elkaar worden gekoppeld, zonder naam of account. Een nieuwe starten beperkt dat. Een nieuwe sessie krijgt een tijdje een kortere weergave van Google (minder recensies, bij sommige plaatsen geen drukke tijden)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google rozpoznaje ten telefon po pliku cookie, więc to czego Vela szuka póki ten plik jest ważny można ze sobą powiązać bez imienia ani konta. Rozpoczęcie nowej sesji to ogranicza. Nowa sesja przez jakiś czas dostaje od Google skrócony widok (mniej opinii, przy niektórych miejscach brak popularnych godzin)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Google reconhece este celular por um cookie, por isso o que o Vela pesquisa enquanto ele durar pode ser ligado entre si, sem nenhum nome nem conta. Iniciar uma nova sessão limita isso. Uma sessão nova recebe do Google uma visão mais curta durante algum tempo (menos avaliações, sem horários de pico em alguns locais)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Google reconhece este telemóvel por um cookie, por isso o que a Vela pesquisa enquanto ele dura pode ser ligado entre si, sem nenhum nome nem conta. Iniciar uma nova sessão limita isso. Uma sessão nova recebe da Google uma vista mais curta durante algum tempo (menos avaliações, sem horas de maior movimento em alguns locais)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google recunoaște acest dispozitiv prin intermediul cookie, așadar tot ceea ce caută Vela cât timp este activă pot fi legat între ele, deși fără un nume sau un cont. Acest lucru limitează noua sesiune. Pentru o perioadă, o nouă sesiune primește o versiune prescurtată de la Google (mai puține recenzii, unele locațiile nu au ore de popularitate)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google узнаёт этот телефон по cookie, поэтому всё, что Vela ищет, пока он действует, можно связать между собой, хоть и без имени и аккаунта. Новый сеанс это ограничивает. Новый сеанс какое-то время получает от Google сокращённую версию (меньше отзывов, у некоторых мест нет популярного времени)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google känner igen den här telefonen med en cookie, så det Vela slår upp medan den gäller kan kopplas ihop, utan namn eller konto. Att starta en ny sätter en gräns för det. En ny session får en kortare vy från Google ett tag (färre recensioner, populära tider saknas för vissa platser)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google впізнає цей телефон за cookie, тож усе, що Vela шукає, поки він діє, можна пов'язати між собою, хоч і без імені чи акаунта. Новий сеанс це обмежує. Новий сеанс якийсь час отримує від Google скорочену версію (менше відгуків, у деяких місць немає годин відвідуваності)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 通过 Cookie 识别这部手机，因此在其有效期内 Vela 查询的内容可以被关联在一起，尽管不涉及任何姓名或账号。开始新会话可以限制这种关联。新会话在一段时间内从 Google 获得的内容会较少（评价更少，部分地点缺少热门时段）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 會用 Cookie 記住這支手機，所以在它有效期間，Vela 查詢過的內容都可能被串在一起，不過不會牽涉任何姓名或帳戶。開始新的工作階段就能限制這種關聯。新的工作階段在一段時間內從 Google 拿到的內容會比較少（評論較少，部分地點沒有熱門時段）。"
          }
        }
      }
    },
