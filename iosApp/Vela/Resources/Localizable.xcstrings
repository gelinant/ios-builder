    "settings_voice_lib_lang_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wegbeschreibungen werden in %1$@ angegeben. Laden Sie unten eine %2$@-Stimme herunter, damit die gesprochenen Wegbeschreibungen übereinstimmen (eine englische Stimme würde die Straßennamen in %3$@ falsch aussprechen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directions are in %1$@. Download a %2$@ voice below so the spoken directions match (an English voice would mispronounce %3$@ street names)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El idioma de tu app es %1$@: descarga una voz en %2$@ más abajo para que las indicaciones habladas coincidan (una voz en inglés pronunciaría mal los nombres de calles en %3$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La langue de votre application est %1$@, téléchargez une voix %2$@ ci-dessous pour que les instructions vocales correspondent (une voix anglaise prononcerait mal les noms de rues en %3$@)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוראות הניווט נשמרות בתוך %1$@. מומלץ להוריד למטה קול של השפה ה%2$@ כדי שההוראות המדוברות יתאימו (קול אנגלי יהגה לא נכון שמות רחובות ב%3$@)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az app nyelve %1$@. Tölts le egy %2$@ hangot lent, hogy a hangos útvonalvezetés illeszkedjen (egy angol hang rosszul ejtené a(z) %3$@ utcaneveket)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le indicazioni sono in %1$@. Scarica una voce in %2$@ qui sotto affinché le indicazioni vocali corrispondano (una voce inglese pronuncerebbe in modo errato i nomi delle strade in %3$@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの言語は %1$@ です。音声案内を合わせるため、下から %2$@ の音声をダウンロードしてください（英語の音声では %3$@ の通りの名前を正しく発音できません）。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw apptaal is %1$@, download hieronder een %2$@-stem zodat de gesproken instructies overeenkomen (een Engelse stem zou %3$@ straatnamen verkeerd uitspreken)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskazówki głosowe są w języku %1$@. Pobierz głos %2$@ poniżej aby wskazówki głosowe pasowały (angielski głos błędnie wymawiałby %3$@ nazwy ulic)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O idioma do seu app é %1$@. Baixe uma voz de %2$@ abaixo para que as instruções faladas correspondam (uma voz de inglês pronunciaria mal os nomes das ruas em %3$@)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direções estão em %1$@, transfira uma voz de %2$@ abaixo para que as indicações faladas correspondam (uma voz de inglês pronunciaria mal os nomes das ruas em %3$@)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicațiile de orientare sunt exprimate în %1$@. Descarcă mai jos o voce %2$@, astfel încât indicațiile vocale să corespundă (o voce în limba engleză ar pronunța greșit numele străzilor din %3$@)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Язык приложения, %1$@. Загрузите голос (%2$@) ниже, чтобы голосовые подсказки совпадали (английский голос неправильно произнёс бы названия улиц (%3$@))."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt appspråk är %1$@, hämta en %2$@-röst nedan så att talade vägbeskrivningar matchar (en engelsk röst skulle uttala %3$@ gatunamn fel)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мова застосунку, %1$@. Завантажте голос %2$@ нижче, щоб голосові вказівки відповідали (англійський голос неправильно вимовляв би назви вулиць мовою %3$@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的应用语言是%1$@。请在下方下载%2$@语音，让语音播报与之匹配（英语语音会读错%3$@街道名称）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的應用程式語言是%1$@。請在下方下載%2$@語音，讓語音指引與語言相符（英文語音會唸錯%3$@的街道名稱）。"
          }
        }
      }
    },
