    "settings_prefer_buttons_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält eine Schaltfläche für alles, was es auch als Geste gibt: Schaltflächen zum Vergrößern und Verkleinern auf der Karte und die Schaltfläche für die Wegbeschreibung in der Navigationsleiste. Bei Telefonen ohne Touchscreen immer an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps a button for things that also have a gesture: zoom in and out buttons on the map, and the step list button on the navigation bar. Always on for phones without a touch screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene un botón para lo que también tiene un gesto: los botones de acercar y alejar en el mapa y el botón de la lista de pasos en la barra de navegación. Siempre activado en teléfonos sin pantalla táctil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde un bouton pour ce qui a aussi un geste : les boutons de zoom avant et arrière sur la carte, et le bouton de liste des étapes dans la barre de navigation. Toujours activé sur les téléphones sans écran tactile."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משאיר כפתור לדברים שיש להם גם מחווה: כפתורי התקרבות והתרחקות במפה, וכפתור רשימת השלבים בסרגל הניווט. תמיד דלוק בטלפונים ללא מסך מגע."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meghagy egy gombot azokhoz a műveletekhez, amelyekhez gesztus is tartozik: nagyítás és kicsinyítés gombok a térképen, valamint a lépéslista gomb a navigációs sávon. Érintőképernyő nélküli telefonokon mindig bekapcsolva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene un pulsante per le cose che hanno anche un gesto: i pulsanti di zoom sulla mappa e il pulsante dell'elenco dei passaggi nella barra di navigazione. Sempre attivo sui telefoni senza touch screen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジェスチャーでも操作できる項目にボタンを残します（地図の拡大・縮小ボタン、ナビバーのルート詳細ボタン）。タッチスクリーンのない端末では常にオンです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt een knop voor dingen die ook een gebaar hebben: knoppen om in en uit te zoomen op de kaart, en de knop voor de stappenlijst op de navigatiebalk. Altijd aan voor telefoons zonder aanraakscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowuje przycisk tam gdzie jest też gest: przyciski przybliżania i oddalania na mapie oraz przycisk listy etapów na pasku nawigacji. Zawsze włączone na telefonach bez ekranu dotykowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém um botão para as coisas que também têm um gesto: botões de aproximar e afastar no mapa e o botão da lista de etapas na barra de navegação. Sempre ativado em celulares sem tela sensível ao toque."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém um botão para as coisas que também têm um gesto: botões de aproximar e afastar no mapa e o botão da lista de etapas na barra de navegação. Sempre ligado em telemóveis sem ecrã tátil."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menține activ un buton pentru elementele care pot fi controlate și prin gesturi: butoanele de mărire și micșorare de pe hartă și butonul listei de pași din bara de navigare. Rămâne activ în permanență pe telefoanele fără ecran tactil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставляет кнопку там, где есть и жест: кнопки приближения и отдаления на карте и кнопку списка шагов на панели навигации. На телефонах без сенсорного экрана всегда включено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behåller en knapp för sådant som också har en gest: knappar för att zooma in och ut på kartan, och knappen för steglistan i navigeringsfältet. Alltid på för telefoner utan pekskärm."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залишає кнопку для того, що має й жест: кнопки наближення та віддалення на карті й кнопку списку кроків на панелі навігації. Завжди увімкнено на телефонах без сенсорного екрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为同时支持手势的操作保留按钮：地图上的放大和缩小按钮，以及导航栏上的步骤列表按钮。无触摸屏的手机始终开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為同時有手勢的功能保留按鈕：地圖上的放大與縮小按鈕，以及導航列上的步驟清單按鈕。沒有觸控螢幕的手機一律開啟。"
          }
        }
      }
    },
