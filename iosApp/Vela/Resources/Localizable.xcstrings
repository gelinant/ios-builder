    "settings_house_numbers_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hausnummern stammen aus OpenStreetMap und in den USA aus OpenAddresses. Ein Gebäude, das in beiden keine Nummer hat, zeigt keine, auch wenn die Suche die Adresse über Google trotzdem findet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "House numbers come from OpenStreetMap and, in the US, OpenAddresses. A building that has no number in either shows none, even though search still finds the address through Google."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los números de casa vienen de OpenStreetMap y, en EE. UU., de OpenAddresses. Un edificio que no tenga número en ninguno de los dos no muestra ninguno, aunque la búsqueda siga encontrando la dirección a través de Google."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les numéros de rue proviennent d'OpenStreetMap et, aux États-Unis, d'OpenAddresses. Un bâtiment absent des deux n'en affiche aucun, même si la recherche trouve toujours l'adresse via Google."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מספרי הבתים מגיעים מ-OpenStreetMap, ובארצות הברית גם מ-OpenAddresses. בניין שאין לו מספר באף אחד מהם לא יציג מספר, גם אם החיפוש עדיין מוצא את הכתובת דרך Google."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A házszámok az OpenStreetMap-ből, az Egyesült Államokban pedig az OpenAddresses-ből származnak. Amelyik épülethez egyikben sincs szám, annál nem jelenik meg semmi, még akkor sem, ha a keresés a Google-n keresztül továbbra is megtalálja a címet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I numeri civici arrivano da OpenStreetMap e, negli Stati Uniti, da OpenAddresses. Un edificio che non ha il numero in nessuno dei due non ne mostra, anche se la ricerca trova comunque l'indirizzo tramite Google."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番地は OpenStreetMap、米国では OpenAddresses のデータです。どちらにも番号がない建物には表示されませんが、検索では Google 経由でその住所を見つけられます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huisnummers komen uit OpenStreetMap en, in de VS, OpenAddresses. Een gebouw dat in geen van beide een nummer heeft, toont er geen, ook al vindt zoeken het adres nog steeds via Google."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numery domów pochodzą z OpenStreetMap, a w USA z OpenAddresses. Budynek, który nie ma numeru w żadnym z nich, nie pokaże go, choć wyszukiwanie i tak znajdzie adres przez Google."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os números de porta vêm do OpenStreetMap e, nos EUA, do OpenAddresses. Um edifício que não tenha número em nenhum dos dois não mostra nenhum, mesmo que a pesquisa ainda encontre o endereço pelo Google."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os números de porta vêm do OpenStreetMap e, nos EUA, do OpenAddresses. Um edifício que não tenha número em nenhum dos dois não mostra nenhum, mesmo que a pesquisa continue a encontrar a morada através da Google."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numerele caselor provin de la OpenStreetMap și, în SUA, de la OpenAddresses. Dacă o clădire nu are un număr în niciuna dintre locuri, aceasta nu va apărea, deși o căutare pe Google va găsi totuși adresa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Номера домов берутся из OpenStreetMap, а в США ещё и из OpenAddresses. Если у здания нет номера ни там, ни там, он не показывается, хотя поиск всё равно найдёт адрес через Google."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husnummer kommer från OpenStreetMap och, i USA, OpenAddresses. En byggnad som saknar nummer i båda visar inget, även om sökningen ändå hittar adressen via Google."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Номери будинків беруться з OpenStreetMap, а в США ще й з OpenAddresses. Будинок, для якого номера немає ніде, залишиться без нього, хоча пошук усе одно знайде адресу через Google."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "门牌号来自 OpenStreetMap，在美国还来自 OpenAddresses。两者都没有号码的建筑不会显示门牌号，但搜索仍可通过 Google 找到该地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "門牌號碼來自 OpenStreetMap，美國地區另外使用 OpenAddresses。兩者都沒有號碼的建築物不會顯示號碼，但搜尋仍可透過 Google 找到該地址。"
          }
        }
      }
    },
