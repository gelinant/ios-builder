    "settings_parking_button_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die P-Taste auf der Karte, die speichert, wo Sie geparkt haben. Aus: Sie erscheint nur, solange ein Parkplatz gespeichert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The P button on the map that saves where you parked. Off: it shows only while a spot is saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón P del mapa que guarda dónde aparcaste. Desactivado: solo aparece mientras haya un sitio guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton P sur la carte qui enregistre où vous êtes garé. Désactivé : il n'apparaît que lorsqu'une place est enregistrée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כפתור ה-P במפה ששומר איפה חנית. כבוי: הוא מוצג רק כשיש מיקום חניה שמור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A térképen lévő P gomb, amely elmenti, hol parkoltál. Kikapcsolva: csak akkor látszik, amíg van mentett hely."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pulsante P sulla mappa che salva dove hai parcheggiato. Disattivato: compare solo quando c'è un parcheggio salvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "駐車位置を保存する地図上の P ボタンです。オフにすると、駐車位置を保存している間だけ表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De P-knop op de kaart die opslaat waar je hebt geparkeerd. Uit: hij verschijnt alleen zolang er een plek is opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przycisk P na mapie, który zapisuje miejsce parkowania. Wyłączone: widać go tylko, gdy miejsce jest zapisane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O botão P no mapa que salva onde você estacionou. Desativado: só aparece enquanto houver uma vaga salva."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O botão P no mapa que guarda o local onde estacionou. Desligado: só aparece enquanto houver um lugar guardado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Butonul P de pe hartă care salvează locul unde ai parcat. Dezactivat: se afișează doar cât timp un loc este salvat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка P на карте, которая сохраняет место парковки. Выкл.: она видна, только пока место сохранено."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumb P na zemljevidu shrani mesto parkiranja. Če možnost izklopite, je prikazan samo, ko je parkirno mesto shranjeno."
          }
        },
        "sv" : {
