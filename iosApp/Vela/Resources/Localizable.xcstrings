    "settings_nav_trace_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet auf, wie sich die Kartenkamera während der Navigation bewegt, damit eine ruckelnde oder schwimmende Karte untersucht werden kann. Enthält keine Standortdaten, nur Richtungen, Geschwindigkeiten und Zeiten, und kann daher gefahrlos an einen Fehlerbericht angehängt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records how the map camera moves while you navigate, so a jittery or swimming map can be diagnosed. Contains no location data, only headings, speeds and timings, so it is safe to attach to a bug report."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba cómo se mueve la cámara del mapa mientras navegas, para poder diagnosticar un mapa con tirones o que parece flotar. No contiene datos de ubicación, solo rumbos, velocidades y tiempos, así que puedes adjuntarlo sin problema a un informe de error."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre les mouvements de la caméra de la carte pendant la navigation, pour diagnostiquer une carte qui tremble ou qui flotte. Ne contient aucune donnée de position, seulement des caps, des vitesses et des durées : vous pouvez la joindre à un rapport de bug sans risque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מקליט איך מצלמת המפה זזה בזמן ניווט, כדי שאפשר יהיה לאבחן מפה רועדת או שוחה. לא מכיל נתוני מיקום, רק כיוונים, מהירויות ותזמונים, ולכן בטוח לצרף אותו לדוח תקלה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rögzíti, hogyan mozog a térkép kamerája navigáció közben, hogy egy szaggatott vagy imbolygó térkép diagnosztizálható legyen. Nem tartalmaz helyadatot, csak irányokat, sebességeket és időzítéseket, ezért biztonságosan csatolható egy hibajelentéshez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra come si muove la camera della mappa durante la navigazione, così una mappa che vibra o scivola può essere diagnosticata. Non contiene dati di posizione, solo direzioni, velocità e tempi, quindi si può allegare a una segnalazione senza problemi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ナビ中に地図のカメラがどう動いたかを記録し、地図のガタつきや流れるような動きを調べられるようにします。位置情報は含まず、方位・速度・タイミングのみなので、不具合報告に添付しても安全です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt vast hoe de kaartcamera beweegt terwijl je navigeert, zodat een schokkende of zwevende kaart onderzocht kan worden. Bevat geen locatiegegevens, alleen richtingen, snelheden en tijden, dus je kunt het veilig aan een bugrapport toevoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejestruje jak porusza się kamera mapy podczas nawigacji aby dało się zdiagnozować drgającą lub pływającą mapę. Nie zawiera danych o lokalizacji tylko kierunki, prędkości i czasy więc można go bezpiecznie dołączyć do zgłoszenia błędu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra como a câmera do mapa se move durante a navegação, para que seja possível diagnosticar um mapa trêmulo ou instável. Não contém dados de localização, apenas direções, velocidades e tempos, por isso é seguro anexá-lo a um relatório de erro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regista como a câmara do mapa se move durante a navegação, para poder diagnosticar um mapa trémulo ou instável. Não contém dados de localização, apenas direções, velocidades e tempos, por isso é seguro juntá-lo a um relatório de erro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrează modul în care se mișcă camera hărții în timp ce navighezi, astfel încât să se poată diagnostica o hartă tremurândă sau „plutirea” hărții. Nu conține date despre locație, ci doar direcții, viteze și temporizări, deci poate fi atașată în siguranță la un raport de eroare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает, как движется камера карты во время навигации, чтобы можно было разобраться с рывками или «плаванием» карты. Данных о местоположении не содержит, только направления, скорости и тайминги, поэтому её безопасно приложить к отчёту об ошибке."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beleži premikanje kamere zemljevida med navigacijo za odkrivanje zatikanja. Ne vsebuje lokacijskih podatkov, temveč le smeri, hitrosti in časovne podatke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelar in hur kartkameran rör sig medan du navigerar, så att en ryckig eller flytande karta går att felsöka. Innehåller inga platsdata, bara riktningar, hastigheter och tider, så den är säker att bifoga i en felrapport."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записує, як рухається камера карти під час навігації, щоб можна було з'ясувати причину смикання чи «плавання» карти. Не містить даних про місцезнаходження, лише напрямки, швидкості та час, тож його безпечно додавати до звіту про помилку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录导航时地图镜头的移动方式，以便诊断画面抖动或漂移。不含位置数据，只有朝向、速度和时间信息，可放心附在问题反馈中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記錄導航時地圖鏡頭的移動方式，以便診斷地圖抖動或漂移。不含任何位置資料，只有方位、速度與時間，可以安心附在錯誤回報中。"
          }
        }
      }
    },
