    "map_both_rasters_need_a_network_connection" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج كلا البيانات النقطية إلى اتصال بالشبكة. ولا يتم تمكينها مطلقًا في المنطقة التي تم تنزيلها، حيث تكون الخريطة المتجهة هي الخريطة غير المتصلة بالإنترنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Raster benötigen eine Netzwerkverbindung. Sie werden niemals für eine heruntergeladene Region aktiviert, in der die Vektorkarte die Offline-Karte ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both rasters need a network connection. They are never enabled over a downloaded region, where the vector map is the offline map."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both rasters need a network connection. They are never enabled over a downloaded region, where the vector map is the offline map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos rásteres necesitan una conexión de red. Nunca se habilitan en una región descargada, donde el mapa vectorial es el mapa sin conexión."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mõlemad rastrid vajavad võrguühendust. Neid ei lubata kunagi allalaaditud piirkonnas, kus vektorkaart on võrguühenduseta kaart."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux rasters nécessitent une connexion réseau. Ils ne sont jamais activés sur une région téléchargée, où la carte vectorielle est la carte hors ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שני הרסטרים זקוקים לחיבור רשת. הם לעולם אינם מופעלים באזור שהורד, כאשר המפה הווקטורית היא המפה הלא מקוונת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindkét raszternek hálózati kapcsolatra van szüksége. Soha nem engedélyezettek egy letöltött régióban, ahol a vektoros térkép az offline térkép."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrambi i raster necessitano di una connessione di rete. Non vengono mai abilitati su una regione scaricata, dove la mappa vettoriale è la mappa offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらのラスターにもネットワーク接続が必要です。これらは、ベクトル マップがオフライン マップであるダウンロードされたリージョンでは決して有効になりません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide rasters hebben een netwerkverbinding nodig. Ze worden nooit ingeschakeld via een gedownloade regio, waarbij de vectorkaart de offline kaart is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obydwa rastry wymagają połączenia sieciowego. Nigdy nie są one włączone w pobranym regionie, gdzie mapa wektorowa jest mapą offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos os rasters precisam de uma conexão de rede. Eles nunca são habilitados em uma região baixada, onde o mapa vetorial é o mapa offline."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos os rasters precisam de uma conexão de rede. Eles nunca são habilitados em uma região baixada, onde o mapa vetorial é o mapa offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambele raster-uri au nevoie de o conexiune la rețea. Ele nu sunt niciodată activate într-o regiune descărcată, unde harta vectorială este harta offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оба растра требуют подключения к сети. Они никогда не включаются в загруженном регионе, где векторная карта является автономной картой."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oba rastra potrebujeta omrežno povezavo. Nikoli niso omogočeni v preneseni regiji, kjer je vektorski zemljevid zemljevid brez povezave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Båda rasterna behöver en nätverksanslutning. De är aldrig aktiverade över en nedladdad region, där vektorkartan är offlinekartan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her iki taramanın da bir ağ bağlantısına ihtiyacı vardır. Vektör haritasının çevrimdışı harita olduğu indirilen bir bölge üzerinde hiçbir zaman etkinleştirilmezler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обидва растри потребують підключення до мережі. Вони ніколи не вмикаються в завантаженому регіоні, де векторна карта є офлайновою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两个栅格都需要网络连接。它们永远不会在下载的区域上启用，其中矢量地图是离线地图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩個柵格都需要網路連接。它們永遠不會在下載的區域上啟用，其中向量地圖是離線地圖。"
          }
        }
      }
    },
